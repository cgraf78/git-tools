#!/usr/bin/env bash
# Audit local branches and report exact merged-branch cleanup candidates.

set -euo pipefail

# shellcheck disable=SC2034 # consumed by lib/git-tools-pr.sh after dynamic source
gt_command="git branch-audit"

# BEGIN GENERATED LAUNCHER BOOTSTRAP
# Generated by support/sync-launcher-bootstrap; edit the template, not launcher copies.
_script_path="${BASH_SOURCE[0]}"
while [[ -L "$_script_path" ]]; do
  _script_dir=$(cd -P -- "$(dirname -- "$_script_path")" && pwd)
  _link=$(readlink "$_script_path")
  case "$_link" in
    /*) _script_path="$_link" ;;
    *) _script_path="$_script_dir/$_link" ;;
  esac
done
_root=$(cd -P -- "$(dirname -- "$_script_path")/.." && pwd)
# END GENERATED LAUNCHER BOOTSTRAP
# shellcheck disable=SC1091
. "$_root/lib/git-tools-pr.sh"
# shellcheck disable=SC1091
. "$_root/lib/git-tools-base.sh"
# shellcheck disable=SC1091
. "$_root/lib/git-tools-cleanup.sh"

_usage() {
  cat <<'EOF'
Usage: git branch-audit [options]

List local branches with their state relative to the default branch: last commit
age, ahead/behind counts, whether they are merged into the default branch, and
the open PR number when GitHub data is available. The default branch itself is
the reference point and is omitted from the listing.

Merge status uses the same proofs as git cleanup-repo: ancestry, an exact
squash, rebase, or cherry-pick replay, or a branch tree that is a mainline
snapshot. Incomplete branch enumeration aborts reporting. The audit only
reports; preview cleanup with git cleanup-repo --dry-run.

Options:
      --porcelain        Print stable tab-separated branch records.
  -b, --base <branch>    Use this branch as the default instead of inferring one.
  -h, --help             Show this help.

Exit status:
  0  Audit completed.
  1  Audit failed.
  2  Usage or local environment error.
EOF
}

_porcelain=0
_base=""

while (($#)); do
  case "$1" in
    --porcelain)
      _porcelain=1
      shift
      ;;
    --drop-merged | --yes | -n | --dry-run)
      # The audit used to report cleanup candidates without deleting them.
      # cleanup-repo now owns that decision, with the same proofs.
      gt_usage_error "$1 was removed; branch-audit only reports, preview cleanup with: git cleanup-repo --dry-run"
      ;;
    -b | --base)
      shift
      (($#)) || gt_usage_error "--base requires a value"
      _base="$1"
      shift
      ;;
    --base=*)
      _base="${1#--base=}"
      [[ -n "$_base" ]] || gt_usage_error "--base requires a value"
      shift
      ;;
    -h | --help)
      _usage
      exit 0
      ;;
    -*)
      gt_usage_error "unexpected option: $1"
      ;;
    *)
      gt_usage_error "unexpected argument: $1"
      ;;
  esac
done

# Resolve the default branch to a concrete ref so ahead/behind and merge checks
# work even when only a remote-tracking copy exists locally.
_resolve_default() {
  local ref_status=0

  if [[ -n "$_base" ]]; then
    _default="$_base"
  else
    # origin is the conventional default remote; naming it also keeps the
    # shared helper's optional argument explicit for shellcheck (SC2119).
    _default=$(gt_default_branch origin) ||
      gt_usage_error "could not determine default branch; pass --base <branch>"
  fi

  git check-ref-format --branch "$_default" >/dev/null 2>&1 ||
    gt_usage_error "invalid base branch name: $_default"

  gt_find_ref_commit "refs/heads/$_default" || ref_status=$?
  if [[ "$ref_status" == 0 ]]; then
    _default_oid=$GT_REF_OID
    return 0
  fi
  [[ "$ref_status" == 1 ]] ||
    gt_die "could not inspect default branch ref: refs/heads/$_default"

  ref_status=0
  gt_find_ref_commit "refs/remotes/origin/$_default" || ref_status=$?
  case "$ref_status" in
    0)
      _default_oid=$GT_REF_OID
      ;;
    1) gt_usage_error "default branch ref not found: $_default" ;;
    *) gt_die "could not inspect default branch ref: refs/remotes/origin/$_default" ;;
  esac
}

_branch_records() {
  git for-each-ref \
    --format='%(refname)%09%(objectname)%09%(committerdate:unix)%09%(committerdate:relative)%09%(upstream:track)' \
    refs/heads
}

_list() {
  local records ref name oid cdate crel track behind ahead merged gone pr counts
  local proof

  records=$(_branch_records) || gt_die "could not enumerate branches"

  while IFS=$'\t' read -r ref oid cdate crel track; do
    [[ -n "$ref" ]] || continue
    case "$ref" in
      refs/heads/*) name=${ref#refs/heads/} ;;
      *) gt_die "invalid branch inventory record: $ref" ;;
    esac
    [[ "$name" != "$_default" ]] || continue

    counts=$(git rev-list --left-right --count "$_default_oid...$oid" 2>/dev/null) ||
      gt_die "could not compare branch to default: $name"
    read -r behind ahead <<<"$counts"
    merged=false
    proof=""
    # The count walk already classifies both one-sided histories. No branch-only
    # commits means an ordinary merge; no default-only commits means the branch
    # was based on the current default, which therefore cannot already contain
    # a landing of it. Only genuinely divergent histories need the more
    # expensive exact-delta, patch-ID, and mainline-tree proofs, which are the
    # ones gt_merge_proof runs after its ancestry check.
    if [[ "$ahead" == 0 ]]; then
      proof=merged
    elif [[ "$behind" != 0 ]] &&
      gt_merge_proof "$oid" "$_default_oid" divergent; then
      proof=$GT_CLEANUP_PROOF
    fi
    [[ -z "$proof" ]] || merged=true
    gone=false
    [[ "$track" == "[gone]" ]] && gone=true
    pr=$(gt_pr_number_for_branch "$name" || true)

    if [[ "$_porcelain" == 1 ]]; then
      printf 'branch\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$name" "$merged" "$ahead" "$behind" "$pr" "$cdate" "$gone" \
        "$proof" "$oid"
    else
      printf '%s merged=%s ahead=%s behind=%s gone=%s' "$name" "$merged" "$ahead" "$behind" "$gone"
      [[ -z "$proof" ]] || printf ' proof=%s' "$proof"
      [[ -z "$pr" ]] || printf ' pr=#%s' "$pr"
      printf ' (%s)\n' "$crel"
    fi
  done <<<"$records"
}

gt_require_repo
_resolve_default

gt_pr_load
_list
