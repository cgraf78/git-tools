#!/usr/bin/env bash
# Clean up stale local Git branches after PRs have landed.

set -euo pipefail

# BEGIN GENERATED LAUNCHER BOOTSTRAP
# Generated by support/sync-launcher-bootstrap; edit the template, not launcher copies.
_script_path="${BASH_SOURCE[0]}"
while [[ -L "$_script_path" ]]; do
  _script_dir=$(cd -P -- "$(dirname -- "$_script_path")" && pwd)
  _link=$(readlink "$_script_path")
  case "$_link" in
    /*) _script_path="$_link" ;;
    *) _script_path="$_script_dir/$_link" ;;
  esac
done
_root=$(cd -P -- "$(dirname -- "$_script_path")/.." && pwd)
# END GENERATED LAUNCHER BOOTSTRAP
# shellcheck disable=SC1091
. "$_root/lib/git-tools-base.sh"

_usage() {
  cat <<'EOF'
Usage: git cleanup-repo [options]

Fetch the exact remote base, update it by pinned OID, then delete stale local
branches whose exact OIDs are proven merged. Patch IDs identify replay
candidates, but exact raw-delta evidence is also required. Historical squash
proof survives later mainline edits. Incomplete branch inventories abort before
deletion.

Options:
  -b, --base <branch>       Base branch to keep and update.
  -r, --remote <name>       Remote endpoint to fetch from (default: origin).
      --gone                Select gone-upstream branches for cleanup.
  -a, --all                 Delete all local branches except the base branch.
      --remove-worktrees    Remove eligible linked worktrees for deleted branches.
  -n, --dry-run             Print actions without changing anything.
  -h, --help                Show this help.
EOF
}

_die() {
  printf 'git cleanup-repo: %s\n' "$*" >&2
  exit 2
}

_say() {
  printf 'git cleanup-repo: %s\n' "$*" >&2
}

_run() {
  if [[ "$_dry_run" == 1 ]]; then
    printf 'git cleanup-repo: would run:' >&2
    printf ' %q' "$@" >&2
    printf '\n' >&2
    return 0
  fi
  "$@"
}

_git_path_exists() {
  local path
  path=$(git rev-parse --git-path "$1") || return 2
  [[ -e "$path" ]]
}

_ensure_repo_ready() {
  local bare state state_rc status

  git rev-parse --git-dir >/dev/null 2>&1 ||
    _die "not inside a git repository"
  bare=$(git rev-parse --is-bare-repository) ||
    _die "could not inspect repository type"
  [[ "$bare" == "false" ]] ||
    _die "bare repositories are not supported"

  for state in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
    state_rc=0
    _git_path_exists "$state" || state_rc=$?
    case "$state_rc" in
      0) _die "repository already has an active rebase, merge, cherry-pick, or revert" ;;
      1) ;;
      *) _die "could not inspect repository operation state" ;;
    esac
  done

  # Switching branches and fast-forwarding the base should not trample pending
  # edits. Keep cleanup focused on refs, not worktree conflict resolution.
  status=$(GIT_OPTIONAL_LOCKS=0 git status --porcelain) ||
    _die "could not inspect worktree status"
  if [[ -n "$status" ]]; then
    if [[ "$_dry_run" == 1 ]]; then
      _say "worktree is dirty; real cleanup would stop before changing refs"
      return 0
    fi
    _die "worktree must be clean before cleanup"
  fi
}

_resolve_remote() {
  local configured="" configured_count=0 value

  while IFS= read -r value; do
    configured_count=$((configured_count + 1))
    configured=$value
  done < <(git config --get-all "remote.$_remote.url" 2>/dev/null)
  [[ "$configured_count" == 1 && -n "$configured" ]] ||
    _die "could not resolve one fetch endpoint for remote: $_remote"
  # Reuse the raw URL so Git applies insteadOf exactly once per operation.
  _remote_url=$configured
}

_local_branch_exists() {
  gt_find_ref_commit "refs/heads/$1"
}

_validate_native_oid() {
  local oid="$1"
  [[ "${#oid}" == "$_oid_width" && "$oid" != *[!0-9a-f]* ]]
}

_default_branch() {
  if [[ -n "$_base" ]]; then
    printf '%s\n' "$_base"
    return 0
  fi

  gt_default_branch "$_remote" ||
    _die "could not determine base branch; pass --base <branch>"
}

_cleanup_dry_objects() {
  local status=$?

  trap - EXIT HUP INT TERM
  if [[ -n "${_dry_object_root:-}" ]]; then
    rm -rf -- "$_dry_object_root" || status=2
  fi
  exit "$status"
}

# Dry-run classification still needs the exact remote base object, which may not
# exist locally; `git fetch --dry-run` therefore cannot supply the commit graph
# needed below. A normal no-ref fetch avoids ref and FETCH_HEAD updates but would
# still add objects to the repository. Redirect those writes to private temporary
# storage, expose the original object store and caller-provided alternates only as
# read sources, and remove the temporary store on normal or signaled exit.
_enable_dry_object_store() {
  local source_objects existing_alternates="${GIT_ALTERNATE_OBJECT_DIRECTORIES:-}"

  source_objects=${GIT_OBJECT_DIRECTORY:-}
  if [[ -z "$source_objects" ]]; then
    source_objects=$(git rev-parse --git-path objects) ||
      _die "could not resolve local object storage"
    source_objects=$(cd -P -- "$source_objects" && pwd -P) ||
      _die "could not resolve absolute local object storage"
  fi
  _dry_object_root=""
  trap _cleanup_dry_objects EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  _dry_object_root=$(umask 077 &&
    mktemp -d "${TMPDIR:-/tmp}/git-cleanup-repo-dry.XXXXXX") ||
    _die "could not create dry-run object storage"
  mkdir -m 700 "$_dry_object_root/objects" ||
    _die "could not initialize dry-run object storage"

  export GIT_OBJECT_DIRECTORY="$_dry_object_root/objects"
  if [[ -n "$existing_alternates" ]]; then
    export GIT_ALTERNATE_OBJECT_DIRECTORIES="$source_objects:$existing_alternates"
  else
    export GIT_ALTERNATE_OBJECT_DIRECTORIES="$source_objects"
  fi
}

_pin_remote_base() {
  local record status=0 oid ref extra resolved

  record=$(git ls-remote --exit-code -- "$_remote_url" \
    "refs/heads/$_base" 2>/dev/null) || status=$?
  case "$status" in
    0) ;;
    2) _die "remote base branch does not exist: $_remote/$_base" ;;
    *) _die "could not inspect remote base branch: $_remote/$_base" ;;
  esac
  [[ -n "$record" && "$record" != *$'\n'* ]] ||
    _die "remote base lookup returned multiple records: $_remote/$_base"
  IFS=$'\t' read -r oid ref extra <<<"$record"
  [[ "$ref" == "refs/heads/$_base" && -z "$extra" ]] ||
    _die "remote base lookup returned an invalid ref: $_remote/$_base"
  _validate_native_oid "$oid" ||
    _die "remote base lookup returned an invalid object ID: $_remote/$_base"
  _remote_oid=$oid

  if [[ "$_dry_run" == 1 ]]; then
    _enable_dry_object_store
  fi
  git fetch --quiet --no-tags --no-write-fetch-head \
    --no-auto-gc --no-recurse-submodules \
    -- "$_remote_url" "refs/heads/$_base" ||
    _die "could not fetch exact remote base: $_remote/$_base"
  resolved=$(git rev-parse --verify "$_remote_oid^{commit}" 2>/dev/null) ||
    _die "exact remote base object was not fetched: $_remote/$_base"
  [[ "$resolved" == "$_remote_oid" ]] ||
    _die "fetched remote base did not match its pinned object ID"
}

_resolve_local_base() {
  local status=0

  _local_branch_exists "$_base" || status=$?
  case "$status" in
    0)
      _base_local_exists=1
      _local_base_oid=$GT_REF_OID
      ;;
    1)
      _base_local_exists=0
      _local_base_oid=""
      ;;
    *) _die "could not inspect local base branch: $_base" ;;
  esac
}

_preflight_base() {
  local ancestor_status=0

  if [[ "$_base_local_exists" == 0 ]]; then
    _planned_base_oid=$_remote_oid
    return 0
  fi

  git merge-base --is-ancestor "$_remote_oid" "$_local_base_oid" \
    2>/dev/null || ancestor_status=$?
  case "$ancestor_status" in
    0)
      _planned_base_oid=$_local_base_oid
      return 0
      ;;
    1) ;;
    *) _die "could not compare local and remote base branches" ;;
  esac

  ancestor_status=0
  git merge-base --is-ancestor "$_local_base_oid" "$_remote_oid" \
    2>/dev/null || ancestor_status=$?
  case "$ancestor_status" in
    0) _planned_base_oid=$_remote_oid ;;
    1) _die "local base cannot be fast-forwarded to $_remote/$_base" ;;
    *) _die "could not compare local and remote base branches" ;;
  esac
}

# Record the invoking checkout and its branch. The branch comes from HEAD
# rather than from `git worktree list`, which names a main worktree by its Git
# directory when the checkout uses a separate Git directory or `core.worktree`,
# omits a bare repository's external work tree, and needs Git 2.36 or newer.
_locate_worktrees() {
  local head_status=0

  gt_find_current_worktree || _die "could not resolve current worktree"
  _current_worktree=$GT_WORKTREE_PATH
  _current_branch=$(git symbolic-ref -q HEAD) || head_status=$?
  case "$head_status" in
    0) _current_branch=${_current_branch#refs/heads/} ;;
    1) _current_branch="" ;;
    *) _die "could not inspect current branch" ;;
  esac
  _switched_to_base=0
}

_record_base_config() {
  _run git config --local --replace-all "branch.$_base.remote" "$_remote"
  _run git config --local --replace-all \
    "branch.$_base.merge" "refs/heads/$_base"
}

# Leave the local base where it is. Merges are then proven against that older
# base, which can only keep more branches. Without a local base there is
# nothing to prove against, so that case cannot be skipped.
_skip_base_update() {
  _keep_local_base "$*"
  _say "not updating $_base; $*"
}

# A main worktree whose files live outside its Git directory belongs to the
# tooling that manages it, which may validate, back up, or normalize what it
# checks out, so cleanup never merges into it from another checkout.
_leave_external_base() {
  local path=$GT_BASE_SYNC_PATH

  _keep_local_base "its checkout in $path has other tooling"
  if [[ "$GT_BASE_SYNC_REASON" == index ]]; then
    _say "not updating $_base in $path; update that checkout with its own" \
      "tooling (a bare repository with an index counts as checked out;" \
      "remove $path/index if no work tree uses it)"
  else
    _say "not updating $_base in $path;" \
      "update that checkout with its own tooling"
  fi
}

_keep_local_base() {
  [[ "$_base_local_exists" == 1 ]] ||
    _die "could not create local base branch $_base; $*"
  _planned_base_oid=$_local_base_oid
}

# Check out and fast-forward the base in the invoking worktree. This is the
# historical behavior and stays reserved for the main worktree or a worktree
# that already has the base checked out, where it cannot steal the base from
# another worktree or orphan a linked worktree's own branch.
_switch_to_base() {
  if [[ "$_base_local_exists" == 1 ]]; then
    _run git switch --quiet --no-guess "$_base"
  else
    _run git switch --quiet -c "$_base" "$_remote_oid"
    _record_base_config
  fi
  _run git merge --quiet --ff-only "$_remote_oid"
  _switched_to_base=1
}

# Another worktree owns the base, so only that worktree can advance it without
# leaving its index and files behind the moved ref. Its pending edits belong to
# the user, so skip the update rather than merge into them.
_fast_forward_base_worktree() {
  local path="$1" operation status

  if ! operation=$(gt_worktree_operation "$path"); then
    _skip_base_update "could not inspect worktree: $path"
    return 0
  fi
  if [[ -n "$operation" ]]; then
    _skip_base_update "worktree has active $operation: $path"
    return 0
  fi
  if ! status=$(GIT_OPTIONAL_LOCKS=0 gt_git_without_local_env -C "$path" \
    status --porcelain 2>/dev/null); then
    _skip_base_update "could not inspect worktree: $path"
    return 0
  fi
  if [[ -n "$status" ]]; then
    _skip_base_update "worktree has local changes: $path"
    return 0
  fi
  # Report the user-visible command; the real run clears this worktree's
  # inherited Git environment so the merge happens in the base worktree.
  if [[ "$_dry_run" == 1 ]]; then
    _run git -C "$path" merge --quiet --ff-only "$_remote_oid"
    return 0
  fi
  if ! gt_git_without_local_env -C "$path" merge --quiet --ff-only \
    "$_remote_oid"; then
    # A fast-forward refuses before changing anything when, for example, an
    # untracked file hidden by status.showUntrackedFiles is in the way. That
    # is the same kind of local state as the changes skipped above.
    if ! _local_branch_exists "$_base" ||
      [[ "$GT_REF_OID" != "$_local_base_oid" ]]; then
      _die "could not fast-forward $_base in worktree $path"
    fi
    _skip_base_update "could not fast-forward it in worktree $path"
    return 0
  fi
  _say "fast-forwarded $_base in worktree $path"
}

# Nothing has the base checked out or reserved, so a linked worktree can
# advance the ref directly instead of switching away from its own branch.
# Preflight proved the move is a fast-forward; the old-value guard keeps a
# concurrent ref update from being overwritten.
_fast_forward_base_ref() {
  local message="cleanup-repo: fast-forward $_base to $_remote/$_base"

  if [[ "$_base_local_exists" == 0 ]]; then
    _run git update-ref -m "$message" "refs/heads/$_base" "$_remote_oid" "" ||
      _die "could not create local base branch: $_base"
    _record_base_config
    [[ "$_dry_run" == 1 ]] ||
      _say "created $_base at $_remote/$_base; no worktree has it checked out"
    return 0
  fi
  _run git update-ref -m "$message" "refs/heads/$_base" \
    "$_planned_base_oid" "$_local_base_oid" ||
    _die "could not fast-forward local base branch: $_base"
  [[ "$_dry_run" == 1 ]] ||
    _say "fast-forwarded $_base to $_remote/$_base; no worktree has it checked out"
}

_update_base() {
  _pin_remote_base
  _resolve_local_base
  _preflight_base

  # `git switch` refuses a base another worktree reserves, so the main
  # worktree does not need the slower reservation scan.
  gt_plan_base_sync "$_base" || _die "could not inspect current worktree"
  case "$GT_BASE_SYNC_ACTION" in
    current | switch) _switch_to_base ;;
    unknown)
      # Without an inventory (for example Git before 2.36), the main worktree
      # keeps its historical switch, which Git itself refuses when another
      # worktree has the base checked out or reserved.
      if [[ "$GT_BASE_SYNC_REASON" == inventory &&
        "$GT_BASE_SYNC_IN_MAIN" == 1 ]]; then
        _switch_to_base
      elif [[ "$_planned_base_oid" == "$_local_base_oid" ]]; then
        :
      elif [[ "$GT_BASE_SYNC_REASON" == inventory ]]; then
        _skip_base_update "could not inspect worktrees"
      else
        _skip_base_update "could not inspect worktree reservations" \
          "(if a worktree directory was deleted, run git worktree prune," \
          "after git worktree unlock if it is locked)"
      fi
      ;;
    *)
      # Everything else leaves the invoking checkout alone, so there is
      # nothing to do unless the base ref has to move.
      if [[ "$_planned_base_oid" != "$_local_base_oid" ]]; then
        case "$GT_BASE_SYNC_ACTION" in
          worktree) _fast_forward_base_worktree "$GT_BASE_SYNC_PATH" ;;
          ref) _fast_forward_base_ref ;;
          reserved)
            _skip_base_update "reserved by worktree $GT_BASE_SYNC_PATH"
            ;;
          external) _leave_external_base ;;
          *) _die "could not plan the base update" ;;
        esac
      fi
      ;;
  esac

  if [[ "$_dry_run" == 1 ]]; then
    _base_oid=$_planned_base_oid
    return 0
  fi
  _local_branch_exists "$_base" ||
    _die "could not resolve local base branch after update: $_base"
  [[ "$GT_REF_OID" == "$_planned_base_oid" ]] ||
    _die "updated local base does not match the preflighted object ID"
  _base_oid=$GT_REF_OID
}

# Ancestor-only merge check. Squash/rebase merges are detected separately with
# the shared pinned-OID predicate so `_delete_reason` can report a distinct
# reason for each without resolving inventory OIDs again.
_branch_merged_into_base() {
  git merge-base --is-ancestor "$1" "$_base_oid" 2>/dev/null
}

_delete_reason() {
  local branch_oid="$1" upstream_track="$2" ancestor_status=0

  if [[ "$_all" == 1 ]]; then
    printf 'all\n'
    return 0
  fi
  _branch_merged_into_base "$branch_oid" || ancestor_status=$?
  case "$ancestor_status" in
    0)
      printf 'merged\n'
      return 0
      ;;
    1) ;;
    *) return 1 ;;
  esac
  if _gt_branch_content_merged_oids "$branch_oid" "$_base_oid"; then
    printf 'content-merged\n'
    return 0
  fi
  if [[ "$_gone" == 1 && "$upstream_track" == "[gone]" ]]; then
    printf 'upstream gone\n'
    return 0
  fi

  return 1
}

_validate_worktree_prune_path() {
  local entry="$1" folded

  case "$entry" in
    "" | . | .. | */* | *\\* | *$'\n'* | *$'\r'*) return 1 ;;
  esac
  folded=$(printf '%s' "$entry" | LC_ALL=C tr '[:upper:]' '[:lower:]') ||
    return 1
  [[ "$folded" != .git ]]
}

_emit_worktree_prune_paths() {
  # Keep the unpredictable completion marker in positional parameters. A
  # named local can inherit an exported attribute from the caller and leak the
  # marker to the Git producer's environment on Bash 3.2.
  set -- "$1" 0
  git config --local --null --get-all \
    cleanupRepo.worktreePrunePath || set -- "$1" "$?"
  printf '%s:%s\0' "$1" "$2"
}

_load_worktree_prune_paths() {
  local candidate completion_status="" config_fd="" configured entry existing
  local complete=0 invalid=0 invalid_entry="" malformed=0 saw_entry=0
  local trailing=0

  _worktree_prune_paths=()
  for candidate in 9 8 7 6 5 4 3; do
    if ! { true <&"$candidate"; } 2>/dev/null; then
      config_fd=$candidate
      break
    fi
  done
  [[ -n "$config_fd" ]] ||
    _die "could not reserve a descriptor for worktree prune paths"
  set -- "$(LC_ALL=C od -An -N16 -tx1 /dev/urandom 2>/dev/null && printf x)"
  set -- "${1//[[:space:]]/}"
  [[ ${#1} -eq 33 && "$1" == *x && "${1%x}" != *[!0-9a-f]* ]] ||
    _die "could not create a worktree prune path completion record"
  set -- $'\036git-tools-worktree-prune-paths-complete-'"${1%x}"
  if ! eval "exec $config_fd< <(_emit_worktree_prune_paths \"\$1\")"; then
    _die "could not read repository-local worktree prune paths"
  fi

  # Deletion authority must be granted by this repository. In particular,
  # inherited global and command-scope values cannot silently opt every
  # checkout into removing a common name such as .cache.
  while :; do
    entry=""
    if IFS= read -r -d '' entry <&"$config_fd"; then
      if [[ "$entry" == "$1":* ]]; then
        if [[ "$complete" == 1 ]]; then
          trailing=1
        else
          completion_status=${entry#"$1":}
          [[ -n "$completion_status" &&
            "$completion_status" != *[!0-9]* ]] || malformed=1
          complete=1
        fi
        continue
      fi
      if [[ "$complete" == 1 ]]; then
        trailing=1
        continue
      fi
      saw_entry=1
      if ! _validate_worktree_prune_path "$entry"; then
        if [[ "$invalid" == 0 ]]; then
          invalid=1
          invalid_entry=$entry
        fi
        continue
      fi
      configured=0
      for existing in \
        ${_worktree_prune_paths[@]+"${_worktree_prune_paths[@]}"}; do
        if [[ "$existing" == "$entry" ]]; then
          configured=1
          break
        fi
      done
      [[ "$configured" == 1 ]] || _worktree_prune_paths+=("$entry")
      continue
    fi
    [[ -z "$entry" ]] || malformed=1
    break
  done
  eval "exec $config_fd<&-"

  [[ "$complete" == 1 && "$trailing" == 0 && "$malformed" == 0 ]] ||
    _die "could not read repository-local worktree prune paths"
  case "$completion_status" in
    0) ;;
    1)
      [[ "$saw_entry" == 0 ]] ||
        _die "could not read repository-local worktree prune paths"
      return 0
      ;;
    *) _die "could not read repository-local worktree prune paths" ;;
  esac
  [[ "$invalid" == 0 ]] ||
    _die "invalid repository-local worktree prune path: $invalid_entry"
}

_worktree_entry_has_cache_tag() {
  local path="$1" entry="$2" signature=""

  # Restrict automatic recognition to real, top-level directories and real
  # tags. A symlink must never turn cache pruning into traversal outside the
  # worktree.
  case "$entry" in
    "" | . | .. | .git | */*) return 1 ;;
  esac
  [[ -d "$path/$entry" && ! -L "$path/$entry" ]] || return 1
  [[ -f "$path/$entry/CACHEDIR.TAG" &&
    ! -L "$path/$entry/CACHEDIR.TAG" ]] || return 1
  IFS= read -r signature <"$path/$entry/CACHEDIR.TAG" || return 1
  [[ "$signature" == "Signature: 8a477f597d28d172789f06886806bc55" ]]
}

_worktree_entry_is_disposable() {
  local path="$1" entry="$2" configured

  for configured in \
    ${_worktree_prune_paths[@]+"${_worktree_prune_paths[@]}"}; do
    [[ "$configured" != "$entry" ]] || return 0
  done
  _worktree_entry_has_cache_tag "$path" "$entry"
}

_classify_worktree_status() {
  local path="$1" entry record="" top
  local has_dirty=0 has_disposable=0 has_hidden=0 malformed=0

  while :; do
    record=""
    if IFS= read -r -d '' record; then
      # A rename or copy has a second, headerless pathname record. Once any
      # tracked status is present, the worktree is ineligible; drain the rest
      # without interpreting continuation records or risking producer SIGPIPE.
      [[ "$has_dirty" == 0 ]] || continue
      case "$record" in
        '?? '* | '!! '*)
          entry=${record#???}
          if [[ -z "$entry" ]]; then
            malformed=1
            continue
          fi
          top=${entry%%/*}
          if _worktree_entry_is_disposable "$path" "$top"; then
            has_disposable=1
          else
            has_hidden=1
          fi
          ;;
        ??' '*) has_dirty=1 ;;
        *) malformed=1 ;;
      esac
      continue
    fi
    [[ -z "$record" ]] || malformed=1
    break
  done

  [[ "$malformed" == 0 ]] || return 1
  if [[ "$has_dirty" == 1 ]]; then
    printf 'dirty\n'
  elif [[ "$has_hidden" == 1 ]]; then
    printf 'hidden\n'
  elif [[ "$has_disposable" == 1 ]]; then
    printf 'disposable\n'
  else
    printf 'clean\n'
  fi
}

_worktree_status_state() {
  local path="$1" state status=0

  state=$(
    set -o pipefail
    GIT_OPTIONAL_LOCKS=0 gt_git_without_local_env -C "$path" status \
      --porcelain=v1 -z --ignored=matching --untracked-files=all \
      2>/dev/null | _classify_worktree_status "$path"
  ) || status=$?
  [[ "$status" == 0 ]] || return 1
  printf '%s\n' "$state"
}

_worktree_dirty_state() {
  local path="$1" entry index_state state

  if ! state=$(_worktree_status_state "$path"); then
    printf 'unknown\n'
  elif [[ "$state" == dirty ]]; then
    printf 'dirty\n'
  elif ! index_state=$(GIT_OPTIONAL_LOCKS=0 \
    gt_git_without_local_env -C "$path" ls-files -v 2>/dev/null); then
    printf 'unknown\n'
  else
    while IFS= read -r entry; do
      case "$entry" in
        [a-z]' '* | S' '*)
          printf 'hidden\n'
          return 0
          ;;
      esac
    done <<<"$index_state"
    printf '%s\n' "$state"
  fi
}

_prune_worktree_entry() {
  local path="$1" entry="$2"

  [[ -e "$path/$entry" || -L "$path/$entry" ]] || return 0
  if [[ "$_dry_run" == 1 ]]; then
    _say "would prune disposable worktree entry: $path/$entry"
  else
    _say "pruning disposable worktree entry: $path/$entry"
    # One force flag deliberately preserves nested repositories. The literal
    # top-level pathspec and the post-clean state check are additional guards;
    # this never broadens into a worktree-wide clean.
    GIT_OPTIONAL_LOCKS=0 gt_git_without_local_env -C "$path" \
      clean -fdx -- ":(top,literal)$entry" || return 1
  fi
}

_prune_disposable_worktree_entries() {
  local path="$1" configured entry existing seen tag
  local -a entries=()

  for configured in \
    ${_worktree_prune_paths[@]+"${_worktree_prune_paths[@]}"}; do
    entries+=("$configured")
  done

  for tag in \
    "$path"/*/CACHEDIR.TAG \
    "$path"/.[!.]*/CACHEDIR.TAG \
    "$path"/..?*/CACHEDIR.TAG; do
    entry=${tag#"$path"/}
    entry=${entry%/CACHEDIR.TAG}
    _worktree_entry_has_cache_tag "$path" "$entry" || continue
    seen=0
    for existing in ${entries[@]+"${entries[@]}"}; do
      if [[ "$existing" == "$entry" ]]; then
        seen=1
        break
      fi
    done
    [[ "$seen" == 1 ]] || entries+=("$entry")
  done

  for entry in ${entries[@]+"${entries[@]}"}; do
    _prune_worktree_entry "$path" "$entry" || return 1
  done
}

_branch_still_at() {
  local branch="$1" expected_oid="$2" status=0

  gt_find_ref_commit "refs/heads/$branch" || status=$?
  [[ "$status" == 0 && "$GT_REF_OID" == "$expected_oid" ]]
}

_remove_branch_worktree_if_needed() {
  local branch="$1" branch_oid="$2" operation path state

  if ! gt_find_worktree_reserving_branch "$branch"; then
    _say "skipping $branch; could not inspect worktree reservations"
    return 1
  fi
  path=$GT_WORKTREE_PATH

  # A dry run does not really switch to the base, but the real run releases
  # the branch the current worktree leaves, so report that outcome.
  if [[ "$_dry_run" == 1 && "$_switched_to_base" == 1 &&
    -n "$_current_branch" && "$branch" == "$_current_branch" ]]; then
    return 0
  fi
  # Never delete the invoking checkout's branch, and never remove that
  # checkout. The branch-name check runs first because the inventory can miss
  # it entirely: a bare repository used through GIT_DIR and GIT_WORK_TREE has
  # no branch line, and other main worktrees are listed by their Git
  # directory. The path check covers a branch the current worktree reserves
  # without having it checked out, such as during a detached bisect.
  if [[ "$_switched_to_base" != 1 && -n "$_current_branch" &&
    "$branch" == "$_current_branch" ]] ||
    [[ -n "$path" && "$path" -ef "$_current_worktree" ]]; then
    _say "keeping $branch; checked out in the current worktree"
    return 1
  fi
  [[ -n "$path" ]] || return 0
  if [[ "$_remove_worktrees" != 1 ]]; then
    _say "skipping $branch; checked out in worktree $path"
    return 1
  fi
  # Git refuses to remove the main worktree only after cache pruning has
  # already touched it, so it is never eligible, even with --remove-worktrees.
  # Both paths come from the same inventory, so they agree even when the main
  # worktree is listed by its Git directory.
  if ! gt_find_main_worktree; then
    _say "skipping $branch; could not inspect worktrees"
    return 1
  fi
  if [[ "$path" == "$GT_WORKTREE_PATH" || "$path" -ef "$GT_WORKTREE_PATH" ]]; then
    _say "skipping $branch; checked out in the main worktree $path"
    return 1
  fi

  if ! operation=$(gt_worktree_operation "$path"); then
    _say "skipping $branch; could not inspect worktree operation state: $path"
    return 1
  fi
  if [[ -n "$operation" ]]; then
    _say "skipping $branch; worktree has active $operation: $path"
    return 1
  fi

  state=$(_worktree_dirty_state "$path")
  case "$state" in
    clean) ;;
    disposable)
      if ! _branch_still_at "$branch" "$branch_oid"; then
        _say "skipping $branch; branch changed before cache pruning"
        return 1
      fi
      if ! _prune_disposable_worktree_entries "$path"; then
        _say "skipping $branch; disposable entry could not be pruned safely: $path"
        return 1
      fi
      if [[ "$_dry_run" != 1 ]]; then
        state=$(_worktree_dirty_state "$path")
        case "$state" in
          clean) ;;
          dirty)
            _say "skipping $branch; worktree changed while pruning cache: $path"
            return 1
            ;;
          hidden)
            _say "skipping $branch; worktree has hidden local content: $path"
            return 1
            ;;
          disposable)
            _say "skipping $branch; disposable entry could not be pruned safely: $path"
            return 1
            ;;
          *)
            _say "skipping $branch; could not recheck worktree status: $path"
            return 1
            ;;
        esac
      fi
      ;;
    dirty)
      _say "skipping $branch; worktree has uncommitted changes: $path"
      return 1
      ;;
    hidden)
      _say "skipping $branch; worktree has hidden local content: $path"
      return 1
      ;;
    *)
      _say "skipping $branch; could not inspect worktree status: $path"
      return 1
      ;;
  esac

  if ! _branch_still_at "$branch" "$branch_oid"; then
    _say "skipping $branch; branch changed during cleanup"
    return 1
  fi
  if ! _run git worktree remove "$path"; then
    _say "skipping $branch; worktree could not be removed safely: $path"
    return 1
  fi
}

_delete_branch() {
  local branch="$1" branch_oid="$2" reason="$3"

  if ! gt_find_worktree_reserving_branch "$branch"; then
    _say "skipping $branch; could not recheck worktree reservations"
    return 1
  fi
  if [[ -n "$GT_WORKTREE_PATH" && "$_dry_run" != 1 ]]; then
    _say "skipping $branch; branch became reserved by worktree $GT_WORKTREE_PATH"
    return 1
  fi
  if ! _branch_still_at "$branch" "$branch_oid"; then
    _say "skipping $branch; branch changed during cleanup"
    return 1
  fi

  if [[ "$_dry_run" == 1 ]]; then
    _say "would delete $branch at $branch_oid ($reason)"
  else
    _say "deleting $branch ($reason)"
  fi
  if ! _run git update-ref -d "refs/heads/$branch" "$branch_oid"; then
    _say "skipping $branch; exact ref deletion failed"
    return 1
  fi
}

_inventory_branches() {
  local records branch_ref branch branch_oid upstream upstream_track status=0

  _branches=()
  _branch_oids=()
  _upstreams=()
  _upstream_tracks=()
  records=$(git for-each-ref \
    --format='%(refname)%09%(objectname)%09%(upstream)%09%(upstream:track)' \
    refs/heads) ||
    _die "could not enumerate branches"

  while IFS=$'\t' read -r branch_ref branch_oid upstream upstream_track; do
    [[ -n "$branch_ref" ]] || continue
    case "$branch_ref" in
      refs/heads/*) branch=${branch_ref#refs/heads/} ;;
      *) _die "invalid branch inventory record: $branch_ref" ;;
    esac
    _validate_native_oid "$branch_oid" ||
      _die "invalid branch object ID in inventory: $branch_ref"
    status=0
    gt_find_ref_commit "$branch_ref" || status=$?
    [[ "$status" == 0 && "$GT_REF_OID" == "$branch_oid" ]] ||
      _die "branch changed while inventory was collected: $branch_ref"
    [[ "$branch" != "$_base" ]] || continue
    _branches+=("$branch")
    _branch_oids+=("$branch_oid")
    _upstreams+=("$upstream")
    _upstream_tracks+=("$upstream_track")
  done <<<"$records"
}

_cleanup_branches() {
  local branch branch_oid upstream upstream_track reason index
  local candidates=0 skipped=0

  _inventory_branches
  for index in "${!_branches[@]}"; do
    branch=${_branches[$index]}
    branch_oid=${_branch_oids[$index]}
    upstream=${_upstreams[$index]}
    upstream_track=${_upstream_tracks[$index]}

    reason=$(_delete_reason "$branch_oid" "$upstream_track") || {
      if [[ "$upstream_track" == "[gone]" ]]; then
        _say "keeping $branch; merge not proven; upstream is gone;" \
          "--gone selects it for cleanup"
      elif [[ -n "$upstream" ]]; then
        _say "keeping $branch; merge not proven; upstream still exists"
      else
        _say "keeping $branch; merge not proven; no upstream is configured"
      fi
      skipped=$((skipped + 1))
      continue
    }

    if ! _remove_branch_worktree_if_needed "$branch" "$branch_oid"; then
      skipped=$((skipped + 1))
      continue
    fi
    if ! _delete_branch "$branch" "$branch_oid" "$reason"; then
      skipped=$((skipped + 1))
      continue
    fi
    candidates=$((candidates + 1))
  done

  if [[ "$_dry_run" == 1 ]]; then
    _say "done; would delete $candidates local branch(es), skipped $skipped"
  else
    _say "done; deleted $candidates local branch(es), skipped $skipped"
  fi
}

_parse_args() {
  _base=""
  _remote="origin"
  _all=0
  _gone=0
  _dry_run=0
  _remove_worktrees=0

  while (($#)); do
    case "$1" in
      -b | --base)
        local opt="$1"
        shift
        (($#)) || _die "$opt requires a value"
        _base="$1"
        shift
        ;;
      --base=*)
        _base="${1#--base=}"
        [[ -n "$_base" ]] || _die "--base requires a value"
        shift
        ;;
      -r | --remote)
        local opt="$1"
        shift
        (($#)) || _die "$opt requires a value"
        _remote="$1"
        shift
        ;;
      --remote=*)
        _remote="${1#--remote=}"
        [[ -n "$_remote" ]] || _die "--remote requires a value"
        shift
        ;;
      -a | --all)
        _all=1
        shift
        ;;
      --gone)
        _gone=1
        shift
        ;;
      --remove-worktrees)
        _remove_worktrees=1
        shift
        ;;
      -n | --dry-run)
        _dry_run=1
        shift
        ;;
      -h | --help)
        _usage
        exit 0
        ;;
      --)
        shift
        (($# == 0)) || _die "unexpected argument: $1"
        ;;
      *)
        _die "unexpected argument: $1"
        ;;
    esac
  done
}

_parse_args "$@"
_ensure_repo_ready
if [[ "$_remove_worktrees" == 1 ]]; then
  _load_worktree_prune_paths
else
  _worktree_prune_paths=()
fi
_resolve_remote
_locate_worktrees

# A non-writing hash probe detects the native SHA width without requiring the
# newer rev-parse --show-object-format option.
_native_empty_oid=$(git hash-object --stdin </dev/null) ||
  _die "could not determine repository object format"
case "${#_native_empty_oid}" in
  40 | 64) _oid_width=${#_native_empty_oid} ;;
  *) _die "unsupported repository object format" ;;
esac
[[ "$_native_empty_oid" != *[!0-9a-f]* ]] ||
  _die "unsupported repository object format"

_base=$(_default_branch)
git check-ref-format --branch "$_base" >/dev/null 2>&1 ||
  _die "invalid base branch name: $_base"
_update_base
_cleanup_branches
