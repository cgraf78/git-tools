#!/usr/bin/env bash
# Clean up stale local Git branches after PRs have landed.

set -euo pipefail

# BEGIN GENERATED LAUNCHER BOOTSTRAP
# Generated by support/sync-launcher-bootstrap; edit the template, not launcher copies.
_script_path="${BASH_SOURCE[0]}"
while [[ -L "$_script_path" ]]; do
  _script_dir=$(cd -P -- "$(dirname -- "$_script_path")" && pwd)
  _link=$(readlink "$_script_path")
  case "$_link" in
    /*) _script_path="$_link" ;;
    *) _script_path="$_script_dir/$_link" ;;
  esac
done
_root=$(cd -P -- "$(dirname -- "$_script_path")/.." && pwd)
# END GENERATED LAUNCHER BOOTSTRAP
# shellcheck disable=SC1091
. "$_root/lib/git-tools-base.sh"
# shellcheck disable=SC1091
. "$_root/lib/git-tools-cleanup.sh"
# shellcheck disable=SC2034 # read by lib/git-tools-cleanup.sh
GT_CLEANUP_COMMAND="git cleanup-repo"

_usage() {
  cat <<'EOF'
Usage: git cleanup-repo [options]

Fetch the exact remote base, update it by pinned OID, then delete stale local
branches whose exact OIDs are proven merged. Patch IDs identify replay
candidates, but exact raw-delta evidence is also required. Historical squash
proof survives later mainline edits. A branch whose complete tree is a snapshot
on the base's first-parent history (a stacked landing) also counts as merged.
Incomplete branch inventories abort before deletion.

Options:
  -b, --base <branch>       Base branch to keep and update.
  -r, --remote <name>       Remote endpoint to fetch from (default: origin).
      --gone                Select branches whose own-name upstream is gone.
  -a, --all                 Delete all local branches except the base branch.
      --remove-worktrees    Remove eligible linked worktrees for deleted branches.
      --worktree <path>     Remove only this linked worktree (repeatable);
                            implies --remove-worktrees.
      --no-update-base      Prove against the remote base without changing the
                            local base or the current checkout.
      --no-fetch            Prove against the remote-tracking base ref instead
                            of fetching it.
      --porcelain           Print one tab-separated record per decision on
                            stdout instead of messages on stderr.
  -n, --dry-run             Print actions without changing anything.
  -h, --help                Show this help.

Porcelain records are <event> TAB <subject> TAB <code> TAB <detail>. Events:
delete-branch, keep-branch, remove-worktree, and prune-entry, with
would-delete-branch, would-remove-worktree, and would-prune-entry in a dry
run. Backslash, tab, and newline in a field are written as \\, \t, and \n.
Worktree subjects are the paths Git's worktree list records.

Exit status:
  0  Cleanup ran; every decision was reported, including kept branches and
     failed removals.
  2  Usage, repository, or remote error; records already printed may be
     incomplete.
EOF
}

_die() {
  printf 'git cleanup-repo: %s\n' "$*" >&2
  exit 2
}

_say() {
  printf 'git cleanup-repo: %s\n' "$*" >&2
}

# Stop before changing anything. A dry run stops for the same reasons, with the
# same exit status, so it never describes a cleanup the real run would refuse.
_refuse() {
  if [[ "$_dry_run" == 1 ]]; then
    _die "would refuse: $*"
  fi
  _die "$*"
}

_git_path_exists() {
  local path
  path=$(git rev-parse --git-path "$1") || return 2
  [[ -e "$path" ]]
}

_ensure_repo_ready() {
  local bare state state_rc status

  git rev-parse --git-dir >/dev/null 2>&1 ||
    _die "not inside a git repository"
  bare=$(git rev-parse --is-bare-repository) ||
    _die "could not inspect repository type"
  [[ "$bare" == "false" ]] ||
    _die "bare repositories are not supported"
  # Operation state and a clean worktree only protect the base switch and
  # fast-forward; without a base update nothing touches the invoking checkout.
  [[ "$_sync_base" == 1 ]] || return 0

  for state in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
    state_rc=0
    _git_path_exists "$state" || state_rc=$?
    case "$state_rc" in
      0) _refuse "repository already has an active rebase, merge, cherry-pick, or revert" ;;
      1) ;;
      *) _die "could not inspect repository operation state" ;;
    esac
  done

  # Switching branches and fast-forwarding the base should not trample pending
  # edits. Keep cleanup focused on refs, not worktree conflict resolution.
  status=$(GIT_OPTIONAL_LOCKS=0 git status --porcelain) ||
    _die "could not inspect worktree status"
  [[ -z "$status" ]] || _refuse "worktree must be clean before cleanup"
}

_resolve_remote() {
  local configured="" configured_count=0 value

  while IFS= read -r value; do
    configured_count=$((configured_count + 1))
    configured=$value
  done < <(git config --get-all "remote.$_remote.url" 2>/dev/null)
  [[ "$configured_count" == 1 && -n "$configured" ]] ||
    _die "could not resolve one fetch endpoint for remote: $_remote"
  # Reuse the raw URL so Git applies insteadOf exactly once per operation.
  _remote_url=$configured
}

_local_branch_exists() {
  gt_find_ref_commit "refs/heads/$1"
}

_validate_native_oid() {
  local oid="$1"
  [[ "${#oid}" == "$_oid_width" && "$oid" != *[!0-9a-f]* ]]
}

_default_branch() {
  if [[ -n "$_base" ]]; then
    printf '%s\n' "$_base"
    return 0
  fi

  gt_default_branch "$_remote" ||
    _die "could not determine base branch; pass --base <branch>"
}

_cleanup_dry_objects() {
  local status=$?

  trap - EXIT HUP INT TERM
  if [[ -n "${_dry_object_root:-}" ]]; then
    rm -rf -- "$_dry_object_root" || status=2
  fi
  exit "$status"
}

# Dry-run classification still needs the exact remote base object, which may not
# exist locally; `git fetch --dry-run` therefore cannot supply the commit graph
# needed below. A normal no-ref fetch avoids ref and FETCH_HEAD updates but would
# still add objects to the repository. Redirect those writes to private temporary
# storage, expose the original object store and caller-provided alternates only as
# read sources, and remove the temporary store on normal or signaled exit.
_enable_dry_object_store() {
  local source_objects existing_alternates="${GIT_ALTERNATE_OBJECT_DIRECTORIES:-}"

  source_objects=${GIT_OBJECT_DIRECTORY:-}
  if [[ -z "$source_objects" ]]; then
    source_objects=$(git rev-parse --git-path objects) ||
      _die "could not resolve local object storage"
    source_objects=$(cd -P -- "$source_objects" && pwd -P) ||
      _die "could not resolve absolute local object storage"
  fi
  _dry_object_root=""
  trap _cleanup_dry_objects EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  _dry_object_root=$(umask 077 &&
    mktemp -d "${TMPDIR:-/tmp}/git-cleanup-repo-dry.XXXXXX") ||
    _die "could not create dry-run object storage"
  mkdir -m 700 "$_dry_object_root/objects" ||
    _die "could not initialize dry-run object storage"

  export GIT_OBJECT_DIRECTORY="$_dry_object_root/objects"
  if [[ -n "$existing_alternates" ]]; then
    export GIT_ALTERNATE_OBJECT_DIRECTORIES="$source_objects:$existing_alternates"
  else
    export GIT_ALTERNATE_OBJECT_DIRECTORIES="$source_objects"
  fi
}

# Without a fetch, prove against the remote-tracking ref as of the last fetch.
# A stale ref can only be older than the remote, which keeps more branches.
_use_tracking_base() {
  local status=0

  gt_find_ref_commit "refs/remotes/$_remote/$_base" || status=$?
  case "$status" in
    0) _remote_oid=$GT_REF_OID ;;
    1) _die "remote-tracking base does not exist: $_remote/$_base" ;;
    *) _die "could not inspect remote-tracking base: $_remote/$_base" ;;
  esac
}

_pin_remote_base() {
  local record status=0 oid ref extra resolved

  if [[ "$_fetch" == 0 ]]; then
    _use_tracking_base
    return 0
  fi

  record=$(git ls-remote --exit-code -- "$_remote_url" \
    "refs/heads/$_base" 2>/dev/null) || status=$?
  case "$status" in
    0) ;;
    2) _die "remote base branch does not exist: $_remote/$_base" ;;
    *) _die "could not inspect remote base branch: $_remote/$_base" ;;
  esac
  [[ -n "$record" && "$record" != *$'\n'* ]] ||
    _die "remote base lookup returned multiple records: $_remote/$_base"
  IFS=$'\t' read -r oid ref extra <<<"$record"
  [[ "$ref" == "refs/heads/$_base" && -z "$extra" ]] ||
    _die "remote base lookup returned an invalid ref: $_remote/$_base"
  _validate_native_oid "$oid" ||
    _die "remote base lookup returned an invalid object ID: $_remote/$_base"
  _remote_oid=$oid

  if [[ "$_dry_run" == 1 ]]; then
    _enable_dry_object_store
  fi
  git fetch --quiet --no-tags --no-write-fetch-head \
    --no-auto-gc --no-recurse-submodules \
    -- "$_remote_url" "refs/heads/$_base" ||
    _die "could not fetch exact remote base: $_remote/$_base"
  resolved=$(git rev-parse --verify "$_remote_oid^{commit}" 2>/dev/null) ||
    _die "exact remote base object was not fetched: $_remote/$_base"
  [[ "$resolved" == "$_remote_oid" ]] ||
    _die "fetched remote base did not match its pinned object ID"
}

_resolve_local_base() {
  local status=0

  _local_branch_exists "$_base" || status=$?
  case "$status" in
    0)
      _base_local_exists=1
      _local_base_oid=$GT_REF_OID
      ;;
    1)
      _base_local_exists=0
      _local_base_oid=""
      ;;
    *) _die "could not inspect local base branch: $_base" ;;
  esac
}

_preflight_base() {
  local ancestor_status=0

  if [[ "$_base_local_exists" == 0 ]]; then
    _planned_base_oid=$_remote_oid
    return 0
  fi

  git merge-base --is-ancestor "$_remote_oid" "$_local_base_oid" \
    2>/dev/null || ancestor_status=$?
  case "$ancestor_status" in
    0)
      _planned_base_oid=$_local_base_oid
      return 0
      ;;
    1) ;;
    *) _die "could not compare local and remote base branches" ;;
  esac

  ancestor_status=0
  git merge-base --is-ancestor "$_local_base_oid" "$_remote_oid" \
    2>/dev/null || ancestor_status=$?
  case "$ancestor_status" in
    0) _planned_base_oid=$_remote_oid ;;
    1) _refuse "local base cannot be fast-forwarded to $_remote/$_base" ;;
    *) _die "could not compare local and remote base branches" ;;
  esac
}

# Record the invoking checkout and its branch. The branch comes from HEAD
# rather than from `git worktree list`, which names a main worktree by its Git
# directory when the checkout uses a separate Git directory or `core.worktree`,
# omits a bare repository's external work tree, and needs Git 2.36 or newer.
_locate_worktrees() {
  local head_status=0

  gt_find_current_worktree || _die "could not resolve current worktree"
  # shellcheck disable=SC2034 # read by lib/git-tools-cleanup.sh
  GT_CLEANUP_CURRENT_WORKTREE=$GT_WORKTREE_PATH
  GT_CLEANUP_CURRENT_BRANCH=$(git symbolic-ref -q HEAD) || head_status=$?
  case "$head_status" in
    0) GT_CLEANUP_CURRENT_BRANCH=${GT_CLEANUP_CURRENT_BRANCH#refs/heads/} ;;
    1) GT_CLEANUP_CURRENT_BRANCH="" ;;
    *) _die "could not inspect current branch" ;;
  esac
  GT_CLEANUP_SWITCHED_TO_BASE=0
}

_record_base_config() {
  gt_cleanup_run git config --local --replace-all "branch.$_base.remote" "$_remote"
  gt_cleanup_run git config --local --replace-all \
    "branch.$_base.merge" "refs/heads/$_base"
}

# Leave the local base where it is. Merges are then proven against that older
# base, which can only keep more branches. Without a local base there is
# nothing to prove against, so that case cannot be skipped.
_skip_base_update() {
  _keep_local_base "$*"
  _base_skip_reason=$*
  _say "not updating $_base; $*"
}

# A main worktree whose files live outside its Git directory belongs to the
# tooling that manages it, which may validate, back up, or normalize what it
# checks out, so cleanup never merges into it, even when cleanup runs there
# (a Git launcher can route any directory into a dotfiles checkout of $HOME).
# Branch deletion still proceeds, proven against the unchanged local base.
_leave_external_base() {
  _keep_local_base "its checkout has other tooling"
  _base_skip_reason="its checkout is left to its own tooling"
  _say "$(gt_base_sync_external_message "$_base")"
}

_keep_local_base() {
  [[ "$_base_local_exists" == 1 ]] ||
    _refuse "could not create local base branch $_base; $*"
  _planned_base_oid=$_local_base_oid
}

# Check out and fast-forward the base in the invoking worktree. This is the
# historical behavior and stays reserved for the main worktree or a worktree
# that already has the base checked out, where it cannot steal the base from
# another worktree or orphan a linked worktree's own branch.
_switch_to_base() {
  if [[ "$_base_local_exists" == 1 ]]; then
    gt_cleanup_run git switch --quiet --no-guess "$_base"
  else
    gt_cleanup_run git switch --quiet -c "$_base" "$_remote_oid"
    _record_base_config
  fi
  gt_cleanup_run git merge --quiet --ff-only "$_remote_oid"
  # shellcheck disable=SC2034 # read by lib/git-tools-cleanup.sh
  GT_CLEANUP_SWITCHED_TO_BASE=1
}

# Another worktree owns the base, so only that worktree can advance it without
# leaving its index and files behind the moved ref. Its pending edits belong to
# the user, so skip the update rather than merge into them.
_fast_forward_base_worktree() {
  local path="$1" operation status

  if ! operation=$(gt_worktree_operation "$path"); then
    gt_record_uninspectable_worktree "$path" || _gt_cleanup_note_uninspectable
    _skip_base_update "could not inspect worktree: $path"
    return 0
  fi
  if [[ -n "$operation" ]]; then
    _skip_base_update "worktree has active $operation: $path"
    return 0
  fi
  if ! status=$(GIT_OPTIONAL_LOCKS=0 gt_git_without_local_env -C "$path" \
    status --porcelain 2>/dev/null); then
    _skip_base_update "could not inspect worktree: $path"
    return 0
  fi
  if [[ -n "$status" ]]; then
    _skip_base_update "worktree has local changes: $path"
    return 0
  fi
  # Report the user-visible command; the real run clears this worktree's
  # inherited Git environment so the merge happens in the base worktree.
  if [[ "$_dry_run" == 1 ]]; then
    gt_cleanup_run git -C "$path" merge --quiet --ff-only "$_remote_oid"
    return 0
  fi
  if ! gt_git_without_local_env -C "$path" merge --quiet --ff-only \
    "$_remote_oid"; then
    # A fast-forward refuses before changing anything when, for example, an
    # untracked file hidden by status.showUntrackedFiles is in the way. That
    # is the same kind of local state as the changes skipped above.
    if ! _local_branch_exists "$_base" ||
      [[ "$GT_REF_OID" != "$_local_base_oid" ]]; then
      _die "could not fast-forward $_base in worktree $path"
    fi
    _skip_base_update "could not fast-forward it in worktree $path"
    return 0
  fi
  _say "fast-forwarded $_base in worktree $path"
}

# Nothing has the base checked out or reserved, so a linked worktree can
# advance the ref directly instead of switching away from its own branch.
# Preflight proved the move is a fast-forward; the old-value guard keeps a
# concurrent ref update from being overwritten.
_fast_forward_base_ref() {
  local message="cleanup-repo: fast-forward $_base to $_remote/$_base"

  if [[ "$_base_local_exists" == 0 ]]; then
    gt_cleanup_run git update-ref -m "$message" "refs/heads/$_base" "$_remote_oid" "" ||
      _die "could not create local base branch: $_base"
    _record_base_config
    [[ "$_dry_run" == 1 ]] ||
      _say "created $_base at $_remote/$_base; no worktree has it checked out"
    return 0
  fi
  gt_cleanup_run git update-ref -m "$message" "refs/heads/$_base" \
    "$_planned_base_oid" "$_local_base_oid" ||
    _die "could not fast-forward local base branch: $_base"
  [[ "$_dry_run" == 1 ]] ||
    _say "fast-forwarded $_base to $_remote/$_base; no worktree has it checked out"
}

_update_base() {
  _pin_remote_base
  _resolve_local_base
  _preflight_base

  # `git switch` refuses a base another worktree reserves, so the main
  # worktree does not need the slower reservation scan.
  gt_plan_base_sync "$_base" || _die "could not inspect current worktree"
  case "$GT_BASE_SYNC_ACTION" in
    current | switch) _switch_to_base ;;
    unknown)
      # Without an inventory (for example Git before 2.36), the main worktree
      # keeps its historical switch, which Git itself refuses when another
      # worktree has the base checked out or reserved.
      if [[ "$GT_BASE_SYNC_REASON" == inventory &&
        "$GT_BASE_SYNC_MAY_SWITCH" == 1 ]]; then
        _switch_to_base
      elif [[ "$_planned_base_oid" == "$_local_base_oid" ]]; then
        :
      elif [[ "$GT_BASE_SYNC_REASON" == inventory ]]; then
        _skip_base_update "could not inspect worktrees"
      else
        _gt_cleanup_note_uninspectable
        _skip_base_update "could not inspect worktree reservations"
      fi
      ;;
    *)
      # Everything else leaves the invoking checkout alone, so there is
      # nothing to do unless the base ref has to move.
      if [[ "$_planned_base_oid" != "$_local_base_oid" ]]; then
        case "$GT_BASE_SYNC_ACTION" in
          worktree) _fast_forward_base_worktree "$GT_BASE_SYNC_PATH" ;;
          ref) _fast_forward_base_ref ;;
          reserved)
            _skip_base_update "reserved by worktree $GT_BASE_SYNC_PATH"
            ;;
          external) _leave_external_base ;;
          *) _die "could not plan the base update" ;;
        esac
      fi
      ;;
  esac

  if [[ "$_dry_run" == 1 ]]; then
    _base_oid=$_planned_base_oid
    return 0
  fi
  _local_branch_exists "$_base" ||
    _die "could not resolve local base branch after update: $_base"
  [[ "$GT_REF_OID" == "$_planned_base_oid" ]] ||
    _die "updated local base does not match the preflighted object ID"
  _base_oid=$GT_REF_OID
}

# Name the strongest proof that a pinned branch OID is already in the base, or
# the explicit opt-in that selected it. The proof code is the deletion reason:
# merged, content-merged, tree-landed, upstream-gone, or all.
_delete_reason() {
  local branch="$1" branch_oid="$2" upstream_track="$3" remote_name="$4"
  local remote_ref="$5"

  if [[ "$_all" == 1 ]]; then
    printf 'all\n'
    return 0
  fi
  if gt_merge_proof "$branch_oid" "$_base_oid"; then
    printf '%s\n' "$GT_CLEANUP_PROOF"
    return 0
  fi
  if [[ "$_gone" == 1 ]] &&
    gt_own_upstream_gone "$branch" "$upstream_track" "$remote_name" "$remote_ref"; then
    printf 'upstream-gone\n'
    return 0
  fi

  return 1
}

_inventory_branches() {
  local records branch_ref branch branch_oid upstream upstream_track
  local remote_name remote_ref status=0

  _branches=()
  _branch_oids=()
  _upstreams=()
  _upstream_tracks=()
  _upstream_remotes=()
  _upstream_refs=()
  # Optional fields carry a tag: TAB is IFS whitespace, so `read` would
  # collapse an empty field and shift every later one into the wrong slot.
  records=$(git for-each-ref \
    --format='%(refname)%09%(objectname)%09u=%(upstream:short)%09t=%(upstream:track)%09r=%(upstream:remotename)%09f=%(upstream:remoteref)' \
    refs/heads) ||
    _die "could not enumerate branches"

  while IFS=$'\t' read -r branch_ref branch_oid upstream upstream_track \
    remote_name remote_ref; do
    [[ -n "$branch_ref" ]] || continue
    upstream=${upstream#u=}
    upstream_track=${upstream_track#t=}
    remote_name=${remote_name#r=}
    remote_ref=${remote_ref#f=}
    case "$branch_ref" in
      refs/heads/*) branch=${branch_ref#refs/heads/} ;;
      *) _die "invalid branch inventory record: $branch_ref" ;;
    esac
    _validate_native_oid "$branch_oid" ||
      _die "invalid branch object ID in inventory: $branch_ref"
    status=0
    gt_find_ref_commit "$branch_ref" || status=$?
    [[ "$status" == 0 && "$GT_REF_OID" == "$branch_oid" ]] ||
      _die "branch changed while inventory was collected: $branch_ref"
    [[ "$branch" != "$_base" ]] || continue
    _branches+=("$branch")
    _branch_oids+=("$branch_oid")
    _upstreams+=("$upstream")
    _upstream_tracks+=("$upstream_track")
    _upstream_remotes+=("$remote_name")
    _upstream_refs+=("$remote_ref")
  done <<<"$records"
}

_cleanup_branches() {
  local branch branch_oid upstream upstream_track remote_name remote_ref
  local reason index summary
  local candidates=0 skipped=0 unproven="merge not proven"

  # Merges are proven against the local base. When its update was skipped,
  # that base is older than the remote one, so a branch merged only remotely
  # cannot be proven yet; say which base the proof used.
  [[ -z "$_base_skip_reason" ]] ||
    unproven="merge not proven against the local $_base, which was not updated"
  _inventory_branches
  for index in "${!_branches[@]}"; do
    branch=${_branches[$index]}
    branch_oid=${_branch_oids[$index]}
    upstream=${_upstreams[$index]}
    upstream_track=${_upstream_tracks[$index]}
    remote_name=${_upstream_remotes[$index]}
    remote_ref=${_upstream_refs[$index]}

    reason=$(_delete_reason "$branch" "$branch_oid" "$upstream_track" \
      "$remote_name" "$remote_ref") || {
      # Upstream state comes from remote-tracking refs as of the last fetch;
      # cleanup fetches only the base, so say so rather than claim it is live.
      if gt_own_upstream_gone "$branch" "$upstream_track" "$remote_name" \
        "$remote_ref"; then
        gt_cleanup_report keep-branch "$branch" merge-unproven upstream-gone \
          "keeping $branch; $unproven; upstream is gone; --gone selects it for cleanup"
      elif [[ "$upstream_track" == "[gone]" ]]; then
        gt_cleanup_report keep-branch "$branch" merge-unproven \
          other-upstream-gone \
          "keeping $branch; $unproven; upstream $upstream is gone, but it is not this branch's own remote branch"
      elif [[ -n "$upstream" ]]; then
        gt_cleanup_report keep-branch "$branch" merge-unproven upstream \
          "keeping $branch; $unproven; upstream $upstream still exists as of the last fetch"
      else
        gt_cleanup_report keep-branch "$branch" merge-unproven no-upstream \
          "keeping $branch; $unproven; no upstream is configured"
      fi
      skipped=$((skipped + 1))
      continue
    }

    if ! gt_cleanup_retire_branch "$branch" "$branch_oid" "$reason"; then
      skipped=$((skipped + 1))
      continue
    fi
    candidates=$((candidates + 1))
  done

  [[ -z "$GT_CLEANUP_UNINSPECTABLE_HINT" ]] ||
    _say "$GT_CLEANUP_UNINSPECTABLE_HINT"
  if [[ "$_dry_run" == 1 ]]; then
    summary="done; would delete $candidates local branch(es), skipped $skipped"
  else
    summary="done; deleted $candidates local branch(es), skipped $skipped"
  fi
  # Exit 0 still means cleanup did what it safely could; the summary says when
  # the local base was left behind the remote, so it is not taken as current.
  [[ -z "$_base_skip_reason" ]] ||
    summary="$summary; $_base not updated ($_base_skip_reason)"
  # Porcelain callers tally the records themselves.
  [[ "$_porcelain" == 1 ]] || _say "$summary"
}

_parse_args() {
  _base=""
  _remote="origin"
  _all=0
  _gone=0
  _dry_run=0
  _remove_worktrees=0
  _sync_base=1
  _fetch=1
  _porcelain=0
  _worktree_scope=()

  while (($#)); do
    case "$1" in
      -b | --base)
        local opt="$1"
        shift
        (($#)) || _die "$opt requires a value"
        _base="$1"
        shift
        ;;
      --base=*)
        _base="${1#--base=}"
        [[ -n "$_base" ]] || _die "--base requires a value"
        shift
        ;;
      -r | --remote)
        local opt="$1"
        shift
        (($#)) || _die "$opt requires a value"
        _remote="$1"
        shift
        ;;
      --remote=*)
        _remote="${1#--remote=}"
        [[ -n "$_remote" ]] || _die "--remote requires a value"
        shift
        ;;
      -a | --all)
        _all=1
        shift
        ;;
      --gone)
        _gone=1
        shift
        ;;
      --remove-worktrees)
        _remove_worktrees=1
        shift
        ;;
      --worktree)
        shift
        (($#)) || _die "--worktree requires a value"
        [[ -n "$1" ]] || _die "--worktree requires a value"
        _worktree_scope+=("$1")
        _remove_worktrees=1
        shift
        ;;
      --worktree=*)
        [[ -n "${1#--worktree=}" ]] || _die "--worktree requires a value"
        _worktree_scope+=("${1#--worktree=}")
        _remove_worktrees=1
        shift
        ;;
      --no-update-base)
        _sync_base=0
        shift
        ;;
      --no-fetch)
        _fetch=0
        shift
        ;;
      --porcelain)
        _porcelain=1
        shift
        ;;
      -n | --dry-run)
        _dry_run=1
        shift
        ;;
      -h | --help)
        _usage
        exit 0
        ;;
      --)
        shift
        (($# == 0)) || _die "unexpected argument: $1"
        ;;
      *)
        _die "unexpected argument: $1"
        ;;
    esac
  done
}

# Map each --worktree argument to the path Git's worktree list records for it,
# once, so a relative, trailing-slash, or symlinked spelling selects exactly
# that worktree and records name it the same way Git does. An argument that
# names no linked worktree of this repository selects nothing.
_resolve_worktree_scope() {
  local arg field path matched resolved
  local -a scope=()

  _unmatched_scope=()
  ((${#_worktree_scope[@]} > 0)) || return 0
  gt_find_main_worktree || _die "could not inspect worktrees"
  for arg in "${_worktree_scope[@]}"; do
    matched=""
    for field in ${_GT_WORKTREE_FIELDS[@]+"${_GT_WORKTREE_FIELDS[@]}"}; do
      case "$field" in
        "worktree "*) path=${field#worktree } ;;
        *) continue ;;
      esac
      if [[ "$path" == "$arg" || "$path" -ef "$arg" ]]; then
        matched=$path
        break
      fi
    done
    if [[ -z "$matched" ]]; then
      _unmatched_scope+=("$arg")
      continue
    fi
    for resolved in ${scope[@]+"${scope[@]}"}; do
      [[ "$resolved" != "$matched" ]] || continue 2
    done
    scope+=("$matched")
  done
  # shellcheck disable=SC2034 # read by lib/git-tools-cleanup.sh
  GT_CLEANUP_WORKTREE_SCOPE=(${scope[@]+"${scope[@]}"})
  # Every argument named nothing: select nothing rather than everything.
  ((${#scope[@]} > 0)) || GT_CLEANUP_REMOVE_WORKTREES=0
}

# Escape a porcelain field so a path can never forge a field or record break.
_porcelain_field() {
  local value="$1"

  value=${value//\\/\\\\}
  value=${value//$'\t'/\\t}
  value=${value//$'\n'/\\n}
  printf '%s' "$value"
}

_base_skip_reason=""
_parse_args "$@"
# shellcheck disable=SC2034 # read by lib/git-tools-cleanup.sh
GT_CLEANUP_DRY_RUN=$_dry_run
# shellcheck disable=SC2034 # read by lib/git-tools-cleanup.sh
GT_CLEANUP_REMOVE_WORKTREES=$_remove_worktrees
if [[ "$_porcelain" == 1 ]]; then
  # shellcheck disable=SC2034 # read by lib/git-tools-cleanup.sh
  GT_CLEANUP_ECHO_DRY_RUN=0
  # Records go to stdout, one per decision; diagnostics stay on stderr.
  gt_cleanup_report() {
    printf '%s\t%s\t%s\t%s\n' "$1" "$(_porcelain_field "$2")" "$3" \
      "$(_porcelain_field "$4")"
  }
fi
_ensure_repo_ready
if [[ "$_remove_worktrees" == 1 ]]; then
  gt_cleanup_load_prune_paths || _die "$GT_CLEANUP_ERROR"
fi
_resolve_remote
_locate_worktrees
_resolve_worktree_scope

# A non-writing hash probe detects the native SHA width without requiring the
# newer rev-parse --show-object-format option.
_native_empty_oid=$(git hash-object --stdin </dev/null) ||
  _die "could not determine repository object format"
case "${#_native_empty_oid}" in
  40 | 64) _oid_width=${#_native_empty_oid} ;;
  *) _die "unsupported repository object format" ;;
esac
[[ "$_native_empty_oid" != *[!0-9a-f]* ]] ||
  _die "unsupported repository object format"

_base=$(_default_branch)
git check-ref-format --branch "$_base" >/dev/null 2>&1 ||
  _die "invalid base branch name: $_base"
if [[ "$_sync_base" == 1 ]]; then
  _update_base
else
  _pin_remote_base
  _base_oid=$_remote_oid
fi
_cleanup_branches
