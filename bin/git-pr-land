#!/usr/bin/env bash
# Merge one ready GitHub pull request and clean up its local branch.

set -euo pipefail

# shellcheck disable=SC2034 # consumed by lib/git-tools-pr.sh after dynamic source
gt_command="git pr-land"

# BEGIN GENERATED LAUNCHER BOOTSTRAP
# Generated by support/sync-launcher-bootstrap; edit the template, not launcher copies.
_script_path="${BASH_SOURCE[0]}"
while [[ -L "$_script_path" ]]; do
  _script_dir=$(cd -P -- "$(dirname -- "$_script_path")" && pwd)
  _link=$(readlink "$_script_path")
  case "$_link" in
    /*) _script_path="$_link" ;;
    *) _script_path="$_script_dir/$_link" ;;
  esac
done
_root=$(cd -P -- "$(dirname -- "$_script_path")/.." && pwd)
# END GENERATED LAUNCHER BOOTSTRAP
# shellcheck disable=SC1091
. "$_root/lib/git-tools-pr.sh"
# shellcheck disable=SC1091
. "$_root/lib/git-tools-base.sh"
# shellcheck disable=SC1091
. "$_root/lib/git-tools-cleanup.sh"
# shellcheck disable=SC2034 # read by lib/git-tools-cleanup.sh
GT_CLEANUP_COMMAND="git pr-land"

_usage() {
  cat <<'EOF'
Usage: git pr-land [options] <number|url|branch>

Verify that one GitHub pull request is ready, merge it, and sync the base branch.
Then delete the local PR head when it is exactly the landed head, or an earlier
snapshot of it that tracks the PR head, removing its clean linked worktree as
git cleanup-repo would.
Remote heads are reported for manual cleanup and are never deleted.
This command does not discover or land stacks.

Options:
  -m, --method <method>   Merge method: squash, merge, or rebase (default: squash).
      --keep-branch       Keep the local PR head and its worktree.
  -n, --dry-run           Print actions without changing anything.
  -h, --help              Show this help.

Exit status:
  0  PR was landed.
  1  PR is not ready, merge failed, or post-merge cleanup is incomplete.
  2  Usage or local environment error.
EOF
}

_target=""
_method="squash"
_dry_run=0
_expected_topology=""
_expected_base=""
_keep_branch=0
_switched_to_base=0

_run() {
  if [[ "$_dry_run" == 1 ]]; then
    printf 'git pr-land: would run:' >&2
    case "${1:-}" in
      gt_gh_pr)
        shift
        printf ' gh pr' >&2
        ;;
      # Show the Git command the user would type; clearing the inherited
      # repository environment is an implementation detail.
      gt_git_without_local_env)
        shift
        printf ' git' >&2
        ;;
    esac
    printf ' %q' "$@" >&2
    printf '\n' >&2
    return 0
  fi
  "$@"
}

while (($#)); do
  case "$1" in
    -m | --method)
      _opt="$1"
      shift
      (($#)) || gt_usage_error "$_opt requires a value"
      _method="$1"
      shift
      ;;
    --method=*)
      _method="${1#--method=}"
      [[ -n "$_method" ]] || gt_usage_error "--method requires a value"
      shift
      ;;
    --keep-branch)
      _keep_branch=1
      shift
      ;;
    # Private handoff used by bundled stack orchestrators, not a stable CLI
    # serialization format.
    --expect-topology)
      shift
      (($#)) || gt_usage_error "--expect-topology requires a value"
      _expected_topology="$1"
      shift
      ;;
    --expect-topology=*)
      _expected_topology="${1#--expect-topology=}"
      [[ -n "$_expected_topology" ]] ||
        gt_usage_error "--expect-topology requires a value"
      shift
      ;;
    # Private handoff: the base `git pr-land-stack` retargets this PR to before
    # landing it. A stack dry run cannot retarget, so it plans the base sync
    # and its preflight against this base instead of the PR's current one.
    --expect-base)
      shift
      (($#)) || gt_usage_error "--expect-base requires a value"
      _expected_base="$1"
      shift
      ;;
    --expect-base=*)
      _expected_base="${1#--expect-base=}"
      [[ -n "$_expected_base" ]] ||
        gt_usage_error "--expect-base requires a value"
      shift
      ;;
    -n | --dry-run)
      _dry_run=1
      shift
      ;;
    -h | --help)
      _usage
      exit 0
      ;;
    --)
      shift
      (($# == 1)) || gt_usage_error "expected exactly one target"
      _target="$1"
      break
      ;;
    -*)
      gt_usage_error "unexpected option: $1"
      ;;
    *)
      [[ -z "$_target" ]] || gt_usage_error "expected exactly one target"
      _target="$1"
      shift
      ;;
  esac
done

[[ -n "$_target" ]] || gt_usage_error "expected exactly one target"

case "$_method" in
  squash | merge | rebase) ;;
  *) gt_usage_error "merge method must be squash, merge, or rebase" ;;
esac

_local_branch_exists() {
  gt_find_ref_commit "refs/heads/$1"
}

# Optional locks off: a plain status refreshes and rewrites the index, which a
# dry run must not do, and which could make a concurrent commit there fail on
# index.lock.
_worktree_status() {
  GIT_OPTIONAL_LOCKS=0 gt_git_without_local_env -C "$1" status --porcelain
}

# Stop before the merge. A dry run makes the same checks as the real run, so it
# reports the refusal the real run would make instead of a successful landing.
_refuse() {
  if [[ "$_dry_run" == 1 ]]; then
    gt_die "would refuse: $*"
  fi
  gt_die "$*"
}

_load_exact_base_oid() {
  local remote="$1" url="$2" base="$3" status=0

  if [[ "$_dry_run" == 1 ]]; then
    gt_say "would fetch refs/heads/$base from $remote"
    gt_find_remote_ref_exact_url "$url" "refs/heads/$base" || status=$?
    case "$status" in
      0) _exact_base_oid=$GT_REMOTE_REF_OID ;;
      1) return 1 ;;
      *) return 2 ;;
    esac
  else
    gt_snapshot_and_fetch_ref_exact_url "$url" "refs/heads/$base" || return $?
    _exact_base_oid=$GT_EXACT_REF_OID
  fi
}

_preflight_local_plan() {
  local remote="$1"
  local url="$2"
  local base="$3"
  local current_worktree base_worktree operation status ref_status=0

  _load_exact_base_oid "$remote" "$url" "$base" || ref_status=$?
  case "$ref_status" in
    0) ;;
    1) _refuse "base branch does not exist on $remote: $base" ;;
    *) gt_die "could not fetch exact base branch from $remote: $base" ;;
  esac
  _preflight_base_oid=$_exact_base_oid

  gt_find_current_worktree || gt_die "could not resolve current worktree"
  current_worktree=$GT_WORKTREE_PATH
  operation=$(gt_worktree_operation "") ||
    gt_die "could not inspect current worktree operation"
  [[ -z "$operation" ]] ||
    _refuse "current worktree has $operation in progress: $current_worktree"
  # Refuse before the irreversible merge when the base cannot be synchronized
  # afterwards. Reservations are scanned even from the main worktree so a
  # reserved base refuses here rather than in `git switch` after the merge. A
  # base left to another external checkout's own tooling is never touched, so
  # neither it nor that checkout is inspected. (The current checkout is never
  # external here; gt_refuse_external_checkout stopped that earlier.)
  gt_plan_base_sync "$base" 1 || gt_die "could not inspect current worktree"
  if [[ "$GT_BASE_SYNC_ACTION" != external ]]; then
    ref_status=0
    _local_branch_exists "$base" || ref_status=$?
    # A dry run only queried the remote OID, so ancestry can be checked only
    # when that commit already exists locally.
    if [[ "$ref_status" == 0 ]] && { [[ "$_dry_run" != 1 ]] ||
      git cat-file -e "$_preflight_base_oid^{commit}" 2>/dev/null; }; then
      git merge-base --is-ancestor "$GT_REF_OID" "$_preflight_base_oid" 2>/dev/null ||
        _refuse "local $base cannot fast-forward to $remote/$base"
    elif [[ "$ref_status" != 0 && "$ref_status" != 1 ]]; then
      gt_die "could not inspect local base branch: $base"
    fi
  fi
  case "$GT_BASE_SYNC_ACTION" in
    worktree | reserved)
      base_worktree=$GT_BASE_SYNC_PATH
      if ! operation=$(gt_worktree_operation "$base_worktree"); then
        gt_record_uninspectable_worktree "$base_worktree" ||
          _refuse "could not inspect base worktree operation: $base_worktree" \
            "($(gt_uninspectable_worktree_hint))"
      fi
      [[ -z "$operation" ]] ||
        _refuse "base worktree has $operation in progress: $base_worktree"
      status=$(_worktree_status "$base_worktree") ||
        gt_die "could not inspect base worktree: $base_worktree"
      [[ -z "$status" ]] || _refuse "base worktree must be clean: $base_worktree"
      ;;
    unknown)
      _refuse "could not inspect worktrees${GT_WORKTREE_FAILED_PATH:+ ($(gt_uninspectable_worktree_hint))}"
      ;;
  esac
}

# Advance the local base under the same rules as `git cleanup-repo`: merge only
# in the checkout that has the base checked out, let only the main worktree
# take the base over, move only the ref when nothing has it checked out, and
# leave an external main checkout to its own tooling. Every update to another
# checkout, and every skip, is reported.
_sync_base() {
  local remote="$1"
  local url="$2"
  local base="$3"
  local base_oid path

  # A dry run merges nothing, so the OID preflight saw is still the one to plan
  # with; a real run fetches the base again to pick up the merge.
  if [[ "$_dry_run" == 1 ]]; then
    base_oid=$_preflight_base_oid
  else
    _load_exact_base_oid "$remote" "$url" "$base" || return 1
    base_oid=$_exact_base_oid
  fi
  gt_plan_base_sync "$base" 1 || return 1
  path=$GT_BASE_SYNC_PATH

  case "$GT_BASE_SYNC_ACTION" in
    current | switch) _switch_and_merge_base "$remote" "$base" "$base_oid" ;;
    worktree)
      _base_update_clear "$path" "$base" "$base_oid" || return 1
      _run gt_git_without_local_env -C "$path" merge --quiet --ff-only \
        --no-overwrite-ignore "$base_oid" || return 1
      [[ "$_dry_run" == 1 ]] || gt_say "fast-forwarded $base in worktree $path"
      ;;
    ref) _fast_forward_base_ref "$remote" "$base" "$base_oid" ;;
    external) gt_say "$(gt_base_sync_external_message "$base")" ;;
    reserved) gt_say "not updating $base; reserved by worktree $path" ;;
    *)
      gt_say "not updating $base; could not inspect worktrees"
      return 1
      ;;
  esac
}

# Replace any stale upstream values so a multi-valued key cannot fail the run
# after the base has been created.
_record_base_config() {
  local remote="$1" base="$2"

  git config --local --replace-all "branch.$base.remote" "$remote" || return 1
  git config --local --replace-all "branch.$base.merge" "refs/heads/$base"
}

# Succeed when updating the worktree at $1 (empty: the current one) to the
# base commit $3 would not overwrite an untracked or ignored file. Git itself
# refuses with --no-overwrite-ignore, but not in a dry run, and not in a sparse
# checkout, where it overwrites with only a warning. Checking first in every
# run also keeps a refused fast-forward from leaving the checkout switched to
# a stale base. The path moves from its HEAD to the local base (when switching
# to one) and then to the base commit.
_base_update_clear() {
  local path="$1" base="$2" base_oid="$3" head_oid local_oid=""
  local -a wt_git=(git)

  [[ -z "$path" ]] || wt_git=(gt_git_without_local_env -C "$path")
  head_oid=$("${wt_git[@]}" rev-parse --verify -q HEAD 2>/dev/null) || head_oid=""
  local_oid=$(git rev-parse --verify -q "refs/heads/$base^{commit}" 2>/dev/null) ||
    local_oid=""
  if [[ -n "$local_oid" && "$local_oid" != "$head_oid" ]] &&
    ! gt_checkout_would_succeed "$path" "$head_oid" "$local_oid"; then
    gt_say "not updating $base; an untracked or ignored file is in the way"
    return 1
  fi
  if ! gt_checkout_would_succeed "$path" "${local_oid:-$head_oid}" "$base_oid"; then
    gt_say "not updating $base; an untracked or ignored file is in the way"
    return 1
  fi
}

# Check out the base in the invoking checkout, which is either already on it
# or the main worktree. Neither the switch nor the fast-forward may overwrite
# an ignored file (a local .env) with a newly tracked one.
_switch_and_merge_base() {
  local remote="$1" base="$2" base_oid="$3" ref_status=0

  _base_update_clear "" "$base" "$base_oid" || return 1
  _local_branch_exists "$base" || ref_status=$?
  if [[ "$ref_status" == 0 ]]; then
    _run git switch --quiet --no-overwrite-ignore "$base" || return 1
  elif [[ "$ref_status" != 1 ]]; then
    return 1
  else
    _run git switch --quiet --no-overwrite-ignore -c "$base" "$base_oid" || return 1
    if [[ "$_dry_run" != 1 ]]; then
      _record_base_config "$remote" "$base" || return 1
    fi
  fi

  _run git merge --quiet --ff-only --no-overwrite-ignore "$base_oid" || return 1
  # The invoking checkout no longer holds the PR head (or, in a dry run,
  # would not), which releases that branch for deletion.
  _switched_to_base=1
}

# Nothing has the base checked out or reserved, so a linked worktree advances
# only the ref instead of switching away from its own branch. Like
# `merge --ff-only`, an older target is a no-op and a divergent one fails; the
# old-value guard keeps a concurrent ref update from being overwritten.
_fast_forward_base_ref() {
  local remote="$1" base="$2" base_oid="$3" local_oid ref_status=0
  local message="pr-land: fast-forward $base to $remote/$base"

  _local_branch_exists "$base" || ref_status=$?
  case "$ref_status" in
    0) local_oid=$GT_REF_OID ;;
    1)
      _run git update-ref -m "$message" "refs/heads/$base" "$base_oid" "" ||
        return 1
      if [[ "$_dry_run" != 1 ]]; then
        _record_base_config "$remote" "$base" || return 1
        gt_say "created $base at $remote/$base; no worktree has it checked out"
      fi
      return 0
      ;;
    *) return 1 ;;
  esac
  [[ "$local_oid" != "$base_oid" ]] || return 0
  # A dry run only queried the remote OID, so its ancestry can be checked only
  # when that commit already exists locally. Preflight refuses a divergent base
  # before merging, so divergence here means the base moved since then.
  if [[ "$_dry_run" != 1 ]] ||
    git cat-file -e "$base_oid^{commit}" 2>/dev/null; then
    if git merge-base --is-ancestor "$base_oid" "$local_oid" 2>/dev/null; then
      return 0
    fi
    git merge-base --is-ancestor "$local_oid" "$base_oid" 2>/dev/null ||
      return 1
  fi
  _run git update-ref -m "$message" "refs/heads/$base" "$base_oid" "$local_oid" ||
    return 1
  [[ "$_dry_run" == 1 ]] ||
    gt_say "fast-forwarded $base to $remote/$base; no worktree has it checked out"
}

# Succeed when a local branch tracks the PR head: its upstream is the remote
# mapped to the head repository and the head's own branch there.
_local_head_tracks_pr() {
  local upstream

  [[ -n "$_head_remote" ]] || return 1
  upstream=$(git for-each-ref \
    --format='r=%(upstream:remotename)%09f=%(upstream:remoteref)' \
    "refs/heads/$1") || return 1
  [[ "$upstream" == "r=$_head_remote"$'\t'"f=refs/heads/$_head" ]]
}

# Delete the local PR head through the shared cleanup engine when every local
# commit is in what GitHub just merged: the head is exactly the landed head, or
# an ancestor of it that tracks the PR head (an earlier local snapshot). A
# same-named branch that does not track the PR head (another fork's PR, a new
# local branch on an older commit) needs the exact landed head. A head with
# later commits, or --keep-branch, keeps the branch. A kept branch is
# reported, not an error.
# shellcheck disable=SC2034 # GT_CLEANUP_* inputs are read by lib/git-tools-cleanup.sh
_retire_local_head() {
  local head="$1" landed_oid="$2" status=0 local_oid

  _local_branch_exists "$head" || status=$?
  case "$status" in
    0) local_oid=$GT_REF_OID ;;
    1) return 0 ;;
    *) return 1 ;;
  esac
  if [[ "$_keep_branch" == 1 ]]; then
    gt_say "preserving local PR head $head at $local_oid; --keep-branch was given"
    return 0
  fi
  if [[ "$local_oid" != "$landed_oid" ]]; then
    if ! git cat-file -e "$landed_oid^{commit}" 2>/dev/null; then
      gt_say "preserving local PR head $head at $local_oid; the landed head $landed_oid is not available locally to compare"
      return 0
    fi
    if ! git merge-base --is-ancestor "$local_oid" "$landed_oid" 2>/dev/null; then
      gt_say "preserving local PR head $head at $local_oid; it has commits the landed head $landed_oid does not"
      return 0
    fi
    if ! _local_head_tracks_pr "$head"; then
      gt_say "preserving local PR head $head at $local_oid; it is older than the landed head $landed_oid and does not track the PR head"
      return 0
    fi
  fi
  GT_CLEANUP_DRY_RUN=$_dry_run
  GT_CLEANUP_REMOVE_WORKTREES=1
  GT_CLEANUP_SWITCHED_TO_BASE=$_switched_to_base
  GT_CLEANUP_CURRENT_BRANCH=$_invoking_branch
  GT_CLEANUP_CURRENT_WORKTREE=$_invoking_worktree
  if ! gt_cleanup_load_prune_paths; then
    gt_say "keeping the worktree of $head; $GT_CLEANUP_ERROR"
    GT_CLEANUP_REMOVE_WORKTREES=0
  fi
  gt_cleanup_retire_branch "$head" "$local_oid" merged-pr \
    "merged in PR #$_number" || true
}

_cleanup_incomplete() {
  if [[ "$_dry_run" == 1 ]]; then
    gt_die "would merge PR #$_number, but cleanup would be incomplete: $*"
  fi
  gt_die "PR #$_number merged; cleanup incomplete: $*"
}

_require_expected_topology() {
  local view

  [[ -n "$_expected_topology" ]] || return 0
  view=$(gt_pr_view_tsv "$_url") ||
    gt_die "could not revalidate PR #$_number topology"
  gt_pr_record_matches_topology "$view" "$_expected_topology" ||
    gt_die "PR #$_number topology changed since stack discovery"
}

gt_require_repo
gt_refuse_external_checkout "$_dry_run"
gt_find_current_worktree || gt_die "could not resolve current worktree"
_invoking_worktree=$GT_WORKTREE_PATH
_invoking_branch=$(git symbolic-ref -q --short HEAD) || _invoking_branch=""
gt_require_gh
_status=$(GIT_OPTIONAL_LOCKS=0 git status --porcelain) ||
  gt_die "could not inspect worktree status"
[[ -z "$_status" ]] || _refuse "worktree must be clean"

_target_repo_status=0
gt_validate_pr_target_repository "$_target" || _target_repo_status=$?
case "$_target_repo_status" in
  0) ;;
  1) gt_die "target pull request belongs to a different repository" ;;
  *) gt_die "could not resolve the current GitHub repository" ;;
esac

_view=$(gt_pr_view_tsv "$_target") || gt_die "could not read pull request"
IFS=$'\t' read -r _number _state _draft _merge_state _head _head_oid _base \
  _head_repo _cross_repo _url _title <<<"$_view"
if [[ -n "$_expected_topology" ]]; then
  gt_pr_record_matches_topology "$_view" "$_expected_topology" ||
    gt_die "PR #$_number topology changed since stack discovery"
else
  _expected_topology=$(gt_pr_record_topology_tsv "$_view") ||
    gt_die "could not snapshot PR #$_number topology"
fi

_target_repo_status=0
gt_validate_pr_url_repository "$_url" || _target_repo_status=$?
case "$_target_repo_status" in
  0) ;;
  1) gt_die "target pull request belongs to a different repository" ;;
  *) gt_die "could not resolve the current GitHub repository" ;;
esac

_checks=$(gt_pr_checks_status "$_url") || gt_die "could not read pull request checks"
_checks_state=$(gt_checks_ready_state "$_checks")
_require_expected_topology

if [[ "$_state" != "OPEN" ]]; then
  gt_die "PR #$_number is not open"
elif gt_bool "$_draft"; then
  gt_die "PR #$_number is a draft"
elif [[ "$_merge_state" != "CLEAN" ]]; then
  gt_die "PR #$_number merge state is $_merge_state"
elif [[ "$_checks_state" != "pass" ]]; then
  gt_die "PR #$_number checks are $_checks_state"
fi
case "$_cross_repo" in
  true | false) ;;
  *) gt_die "could not parse pull request head repository state" ;;
esac

_base_remote_status=0
gt_find_current_repo_fetch_remote || _base_remote_status=$?
case "$_base_remote_status" in
  0)
    _remote=$GT_REPO_FETCH_REMOTE
    _base_remote_url=$GT_REPO_FETCH_REMOTE_URL
    ;;
  1) gt_die "could not resolve one exact fetch remote for the base repository" ;;
  *) gt_die "could not inspect configured fetch remotes for the base repository" ;;
esac
# The base this landing syncs: the PR's own, or in a stack dry run the base the
# real run would have retargeted it to by now.
_sync_base_branch=$_base
if [[ -n "$_expected_base" ]]; then
  if [[ "$_dry_run" == 1 ]]; then
    _sync_base_branch=$_expected_base
  elif [[ "$_expected_base" != "$_base" ]]; then
    gt_die "PR #$_number base changed since stack discovery"
  fi
fi
_preflight_local_plan "$_remote" "$_base_remote_url" "$_sync_base_branch"
# The live PR head is checked in dry runs as well: it is read-only, and the
# real run refuses on it before merging.
_head_remote=""
_head_remote_url=""
_head_remote_map_status=0
gt_find_pr_head_remote "$_head" "$_head_repo" "$_url" ||
  _head_remote_map_status=$?
case "$_head_remote_map_status" in
  0)
    _head_remote=$GT_PR_HEAD_REMOTE
    _head_remote_url=$GT_PR_HEAD_REMOTE_URL
    ;;
  1) ;;
  *) gt_die "could not inspect configured remotes for PR head $_head" ;;
esac
_remote_head_oid=""
_remote_head_status=0
if [[ -n "$_head_remote_url" ]]; then
  gt_find_remote_ref_exact_url "$_head_remote_url" "refs/heads/$_head" ||
    _remote_head_status=$?
  case "$_remote_head_status" in
    0)
      _remote_head_oid=$GT_REMOTE_REF_OID
      [[ "$_remote_head_oid" == "$_head_oid" ]] ||
        _refuse "remote PR head $_head_remote/$_head does not match PR #$_number head OID"
      ;;
    1) _refuse "remote PR head does not exist: $_head_remote/$_head" ;;
    *) gt_die "could not snapshot remote branch $_head_remote/$_head" ;;
  esac
fi
_merge_args=(merge "$_number" "--$_method" --match-head-commit "$_head_oid")

_require_expected_topology
gt_say "merging PR #$_number with $_method"
_merge_status=0
_run gt_gh_pr "${_merge_args[@]}" || _merge_status=$?
if [[ "$_dry_run" != 1 ]]; then
  _after_view=$(gt_pr_view_tsv "$_url") || {
    if ((_merge_status != 0)); then
      gt_die "merge command failed and PR #$_number state could not be verified"
    fi
    gt_die "merge command succeeded but PR #$_number state could not be verified"
  }
  if [[ -n "$_expected_topology" ]] &&
    ! gt_pr_record_matches_topology "$_after_view" "$_expected_topology"; then
    gt_die "PR #$_number merged; cleanup incomplete: topology changed after merge"
  fi
  IFS=$'\t' read -r _ _after_state _ <<<"$_after_view"
  if [[ "$_after_state" != "MERGED" ]]; then
    if ((_merge_status != 0)); then
      gt_die "merge command failed for PR #$_number (state: $_after_state)"
    fi
    gt_die "PR #$_number is not merged after merge command (state: $_after_state); local cleanup skipped"
  fi
  if ((_merge_status != 0)); then
    gt_say "PR #$_number is merged despite merge command exit $_merge_status"
  fi
fi

gt_say "syncing $_sync_base_branch from $_remote"
_sync_base "$_remote" "$_base_remote_url" "$_sync_base_branch" ||
  _cleanup_incomplete "could not fast-forward $_sync_base_branch from $_remote"
if [[ "$_dry_run" != 1 && -n "${_head_remote_url:-}" ]]; then
  gt_say "preserving remote PR head $_head at $_remote_head_oid; delete it manually after verifying no pull request consumes it"
elif [[ "$_dry_run" != 1 ]]; then
  gt_say "preserving remote PR head $_head; no configured remote maps to $_head_repo"
fi
_retire_local_head "$_head" "$_head_oid" ||
  _cleanup_incomplete "could not inspect local branch $_head"

if [[ "$_dry_run" == 1 ]]; then
  gt_say "would land PR #$_number ($_head -> $_sync_base_branch)"
else
  gt_say "landed PR #$_number ($_head -> $_base)"
fi
