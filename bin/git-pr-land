#!/usr/bin/env bash
# Merge one ready GitHub pull request and clean up its local branch.

set -euo pipefail

# shellcheck disable=SC2034 # consumed by lib/git-tools-pr.sh after dynamic source
gt_command="git pr-land"

# BEGIN GENERATED LAUNCHER BOOTSTRAP
# Generated by support/sync-launcher-bootstrap; edit the template, not launcher copies.
_script_path="${BASH_SOURCE[0]}"
while [[ -L "$_script_path" ]]; do
  _script_dir=$(cd -P -- "$(dirname -- "$_script_path")" && pwd)
  _link=$(readlink "$_script_path")
  case "$_link" in
    /*) _script_path="$_link" ;;
    *) _script_path="$_script_dir/$_link" ;;
  esac
done
_root=$(cd -P -- "$(dirname -- "$_script_path")/.." && pwd)
# END GENERATED LAUNCHER BOOTSTRAP
# shellcheck disable=SC1091
. "$_root/lib/git-tools-pr.sh"
# shellcheck disable=SC1091
. "$_root/lib/git-tools-base.sh"

_usage() {
  cat <<'EOF'
Usage: git pr-land [options] <number|url|branch>

Verify that one GitHub pull request is ready, merge it, sync the base branch,
and delete the local PR branch. This command does not discover or land stacks.

Options:
  -m, --method <method>   Merge method: squash, merge, or rebase (default: squash).
      --keep-branch       Do not ask GitHub to delete the remote branch and do
                          not delete the local branch.
  -n, --dry-run           Print actions without changing anything.
  -h, --help              Show this help.

Exit status:
  0  PR was landed.
  1  PR is not ready, merge failed, or post-merge cleanup is incomplete.
  2  Usage or local environment error.
EOF
}

_target=""
_method="squash"
_keep_branch=0
_dry_run=0

_run() {
  if [[ "$_dry_run" == 1 ]]; then
    printf 'git pr-land: would run:' >&2
    printf ' %q' "$@" >&2
    printf '\n' >&2
    return 0
  fi
  "$@"
}

while (($#)); do
  case "$1" in
    -m | --method)
      _opt="$1"
      shift
      (($#)) || gt_usage_error "$_opt requires a value"
      _method="$1"
      shift
      ;;
    --method=*)
      _method="${1#--method=}"
      [[ -n "$_method" ]] || gt_usage_error "--method requires a value"
      shift
      ;;
    --keep-branch)
      _keep_branch=1
      shift
      ;;
    -n | --dry-run)
      _dry_run=1
      shift
      ;;
    -h | --help)
      _usage
      exit 0
      ;;
    --)
      shift
      (($# == 1)) || gt_usage_error "expected exactly one target"
      _target="$1"
      break
      ;;
    -*)
      gt_usage_error "unexpected option: $1"
      ;;
    *)
      [[ -z "$_target" ]] || gt_usage_error "expected exactly one target"
      _target="$1"
      shift
      ;;
  esac
done

[[ -n "$_target" ]] || gt_usage_error "expected exactly one target"

case "$_method" in
  squash | merge | rebase) ;;
  *) gt_usage_error "merge method must be squash, merge, or rebase" ;;
esac

_remote_for_branch() {
  local branch="$1"
  local remote

  remote=$(git config "branch.$branch.remote" 2>/dev/null || true)
  if [[ -n "$remote" ]]; then
    printf '%s\n' "$remote"
    return 0
  fi
  printf 'origin\n'
}

_local_branch_exists() {
  git show-ref --verify --quiet "refs/heads/$1"
}

_remote_branch_exists() {
  local remote="$1"
  local branch="$2"
  git show-ref --verify --quiet "refs/remotes/$remote/$branch"
}

_current_worktree() {
  git rev-parse --show-toplevel
}

_worktree_status() {
  gt_git_without_local_env -C "$1" status --porcelain
}

_fetch_remote() {
  _run git fetch --quiet --prune --tags "$1"
}

_preflight_local_plan() {
  local remote="$1"
  local base="$2"
  local head="$3"
  local current_worktree base_worktree head_worktree operation status

  _fetch_remote "$remote"
  _remote_branch_exists "$remote" "$base" ||
    gt_die "base branch does not exist on $remote: $base"

  if _local_branch_exists "$base" &&
    ! git merge-base --is-ancestor "$base" "$remote/$base" 2>/dev/null; then
    gt_die "local $base cannot fast-forward to $remote/$base"
  fi

  current_worktree=$(_current_worktree) || gt_die "could not resolve current worktree"
  operation=$(gt_worktree_operation "$current_worktree")
  [[ -z "$operation" ]] ||
    gt_die "current worktree has $operation in progress: $current_worktree"
  base_worktree=$(gt_worktree_for_branch "$base")
  head_worktree=$(gt_worktree_for_branch "$head")

  if [[ -n "$base_worktree" ]]; then
    operation=$(gt_worktree_operation "$base_worktree")
    [[ -z "$operation" ]] ||
      gt_die "base worktree has $operation in progress: $base_worktree"
    status=$(_worktree_status "$base_worktree") ||
      gt_die "could not inspect base worktree: $base_worktree"
    [[ -z "$status" ]] || gt_die "base worktree must be clean: $base_worktree"
  fi

  [[ "$_keep_branch" == 1 || -z "$head_worktree" ]] && return 0
  if [[ "$head_worktree" != "$current_worktree" ]]; then
    gt_die "PR branch is checked out in another worktree: $head_worktree (use --keep-branch or remove that worktree)"
  fi
  if [[ -n "$base_worktree" && "$base_worktree" != "$current_worktree" ]]; then
    gt_die "cannot delete $head while $base is checked out in $base_worktree (use --keep-branch or remove that worktree)"
  fi
}

_sync_base() {
  local remote="$1"
  local base="$2"
  local current_worktree base_worktree

  _fetch_remote "$remote" || return 1
  _remote_branch_exists "$remote" "$base" || return 1
  current_worktree=$(_current_worktree) || return 1
  base_worktree=$(gt_worktree_for_branch "$base")

  if [[ -n "$base_worktree" && "$base_worktree" != "$current_worktree" ]]; then
    gt_git_without_local_env -C "$base_worktree" merge --quiet --ff-only "$remote/$base" ||
      return 1
    return 0
  fi

  if _local_branch_exists "$base"; then
    _run git switch --quiet "$base" || return 1
  elif _remote_branch_exists "$remote" "$base"; then
    _run git switch --quiet -c "$base" --track "$remote/$base" || return 1
  else
    return 1
  fi

  _run git merge --quiet --ff-only "$remote/$base"
}

_delete_local_head() {
  local head="$1"
  local current worktree

  [[ "$_keep_branch" == 0 ]] || return 0
  _local_branch_exists "$head" || return 0
  if [[ "$_dry_run" == 1 ]]; then
    _run git branch -D "$head"
    return 0
  fi
  current=$(git symbolic-ref -q --short HEAD 2>/dev/null || true)
  [[ "$current" != "$head" ]] || return 1
  worktree=$(gt_worktree_for_branch "$head")
  [[ -z "$worktree" ]] || return 1
  _run git branch -D "$head"
}

_cleanup_incomplete() {
  gt_die "PR #$_number merged; cleanup incomplete: $*"
}

gt_require_repo
gt_require_gh
if [[ "$_dry_run" != 1 ]]; then
  gt_require_clean_worktree
fi

_view=$(gt_pr_view_tsv "$_target") || gt_die "could not read pull request"
IFS=$'\t' read -r _number _state _draft _merge_state _head _base _url _title <<<"$_view"

_checks=$(gt_pr_checks_status "$_target") || gt_die "could not read pull request checks"
_checks_state=$(gt_checks_ready_state "$_checks")

if [[ "$_state" != "OPEN" ]]; then
  gt_die "PR #$_number is not open"
elif gt_bool "$_draft"; then
  gt_die "PR #$_number is a draft"
elif [[ "$_merge_state" != "CLEAN" ]]; then
  gt_die "PR #$_number merge state is $_merge_state"
elif [[ "$_checks_state" != "pass" ]]; then
  gt_die "PR #$_number checks are $_checks_state"
fi

_remote=$(_remote_for_branch "$_base")
if [[ "$_dry_run" != 1 ]]; then
  _preflight_local_plan "$_remote" "$_base" "$_head"
fi
_merge_args=(pr merge "$_number" "--$_method")
if [[ "$_keep_branch" == 0 ]]; then
  _merge_args+=(--delete-branch)
fi

gt_say "merging PR #$_number with $_method"
_merge_status=0
_run gh "${_merge_args[@]}" || _merge_status=$?
if [[ "$_dry_run" != 1 ]]; then
  _after_view=$(gt_pr_view_tsv "$_number") || {
    if ((_merge_status != 0)); then
      gt_die "merge command failed and PR #$_number state could not be verified"
    fi
    gt_die "merge command succeeded but PR #$_number state could not be verified"
  }
  IFS=$'\t' read -r _ _after_state _ <<<"$_after_view"
  if [[ "$_after_state" != "MERGED" ]]; then
    if ((_merge_status != 0)); then
      gt_die "merge command failed for PR #$_number (state: $_after_state)"
    fi
    gt_die "PR #$_number is not merged after merge command (state: $_after_state); local cleanup skipped"
  fi
  if ((_merge_status != 0)); then
    gt_say "PR #$_number is merged despite merge command exit $_merge_status"
  fi
fi

gt_say "syncing $_base from $_remote"
_sync_base "$_remote" "$_base" ||
  _cleanup_incomplete "could not fast-forward $_base from $_remote"
_delete_local_head "$_head" ||
  _cleanup_incomplete "local branch $_head is still checked out in a worktree"

gt_say "landed PR #$_number ($_head -> $_base)"
