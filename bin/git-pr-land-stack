#!/usr/bin/env bash
# Land a linear stack of ready GitHub pull requests.

set -euo pipefail

# shellcheck disable=SC2034 # consumed by lib/git-tools-pr.sh after dynamic source
gt_command="git pr-land-stack"

# BEGIN GENERATED LAUNCHER BOOTSTRAP
# Generated by support/sync-launcher-bootstrap; edit the template, not launcher copies.
_script_path="${BASH_SOURCE[0]}"
while [[ -L "$_script_path" ]]; do
  _script_dir=$(cd -P -- "$(dirname -- "$_script_path")" && pwd)
  _link=$(readlink "$_script_path")
  case "$_link" in
    /*) _script_path="$_link" ;;
    *) _script_path="$_script_dir/$_link" ;;
  esac
done
_root=$(cd -P -- "$(dirname -- "$_script_path")/.." && pwd)
# END GENERATED LAUNCHER BOOTSTRAP
# shellcheck disable=SC1091
. "$_root/lib/git-tools-pr.sh"
# shellcheck disable=SC1091
. "$_root/lib/git-tools-base.sh"

_tool_tmp=""
_cleanup_tools() {
  [[ -z "$_tool_tmp" ]] || rm -rf "$_tool_tmp"
}

_snapshot_tool_dir() {
  [[ -z "${GIT_TOOLS_TOOL_DIR:-}" ]] || {
    _tool_dir="$GIT_TOOLS_TOOL_DIR"
    return 0
  }

  # `git pr-land` switches the checkout to the landing base after each merge.
  # Keep the helper implementations stable for the whole orchestration instead
  # of reading whatever files happen to exist after those branch switches.
  _tool_tmp=$(mktemp -d)
  mkdir -p "$_tool_tmp/bin" "$_tool_tmp/lib"
  cp "$_root/bin/git-pr-land" "$_tool_tmp/bin/git-pr-land"
  cp "$_root/bin/git-pr-restack" "$_tool_tmp/bin/git-pr-restack"
  cp "$_root/bin/git-pr-stack" "$_tool_tmp/bin/git-pr-stack"
  cp "$_root/lib/git-tools-base.sh" "$_tool_tmp/lib/git-tools-base.sh"
  cp "$_root/lib/git-tools-pr.sh" "$_tool_tmp/lib/git-tools-pr.sh"
  _tool_dir="$_tool_tmp/bin"
}

trap _cleanup_tools EXIT
_tool_dir=""
_snapshot_tool_dir

_usage() {
  cat <<'EOF'
Usage: git pr-land-stack [options] <number|url|branch>

Land a linear stack of ready GitHub PRs from parent to child. The command is a
thin orchestrator over git pr-stack, git pr-land, and git pr-restack. Local and
remote PR heads are reported for manual cleanup and are never deleted
automatically.

Options:
  -m, --method <method>   Merge method: squash, merge, or rebase (default: squash).
      --keep-branch       Pass --keep-branch to git pr-land.
      --check-timeout <s>  Seconds to wait after restacking for checks (default: 900).
      --check-interval <s> Seconds between check polls (default: 10).
  -n, --dry-run           Print actions without changing anything.
  -h, --help              Show this help.

Exit status:
  0  Stack was landed.
  1  Stack is not ready or a child restack/merge failed.
  2  Usage or local environment error.
EOF
}

_target=""
_method="squash"
_keep_branch=0
_dry_run=0
_check_timeout=900
_check_interval=10

# Invoke a sub-tool that understands --dry-run (git pr-land / pr-restack). The
# caller appends --dry-run, so the sub-tool self-describes; we always execute it,
# including in dry-run, where the sub-tool emits its own plan rather than acting.
_run_tool() {
  if [[ "$_dry_run" == 1 ]]; then
    printf 'git pr-land-stack: would run:' >&2
    printf ' %q' "$@" >&2
    printf '\n' >&2
  fi
  "$@"
}

_preflight_stack_topology() {
  local current head_worktree index operation

  gt_find_current_worktree || gt_die "could not resolve current worktree"
  current=$GT_WORKTREE_PATH
  operation=$(gt_worktree_operation "$current") ||
    gt_die "could not inspect current worktree operation"
  [[ -z "$operation" ]] ||
    gt_die "current worktree has $operation in progress: $current"
  for index in "${!_heads[@]}"; do
    # Every child after the root will be checked out for restacking.
    if ((index > 0)); then
      gt_find_worktree_reserving_branch "${_heads[$index]}" ||
        gt_die "could not inspect worktrees"
      head_worktree=$GT_WORKTREE_PATH
      if [[ -n "$head_worktree" && "$head_worktree" != "$current" ]]; then
        gt_die "stack branch ${_heads[$index]} is checked out or reserved in another worktree: $head_worktree"
      fi
    fi
  done
}

_require_positive_integer() {
  local name="$1"
  local value="$2"

  case "$value" in
    '' | *[!0-9]*)
      gt_usage_error "$name must be a positive integer"
      ;;
    0)
      gt_usage_error "$name must be greater than zero"
      ;;
  esac
}

_wait_for_ready_pr() {
  local target="$1"
  local number="$2"
  local expected_topology="$3"
  local elapsed=0
  local checks checks_state view
  local state draft merge_state

  [[ "$_dry_run" == 0 ]] || return 0

  while :; do
    view=$(gt_pr_view_tsv "$target") ||
      gt_die "could not read PR #$number after restack"
    gt_pr_record_matches_topology "$view" "$expected_topology" ||
      gt_die "PR #$number topology changed after restack"
    IFS=$'\t' read -r _ state draft merge_state _ _ _ _ _ <<<"$view"

    checks=$(gt_pr_checks_status "$target") ||
      gt_die "could not read checks for PR #$number"
    checks_state=$(gt_checks_ready_state "$checks")

    if [[ "$state" != "OPEN" ]]; then
      gt_die "PR #$number is no longer open after restack"
    elif gt_bool "$draft"; then
      gt_die "PR #$number is a draft after restack"
    elif [[ "$checks_state" == "fail" ]]; then
      gt_die "PR #$number checks failed after restack"
    elif [[ "$merge_state" == "CLEAN" && "$checks_state" == "pass" ]]; then
      gt_say "PR #$number is ready after restack"
      return 0
    fi

    case "$checks_state" in
      none | pending | pass)
        ;;
      *)
        gt_die "unexpected checks state for PR #$number: $checks_state"
        ;;
    esac

    case "$merge_state" in
      BLOCKED | CLEAN | DIRTY | HAS_HOOKS | UNKNOWN | UNSTABLE)
        ;;
      *)
        gt_die "unexpected merge state for PR #$number after restack: $merge_state"
        ;;
    esac

    if ((elapsed >= _check_timeout)); then
      gt_die "timed out waiting for PR #$number after restack: merge $merge_state, checks $checks_state"
    fi
    gt_say "waiting for PR #$number after restack: merge $merge_state, checks $checks_state"
    sleep "$_check_interval"
    elapsed=$((elapsed + _check_interval))
  done
}

_stack_topology() {
  local index="$1" base="$2"

  gt_pr_topology_tsv "${_numbers[$index]}" "${_heads[$index]}" \
    "${_expected_head_oids[$index]}" "$base" \
    "${_head_repos[$index]}" "${_head_cross_repos[$index]}" \
    "${_head_urls[$index]}"
}

_require_stack_topology() {
  local index="$1" expected_topology="$2" view

  view=$(gt_pr_view_tsv "${_head_urls[$index]}") ||
    gt_die "could not revalidate PR #${_numbers[$index]} topology"
  gt_pr_record_matches_topology "$view" "$expected_topology" ||
    gt_die "PR #${_numbers[$index]} topology changed since stack discovery"
}

_refresh_restacked_topology() {
  local index="$1" base="$2" local_oid view live_oid expected

  gt_find_ref_commit "refs/heads/${_heads[$index]}" ||
    gt_die "could not read local head for PR #${_numbers[$index]} after restack"
  local_oid=$GT_REF_OID
  view=$(gt_pr_view_tsv "${_head_urls[$index]}") ||
    gt_die "could not read PR #${_numbers[$index]} after restack"
  IFS=$'\t' read -r _ _ _ _ _ live_oid _ _ _ _ _ <<<"$view"
  expected=$(gt_pr_topology_tsv "${_numbers[$index]}" \
    "${_heads[$index]}" "$live_oid" "$base" "${_head_repos[$index]}" \
    "${_head_cross_repos[$index]}" "${_head_urls[$index]}") ||
    gt_die "could not validate restacked topology for PR #${_numbers[$index]}"
  gt_pr_record_matches_topology "$view" "$expected" ||
    gt_die "PR #${_numbers[$index]} topology changed after restack"
  [[ "$live_oid" == "$local_oid" ]] ||
    gt_die "PR #${_numbers[$index]} head OID does not match the restacked branch"
  _expected_head_oids[index]=$live_oid
  _expected_bases[index]=$base
}

while (($#)); do
  case "$1" in
    -m | --method)
      _opt="$1"
      shift
      (($#)) || gt_usage_error "$_opt requires a value"
      _method="$1"
      shift
      ;;
    --method=*)
      _method="${1#--method=}"
      [[ -n "$_method" ]] || gt_usage_error "--method requires a value"
      shift
      ;;
    --keep-branch)
      _keep_branch=1
      shift
      ;;
    --check-timeout)
      _opt="$1"
      shift
      (($#)) || gt_usage_error "$_opt requires a value"
      _check_timeout="$1"
      shift
      ;;
    --check-timeout=*)
      _check_timeout="${1#--check-timeout=}"
      [[ -n "$_check_timeout" ]] || gt_usage_error "--check-timeout requires a value"
      shift
      ;;
    --check-interval)
      _opt="$1"
      shift
      (($#)) || gt_usage_error "$_opt requires a value"
      _check_interval="$1"
      shift
      ;;
    --check-interval=*)
      _check_interval="${1#--check-interval=}"
      [[ -n "$_check_interval" ]] || gt_usage_error "--check-interval requires a value"
      shift
      ;;
    -n | --dry-run)
      _dry_run=1
      shift
      ;;
    -h | --help)
      _usage
      exit 0
      ;;
    --)
      shift
      (($# == 1)) || gt_usage_error "expected exactly one target"
      _target="$1"
      break
      ;;
    -*)
      gt_usage_error "unexpected option: $1"
      ;;
    *)
      [[ -z "$_target" ]] || gt_usage_error "expected exactly one target"
      _target="$1"
      shift
      ;;
  esac
done

[[ -n "$_target" ]] || gt_usage_error "expected exactly one target"
case "$_method" in
  squash | merge | rebase) ;;
  *) gt_usage_error "merge method must be squash, merge, or rebase" ;;
esac
_require_positive_integer "--check-timeout" "$_check_timeout"
_require_positive_integer "--check-interval" "$_check_interval"

gt_require_repo
gt_require_gh
if [[ "$_dry_run" != 1 ]]; then
  gt_require_clean_worktree
fi

_target_repo_status=0
gt_validate_pr_target_repository "$_target" || _target_repo_status=$?
case "$_target_repo_status" in
  0) ;;
  1) gt_die "target pull request belongs to a different repository" ;;
  *) gt_die "could not resolve the current GitHub repository" ;;
esac

_stack_output=$("$_tool_dir/git-pr-stack" "$_target" --porcelain=v2) ||
  gt_die "could not discover stack"

_records=()
while IFS= read -r _line; do
  [[ -n "$_line" ]] || continue
  _records+=("$_line")
done <<<"$_stack_output"

((${#_records[@]} > 0)) || gt_die "stack is empty"

_numbers=()
_bases=()
_heads=()
_original_head_oids=()
_expected_head_oids=()
_head_repos=()
_head_cross_repos=()
_head_urls=()
_expected_bases=()
_ready=()
_reasons=()

for _record in "${_records[@]}"; do
  IFS=$'\t' read -r _kind _index _number _base _head _is_ready _reason _checks \
    _url _head_oid _head_repo _head_cross_repo <<<"$_record"
  [[ "$_kind" == "pr" ]] || gt_die "unexpected pr-stack record: $_record"
  case "$_head_cross_repo" in
    true | false) ;;
    *) gt_die "unexpected pr-stack head repository state: $_record" ;;
  esac
  _numbers+=("$_number")
  _bases+=("$_base")
  _heads+=("$_head")
  _original_head_oids+=("$_head_oid")
  _expected_head_oids+=("$_head_oid")
  _head_repos+=("$_head_repo")
  _head_cross_repos+=("$_head_cross_repo")
  _head_urls+=("$_url")
  _expected_bases+=("$_base")
  _ready+=("$_is_ready")
  _reasons+=("$_reason")
  _record_repo_status=0
  gt_validate_pr_url_repository "$_url" || _record_repo_status=$?
  case "$_record_repo_status" in
    0) ;;
    1) gt_die "stack PR #$_number belongs to a different repository" ;;
    *) gt_die "could not resolve the current GitHub repository" ;;
  esac
done

for _i in "${!_numbers[@]}"; do
  if [[ "${_ready[$_i]}" != true ]]; then
    gt_die "PR #${_numbers[$_i]} is not ready: ${_reasons[$_i]}"
  fi
done

if [[ "$_dry_run" != 1 ]]; then
  _preflight_stack_topology
fi

gt_say "landing ${#_numbers[@]} PR(s)"

_land_base="${_bases[0]}"

for _i in "${!_numbers[@]}"; do
  _number="${_numbers[$_i]}"
  _next_index=$((_i + 1))
  _expected_topology=$(_stack_topology "$_i" "${_expected_bases[$_i]}") ||
    gt_die "could not validate expected topology for PR #$_number"

  _require_stack_topology "$_i" "$_expected_topology"

  _land_args=("$_tool_dir/git-pr-land" "${_head_urls[$_i]}" --method "$_method")
  if [[ "$_keep_branch" == 1 || $_next_index -lt ${#_numbers[@]} ]]; then
    _land_args+=(--keep-branch)
  fi
  if [[ "$_dry_run" == 1 ]]; then
    _land_args+=(--dry-run)
  fi
  _land_args+=(--expect-topology "$_expected_topology")

  _run_tool "${_land_args[@]}"

  if ((_next_index < ${#_numbers[@]})); then
    _child="${_numbers[$_next_index]}"
    _child_url="${_head_urls[$_next_index]}"
    _child_topology=$(_stack_topology "$_next_index" \
      "${_expected_bases[$_next_index]}") ||
      gt_die "could not validate expected topology for PR #$_child"
    _require_stack_topology "$_next_index" "$_child_topology"
    # The just-landed parent's head is the child's old base. Pass it as the fork
    # point so the parent's commits drop out of the child instead of being
    # re-applied onto the root base (which conflicts after a squash merge).
    _restack_args=("$_tool_dir/git-pr-restack" "$_child_url" --base "$_land_base" --fork "oid:${_original_head_oids[$_i]}")
    if [[ "$_dry_run" == 1 ]]; then
      _restack_args+=(--dry-run)
    fi
    _restack_args+=(--expect-topology "$_child_topology")
    _run_tool "${_restack_args[@]}"
    if [[ "$_dry_run" == 0 ]]; then
      _refresh_restacked_topology "$_next_index" "$_land_base"
      _child_topology=$(_stack_topology "$_next_index" "$_land_base") ||
        gt_die "could not validate restacked topology for PR #$_child"
      _wait_for_ready_pr "$_child_url" "$_child" "$_child_topology"
      _require_stack_topology "$_next_index" "$_child_topology"
    fi
  fi
done

gt_say "landed stack rooted at PR #${_numbers[0]}"
