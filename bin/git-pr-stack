#!/usr/bin/env bash
# Print a linear GitHub pull-request stack in parent-to-child order.

set -euo pipefail

# shellcheck disable=SC2034 # consumed by lib/git-tools-pr.sh after dynamic source
gt_command="git pr-stack"

# BEGIN GENERATED LAUNCHER BOOTSTRAP
# Generated by support/sync-launcher-bootstrap; edit the template, not launcher copies.
_script_path="${BASH_SOURCE[0]}"
while [[ -L "$_script_path" ]]; do
  _script_dir=$(cd -P -- "$(dirname -- "$_script_path")" && pwd)
  _link=$(readlink "$_script_path")
  case "$_link" in
    /*) _script_path="$_link" ;;
    *) _script_path="$_script_dir/$_link" ;;
  esac
done
_root=$(cd -P -- "$(dirname -- "$_script_path")/.." && pwd)
# END GENERATED LAUNCHER BOOTSTRAP
# shellcheck disable=SC1091
. "$_root/lib/git-tools-pr.sh"

_usage() {
  cat <<'EOF'
Usage: git pr-stack [options] [<number|url|branch>]

Discover the linear GitHub pull-request stack connected to a target PR and print
it in parent-to-child order. Without a target, uses the PR for the current
branch. A stack is connected when one PR's base branch is another PR's head
branch. Ambiguous, branched, or cyclic topology fails closed.

Options:
      --porcelain      Print one stable schema-v1 record per PR.
      --porcelain=v2   Print one stable schema-v2 record per PR.
  -h, --help        Show this help.

Exit status:
  0  Stack printed.
  1  Stack could not be read or has invalid topology.
  2  Usage or local environment error.
EOF
}

_target=""
_porcelain=0

while (($#)); do
  case "$1" in
    --porcelain)
      _porcelain=1
      shift
      ;;
    --porcelain=v2)
      _porcelain=2
      shift
      ;;
    --porcelain=*)
      gt_usage_error "unsupported porcelain version: ${1#*=}"
      ;;
    -h | --help)
      _usage
      exit 0
      ;;
    --)
      shift
      (($# <= 1)) || gt_usage_error "expected at most one target"
      _target="${1:-}"
      break
      ;;
    -*)
      gt_usage_error "unexpected option: $1"
      ;;
    *)
      [[ -z "$_target" ]] || gt_usage_error "expected at most one target"
      _target="$1"
      shift
      ;;
  esac
done

_number() {
  local number _rest
  IFS=$'\t' read -r number _rest <<<"$1"
  printf '%s\n' "$number"
}

_state() {
  local number state _rest
  IFS=$'\t' read -r number state _rest <<<"$1"
  printf '%s\n' "$state"
}

_draft() {
  local number state draft _rest
  IFS=$'\t' read -r number state draft _rest <<<"$1"
  printf '%s\n' "$draft"
}

_merge_state() {
  local number state draft merge_state _rest
  IFS=$'\t' read -r number state draft merge_state _rest <<<"$1"
  printf '%s\n' "$merge_state"
}

_head() {
  local number state draft merge_state head _rest
  IFS=$'\t' read -r number state draft merge_state head _rest <<<"$1"
  printf '%s\n' "$head"
}

_base() {
  local number state draft merge_state head head_oid base _rest
  IFS=$'\t' read -r number state draft merge_state head head_oid base _rest <<<"$1"
  printf '%s\n' "$base"
}

_head_oid() {
  local number state draft merge_state head head_oid _rest
  IFS=$'\t' read -r number state draft merge_state head head_oid _rest <<<"$1"
  printf '%s\n' "$head_oid"
}

_url() {
  local number state draft merge_state head head_oid base head_repo cross url _rest
  IFS=$'\t' read -r number state draft merge_state head head_oid base head_repo cross url _rest <<<"$1"
  printf '%s\n' "$url"
}

_title() {
  local number state draft merge_state head head_oid base head_repo cross url title
  IFS=$'\t' read -r number state draft merge_state head head_oid base head_repo cross url title <<<"$1"
  printf '%s\n' "$title"
}

_head_repo() {
  local number state draft merge_state head head_oid base head_repo _rest
  IFS=$'\t' read -r number state draft merge_state head head_oid base head_repo _rest <<<"$1"
  printf '%s\n' "$head_repo"
}

_cross_repo() {
  local number state draft merge_state head head_oid base head_repo cross _rest
  IFS=$'\t' read -r number state draft merge_state head head_oid base head_repo cross _rest <<<"$1"
  printf '%s\n' "$cross"
}

_find_by_number() {
  local want="$1"
  local record
  for record in "${_prs[@]}"; do
    [[ "$(_number "$record")" == "$want" ]] || continue
    printf '%s\n' "$record"
    return 0
  done
  return 1
}

_find_by_head() {
  local want="$1"
  local record found="" count=0
  for record in "${_prs[@]}"; do
    [[ "$(_cross_repo "$record")" == false ]] || continue
    [[ "$(_head "$record")" == "$want" ]] || continue
    found=$record
    count=$((count + 1))
  done
  if ((count > 1)); then
    return 2
  fi
  [[ "$count" == 1 ]] || return 1
  printf '%s\n' "$found"
}

_parent_of() {
  local record="$1"
  _find_by_head "$(_base "$record")"
}

_child_of() {
  local record="$1"
  local child_base
  local found="" count=0 candidate

  # A fork head is not a branch in the repository whose open PRs are being
  # listed, so it cannot be another listed PR's base branch.
  [[ "$(_cross_repo "$record")" == false ]] || return 1
  child_base=$(_head "$record")
  for candidate in "${_prs[@]}"; do
    [[ "$(_base "$candidate")" == "$child_base" ]] || continue
    found="$candidate"
    count=$((count + 1))
  done

  if ((count > 1)); then
    return 2
  fi
  [[ "$count" == 1 ]] || return 1
  printf '%s\n' "$found"
}

_append_stack() {
  _stack+=("$1")
}

_prepend_stack() {
  local record="$1"
  _stack=("$record" "${_stack[@]}")
}

_stack_contains_number() {
  local want="$1" record
  for record in "${_stack[@]}"; do
    [[ "$(_number "$record")" != "$want" ]] || return 0
  done
  return 1
}

_record_ready() {
  local record="$1"
  local checks checks_state

  checks=$(gt_pr_checks_status "$(_url "$record")") || return 1
  checks_state=$(gt_checks_ready_state "$checks")

  if [[ "$(_state "$record")" != "OPEN" ]]; then
    printf 'false\tstate %s\t%s\n' "$(_state "$record")" "$checks_state"
  elif gt_bool "$(_draft "$record")"; then
    printf 'false\tdraft\t%s\n' "$checks_state"
  elif [[ "$(_merge_state "$record")" != "CLEAN" ]]; then
    printf 'false\tmerge state %s\t%s\n' "$(_merge_state "$record")" "$checks_state"
  elif [[ "$checks_state" != "pass" ]]; then
    printf 'false\tchecks %s\t%s\n' "$checks_state" "$checks_state"
  else
    printf 'true\tready\t%s\n' "$checks_state"
  fi
}

gt_require_repo
gt_require_gh

_target_repo_status=0
gt_validate_pr_target_repository "$_target" || _target_repo_status=$?
case "$_target_repo_status" in
  0) ;;
  1) gt_die "target pull request belongs to a different repository" ;;
  *) gt_die "could not resolve the current GitHub repository" ;;
esac

_pr_records=$(gt_pr_list_open_tsv) || gt_die "could not list open pull requests"
_prs=()
while IFS= read -r _record; do
  [[ -n "$_record" ]] || continue
  case "$(_cross_repo "$_record")" in
    true | false) ;;
    *) gt_die "could not parse pull request repository identity" ;;
  esac
  _prs+=("$_record")
done <<<"$_pr_records"

((${#_prs[@]} > 0)) || gt_die "no open pull requests found"

_target_view=$(gt_pr_view_tsv "$_target") || gt_die "could not read target pull request"
_target_url=$(_url "$_target_view")
_target_repo_status=0
gt_validate_pr_url_repository "$_target_url" || _target_repo_status=$?
case "$_target_repo_status" in
  0) ;;
  1) gt_die "target pull request belongs to a different repository" ;;
  *) gt_die "could not resolve the current GitHub repository" ;;
esac
_target_number=$(_number "$_target_view")
_current=$(_find_by_number "$_target_number") ||
  gt_die "target PR #$_target_number is not open"
gt_pr_records_match_topology "$_target_view" "$_current" ||
  gt_die "target PR #$_target_number topology changed while discovering the stack"

_stack=("$_current")

while :; do
  _parent_status=0
  _parent=$(_parent_of "${_stack[0]}") || _parent_status=$?
  case "$_parent_status" in
    0)
      _parent_number=$(_number "$_parent")
      if _stack_contains_number "$_parent_number"; then
        gt_die "stack topology contains a cycle at PR #$_parent_number"
      fi
      _prepend_stack "$_parent"
      ;;
    1) break ;;
    2)
      gt_die "stack parent is ambiguous at $(_base "${_stack[0]}"); multiple same-repository heads found"
      ;;
    *) gt_die "could not discover stack parent" ;;
  esac
done

while :; do
  _child_status=0
  _child=$(_child_of "${_stack[${#_stack[@]} - 1]}") || _child_status=$?
  case "$_child_status" in
    0)
      _child_number=$(_number "$_child")
      if _stack_contains_number "$_child_number"; then
        gt_die "stack topology contains a cycle at PR #$_child_number"
      fi
      _append_stack "$_child"
      ;;
    1) break ;;
    2)
      gt_die "stack is branched at $(_head "${_stack[${#_stack[@]} - 1]}"); multiple child PRs found"
      ;;
    *) gt_die "could not discover stack child" ;;
  esac
done

_index=0
for _record in "${_stack[@]}"; do
  _ready_info=$(_record_ready "$_record") || gt_die "could not read PR checks"
  IFS=$'\t' read -r _ready _reason _checks_state <<<"$_ready_info"

  # Legacy Bash read binds the final URL, so v1 must stay exactly nine fields.
  if [[ "$_porcelain" == 1 ]]; then
    printf 'pr\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$_index" "$(_number "$_record")" "$(_base "$_record")" "$(_head "$_record")" \
      "$_ready" "$_reason" "$_checks_state" "$(_url "$_record")"
  elif [[ "$_porcelain" == 2 ]]; then
    printf 'pr\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$_index" "$(_number "$_record")" "$(_base "$_record")" "$(_head "$_record")" \
      "$_ready" "$_reason" "$_checks_state" "$(_url "$_record")" \
      "$(_head_oid "$_record")" "$(_head_repo "$_record")" "$(_cross_repo "$_record")"
  else
    printf '%s. #%s %s -> %s checks=%s ready=%s\n' \
      "$((_index + 1))" "$(_number "$_record")" "$(_base "$_record")" \
      "$(_head "$_record")" "$_checks_state" "$_ready"
    printf '   %s\n' "$(_title "$_record")"
    if [[ "$_ready" != true ]]; then
      printf '   not ready: %s\n' "$_reason"
    fi
  fi
  _index=$((_index + 1))
done
