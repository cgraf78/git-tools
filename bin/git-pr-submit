#!/usr/bin/env bash
# Turn commits made on the default branch into an auto-merging pull request.

set -euo pipefail

# shellcheck disable=SC2034 # consumed by shared helpers after dynamic source
gt_command="git pr-submit"

# BEGIN GENERATED LAUNCHER BOOTSTRAP
# Generated by support/sync-launcher-bootstrap; edit the template, not launcher copies.
_script_path="${BASH_SOURCE[0]}"
while [[ -L "$_script_path" ]]; do
  _script_dir=$(cd -P -- "$(dirname -- "$_script_path")" && pwd)
  _link=$(readlink "$_script_path")
  case "$_link" in
    /*) _script_path="$_link" ;;
    *) _script_path="$_script_dir/$_link" ;;
  esac
done
_root=$(cd -P -- "$(dirname -- "$_script_path")/.." && pwd)
# END GENERATED LAUNCHER BOOTSTRAP
# shellcheck disable=SC1091
. "$_root/lib/git-tools-pr.sh"
# shellcheck disable=SC1091
. "$_root/lib/git-tools-base.sh"

_usage() {
  cat <<'EOF'
Usage: git pr-submit

Move commits made on the repository default branch to a generated feature
branch, open a pull request using their commit text, and queue squash
auto-merge without bypassing repository protections.

A single commit supplies the pull request title and body directly. Multiple
commits open the configured Git editor with every commit message; unchanged or
an empty edited title cancels submission before any branch is moved.
EOF
}

_cleanup_file=""
_cleanup_file_two=""

# PR bodies may contain private draft text until the pull request is created.
# Track both temporary paths centrally so every exit path can remove them
# without relying on whichever phase happened to allocate each file.
_remove_temp_files() {
  [[ -z "$_cleanup_file" ]] || rm -f -- "$_cleanup_file" || true
  [[ -z "$_cleanup_file_two" ]] || rm -f -- "$_cleanup_file_two" || true
}

# EXIT preserves the command's real status. Signals need dedicated handlers:
# Bash exposes the interrupted command's prior status to a signal trap, which
# can be zero when the signal lands during builtin work.
# shellcheck disable=SC2329 # invoked by the EXIT trap.
_cleanup_on_exit() {
  local status=$?

  trap - EXIT
  _remove_temp_files
  exit "$status"
}

# shellcheck disable=SC2329 # invoked by the signal traps.
_cleanup_on_signal() {
  local status="$1"

  trap - EXIT HUP INT TERM
  _remove_temp_files
  exit "$status"
}

trap _cleanup_on_exit EXIT
trap '_cleanup_on_signal 129' HUP
trap '_cleanup_on_signal 130' INT
trap '_cleanup_on_signal 143' TERM

while (($#)); do
  case "$1" in
    -h | --help)
      _usage
      exit 0
      ;;
    -*) gt_usage_error "unexpected option: $1" ;;
    *) gt_usage_error "unexpected argument: $1" ;;
  esac
done

# Ref movement is intentionally the last phase. All repository, GitHub, remote,
# commit-text, and editor validation runs first so a refusal or human
# cancellation leaves the user's directly-committed main branch untouched.
gt_require_repo
gt_require_clean_worktree
_original_branch=$(gt_current_branch)
gt_require_gh
gt_load_current_repo_default_branch ||
  gt_die "could not resolve the base repository default branch"
_base=$GT_CURRENT_REPO_DEFAULT_BRANCH
[[ "$_original_branch" == "$_base" ]] ||
  gt_usage_error "current branch is not the base branch: $_base"

# Resolve the fetch endpoint through the checkout's verified GitHub identity.
# A convenient submission command must not let a foreign `origin`, GH_REPO, or
# URL rewrite redirect the protected base snapshot it is about to trust.
_base_remote_status=0
gt_find_current_repo_fetch_remote || _base_remote_status=$?
case "$_base_remote_status" in
  0) _base_remote_url=$GT_REPO_FETCH_REMOTE_URL ;;
  1) gt_die "could not resolve one exact fetch remote for the base repository" ;;
  *) gt_die "could not inspect configured fetch remotes for the base repository" ;;
esac

_fetch_status=0
gt_snapshot_and_fetch_ref_exact_url \
  "$_base_remote_url" "refs/heads/$_base" || _fetch_status=$?
case "$_fetch_status" in
  0) _base_oid=$GT_EXACT_REF_OID ;;
  1) gt_die "base branch does not exist on the validated remote: $_base" ;;
  *) gt_die "could not fetch a stable snapshot of the remote base: $_base" ;;
esac

_head_oid=$(git rev-parse --verify 'HEAD^{commit}' 2>/dev/null) ||
  gt_die "could not resolve the current commit"
[[ "$_head_oid" != "$_base_oid" ]] ||
  gt_usage_error "base branch has no commits to submit"

# Only the ahead-only case can be split into a PR branch without rewriting
# commits. Automatically rebasing a divergence would turn a shortcut into an
# implicit conflict-resolution policy, so keep that decision with the user.
_ancestor_status=0
git merge-base --is-ancestor "$_base_oid" "$_head_oid" 2>/dev/null ||
  _ancestor_status=$?
case "$_ancestor_status" in
  0) ;;
  1) gt_die "local $_base has diverged from its remote; rebase it before submitting" ;;
  *) gt_die "could not compare local $_base with its remote" ;;
esac

# Pin the ordered commit set before opening an editor. The immutable OIDs keep
# PR text generation and the later branch operation bound to the same history,
# even if another process changes an unrelated ref while the editor is open.
_commit_list=$(git rev-list --reverse "$_base_oid..$_head_oid") ||
  gt_die "could not enumerate commits to submit"
_commit_oids=()
while IFS= read -r _oid; do
  [[ -z "$_oid" ]] || _commit_oids+=("$_oid")
done <<<"$_commit_list"
((${#_commit_oids[@]} > 0)) ||
  gt_die "could not resolve commits to submit"

# Restrictive creation permissions matter because commit bodies and the
# human-edited PR draft can contain details not yet published to GitHub. Restore
# the caller's umask immediately so the command does not leak shell state.
_old_umask=$(umask)
umask 077
_cleanup_file=$(mktemp "${TMPDIR:-/tmp}/git-pr-submit.XXXXXX") || {
  umask "$_old_umask"
  gt_die "could not create a temporary PR description"
}
umask "$_old_umask"

if ((${#_commit_oids[@]} == 1)); then
  # One commit already has the exact title/body structure GitHub needs. Avoid
  # opening an editor so the common typo-fix workflow stays as cheap as push.
  _title=$(git show -s --format=%s "${_commit_oids[0]}") ||
    gt_die "could not read the commit subject"
  [[ -n "$_title" ]] || gt_die "commit subject cannot be empty"
  git show -s --format=%b "${_commit_oids[0]}" >"$_cleanup_file" ||
    gt_die "could not read the commit body"
  _body_file=$_cleanup_file
else
  # Multiple commit messages are evidence, not necessarily a coherent PR
  # description. Seed all of them for context but require a human to collapse
  # that history into one title and body before any durable mutation occurs.
  _first=1
  for _oid in "${_commit_oids[@]}"; do
    if [[ "$_first" == 0 ]]; then
      printf '\n---\n\n' >>"$_cleanup_file"
    fi
    # Git's pretty-printer adds its own record terminator after the commit
    # message. Normalize each message independently so separators and the
    # unchanged-buffer fingerprint do not depend on incidental blank lines.
    git show -s --format=%B "$_oid" | git stripspace >>"$_cleanup_file" ||
      gt_die "could not seed PR text from commit $_oid"
    _first=0
  done
  _seed_oid=$(git hash-object --no-filters "$_cleanup_file") ||
    gt_die "could not fingerprint the seeded PR text"
  _editor=$(git var GIT_EDITOR) ||
    gt_die "could not resolve the Git editor"
  [[ -n "$_editor" ]] || gt_die "Git editor cannot be empty"
  gt_say "multiple commits detected; edit the first line as the PR title and the remainder as its body"
  _editor_status=0
  # `git var GIT_EDITOR` deliberately returns a shell command, not necessarily
  # one executable path (`code --wait` is common). Append a literal quoted
  # "$@" to that trusted command string and pass the draft as a positional
  # argument; this matches Git's command semantics without reparsing the
  # temporary filename through eval.
  sh -c "$_editor \"\$@\"" git-pr-submit-editor \
    "$_cleanup_file" || _editor_status=$?
  [[ "$_editor_status" == 0 ]] ||
    gt_die "editor exited unsuccessfully; submission cancelled"

  # Inspect the raw first line before whole-buffer normalization. `git stripspace`
  # intentionally removes leading blank lines, which would otherwise promote a
  # body line into the title and defeat the explicit human edit.
  _raw_title=""
  IFS= read -r _raw_title <"$_cleanup_file" || true
  [[ "$_raw_title" =~ [^[:space:]] ]] ||
    gt_die "edited PR title is empty; submission cancelled"

  _old_umask=$(umask)
  umask 077
  _cleanup_file_two=$(mktemp \
    "${TMPDIR:-/tmp}/git-pr-submit.XXXXXX") || {
    umask "$_old_umask"
    gt_die "could not create a temporary edited PR description"
  }
  umask "$_old_umask"
  git stripspace <"$_cleanup_file" >"$_cleanup_file_two" ||
    gt_die "could not normalize the edited PR text"
  _edited_oid=$(git hash-object --no-filters "$_cleanup_file_two") ||
    gt_die "could not fingerprint the edited PR text"
  # Treat an unchanged normalized buffer as cancellation. Comparing content,
  # rather than editor exit status or timestamps, works across terminal and GUI
  # editors and prevents a no-op save from bypassing the required human edit.
  [[ "$_edited_oid" != "$_seed_oid" ]] ||
    gt_die "PR text was not changed; submission cancelled"

  # The normalized copy is only a comparison aid and a safe source for the
  # single-line title. Build the body from the raw editor output so deliberate
  # Markdown hard breaks, code indentation, and repeated blank lines survive.
  _title=""
  IFS= read -r _title <"$_cleanup_file_two" || true
  [[ -n "$_title" ]] || gt_die "edited PR title is empty; submission cancelled"
  sed -e '1d' -e '2{/^[[:space:]]*$/d;}' \
    "$_cleanup_file" >"$_cleanup_file_two" ||
    gt_die "could not separate the edited PR title and body"
  _body_file=$_cleanup_file_two
fi

# Query capability before refs move. GitHub may preserve the repository setting
# on a private repository even when the owner's plan cannot use that feature.
# REST exposes the setting and visibility together; `gh repo view` does not
# expose auto-merge in its supported structured fields.
_repo_slug=${GT_CURRENT_REPO_IDENTITY#*/}
_auto_merge_record=$(
  GH_HOST="$GT_CURRENT_REPO_HOST" gh api \
    --hostname "$GT_CURRENT_REPO_HOST" "repos/$_repo_slug" \
    --jq '[.allow_auto_merge,.visibility] | @tsv'
) || gt_die "could not inspect repository auto-merge capability"
IFS=$'\t' read -r _auto_merge_setting _repo_visibility _extra \
  <<<"$_auto_merge_record"
[[ -n "$_auto_merge_setting" && -n "$_repo_visibility" && -z "$_extra" &&
  "$_auto_merge_record" != *$'\n'* ]] ||
  gt_die "repository returned an invalid auto-merge capability"
case "$_auto_merge_setting" in
  true | false) ;;
  *) gt_die "repository returned an invalid auto-merge capability" ;;
esac
case "$_repo_visibility" in
  public | private | internal) ;;
  *) gt_die "repository returned an invalid visibility" ;;
esac
_auto_merge_allowed=false
if [[ "$_auto_merge_setting" == true && "$_repo_visibility" == public ]]; then
  _auto_merge_allowed=true
fi

# The submitted head makes the generated name deterministic and retry-visible.
# Refuse an existing name instead of guessing whether it belongs to a partial
# run, another worktree, or a short-OID collision with different GitHub state.
_short_oid=$(git rev-parse --short=12 "$_head_oid") ||
  gt_die "could not abbreviate the current commit"
_feature_branch="pr/$_short_oid"
_feature_status=0
gt_find_ref_commit "refs/heads/$_feature_branch" || _feature_status=$?
case "$_feature_status" in
  0) gt_die "generated feature branch already exists: $_feature_branch" ;;
  1) ;;
  *) gt_die "could not inspect generated feature branch: $_feature_branch" ;;
esac

# Create the preservation ref first and verify both symbolic HEAD and its OID.
# Only then move main back with an expected-old value; a concurrent ref update
# makes update-ref fail rather than discarding somebody else's commit.
git switch --quiet --create "$_feature_branch" "$_head_oid" ||
  gt_die "could not create generated feature branch: $_feature_branch"
[[ "$(gt_current_branch)" == "$_feature_branch" ]] ||
  gt_die "generated feature branch was created but is not checked out"
[[ "$(git rev-parse --verify 'HEAD^{commit}')" == "$_head_oid" ]] ||
  gt_die "generated feature branch does not preserve the submitted commit"
gt_require_clean_worktree

git update-ref "refs/heads/$_base" "$_base_oid" "$_head_oid" ||
  gt_die "feature branch is preserved, but local $_base could not be restored"

# Reuse git-pr-open rather than duplicating its transport and topology checks.
# From this point onward, every failure diagnostic names the durable branch or
# PR that the user can inspect and resume manually.
_pr_url=$("$_root/bin/git-pr-open" \
  --title "$_title" --body-file "$_body_file" --base "$_base" \
  --expect-head "$_head_oid" --expect-repo "$GT_CURRENT_REPO_IDENTITY") ||
  gt_die "commit is preserved on $_feature_branch, but the pull request could not be created"

_merge_status=0
if [[ "$_auto_merge_allowed" == true ]]; then
  # The head lease prevents a PR update between creation and the merge request
  # from silently broadening what will land. Omitting --admin is intentional:
  # GitHub must continue enforcing every required check and review.
  gt_gh_pr merge "$_pr_url" --auto --squash \
    --match-head-commit "$_head_oid" || _merge_status=$?
fi

# Return to the familiar default-branch workspace even when auto-merge cannot
# be queued. Print the URL before reporting a later failure so the successfully
# created server-side object is never hidden by local checkout recovery. A
# successful switch exit is not enough: checkout hooks and concurrent Git
# processes can still move the ref, so verify both the symbolic branch and the
# exact fetched OID before declaring the local recovery complete.
_switch_error=""
if ! git switch --quiet "$_base"; then
  _switch_error="the checkout could not return to $_base"
else
  _returned_branch=$(git symbolic-ref -q --short HEAD 2>/dev/null) ||
    _returned_branch=""
  _returned_oid=$(git rev-parse --verify 'HEAD^{commit}' 2>/dev/null) ||
    _returned_oid=""
  if [[ "$_returned_branch" != "$_base" ]]; then
    _switch_error="the checkout did not remain on $_base"
  elif [[ "$_returned_oid" != "$_base_oid" ]]; then
    _switch_error="the checkout returned to $_base at an unexpected commit"
  fi
fi
printf '%s\n' "$_pr_url"

[[ -z "$_switch_error" ]] ||
  gt_die "pull request was created, but $_switch_error"
if [[ "$_auto_merge_allowed" == false ]]; then
  gt_say "pull request created; repository auto-merge is unavailable, so land it manually"
elif [[ "$_merge_status" != 0 ]]; then
  gt_die "pull request was created, but protected auto-merge could not be queued"
fi
