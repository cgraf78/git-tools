#!/usr/bin/env bash
# Restack every PR in a linear stack without merging anything.

set -euo pipefail

# shellcheck disable=SC2034 # consumed by lib/git-tools-pr.sh after dynamic source
gt_command="git pr-sync-stack"

# BEGIN GENERATED LAUNCHER BOOTSTRAP
# Generated by support/sync-launcher-bootstrap; edit the template, not launcher copies.
_script_path="${BASH_SOURCE[0]}"
while [[ -L "$_script_path" ]]; do
  _script_dir=$(cd -P -- "$(dirname -- "$_script_path")" && pwd)
  _link=$(readlink "$_script_path")
  case "$_link" in
    /*) _script_path="$_link" ;;
    *) _script_path="$_script_dir/$_link" ;;
  esac
done
_root=$(cd -P -- "$(dirname -- "$_script_path")/.." && pwd)
# END GENERATED LAUNCHER BOOTSTRAP
# shellcheck disable=SC1091
. "$_root/lib/git-tools-pr.sh"

_usage() {
  cat <<'EOF'
Usage: git pr-sync-stack [options] [<number|url|branch>]

Restack every pull request in a linear stack, parent-to-child, without merging
anything. Without a target, uses the PR for the current branch.

Options:
  -b, --base <branch>   Rebase the root PR onto this base branch.
      --no-push         Rebase locally without pushing or editing PR bases.
  -n, --dry-run         Print actions without changing anything.
  -h, --help            Show this help.

Exit status:
  0  Stack was synced.
  1  Stack discovery or restack failed.
  2  Usage or local environment error.
EOF
}

_target=""
_base_override=""
_push=1
_dry_run=0

while (($#)); do
  case "$1" in
    -b | --base)
      _opt="$1"
      shift
      (($#)) || gt_usage_error "$_opt requires a value"
      _base_override="$1"
      shift
      ;;
    --base=*)
      _base_override="${1#--base=}"
      [[ -n "$_base_override" ]] || gt_usage_error "--base requires a value"
      shift
      ;;
    --no-push)
      _push=0
      shift
      ;;
    -n | --dry-run)
      _dry_run=1
      shift
      ;;
    -h | --help)
      _usage
      exit 0
      ;;
    --)
      shift
      (($# <= 1)) || gt_usage_error "expected at most one target"
      _target="${1:-}"
      break
      ;;
    -*)
      gt_usage_error "unexpected option: $1"
      ;;
    *)
      [[ -z "$_target" ]] || gt_usage_error "expected at most one target"
      _target="$1"
      shift
      ;;
  esac
done

_run() {
  if [[ "$_dry_run" == 1 ]]; then
    printf 'git pr-sync-stack: would run:' >&2
    printf ' %q' "$@" >&2
    printf '\n' >&2
  fi
  "$@"
}

_restack() {
  local number="$1"
  local url="$2"
  local base="$3"
  local fork="$4"
  local expected_topology="$5"
  local base_oid="$6"
  local -a args=(git pr-restack "$url" --base "$base")

  [[ -z "$base_oid" ]] || args+=(--base-oid "$base_oid")
  [[ -z "$fork" ]] || args+=(--fork "$fork")
  [[ "$_push" == 1 ]] || args+=(--no-push)
  [[ "$_dry_run" == 0 ]] || args+=(--dry-run)
  args+=(--expect-topology "$expected_topology")

  gt_say "restacking PR #$number onto $base"
  _run "${args[@]}"
}

_refresh_local_restacked_oid() {
  local index="$1" local_oid

  local_oid=$(git rev-parse --verify \
    "refs/heads/${_heads[$index]}^{commit}") ||
    gt_die "could not read local head for PR #${_numbers[$index]} after restack"
  _expected_head_oids[index]=$local_oid
}

_refresh_restacked_topology() {
  local index="$1" base="$2" local_oid view live_oid expected

  local_oid=$(git rev-parse --verify \
    "refs/heads/${_heads[$index]}^{commit}") ||
    gt_die "could not read local head for PR #${_numbers[$index]} after restack"
  view=$(gt_pr_view_tsv "${_urls[$index]}") ||
    gt_die "could not read PR #${_numbers[$index]} after restack"
  IFS=$'\t' read -r _ _ _ _ _ live_oid _ _ _ _ _ <<<"$view"
  expected=$(gt_pr_topology_tsv "${_numbers[$index]}" \
    "${_heads[$index]}" "$live_oid" "$base" "${_head_repos[$index]}" \
    "${_head_cross_repos[$index]}" "${_urls[$index]}") ||
    gt_die "could not validate restacked topology for PR #${_numbers[$index]}"
  gt_pr_record_matches_topology "$view" "$expected" ||
    gt_die "PR #${_numbers[$index]} topology changed after restack"
  [[ "$live_oid" == "$local_oid" ]] ||
    gt_die "PR #${_numbers[$index]} head OID does not match the restacked branch"
  _expected_head_oids[index]=$live_oid
  _bases[index]=$base
}

_stack_topology() {
  local index="$1" normalized_head_repo

  normalized_head_repo=$(gt_github_name_with_owner \
    "${_head_repos[$index]}") || return 1
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "${_numbers[$index]}" "${_heads[$index]}" "${_expected_head_oids[$index]}" \
    "${_bases[$index]}" \
    "$normalized_head_repo" "${_head_cross_repos[$index]}" \
    "${_urls[$index]}"
}

gt_require_repo
gt_require_gh

_stack_args=(git pr-stack --porcelain=v2)
[[ -z "$_target" ]] || _stack_args+=("$_target")

_stack_output=$("${_stack_args[@]}") || gt_die "could not read pull request stack"

_numbers=()
_bases=()
_heads=()
_original_head_oids=()
_expected_head_oids=()
_urls=()
_head_repos=()
_head_cross_repos=()

while IFS=$'\t' read -r _kind _index _number _base _head _ready _reason _checks \
  _url _head_oid _head_repo _head_cross_repo; do
  [[ "$_kind" == "pr" ]] || continue
  _numbers+=("$_number")
  _bases+=("$_base")
  _heads+=("$_head")
  _original_head_oids+=("$_head_oid")
  _expected_head_oids+=("$_head_oid")
  _urls+=("$_url")
  _head_repos+=("$_head_repo")
  _head_cross_repos+=("$_head_cross_repo")
done <<<"$_stack_output"

((${#_numbers[@]} > 0)) || gt_die "no pull requests found in stack"

_index=0
while ((_index < ${#_numbers[@]})); do
  if ((_index == 0)); then
    _base="${_base_override:-${_bases[$_index]}}"
  else
    _base="${_heads[$((_index - 1))]}"
  fi
  _fork=""
  _base_oid=""
  if ((_index > 0)); then
    _fork="oid:${_original_head_oids[$((_index - 1))]}"
    if [[ "$_push" == 0 ]]; then
      _base_oid=${_expected_head_oids[$((_index - 1))]}
    fi
  fi

  _expected_topology=$(_stack_topology "$_index") ||
    gt_die "could not validate expected topology for PR #${_numbers[$_index]}"
  _restack "${_numbers[$_index]}" "${_urls[$_index]}" "$_base" \
    "$_fork" "$_expected_topology" "$_base_oid"
  if [[ "$_push" == 1 && "$_dry_run" == 0 ]]; then
    _refresh_restacked_topology "$_index" "$_base"
  elif [[ "$_push" == 0 && "$_dry_run" == 0 ]]; then
    _refresh_local_restacked_oid "$_index"
  fi
  _index=$((_index + 1))
done

gt_say "synced ${#_numbers[@]} PR(s)"
