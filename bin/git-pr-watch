#!/usr/bin/env bash
# Report whether GitHub pull requests are green, merged, or need action.

set -euo pipefail

# shellcheck disable=SC2034 # consumed by lib/git-tools-pr.sh after dynamic source
gt_command="git pr-watch"

# BEGIN GENERATED LAUNCHER BOOTSTRAP
# Generated by support/sync-launcher-bootstrap; edit the template, not launcher copies.
_script_path="${BASH_SOURCE[0]}"
while [[ -L "$_script_path" ]]; do
  _script_dir=$(cd -P -- "$(dirname -- "$_script_path")" && pwd)
  _link=$(readlink "$_script_path")
  case "$_link" in
    /*) _script_path="$_link" ;;
    *) _script_path="$_script_dir/$_link" ;;
  esac
done
_root=$(cd -P -- "$(dirname -- "$_script_path")/.." && pwd)
# END GENERATED LAUNCHER BOOTSTRAP
# shellcheck disable=SC1091
. "$_root/lib/git-tools-pr.sh"
# shellcheck disable=SC1091
. "$_root/lib/git-tools-pr-snapshot.sh"

_usage() {
  cat <<'EOF'
Usage: git pr-watch [options] [<number|url|branch> ...]

Report whether GitHub pull requests are green, merged, or need action.
Without a target, uses the pull request for the current branch. Every target
must belong to the current checkout's repository; at most 20 per run.

Options:
  -w, --wait            Keep checking until a pull request needs action, every
                        pull request is done, or the rest are stalled.
      --timeout <sec>   With --wait, stop after this long (default: 6 hours,
                        or GIT_PR_WATCH_MAX_SECONDS).
      --interval <sec>  With --wait, seconds between checks (default: 60,
                        at least 15).
  -h, --help            Show this help.

Exit status:
  0  Every pull request is done (checks green, or merged).
  1  A pull request needs action (failed or cancelled check, merge conflict,
     closed, behind its base while auto-merge waits, or auto-merge turned
     off).
  2  Usage, not found, authentication, environment, or internal error.
  3  GitHub could not be read (transient failures or rate limit).
  8  Still pending, or waiting on something outside the pull request.
EOF
}

# --- constants ---------------------------------------------------------------

# A failure in a finished check run is reported only once it has stood this
# long, measured on GitHub's clock from the check's completion. Repositories can
# re-run failed workflows automatically, and a concurrency group can cancel a
# run that a newer run replaces; both resolve within this window.
_confirm_window=150
# Seconds after a push during which a different head on GitHub is treated as
# GitHub catching up rather than as the head to judge.
_push_grace=60
# Attempts per call for transient failures within one check. A one-shot run
# reports a rate limit (exit 3); a waiting run sleeps until it lifts.
_call_attempts=3
# A waiting run past grace windows (since the watch started, or since the
# pull request's head last changed) calls a still-unsettled state a stall.
_head_grace=300
_no_checks_grace=300
_merge_grace=600
# Consecutive checks a BLOCKED merge state or a dropped auto-merge must hold
# before it is reported, so one stale read cannot decide it.
_confirm_checks=2
_interval=60
_min_interval=15
_jitter_max=10
# Per-call time limit for a waiting run, clamped to the time left, with a floor
# so the last call before the deadline still has a chance to answer.
_call_timeout=60
_call_floor=10
# Consecutive checks that could not be read (other than rate limits) before a
# waiting run gives up with exit 3.
_failed_check_limit=10
# Default cap on a waiting run: GitHub-hosted jobs run at most six hours.
_cap_default=21600
_max_targets=20
_max_check_lines=10
# GraphQL Int is 32-bit signed; a larger number is never a pull request.
_max_number=2147483647

# --- exit discipline -----------------------------------------------------------

_targets=()
_numbers=()
_result_done=0
_fail_reason=internal
# Set by _state_init once state files are in use (see "state files" below).
_state_dir=""

_csv() {
  local IFS=,
  printf '%s' "$*"
}

# Every exit prints one final `result:` line. Paths that reach the end of the
# script record their status first; anything else (an unexpected errexit or an
# unbound variable) reports an internal error with exit 2, never the "needs
# action" status 1 that errexit would otherwise leak.
# shellcheck disable=SC2329 # invoked by the EXIT trap
_on_exit() {
  local status=$?

  # The exit is decided; a signal now must not report a second result or cut
  # the state files short. What is left is bounded and makes no network call.
  trap '' INT TERM HUP PIPE
  set +e
  [[ -z "${GT_PR_SNAPSHOT_TMP:-}" ]] || rm -rf -- "$GT_PR_SNAPSHOT_TMP"
  [[ "$_result_done" == 1 ]] || status=2
  [[ -z "$_state_dir" ]] || _state_finish "$status"
  [[ "$_result_done" != 1 ]] || return 0
  _result_done=1
  printf 'result: 2 reason=%s prs=%s\n' "$_fail_reason" \
    "$(_csv ${_numbers[@]+"${_numbers[@]}"})"
  exit 2
}

# shellcheck disable=SC2329 # invoked by signal traps
_on_signal() {
  local pids

  # PIPE too: with the output's reader gone, printing the result line would
  # otherwise kill the shell with SIGPIPE, losing the signal's exit status
  # (and the one the exit records carry).
  trap '' INT TERM HUP PIPE
  # A failed write (EPIPE) must not end the handler early under errexit.
  set +e
  # Background jobs: a gh call, its watchdog, or the sleep between checks.
  pids=$(jobs -p 2>/dev/null) || pids=""
  # shellcheck disable=SC2086 # one pid per word
  [[ -z "$pids" ]] || kill -TERM $pids 2>/dev/null || true
  [[ -z "${GT_PR_SNAPSHOT_TMP:-}" ]] || rm -rf -- "$GT_PR_SNAPSHOT_TMP"
  # The EXIT trap still runs after `exit` below and finishes the state files.
  _result_done=1
  printf 'result: %s reason=signal prs=%s\n' "$1" \
    "$(_csv ${_numbers[@]+"${_numbers[@]}"})"
  exit "$1"
}

trap _on_exit EXIT
trap '_on_signal 130' INT
trap '_on_signal 143' TERM
trap '_on_signal 129' HUP

# @brief Report an error and exit 2 with a machine-readable reason.
_fail() {
  _fail_reason=$1
  shift
  printf '%s: %s\n' "$gt_command" "$*" >&2
  exit 2
}

# @brief Report that GitHub could not be read and exit 3.
# A `next:` line is printed only once every target is resolved: a partial list
# would stop watching the targets not resolved yet.
_resolved_all=0
_unreadable_exit() {
  # The exit is decided: a reader that has gone away must not turn it into a
  # SIGPIPE death, nor a failed write an errexit one (see _on_signal).
  trap '' PIPE
  set +e
  _result_done=1
  printf '%s: %s\n' "$gt_command" "$2" >&2
  [[ "$_resolved_all" != 1 ]] || ((${#_numbers[@]} == 0)) ||
    printf 'next: git pr-watch --wait %s\n' "${_numbers[*]}"
  printf 'result: 3 reason=%s prs=%s\n' "$1" \
    "$(_csv ${_numbers[@]+"${_numbers[@]}"})"
  exit 3
}

# The shared library exits 1 from these helpers; this command reserves 1 for
# "a pull request needs action", so environment and usage problems exit 2.
gt_usage_error() {
  _fail usage "$@"
}

# shellcheck disable=SC2329 # called by lib/git-tools-pr.sh helpers
gt_die() {
  _fail environment "$@"
}

# --- clock -------------------------------------------------------------------

# GIT_TOOLS_TEST_PR_WATCH_CLOCK names a test clock file (test-only): when it
# exists, _now reads it and _pause advances it instead of sleeping.
_test_clock() {
  local clock=${GIT_TOOLS_TEST_PR_WATCH_CLOCK:-} now

  [[ -n "$clock" && -f "$clock" ]] || return 1
  read -r now <"$clock" || now=""
  [[ "$now" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$now"
}

_now() {
  _test_clock || date +%s
}

_pause() {
  local now

  if now=$(_test_clock); then
    printf '%s\n' $((now + $1)) >"$GIT_TOOLS_TEST_PR_WATCH_CLOCK"
    return 0
  fi
  sleep "$1"
}

# --- arguments and environment ----------------------------------------------

_wait=0
_timeout=""
_interval_set=0

# @brief Validate a seconds value for an option.
_seconds_arg() {
  [[ "$2" =~ ^[0-9]{1,9}$ ]] || gt_usage_error "$1 must be a number of seconds"
}

while (($#)); do
  case "$1" in
    -h | --help)
      _result_done=1
      _usage
      exit 0
      ;;
    -w | --wait)
      _wait=1
      shift
      ;;
    --timeout | --interval)
      (($# > 1)) || gt_usage_error "$1 requires a value"
      _seconds_arg "$1" "$2"
      if [[ "$1" == --timeout ]]; then _timeout=$2; else _interval=$2 _interval_set=1; fi
      shift 2
      ;;
    --timeout=*)
      _timeout=${1#--timeout=}
      _seconds_arg --timeout "$_timeout"
      shift
      ;;
    --interval=*)
      _interval=${1#--interval=}
      _seconds_arg --interval "$_interval"
      _interval_set=1
      shift
      ;;
    --)
      shift
      _targets+=("$@")
      break
      ;;
    -*)
      gt_usage_error "unexpected option: $1"
      ;;
    *)
      _targets+=("$1")
      shift
      ;;
  esac
done

if [[ "$_wait" == 0 ]]; then
  [[ -z "$_timeout" && "$_interval_set" == 0 ]] ||
    gt_usage_error "--timeout and --interval need --wait"
fi
((10#$_interval >= _min_interval)) ||
  gt_usage_error "--interval must be at least $_min_interval seconds"
_interval=$((10#$_interval))
_cap=$_cap_default
if [[ -n "${GIT_PR_WATCH_MAX_SECONDS:-}" ]]; then
  if [[ "$GIT_PR_WATCH_MAX_SECONDS" =~ ^[1-9][0-9]{0,8}$ ]]; then
    _cap=$GIT_PR_WATCH_MAX_SECONDS
  else
    printf '%s: ignoring GIT_PR_WATCH_MAX_SECONDS=%s (not a number of seconds)\n' \
      "$gt_command" "$GIT_PR_WATCH_MAX_SECONDS" >&2
  fi
fi
[[ -z "$_timeout" ]] || ((10#$_timeout >= _cap)) || _cap=$((10#$_timeout))
_state_enabled=1
case "${GIT_PR_WATCH_STATE:-}" in
  0) _state_enabled=0 ;;
  "" | 1) ;;
  *)
    printf '%s: ignoring GIT_PR_WATCH_STATE=%s (0 turns state files off)\n' \
      "$gt_command" "$GIT_PR_WATCH_STATE" >&2
    ;;
esac

git rev-parse --git-dir >/dev/null 2>&1 ||
  _fail environment "not inside a git repository"
# Checked before the gh function below exists, since it would satisfy any
# lookup by name.
type -P gh >/dev/null 2>&1 ||
  _fail environment "gh is not installed or not on PATH"

# Every gh call made by this command or by the shared library runs with forced
# color and debug output scrubbed (see gt_pr_gh).
# shellcheck disable=SC2329 # called by lib/git-tools-pr.sh helpers
gh() {
  gt_pr_gh "$@"
}

# This command only reads, so it may use the cached repository identity: most
# runs then make no network call before the query itself, which classifies
# authentication and single sign-on failures on its own.
_toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || _toplevel=""
if [[ -n "$_toplevel" ]]; then
  gt_load_current_repo_identity_cached "$_toplevel" 2>/dev/null ||
    _fail environment "could not resolve the current GitHub repository"
else
  gt_load_current_repo_identity 2>/dev/null ||
    _fail environment "could not resolve the current GitHub repository"
fi

# @brief Stop on a response class that retrying cannot fix.
_fail_on_class() {
  case "$GT_PR_RESPONSE_CLASS" in
    auth) _fail auth "gh is not authenticated, or GitHub rejected its credentials" ;;
    sso) _fail sso "GitHub requires single sign-on authorization for this token" ;;
    error) _fail graphql "GitHub refused the query: ${GT_PR_RESPONSE_MESSAGE:-no message}" ;;
  esac
}

# --- targets -----------------------------------------------------------------

# @brief Resolve a head branch to its pull request number into _resolved.
# Sets a global rather than printing so its failures exit this shell instead
# of a command substitution.
_resolve_branch() {
  local branch="$1" attempt

  for ((attempt = 1; attempt <= _call_attempts; attempt++)); do
    gt_pr_snapshot_argv "$(gt_pr_branch_query)" "$GT_PR_BRANCH_JQ" \
      -f "head=$branch"
    _set_call_timeout
    gt_pr_snapshot_call ||
      _fail environment "could not create a temporary file"
    _fail_on_class
    case "$GT_PR_RESPONSE_CLASS" in
      ok)
        case "$GT_PR_RESPONSE_BODY" in
          "") _fail not-found "no pull request for branch: $branch" ;;
          ambiguous) gt_usage_error "more than one open pull request for branch: $branch" ;;
        esac
        [[ "$GT_PR_RESPONSE_BODY" =~ ^[1-9][0-9]*$ ]] ||
          _fail internal "unexpected pull request number for branch: $branch"
        _resolved=$GT_PR_RESPONSE_BODY
        return 0
        ;;
      not-found) _fail not-found "repository not found: $GT_CURRENT_REPO_SPEC" ;;
      rate-limited)
        # A waiting run waits a rate limit out here too (it does not count as
        # an attempt); a one-shot run, or one out of time, reports it.
        if [[ "$_wait" == 1 ]] && (($(_now) < _deadline)); then
          _rate_reset=$GT_PR_RESPONSE_RESET
          _rate_date=$GT_PR_RESPONSE_DATE
          _sleep_until_next "$(_rate_wait)"
          attempt=$((attempt - 1))
          continue
        fi
        _unreadable_exit rate-limited "GitHub rate limit reached"
        ;;
    esac
    ((attempt == _call_attempts)) || _pause "$attempt"
  done
  _unreadable_exit transient "could not reach GitHub to resolve branch: $branch"
}

_add_number() {
  local number="$1" existing

  ((${#number} <= 10 && 10#$number <= _max_number)) ||
    gt_usage_error "not a pull request number: $number"
  for existing in ${_numbers[@]+"${_numbers[@]}"}; do
    [[ "$existing" != "$number" ]] || return 0
  done
  _numbers+=("$number")
}

_resolve_targets() {
  local target status

  if ((${#_targets[@]} == 0)); then
    target=$(git symbolic-ref -q --short HEAD 2>/dev/null) ||
      gt_usage_error "detached HEAD; pass a pull request number"
    _targets=("$target")
  fi
  for target in "${_targets[@]}"; do
    case "$target" in
      http://* | https://*)
        status=0
        gt_validate_pr_target_repository "$target" || status=$?
        case "$status" in
          0) ;;
          1) gt_usage_error "target pull request belongs to a different repository: $target" ;;
          *) _fail environment "could not resolve the current GitHub repository" ;;
        esac
        gt_parse_pr_url "$target" || gt_usage_error "not a pull request URL: $target"
        _add_number "$GT_PR_URL_NUMBER"
        ;;
      *)
        if [[ "$target" =~ ^[1-9][0-9]*$ ]]; then
          _add_number "$target"
        elif git check-ref-format "refs/heads/$target" >/dev/null 2>&1; then
          _resolve_branch "$target"
          _add_number "$_resolved"
        else
          gt_usage_error "not a pull request number, URL, or branch: $target"
        fi
        ;;
    esac
  done
  ((${#_numbers[@]} <= _max_targets)) ||
    gt_usage_error "at most $_max_targets pull requests per run"
  _resolved_all=1
}

# --- snapshot ----------------------------------------------------------------

# Snapshot facts, indexed in target order. Bash 3.2 has no associative arrays,
# so per-PR fields live in parallel arrays and lookups scan the short list.
_reset_tick() {
  _pr_seen=()
  _pr_state=()
  _pr_mergeable=()
  _pr_mss=()
  _pr_review=()
  _pr_head=()
  _pr_headmatch=()
  _pr_cross=()
  _pr_am=()
  _pr_checks=()
  _pr_zero=()
  _pr_ref=()
  _chk_pr=()
  _chk_class=()
  _chk_running=()
  _chk_req=()
  _chk_kind=()
  _chk_id=()
  _chk_done=()
  _chk_name=()
  _suite_pr=()
  _suite_conclusion=()
  _suite_workflow=()
  _server_now=""
  _read_upto=0
  _snapshot_class=ok
}

_index_of() {
  local number="$1" i

  for ((i = 0; i < ${#_numbers[@]}; i++)); do
    if [[ "${_numbers[$i]}" == "$number" ]]; then
      _index=$i
      return 0
    fi
  done
  return 1
}

# @brief Store one failing-check record after validating every field.
# The free-text name is split off at the first ` name=`: every field before it
# is a validated token that cannot contain that text, while a check name (which
# a pull request author controls) can.
_store_check() {
  local index="$1" line="$2" head tok key value
  local class="" running="" req="" kind="" id="" completed=""
  local -a toks=()

  head=${line%% name=*}
  read -r -a toks <<<"$head"
  for tok in "${toks[@]:2}"; do
    key=${tok%%=*}
    value=${tok#*=}
    case "$key" in
      class) class=$value ;;
      running) running=$value ;;
      req) req=$value ;;
      kind) kind=$value ;;
      id) id=$value ;;
      done) completed=$value ;;
    esac
  done
  [[ "$class" == fail || "$class" == cancel ]] || return 0
  [[ "$running" == y || "$running" == n || "$running" == - ]] || return 0
  [[ "$req" == yes || "$req" == no ]] || return 0
  [[ "$kind" == actions || "$kind" == app || "$kind" == status ]] || return 0
  [[ "$id" =~ ^[0-9]+$ || "$id" == - ]] || return 0
  [[ "$completed" == - || "$completed" =~ ^[0-9T:.Z-]+$ ]] || return 0
  _chk_pr+=("$index")
  _chk_class+=("$class")
  _chk_running+=("$running")
  _chk_req+=("$req")
  _chk_kind+=("$kind")
  _chk_id+=("$id")
  _chk_done+=("$completed")
  _chk_name+=("${line#* name=}")
}

_store_suite() {
  local index="$1" line="$2" head conclusion

  head=${line%% workflow=*}
  conclusion=${head##* conclusion=}
  [[ "$conclusion" =~ ^[A-Z_]+$ ]] || return 0
  _suite_pr+=("$index")
  _suite_conclusion+=("$conclusion")
  _suite_workflow+=("${line#* workflow=}")
}

# @brief Store one chunk's classifier output.
# Record aliases are per chunk (p00, p01, ...), so each is mapped back to the
# number it was queried for.
_store_records() {
  local body="$1" line kind alias pos tok key value
  local -a queried=() toks=()
  shift
  queried=("$@")

  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    kind=${line%% *}
    alias=${line#* }
    alias=${alias%% *}
    [[ "$alias" =~ ^p([0-9]{2})$ ]] || continue
    pos=$((10#${BASH_REMATCH[1]}))
    ((pos < ${#queried[@]})) || continue
    _index_of "${queried[$pos]}" || continue
    case "$kind" in
      pr)
        read -r -a toks <<<"$line"
        # The record must describe the pull request this alias asked for.
        [[ " ${toks[*]:2} " == *" num=${queried[$pos]} "* ]] || continue
        _pr_seen[_index]=1
        for tok in "${toks[@]:2}"; do
          key=${tok%%=*}
          value=${tok#*=}
          case "$key" in
            state) _pr_state[_index]=$value ;;
            mergeable) _pr_mergeable[_index]=$value ;;
            mss) _pr_mss[_index]=$value ;;
            review) _pr_review[_index]=$value ;;
            head) _pr_head[_index]=$value ;;
            headmatch) _pr_headmatch[_index]=$value ;;
            cross) _pr_cross[_index]=$value ;;
            am) _pr_am[_index]=$value ;;
            checks) _pr_checks[_index]=$value ;;
            zero) _pr_zero[_index]=$value ;;
            ref) _pr_ref[_index]=$value ;;
          esac
        done
        ;;
      chk) _store_check "$_index" "$line" ;;
      suite) _store_suite "$_index" "$line" ;;
    esac
  done <<<"$body"
}

# Pull requests per query. It starts at the library's chunk size and only
# shrinks: a size GitHub timed out on once is not tried again in this run.
_chunk=$GT_PR_SNAPSHOT_CHUNK
# Cleared once GitHub refuses this token the repository's checks; later
# queries in the run then read pull request fields only, and _judge stalls
# every pull request that is neither merged nor closed.
_checks_readable=1

# @brief Set the per-call time limit for a waiting run.
# GT_PR_CALL_TIMEOUT is read by gt_pr_snapshot_call in the shared library.
# The limit is clamped to the time left before the deadline, with a floor so
# the last call still has a chance to answer. A one-shot run sets none.
# GIT_TOOLS_TEST_PR_WATCH_CALL_TIMEOUT (test-only) sets the limit directly.
# shellcheck disable=SC2034 # GT_PR_CALL_TIMEOUT is read by the library
_set_call_timeout() {
  local left

  if [[ "$_wait" == 0 ]]; then
    GT_PR_CALL_TIMEOUT=0
    return
  fi
  if [[ "${GIT_TOOLS_TEST_PR_WATCH_CALL_TIMEOUT:-}" =~ ^[1-9][0-9]*$ ]]; then
    GT_PR_CALL_TIMEOUT=$GIT_TOOLS_TEST_PR_WATCH_CALL_TIMEOUT
    return
  fi
  left=$((_deadline - $(_now)))
  ((left <= _call_timeout)) || left=$_call_timeout
  ((left >= _call_floor)) || left=$_call_floor
  GT_PR_CALL_TIMEOUT=$left
}

# @brief Snapshot every target, halving a chunk whenever GitHub times out.
# Stops at the first chunk that cannot be read and records why in
# _snapshot_class; _read_upto marks how many targets were read before it.
_snapshot_all() {
  local count attempt=0 alias
  local -a slice=() missing=()

  while ((_read_upto < ${#_numbers[@]})); do
    count=$((${#_numbers[@]} - _read_upto))
    ((count <= _chunk)) || count=$_chunk
    slice=("${_numbers[@]:_read_upto:count}")
    _set_call_timeout
    # shellcheck disable=SC2034 # read by the library's query builder
    GT_PR_SNAPSHOT_CHECKS=$_checks_readable
    gt_pr_snapshot "$GT_PR_CHECKS_JQ" "${slice[@]}" ||
      _fail environment "could not create a temporary file"
    _fail_on_class
    case "$GT_PR_RESPONSE_CLASS" in
      ok)
        _store_records "$GT_PR_RESPONSE_BODY" "${slice[@]}"
        [[ -z "$GT_PR_RESPONSE_DATE" ]] || _server_now=$GT_PR_RESPONSE_DATE
        _read_upto=$((_read_upto + count))
        attempt=0
        continue
        ;;
      not-found)
        missing=()
        while IFS= read -r alias; do
          [[ "$alias" =~ ^p([0-9]{2})$ ]] || continue
          missing+=("${slice[$((10#${BASH_REMATCH[1]}))]}")
        done < <(gt_pr_not_found_aliases "$GT_PR_RESPONSE_BODY")
        ((${#missing[@]} > 0)) ||
          _fail not-found "repository not found: $GT_CURRENT_REPO_SPEC"
        _fail not-found "pull request not found: $(_csv "${missing[@]}")"
        ;;
      checks-forbidden)
        # A query without checks cannot be refused its checks; failing here
        # keeps a misclassification from looping.
        [[ "$_checks_readable" == 1 ]] ||
          _fail graphql "GitHub refused the query: ${GT_PR_RESPONSE_MESSAGE:-no message}"
        _checks_readable=0
        printf '%s: checks unreadable with this token (%s); judging pull requests by state only\n' \
          "$gt_command" "${GT_PR_RESPONSE_MESSAGE:-no message}" >&2
        continue
        ;;
      rate-limited)
        _snapshot_class=rate-limited
        _rate_reset=$GT_PR_RESPONSE_RESET
        _rate_date=$GT_PR_RESPONSE_DATE
        return 0
        ;;
      timeout)
        # Query time grows with the checks returned; split until it fits.
        if ((count > 1)); then
          _chunk=$(((count + 1) / 2))
          continue
        fi
        ;;
    esac
    attempt=$((attempt + 1))
    if ((attempt >= _call_attempts)); then
      _snapshot_class=transient
      [[ -z "$GT_PR_RESPONSE_MESSAGE" ]] ||
        printf '%s: %s\n' "$gt_command" "$GT_PR_RESPONSE_MESSAGE" >&2
      return 0
    fi
    _pause "$attempt"
  done
}

# --- judgment ----------------------------------------------------------------

_set() {
  _state[$1]=$2
  _reason[$1]=$3
}

# @brief Resolve, once per run, the remote that fetches this repository.
# The push-race check needs it when a branch has no push tracking (pushed with
# an explicit `git push <remote> <src>:<dst>`, say).
_fetch_remote_loaded=0
_fetch_remote=""
_load_fetch_remote() {
  [[ "$_fetch_remote_loaded" == 0 ]] || return 0
  _fetch_remote_loaded=1
  if gt_find_current_repo_fetch_remote 2>/dev/null; then
    _fetch_remote=$GT_REPO_FETCH_REMOTE
  fi
}

# @brief Whether GitHub is still catching up with a recent push of this branch.
# Right after `git push`, GitHub can report the previous head (and its checks)
# for a few seconds; judging it then would report an old result. The push
# updated the branch's remote-tracking ref, so a tracking ref that changed
# within the grace and differs from GitHub's head means the push has not landed
# on GitHub yet. That holds for force-pushes, where the old head is not an
# ancestor of the new one. Local commits that were never pushed leave the
# tracking ref alone and do not hold the watch.
_push_race() {
  local index="$1" ref tracking pushed entry updated name value

  ref=${_pr_ref[index]:--}
  [[ "$ref" != - && "${_pr_cross[index]:-}" == false ]] || return 1
  git check-ref-format "refs/heads/$ref" >/dev/null 2>&1 || return 1
  # %(push) names the remote-tracking ref a push of the local branch updates
  # (empty without a local branch or push configuration). for-each-ref also
  # matches by prefix (refs/heads/$ref/...), so keep only the exact branch.
  tracking=""
  while read -r name value; do
    [[ "$name" != "refs/heads/$ref" ]] || tracking=$value
  done < <(git for-each-ref --format='%(refname) %(push)' "refs/heads/$ref" 2>/dev/null)
  if [[ -z "$tracking" ]]; then
    _load_fetch_remote
    [[ -n "$_fetch_remote" ]] || return 1
    tracking="refs/remotes/$_fetch_remote/$ref"
  fi
  [[ "$tracking" == refs/remotes/* ]] || return 1
  pushed=$(git rev-parse -q --verify "$tracking^{commit}" 2>/dev/null) || return 1
  [[ "$pushed" != "${_pr_head[index]:-}" ]] || return 1
  entry=$(git reflog -1 --date=unix --format=%gd "$tracking" -- 2>/dev/null) || return 1
  [[ "$entry" =~ @\{([0-9]+)\}$ ]] || return 1
  updated=${BASH_REMATCH[1]}
  ((_check_now - updated <= _push_grace))
}

# First sighting, on GitHub's clock, of failing checks GitHub gave no
# completion time (a run cancelled before it started): the confirmation window
# runs from then instead. Keys are "<pull request number>:<check id>".
_first_seen_key=()
_first_seen_at=()

# @brief The server epoch when this failing check was first seen.
_first_seen() {
  local key="$1" i

  for ((i = 0; i < ${#_first_seen_key[@]}; i++)); do
    if [[ "${_first_seen_key[$i]}" == "$key" ]]; then
      printf '%s\n' "${_first_seen_at[$i]}"
      return
    fi
  done
  _first_seen_key+=("$key")
  _first_seen_at+=("$_server_now")
  printf '%s\n' "$_server_now"
}

# @brief Judge whether this PR's failures are final.
# Sets _confirmed to failed, cancelled, or empty while every failure is still
# inside the confirmation window. It sets a global rather than printing so the
# first-sighting record survives (a command substitution would discard it).
_confirmed_failure() {
  local index="$1" i epoch class result=""

  for ((i = 0; i < ${#_chk_pr[@]}; i++)); do
    [[ "${_chk_pr[$i]}" == "$index" ]] || continue
    class=${_chk_class[$i]}
    # A failure while earlier jobs of the same run are still going is final
    # now; cancellations always wait, since a newer run may replace them.
    if [[ "$class" == fail && "${_chk_running[$i]}" == y ]]; then
      result=failed
      break
    fi
    if [[ "${_chk_done[$i]}" == - ]]; then
      [[ "${_chk_id[$i]}" =~ ^[0-9]+$ ]] || continue
      _first_seen "${_numbers[$index]}:${_chk_id[$i]}" >/dev/null
      epoch=$(_first_seen "${_numbers[$index]}:${_chk_id[$i]}")
    else
      epoch=$(gt_iso_epoch "${_chk_done[$i]}" 2>/dev/null) || continue
    fi
    ((_server_now - epoch >= _confirm_window)) || continue
    # A confirmed failure outranks a confirmed cancellation.
    if [[ "$class" == fail ]]; then
      result=failed
      break
    fi
    result=cancelled
  done
  _confirmed=$result
}

# Judgment state that carries across checks, indexed like _numbers: when the
# pull request's current grace windows started (watch start, or its last head
# change), the head last seen, whether auto-merge has ever been seen enabled,
# consecutive-check counters, when it started waiting to merge, and the state
# last printed as progress.
_since=()
_last_head=()
_latched=()
_blocked_count=()
_amoff_count=()
_merge_since=()
_shown=()

# @brief Elapsed seconds since this pull request's grace windows started.
_elapsed() {
  printf '%s\n' $((_check_now - ${_since[$1]:-$_check_now}))
}

# @brief Start this pull request's grace windows over (watch start or a new
# head) and forget counters that only make sense for one head.
_restart() {
  _since[$1]=$_check_now
  _blocked_count[$1]=0
  _amoff_count[$1]=0
  _merge_since[$1]=""
}

# @brief Judge one pull request into a state and reason.
# A one-shot run is a single check at elapsed time zero, so anything that
# needs time to settle (a grace window, a second confirming check) reports as
# pending; a waiting run sees those windows pass.
_judge() {
  local index="$1" reason goal=green head prior_blocked prior_amoff prior_merge

  head=${_pr_head[index]:--}
  if [[ -z "${_since[index]:-}" ]]; then
    _restart "$index"
  elif [[ "$head" != - && -n "${_last_head[index]:-}" && "$head" != "${_last_head[index]}" ]]; then
    printf '[%s] pr=%s new head %s\n' "$(_clock_label)" "${_numbers[$index]}" "${head:0:12}" >&2
    _restart "$index"
  fi
  [[ "$head" == - ]] || _last_head[index]=$head
  [[ "${_pr_am[index]:-false}" != true ]] || _latched[index]=1
  # The confirmation counters and the merge wait count consecutive checks in
  # the same condition: every check starts them over unless its own path
  # carries them forward.
  prior_blocked=${_blocked_count[index]:-0}
  prior_amoff=${_amoff_count[index]:-0}
  prior_merge=${_merge_since[index]:-}
  _blocked_count[index]=0
  _amoff_count[index]=0
  _merge_since[index]=""

  case "${_pr_state[index]:-}" in
    MERGED)
      _set "$index" "done" merged
      return
      ;;
    CLOSED)
      _set "$index" action closed
      return
      ;;
  esac
  # A checks-free read has no head commit to match.
  if [[ "$_checks_readable" == 1 && "${_pr_headmatch[index]:-no}" != yes ]]; then
    if (($(_elapsed "$index") >= _head_grace)); then
      _set "$index" stall head-mismatch
    else
      _set "$index" pending head-settling
    fi
    return
  fi
  if _push_race "$index"; then
    _set "$index" pending push-grace
    return
  fi
  if [[ "${_pr_mergeable[index]:-}" == CONFLICTING ]]; then
    _set "$index" action conflict
    return
  fi
  # A conflict is a pull request field, so it is still reported above; the
  # judgments below all need the checks.
  if [[ "$_checks_readable" == 0 ]]; then
    _set "$index" stall checks-unreadable
    return
  fi
  if [[ "${_pr_zero[index]:-}" == fail ]]; then
    _set "$index" action failed
    return
  fi
  case "${_pr_checks[index]:-none}" in
    fail-running | fail-completed)
      _confirmed_failure "$index"
      if [[ -n "$_confirmed" ]]; then
        _set "$index" action "$_confirmed"
      else
        _set "$index" pending failure-confirming
      fi
      return
      ;;
    too-many)
      _set "$index" stall too-many-checks
      return
      ;;
    pending)
      _set "$index" pending checks-running
      return
      ;;
  esac
  # Waiting zero-run workflows override only green and "no checks", never a
  # failure judged above.
  case "${_pr_zero[index]:-}" in
    approval)
      _set "$index" stall approval-required
      return
      ;;
    pending)
      _set "$index" pending checks-running
      return
      ;;
  esac
  if [[ "${_pr_checks[index]:-none}" == none ]]; then
    if (($(_elapsed "$index") >= _no_checks_grace)); then
      _set "$index" stall no-checks
    else
      _set "$index" pending no-checks-grace
    fi
    return
  fi
  if [[ "${_pr_mergeable[index]:-}" != MERGEABLE ]]; then
    _set "$index" pending mergeable-unknown
    return
  fi
  # Once auto-merge has been seen enabled, done means merged. If it is then
  # off while the pull request is open (a push by someone without write
  # access disables it, for example), nothing will merge it.
  [[ "${_latched[index]:-}" != 1 ]] || goal=merged
  if [[ "$goal" == merged && "${_pr_am[index]:-false}" != true ]]; then
    _amoff_count[index]=$((prior_amoff + 1))
    if ((_amoff_count[index] >= _confirm_checks)); then
      _set "$index" action auto-merge-off
    else
      _set "$index" pending confirming
    fi
    return
  fi
  case "$goal:${_pr_mss[index]:-}" in
    merged:BEHIND)
      _set "$index" action behind
      ;;
    *:BLOCKED)
      case "${_pr_review[index]:-}" in
        REVIEW_REQUIRED) reason=review-required ;;
        CHANGES_REQUESTED) reason=changes-requested ;;
        *) reason="" ;;
      esac
      if [[ -z "$reason" ]]; then
        # BLOCKED with every check finished usually means a required check
        # never reported; it takes a second check to call that a stall.
        _blocked_count[index]=$((prior_blocked + 1))
        if ((_blocked_count[index] >= _confirm_checks)); then
          _set "$index" stall blocked
        else
          _set "$index" pending confirming
        fi
        return
      elif [[ "$goal" == green ]]; then
        _set "$index" "done" "$reason"
      else
        _set "$index" stall "$reason"
      fi
      ;;
    merged:*)
      _merge_since[index]=${prior_merge:-$_check_now}
      if ((_check_now - _merge_since[index] >= _merge_grace)); then
        _set "$index" stall merge-pending
      else
        _set "$index" pending merge-waiting
      fi
      ;;
    *)
      _set "$index" "done" green
      ;;
  esac
}

# @brief Judge every read target; targets past _read_upto were not read.
_judge_all() {
  local i

  _state=()
  _reason=()
  for ((i = 0; i < ${#_numbers[@]}; i++)); do
    if ((i >= _read_upto)); then
      _set "$i" pending unreadable
      continue
    fi
    [[ "${_pr_seen[i]:-}" == 1 ]] ||
      _fail internal "no snapshot returned for pull request ${_numbers[$i]}"
    _judge "$i"
  done
}

# --- report ------------------------------------------------------------------

# @brief A wall-clock label for progress lines.
_clock_label() {
  date +%H:%M:%S 2>/dev/null || printf '%s' "$_check_now"
}

# @brief Print a progress line for each pull request whose state changed.
_progress() {
  local i now_shown

  for ((i = 0; i < ${#_numbers[@]}; i++)); do
    now_shown="${_state[i]}/${_reason[i]}"
    [[ "${_shown[i]:-}" != "$now_shown" ]] || continue
    _shown[i]=$now_shown
    printf '[%s] pr=%s %s\n' "$(_clock_label)" "${_numbers[$i]}" "$now_shown" >&2
  done
}

_stall_hint() {
  case "$1" in
    approval-required) printf 'a workflow is waiting for a maintainer to approve it' ;;
    too-many-checks) printf 'more checks than one query can judge; inspect the pull request directly' ;;
    review-required) printf 'auto-merge is waiting for a required review' ;;
    changes-requested) printf 'auto-merge is waiting because a reviewer requested changes' ;;
    no-checks) printf 'no checks reported; confirm a workflow runs for this branch' ;;
    head-mismatch) printf "GitHub's checks are for a different commit than the pull request head" ;;
    blocked) printf 'merge is blocked with every check finished; a required check may never have reported' ;;
    merge-pending) printf 'auto-merge is enabled and the pull request is mergeable but has not merged' ;;
    checks-unreadable) printf "this token cannot read the repository's checks; watch them another way, or grant check read access" ;;
  esac
}

# The flag the log command needs from this gh, with a trailing space, or
# empty; set by _log_flag_load.
_log_flag=""
_log_flag_loaded=0

# @brief Read once whether this gh needs --allow-escape-sequences for logs.
# From 2.97.0, `gh api` refuses to print a body holding escape sequences
# unless given --allow-escape-sequences; older gh has no such flag and prints
# them. A version that cannot be read gets the flag, as current gh needs it.
_log_flag_load() {
  local version major minor

  ((_log_flag_loaded == 0)) || return 0
  _log_flag_loaded=1
  _log_flag="--allow-escape-sequences "
  version=$(gh --version 2>/dev/null) || version=""
  [[ "$version" =~ ^gh\ version\ ([0-9]+)\.([0-9]+)\. ]] || return 0
  major=$((10#${BASH_REMATCH[1]}))
  minor=$((10#${BASH_REMATCH[2]}))
  ((major > 2 || (major == 2 && minor >= 97))) || _log_flag=""
}

_report_action() {
  local i="$1" j shown=0 more=0 job

  for ((j = 0; j < ${#_chk_pr[@]}; j++)); do
    [[ "${_chk_pr[$j]}" == "$i" ]] || continue
    if ((shown >= _max_check_lines)); then
      more=$((more + 1))
      continue
    fi
    shown=$((shown + 1))
    job=${_chk_id[$j]}
    [[ "${_chk_kind[$j]}" == actions && "$job" =~ ^[0-9]+$ ]] || job=-
    printf 'check pr=%s required=%s job=%s name=%s\n' \
      "${_numbers[$i]}" "${_chk_req[$j]}" "$job" "${_chk_name[$j]}"
  done
  ((more == 0)) || printf 'check-more pr=%s count=%s\n' "${_numbers[$i]}" "$more"
  for ((j = 0; j < ${#_suite_pr[@]}; j++)); do
    [[ "${_suite_pr[$j]}" == "$i" ]] || continue
    printf 'suite pr=%s conclusion=%s workflow=%s\n' \
      "${_numbers[$i]}" "${_suite_conclusion[$j]}" "${_suite_workflow[$j]}"
  done
  shown=0
  for ((j = 0; j < ${#_chk_pr[@]}; j++)); do
    [[ "${_chk_pr[$j]}" == "$i" ]] || continue
    [[ "${_chk_kind[$j]}" == actions && "${_chk_id[$j]}" =~ ^[0-9]+$ ]] || continue
    ((shown < _max_check_lines)) || break
    shown=$((shown + 1))
    _log_flag_load
    # The jobs API serves a job's log while its run is still going, which
    # `gh run view --log-failed` refuses. `gh api` ignores -R, so the host is
    # pinned with --hostname. cat -v keeps escape sequences from a log that a
    # fork's code may control inert in the terminal.
    printf 'run: gh api --hostname %s %srepos/%s/actions/jobs/%s/logs | cat -v\n' \
      "$GT_CURRENT_REPO_HOST" "$_log_flag" "${GT_CURRENT_REPO_SPEC#*/}" "${_chk_id[$j]}"
  done
}

# @brief The exit status the current judgments decide.
# Needs action (1) > unreadable (3) > pending or stalled (8) > done (0).
_decide() {
  local i exit=0

  for ((i = 0; i < ${#_numbers[@]}; i++)); do
    case "${_state[i]}:${_reason[i]}" in
      action:*) exit=1 ;;
      pending:unreadable) [[ "$exit" == 1 ]] || exit=3 ;;
      pending:* | stall:*) [[ "$exit" == 1 || "$exit" == 3 ]] || exit=8 ;;
    esac
  done
  printf '%s\n' "$exit"
}

# @brief Whether any pull request can still change state on a later check.
# A stalled pull request waits on something outside it; when only stalls (and
# finished pull requests) remain, waiting longer cannot change the outcome.
_still_moving() {
  local i

  for ((i = 0; i < ${#_numbers[@]}; i++)); do
    [[ "${_state[i]}" != pending ]] || return 0
  done
  return 1
}

# @brief Print the report and exit with the decided status.
# The result names the pull requests that decided the status, in target order,
# and the first one's reason.
_report() {
  local i exit head result_reason=""
  local -a unfinished=() result_prs=()

  exit=$(_decide)
  # The exit is decided: a reader that has gone away must not turn it into a
  # SIGPIPE death, nor a failed write an errexit one (see _on_signal).
  trap '' PIPE
  set +e
  for ((i = 0; i < ${#_numbers[@]}; i++)); do
    # A closed pull request is final; watching it again cannot change it.
    case "${_state[i]}:${_reason[i]}" in
      "done":* | action:closed) ;;
      *) unfinished+=("${_numbers[$i]}") ;;
    esac
  done

  for ((i = 0; i < ${#_numbers[@]}; i++)); do
    head=${_pr_head[i]:--}
    [[ "$head" == - ]] || head=${head:0:12}
    printf 'pr=%s state=%s reason=%s head=%s\n' \
      "${_numbers[$i]}" "${_state[i]}" "${_reason[i]}" "$head"
  done
  for ((i = 0; i < ${#_numbers[@]}; i++)); do
    case "${_state[i]}" in
      action) _report_action "$i" ;;
      stall) printf 'action: pr=%s %s\n' "${_numbers[$i]}" "$(_stall_hint "${_reason[i]}")" ;;
    esac
  done
  if [[ "$exit" != 0 ]] && ((${#unfinished[@]} > 0)); then
    printf 'next: git pr-watch --wait %s\n' "${unfinished[*]}"
  fi

  for ((i = 0; i < ${#_numbers[@]}; i++)); do
    case "$exit:${_state[i]}:${_reason[i]}" in
      0:"done":* | 1:action:* | 3:pending:unreadable | 8:pending:* | 8:stall:*)
        result_prs+=("${_numbers[$i]}")
        [[ -n "$result_reason" ]] || result_reason=${_reason[i]}
        ;;
    esac
  done
  [[ "$exit" != 3 ]] || result_reason=$_snapshot_class
  _result_done=1
  printf 'result: %s reason=%s prs=%s\n' "$exit" "$result_reason" \
    "$(_csv "${result_prs[@]}")"
  [[ "$exit" != 3 ]] || printf '%s: could not read every pull request from GitHub (%s)\n' \
    "$gt_command" "$_snapshot_class" >&2
  exit "$exit"
}

# --- state files -------------------------------------------------------------

# Other tools (agent hooks, for example) read these files to tell whether a
# pull request is being watched, or finished, without asking GitHub. Their
# layout and the key and scope rules are a contract documented in
# git-pr-watch(1) under STATE FILES; change them only together with it.
# Every write is best-effort: state files never change what this command
# reports or how it exits.

# Characters a key or scope may contain; repository identities are lowercased.
_state_chars='abcdefghijklmnopqrstuvwxyz0123456789._-'
_state_scope=""
_state_ready=0
_state_pending=""
_state_done=()
# Wall-clock time when the current check started, for done/ records: the
# test clock does not apply to files other tools compare with their own clock.
_state_wall_base=""
_state_check_wall=""
# Start of the check whose judgments are the current ones, for exit records.
_state_judged_wall=""

# @brief Choose the state directory and this repository's scope.
# Leaves _state_dir empty (no state files) when they are turned off, when no
# absolute XDG_STATE_HOME or HOME names a root, or when the identity does not
# make a valid scope. Makes no directories: a one-shot run that finishes
# nothing writes nothing.
_state_init() {
  local root scope

  [[ "$_state_enabled" == 1 ]] || return 0
  if [[ "${XDG_STATE_HOME:-}" == /* ]]; then
    root=$XDG_STATE_HOME
  elif [[ "${HOME:-}" == /* ]]; then
    root=$HOME/.local/state
  else
    return 0
  fi
  # Someone else's root is left alone: under sudo with HOME kept, writing would
  # leave root-owned directories in the user's home.
  if [[ -e "$root" ]]; then
    [[ -O "$root" ]] || return 0
  elif [[ "$root" == "${HOME:-}"/* ]]; then
    [[ -O "$HOME" ]] || return 0
  fi
  # GT_CURRENT_REPO_IDENTITY is host/owner/repository, already lowercased.
  # The host is left out: the same owner/repository on two hosts share keys.
  scope=${GT_CURRENT_REPO_IDENTITY#*/}
  scope=${scope/\//_}
  [[ "$scope" == ?*_?* && "$scope" != *[!$_state_chars]* ]] || return 0
  _state_scope=$scope
  _state_dir=$root/git-tools/pr-watch
}

# @brief Make the state directories (private to this user) once per run.
_state_mkdir() {
  [[ "$_state_ready" == 0 ]] || return "$((_state_ready == 1 ? 0 : 1))"
  if (umask 077 && mkdir -p "$_state_dir/watchers" "$_state_dir/exited" \
    "$_state_dir/done") 2>/dev/null; then
    _state_ready=1
    return 0
  fi
  _state_ready=2
  return 1
}

# @brief Replace a state file atomically: readers see the old content or the
# new, never a partial write.
# The temporary file is <file>~<pid>.XXXXXX: `~` never appears in a key or
# scope, so no layout name can look like one, and the pid lets a later run
# remove it once its writer is gone.
_state_write() {
  local file="$1" tmp

  _state_mkdir || return 0
  # mv would move the file into a directory standing in the record's place.
  [[ ! -d "$file" ]] || return 0
  tmp=$(mktemp "$file~$$.XXXXXX" 2>/dev/null) || return 0
  if printf '%s\n' "$2" 2>/dev/null >"$tmp" && mv -f -- "$tmp" "$file" 2>/dev/null; then
    return 0
  fi
  rm -f -- "$tmp" 2>/dev/null || true
}

# @brief Whether a file name is a key: <owner>_<repository>_<number>.
_state_is_key() {
  [[ "$1" != *[!$_state_chars]* && "$1" =~ ^[^_]+_.+_[1-9][[:digit:]]*$ ]]
}

# @brief Whether no process has this pid.
_state_pid_dead() {
  [[ "$1" =~ ^[1-9][[:digit:]]*$ ]] && ! kill -0 "$1" 2>/dev/null
}

# @brief List regular files directly in the given state directories that pass
# the find age test, whose names use only layout characters (plus `~` and the
# uppercase letters of temporary names), so no name can span two lines of the
# listing.
# Usage: _state_old <age test> <age> <directory>...
_state_old() {
  local test="$1" age="$2"
  shift 2

  find "$@" -maxdepth 1 -type f "$test" "$age" ! -name "*[!~ABCDEFGHIJKLMNOPQRSTUVWXYZ$_state_chars]*" \
    -print 2>/dev/null
}

# @brief Remove state left behind by earlier runs.
# Finished and exited records go after 30 days, temporary files an hour after
# their writer is gone (the age spares a writer on another host sharing this
# home), and watcher files once their watcher is gone and a day old (a watcher
# killed outright cannot remove its own). Only regular files whose names
# match the layout are removed, one at a time.
_state_prune() {
  local file name pid

  while IFS= read -r file; do
    name=${file##*/}
    _state_is_key "$name" || continue
    rm -f -- "$file" 2>/dev/null || true
  done < <(_state_old -mtime +30 "$_state_dir/exited" "$_state_dir/done")
  while IFS= read -r file; do
    name=${file##*/}
    [[ "$name" == ?*~* ]] || continue
    pid=${name##*~}
    pid=${pid%%.*}
    _state_pid_dead "$pid" || continue
    rm -f -- "$file" 2>/dev/null || true
  done < <(_state_old -mmin +60 "$_state_dir/watchers" "$_state_dir/exited" "$_state_dir/done")
  while IFS= read -r file; do
    name=${file##*/}
    [[ "$name" != *~* ]] || continue
    pid=${name##*.}
    name=${name%.*}
    [[ "$name" == pending || "$name" == pending.?* ]] || _state_is_key "$name" || continue
    _state_pid_dead "$pid" || continue
    rm -f -- "$file" 2>/dev/null || true
  done < <(_state_old -mmin +1440 "$_state_dir/watchers")
}

# @brief Announce a waiting run before its targets are known.
# Branch lookups can take a while; the pending file covers every pull request
# of this repository until the watcher files below replace it.
_state_start() {
  [[ -n "$_state_dir" ]] || return 0
  _state_mkdir || return 0
  _state_prune
  _state_pending=$_state_dir/watchers/pending.$_state_scope.$$
  _state_write "$_state_pending" "$$"
}

# @brief Write a waiting run's watcher files once its targets are resolved.
# Watcher files are written before the pending file goes, so a reader never
# sees neither.
_state_targets() {
  local number

  [[ -n "$_state_dir" && "$_wait" == 1 ]] || return 0
  for number in ${_numbers[@]+"${_numbers[@]}"}; do
    _state_write "$_state_dir/watchers/${_state_scope}_$number.$$" "$$"
  done
  if [[ -n "$_state_pending" ]]; then
    rm -f -- "$_state_pending" 2>/dev/null || true
    _state_pending=""
  fi
}

# @brief Note the wall-clock time a check starts. Only the first call starts
# a process (date); later ones add the shell's elapsed SECONDS.
_state_check_start() {
  [[ -n "$_state_dir" ]] || return 0
  if [[ -z "$_state_wall_base" ]]; then
    _state_wall_base=$(date +%s 2>/dev/null) || _state_wall_base=""
    [[ "$_state_wall_base" =~ ^[1-9][[:digit:]]*$ ]] || _state_wall_base=x
    [[ "$_state_wall_base" == x ]] || _state_wall_base=$((_state_wall_base - SECONDS))
  fi
  _state_check_wall=-
  [[ "$_state_wall_base" == x ]] || _state_check_wall=$((_state_wall_base + SECONDS))
}

# @brief Record pull requests this check found finished.
# done/<key> holds "<head commit> <green|merged|closed> <epoch>", the epoch
# being when the check that judged it started, so a reader can tell a
# judgment made before some later event (a push, say) from one made after.
# A green record is only written for a judgment of the current head. A record
# is rewritten only when its commit or word changes.
_state_finished() {
  local i head word

  [[ -n "$_state_dir" ]] || return 0
  _state_judged_wall=$_state_check_wall
  for ((i = 0; i < ${#_numbers[@]}; i++)); do
    case "${_state[i]:-}:${_reason[i]:-}" in
      "done":merged) word=merged ;;
      "done":*) word=green ;;
      action:closed) word=closed ;;
      *) continue ;;
    esac
    head=${_pr_head[i]:--}
    [[ "$head" =~ ^[0123456789abcdef]{40}([0123456789abcdef]{24})?$ ]] || head=-
    [[ "${_state_done[i]:-}" != "$head $word" ]] || continue
    _state_done[i]="$head $word"
    _state_write "$_state_dir/done/${_state_scope}_${_numbers[$i]}" \
      "$head $word $_state_check_wall"
  done
  # Under errexit the caller would exit with a failing last command's status.
  return 0
}

# @brief Record a waiting run's exit and remove its watcher files.
# exited/<key> holds "<exit status> <state> <reason> <epoch>", for every
# target resolved by then, so a run that dies while resolving a later branch
# target still records the earlier ones. The epoch is when the check behind
# the reported result started, and only when the run delivered a final one
# for that pull request (exit 0, 1, or 8 with it done, needing action, or
# stalled). A run cut short by a signal, an error, or an unreadable GitHub,
# and a pull request still pending when another one ended the run, get `-`:
# a reader never takes that for a watch of a head pushed meanwhile.
_state_finish() {
  local status="$1" i key epoch
  local -a files

  [[ "$_wait" == 1 ]] || return 0
  files=()
  for ((i = 0; i < ${#_numbers[@]}; i++)); do
    key=${_state_scope}_${_numbers[$i]}
    files+=("$_state_dir/watchers/$key.$$")
    epoch=-
    case "$status:${_state[i]:-}" in
      [018]:"done" | [018]:action | [018]:stall) epoch=${_state_judged_wall:--} ;;
    esac
    _state_write "$_state_dir/exited/$key" "$status ${_state[i]:--} ${_reason[i]:--} $epoch"
  done
  [[ -z "$_state_pending" ]] || files+=("$_state_pending")
  ((${#files[@]} == 0)) || rm -f -- "${files[@]}" 2>/dev/null || true
}

# --- main --------------------------------------------------------------------

# @brief Sleep up to $1 seconds, never past the deadline.
# The sleep is a background job so a signal handler runs at once (and kills
# it) instead of after the sleep ends. The test clock skips the sleep.
_sleep_until_next() {
  local seconds="$1" left pid

  left=$((_deadline - $(_now)))
  ((seconds <= left)) || seconds=$left
  ((seconds > 0)) || return 0
  if _test_clock >/dev/null; then
    _pause "$seconds"
    return 0
  fi
  # Detached from the caller's output, so a sleep orphaned by a SIGKILL of
  # this command cannot hold a `$(git pr-watch ...)` capture open.
  # shellcheck disable=SC2217 # the redirections detach it, not feed it
  sleep "$seconds" </dev/null >/dev/null 2>&1 &
  pid=$!
  wait "$pid" || true
}

# @brief Seconds to wait for a rate limit to lift, with jitter so several
# watchers do not all retry at the same moment.
_rate_wait() {
  local wait=60

  if [[ "${_rate_reset:-}" =~ ^[0-9]+$ && "${_rate_date:-}" =~ ^[0-9]+$ ]]; then
    wait=$((_rate_reset - _rate_date))
    ((wait >= _min_interval)) || wait=$_min_interval
  fi
  printf '%s\n' $((wait + $(_jitter)))
}

_jitter() {
  if _test_clock >/dev/null; then
    printf '0\n'
  else
    printf '%s\n' $((RANDOM % (_jitter_max + 1)))
  fi
}

_started=$(_now)
_deadline=$((_started + _cap))
_failed_checks=0
_rate_reset=""
_rate_date=""
_state_init
[[ "$_wait" == 0 ]] || _state_start
_resolve_targets
_state_targets
while :; do
  _reset_tick
  _check_now=$(_now)
  _state_check_start
  _snapshot_all
  [[ -n "$_server_now" ]] || _server_now=$_check_now
  _judge_all
  _state_finished
  [[ "$_wait" == 0 ]] || _progress
  _status=$(_decide)
  # A one-shot run reports what it saw. A waiting run stops as soon as a pull
  # request needs action (even if others could not be read), when everything
  # is done, when only stalls remain, or at the deadline.
  [[ "$_wait" == 1 && "$_status" != 1 && "$_status" != 0 ]] || _report
  if [[ "$_snapshot_class" == ok ]]; then
    _failed_checks=0
    _still_moving || _report
    (($(_now) < _deadline)) || _report
    _sleep_until_next $((_interval + $(_jitter)))
  elif [[ "$_snapshot_class" == rate-limited ]]; then
    (($(_now) < _deadline)) || _report
    _sleep_until_next "$(_rate_wait)"
  else
    _failed_checks=$((_failed_checks + 1))
    ((_failed_checks < _failed_check_limit)) || _report
    (($(_now) < _deadline)) || _report
    _sleep_until_next $((_interval + $(_jitter)))
  fi
  # The sleep never passes the deadline, so the next check is the last one
  # when it reaches it, and the report reflects the latest state.
done
