#!/usr/bin/env bash

set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
TEMPLATE="$ROOT/support/launcher-bootstrap.sh.template"
BEGIN_MARKER='# BEGIN GENERATED LAUNCHER BOOTSTRAP'
END_MARKER='# END GENERATED LAUNCHER BOOTSTRAP'

# shellcheck source=lib/git-tools-inventory.sh
. "$ROOT/lib/git-tools-inventory.sh"

usage() {
  printf 'Usage: %s [--check]\n' "${0##*/}" >&2
}

check=0
if (($# > 1)); then
  usage
  exit 2
fi

if (($# == 1)); then
  if [[ "$1" != --check ]]; then
    usage
    exit 2
  fi
  check=1
fi

git_tools_validate_commands "$ROOT"

tmpdir=$(mktemp -d)
update_tmp=''
# shellcheck disable=SC2317,SC2329 # invoked indirectly by the EXIT trap
cleanup() {
  rm -rf "$tmpdir"
  if [[ -n "$update_tmp" ]]; then
    rm -f "$update_tmp"
  fi
}
trap cleanup EXIT

block="$tmpdir/block"
{
  printf '%s\n' "$BEGIN_MARKER"
  printf '%s\n' \
    '# Generated by support/sync-launcher-bootstrap; edit the template, not launcher copies.'
  cat "$TEMPLATE"
  printf '%s\n' "$END_MARKER"
} >"$block"

# Validate the assembled block before touching any launcher. This catches a
# missing template newline or reserved marker copied into the template.
if ! awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
  $0 == begin { begin_count++ }
  $0 == end { end_count++ }
  END { exit !(begin_count == 1 && end_count == 1) }
' "$block"; then
  printf 'error: launcher bootstrap template is malformed\n' >&2
  exit 1
fi

commands=()
while IFS= read -r command; do
  commands+=("$command")
done < <(git_tools_commands "$ROOT")

if ((${#commands[@]} == 0)); then
  printf 'error: no executable bin/git-* launchers found\n' >&2
  exit 1
fi

status=0
for command in "${commands[@]}"; do
  launcher="$ROOT/bin/$command"
  candidate="$tmpdir/$command"

  if ! awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" -v block="$block" '
    $0 == begin {
      if (inside || saw_begin) {
        exit 3
      }
      saw_begin = 1
      inside = 1
      while ((getline line < block) > 0) {
        print line
      }
      close(block)
      next
    }
    $0 == end {
      if (!inside || saw_end) {
        exit 3
      }
      saw_end = 1
      inside = 0
      next
    }
    !inside { print }
    END {
      if (!saw_begin || !saw_end || inside) {
        exit 3
      }
    }
  ' "$launcher" >"$candidate"; then
    printf 'error: generated launcher bootstrap markers are missing or malformed: %s\n' \
      "${launcher#"$ROOT/"}" >&2
    status=1
    continue
  fi

  if cmp -s "$launcher" "$candidate"; then
    continue
  fi

  if ((check)); then
    printf 'out of date: %s\n' "${launcher#"$ROOT/"}" >&2
    status=1
  else
    # Keep the executable mode and make interruption safe by replacing only
    # after the complete candidate is present on the launcher's filesystem.
    launcher_dir=${launcher%/*}
    launcher_name=${launcher##*/}
    update_tmp=$(mktemp "$launcher_dir/.${launcher_name}.tmp.XXXXXX")
    cp -p "$launcher" "$update_tmp"
    cat "$candidate" >"$update_tmp"
    mv "$update_tmp" "$launcher"
    update_tmp=''
    printf 'updated: %s\n' "${launcher#"$ROOT/"}"
  fi
done

exit "$status"
