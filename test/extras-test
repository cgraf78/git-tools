#!/usr/bin/env bash

set -uo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

# shellcheck source=lib/git-tools-inventory.sh
. "$ROOT/lib/git-tools-inventory.sh"

_failures=0
_temps=()

_tmpdir() {
  local dir
  dir=$(mktemp -d)
  _temps+=("$dir")
  printf '%s\n' "$dir"
}

_cleanup() {
  local dir
  for dir in "${_temps[@]}"; do
    rm -rf "$dir"
  done
}
trap _cleanup EXIT

_pass() {
  printf 'ok - %s\n' "$1"
}

_fail() {
  printf 'not ok - %s\n' "$1" >&2
  _failures=$((_failures + 1))
}

_assert_file() {
  local name="$1"
  local path="$2"

  if [[ -f "$path" ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  missing file: %s\n' "$path" >&2
  fi
}

_assert_symlink() {
  local name="$1"
  local path="$2"

  if [[ -L "$path" ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  missing symlink: %s\n' "$path" >&2
  fi
}

_assert_link_target() {
  local name="$1"
  local expected="$2"
  local path="$3"

  if [[ -L "$path" && "$(readlink "$path")" == "$expected" ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected link target: %s\n' "$expected" >&2
    printf '  actual path: %s\n' "$path" >&2
  fi
}

_assert_missing() {
  local name="$1"
  local path="$2"

  if [[ ! -e "$path" && ! -L "$path" ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected path to be absent: %s\n' "$path" >&2
  fi
}

_assert_regular_file_content() {
  local name="$1"
  local expected="$2"
  local path="$3"

  if [[ -f "$path" && ! -L "$path" && "$(cat "$path")" == "$expected" ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected preserved regular file: %s\n' "$path" >&2
  fi
}

_assert_contains() {
  local name="$1"
  local needle="$2"
  local path="$3"

  if grep -F -q -- "$needle" "$path"; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected %s to contain: %s\n' "$path" "$needle" >&2
  fi
}

_assert_eq() {
  local name="$1"
  local expected="$2"
  local actual="$3"

  if [[ "$actual" == "$expected" ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected: %s\n' "$expected" >&2
    printf '  actual: %s\n' "$actual" >&2
  fi
}

_assert_line() {
  local name="$1"
  local expected="$2"
  local path="$3"
  local line_number="$4"
  local actual

  actual=$(sed -n "${line_number}p" "$path")

  if [[ "$actual" == "$expected" ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected %s line %s: %s\n' "$path" "$line_number" "$expected" >&2
    printf '  actual: %s\n' "$actual" >&2
  fi
}

_description_for() {
  case "$1" in
    git-absorb-and-rebase)
      printf '%s\n' 'absorb staged changes into earlier commits'
      ;;
    git-branch-audit)
      printf '%s\n' 'audit local branches against the default branch'
      ;;
    git-cleanup-repo)
      printf '%s\n' 'delete safely merged local branches'
      ;;
    git-pr-checks)
      printf '%s\n' 'summarize GitHub pull request checks'
      ;;
    git-pr-land)
      printf '%s\n' 'land one ready GitHub pull request'
      ;;
    git-pr-land-stack)
      printf '%s\n' 'land a ready linear GitHub pull request stack'
      ;;
    git-pr-open)
      printf '%s\n' 'push a branch and create a pull request'
      ;;
    git-pr-ready)
      printf '%s\n' 'check whether a GitHub pull request is landable'
      ;;
    git-pr-restack)
      printf '%s\n' 'rebase one GitHub pull request branch onto a base'
      ;;
    git-pr-stack)
      printf '%s\n' 'discover a linear GitHub pull request stack'
      ;;
    git-pr-submit)
      printf '%s\n' 'submit default-branch commits through a pull request'
      ;;
    git-pr-sync-stack)
      printf '%s\n' 'restack a GitHub pull request stack'
      ;;
    git-repo-state)
      printf '%s\n' 'report repository workflow state'
      ;;
    git-resolve-base)
      printf '%s\n' 'print the inferred branch point of the current branch'
      ;;
    git-stash-audit)
      printf '%s\n' 'inspect and clean git stashes'
      ;;
    git-worktree-audit)
      printf '%s\n' 'report state across all worktrees'
      ;;
    *)
      return 1
      ;;
  esac
}

inventory_root=$(_tmpdir)
mkdir -p "$inventory_root/bin"
touch "$inventory_root/bin/git-zed" "$inventory_root/bin/git-alpha" "$inventory_root/bin/git-beta"
chmod +x "$inventory_root/bin/git-zed" "$inventory_root/bin/git-alpha"
shopt -u nullglob
inventory_result=$(git_tools_commands "$inventory_root")
inventory_expected="$(printf 'git-alpha\ngit-zed')"
_assert_eq "command inventory lists executable git-* files in stable order" \
  "$inventory_expected" "$inventory_result"
if git_tools_validate_commands "$inventory_root" >/dev/null 2>&1; then
  _fail 'command inventory rejects a launcher without its executable bit'
else
  _pass 'command inventory rejects a launcher without its executable bit'
fi
chmod +x "$inventory_root/bin/git-beta"
if git_tools_validate_commands "$inventory_root" >/dev/null 2>&1; then
  _pass 'command inventory accepts executable launchers'
else
  _fail 'command inventory accepts executable launchers'
fi
ln -s git-alpha "$inventory_root/bin/git-live-link"
ln -s missing "$inventory_root/bin/git-dangling-link"
if git_tools_validate_commands "$inventory_root" >/dev/null 2>&1; then
  _fail 'command inventory rejects live and dangling launcher symlinks'
else
  _pass 'command inventory rejects live and dangling launcher symlinks'
fi
symlink_inventory=$(git_tools_commands "$inventory_root")
symlink_expected="$(printf 'git-alpha\ngit-beta\ngit-zed')"
_assert_eq 'command inventory excludes live and dangling launcher symlinks' \
  "$symlink_expected" "$symlink_inventory"
if shopt -q nullglob; then
  _fail "command inventory does not leak nullglob state"
else
  _pass "command inventory does not leak nullglob state"
fi

_commands=()
while IFS= read -r command; do
  _commands+=("$command")
done < <(git_tools_commands "$ROOT")

echo "=== extras ==="

for command in "${_commands[@]}"; do
  if description=$(_description_for "$command"); then
    _pass "description expectation exists for $command"
  else
    _fail "description expectation exists for $command"
    continue
  fi

  _assert_file "man page exists for $command" "$ROOT/man/man1/$command.1"
  _assert_contains "man page names $command" "$command" "$ROOT/man/man1/$command.1"
  _assert_contains "man page summarizes $command" "$description" "$ROOT/man/man1/$command.1"

  _assert_file "bash completion exists for $command" "$ROOT/completions/$command.bash"
  _assert_contains "bash completion registers $command" "complete -F" "$ROOT/completions/$command.bash"
  if bash -n "$ROOT/completions/$command.bash"; then
    _pass "bash completion parses for $command"
  else
    _fail "bash completion parses for $command"
  fi

  _assert_file "zsh completion exists for $command" "$ROOT/completions/$command.zsh"
  _assert_contains "zsh completion declares $command" "#compdef $command" "$ROOT/completions/$command.zsh"
  _assert_line "zsh completion describes $command for git subcommand listing" "#description $description" "$ROOT/completions/$command.zsh" 2
  if command -v zsh >/dev/null 2>&1; then
    if zsh -n "$ROOT/completions/$command.zsh"; then
      _pass "zsh completion parses for $command"
    else
      _fail "zsh completion parses for $command"
    fi
  fi

  _assert_file "fish completion exists for $command" "$ROOT/completions/$command.fish"
  _assert_contains "fish completion registers $command" "complete -c $command" "$ROOT/completions/$command.fish"
  if command -v fish >/dev/null 2>&1; then
    if fish --no-execute "$ROOT/completions/$command.fish"; then
      _pass "fish completion parses for $command"
    else
      _fail "fish completion parses for $command"
    fi
  fi
done

_assert_contains "zsh branch-audit describes candidate reporting" \
  "--drop-merged[Report branches already merged into the default branch]" \
  "$ROOT/completions/git-branch-audit.zsh"
_assert_contains "fish branch-audit describes candidate reporting" \
  'drop-merged -d "Report branches already merged into the default branch"' \
  "$ROOT/completions/git-branch-audit.fish"
_assert_contains "zsh cleanup describes gone selection" \
  "--gone[Select gone-upstream branches for cleanup]" \
  "$ROOT/completions/git-cleanup-repo.zsh"
_assert_contains "fish cleanup describes worktree removal" \
  'remove-worktrees -d "Remove clean linked worktrees for deleted branches"' \
  "$ROOT/completions/git-cleanup-repo.fish"

prefix=$(_tmpdir)
install_out=$(_tmpdir)/install.out
PREFIX="$prefix" "$ROOT/install.sh" >"$install_out" 2>&1

_assert_symlink "installs interactive shell integration" \
  "$prefix/share/git-tools/shell.sh"
_assert_link_target "installs shell integration from this checkout" \
  "$ROOT/share/git-tools/shell.sh" "$prefix/share/git-tools/shell.sh"
for command in "${_commands[@]}"; do
  _assert_symlink "installs $command binary" "$prefix/bin/$command"
  _assert_symlink "installs $command man page" "$prefix/share/man/man1/$command.1"
  _assert_symlink "installs $command bash completion" "$prefix/share/bash-completion/completions/$command"
  _assert_symlink "installs $command zsh completion" "$prefix/share/zsh/site-functions/_$command"
  _assert_symlink "installs $command fish completion" "$prefix/share/fish/vendor_completions.d/$command.fish"
  _assert_link_target "installs $command binary from this checkout" \
    "$ROOT/bin/$command" "$prefix/bin/$command"
  _assert_link_target "installs $command man page from this checkout" \
    "$ROOT/man/man1/$command.1" "$prefix/share/man/man1/$command.1"
  _assert_link_target "installs $command bash completion from this checkout" \
    "$ROOT/completions/$command.bash" \
    "$prefix/share/bash-completion/completions/$command"
  _assert_link_target "installs $command zsh completion from this checkout" \
    "$ROOT/completions/$command.zsh" \
    "$prefix/share/zsh/site-functions/_$command"
  _assert_link_target "installs $command fish completion from this checkout" \
    "$ROOT/completions/$command.fish" \
    "$prefix/share/fish/vendor_completions.d/$command.fish"
done

PREFIX="$prefix" "$ROOT/install.sh" >/dev/null
_assert_link_target "reinstall is idempotent" \
  "$ROOT/bin/${_commands[0]}" "$prefix/bin/${_commands[0]}"
_assert_link_target "shell integration reinstall is idempotent" \
  "$ROOT/share/git-tools/shell.sh" "$prefix/share/git-tools/shell.sh"

custom_root=$(_tmpdir)
custom_bin="$custom_root/commands"
custom_man="$custom_root/manuals"
custom_bash="$custom_root/bash"
custom_zsh="$custom_root/zsh"
custom_fish="$custom_root/fish"
custom_shell="$custom_root/shell"
BIN_DIR="$custom_bin" MAN_DIR="$custom_man" \
  BASH_COMPLETION_DIR="$custom_bash" ZSH_COMPLETION_DIR="$custom_zsh" \
  FISH_COMPLETION_DIR="$custom_fish" \
  SHELL_INTEGRATION_DIR="$custom_shell" "$ROOT/install.sh" >/dev/null
_assert_link_target "custom SHELL_INTEGRATION_DIR receives shell integration" \
  "$ROOT/share/git-tools/shell.sh" "$custom_shell/shell.sh"
for command in "${_commands[@]}"; do
  _assert_link_target "custom BIN_DIR receives $command" \
    "$ROOT/bin/$command" "$custom_bin/$command"
  _assert_link_target "custom MAN_DIR receives $command" \
    "$ROOT/man/man1/$command.1" "$custom_man/$command.1"
  _assert_link_target "custom BASH_COMPLETION_DIR receives $command" \
    "$ROOT/completions/$command.bash" "$custom_bash/$command"
  _assert_link_target "custom ZSH_COMPLETION_DIR receives $command" \
    "$ROOT/completions/$command.zsh" "$custom_zsh/_$command"
  _assert_link_target "custom FISH_COMPLETION_DIR receives $command" \
    "$ROOT/completions/$command.fish" "$custom_fish/$command.fish"
done

blocked_prefix=$(_tmpdir)
blocked_fish="$blocked_prefix/share/fish/vendor_completions.d/${_commands[0]}.fish"
mkdir -p "$(dirname "$blocked_fish")"
printf 'owned elsewhere\n' >"$blocked_fish"
blocked_status=0
blocked_output=$(PREFIX="$blocked_prefix" "$ROOT/install.sh" 2>&1) ||
  blocked_status=$?
_assert_eq "install refuses a non-symlink destination" 1 "$blocked_status"
_assert_regular_file_content "install preserves a non-symlink destination" \
  "owned elsewhere" "$blocked_fish"
_assert_missing "destination preflight prevents a partial install" \
  "$blocked_prefix/bin/${_commands[0]}"
_assert_contains "destination refusal is actionable" \
  "refusing to replace non-symlink" <(printf '%s\n' "$blocked_output")

missing_root=$(_tmpdir)
missing_prefix=$(_tmpdir)
mkdir -p "$missing_root/lib" "$missing_root/support"
cp "$ROOT/support/install-checkout.sh" \
  "$missing_root/support/install-checkout.sh"
cp "$ROOT/lib/git-tools-inventory.sh" "$missing_root/lib/"
cp -R "$ROOT/bin" "$ROOT/man" "$ROOT/completions" "$ROOT/share" \
  "$missing_root/"
rm "$missing_root/completions/${_commands[0]}.fish"
missing_status=0
missing_output=$(PREFIX="$missing_prefix" \
  "$missing_root/support/install-checkout.sh" 2>&1) ||
  missing_status=$?
_assert_eq "install rejects an incomplete source tree" 1 "$missing_status"
_assert_missing "source preflight prevents a partial install" \
  "$missing_prefix/bin/${_commands[0]}"
_assert_contains "missing source is actionable" "source is missing" \
  <(printf '%s\n' "$missing_output")

rollback_prefix=$(_tmpdir)
rollback_bin=$(_tmpdir)
rollback_prior_target=--help
rollback_last_command=${_commands[${#_commands[@]} - 1]}
mkdir -p "$rollback_prefix/bin"
ln -s -- "$rollback_prior_target" \
  "$rollback_prefix/bin/${_commands[0]}"
cat >"$rollback_bin/ln" <<'SH'
#!/usr/bin/env bash
ln_args=("$@")
ln_operand_count=${#ln_args[@]}
ln_source_operand=${ln_args[$((ln_operand_count - 2))]}
ln_target_operand=${ln_args[$((ln_operand_count - 1))]}
"$GIT_TOOLS_TEST_REAL_LN" "$@" || exit $?
if [[ $ln_source_operand == "$GIT_TOOLS_TEST_LN_FAIL_SOURCE" &&
  $ln_target_operand == "$GIT_TOOLS_TEST_LN_FAIL_TARGET" ]]; then
  printf 'injected late ln failure\n' >&2
  exit 73
fi
SH
chmod +x "$rollback_bin/ln"
rollback_status=0
rollback_output=$(
  PATH="$rollback_bin:$PATH" \
    GIT_TOOLS_TEST_REAL_LN="$(command -v ln)" \
    GIT_TOOLS_TEST_LN_FAIL_SOURCE="$ROOT/completions/$rollback_last_command.fish" \
    GIT_TOOLS_TEST_LN_FAIL_TARGET="$rollback_prefix/share/fish/vendor_completions.d/$rollback_last_command.fish" \
    PREFIX="$rollback_prefix" "$ROOT/install.sh" 2>&1
) || rollback_status=$?
_assert_eq "late link failure preserves its status" 73 "$rollback_status"
_assert_contains "late link failure preserves its diagnostic" \
  "injected late ln failure" <(printf '%s\n' "$rollback_output")
_assert_link_target "rollback restores an option-like command target" \
  "$rollback_prior_target" "$rollback_prefix/bin/${_commands[0]}"
for command in "${_commands[@]}"; do
  if [[ "$command" != "${_commands[0]}" ]]; then
    _assert_missing "rollback removes new $command command link" \
      "$rollback_prefix/bin/$command"
  fi
  _assert_missing "rollback removes new $command manpage link" \
    "$rollback_prefix/share/man/man1/$command.1"
  _assert_missing "rollback removes new $command bash completion" \
    "$rollback_prefix/share/bash-completion/completions/$command"
  _assert_missing "rollback removes new $command zsh completion" \
    "$rollback_prefix/share/zsh/site-functions/_$command"
  _assert_missing "rollback removes new $command fish completion" \
    "$rollback_prefix/share/fish/vendor_completions.d/$command.fish"
done
_assert_missing "rollback removes new shell integration" \
  "$rollback_prefix/share/git-tools/shell.sh"

installed_help=$(_tmpdir)/repo-state-help.out
if "$prefix/bin/git-repo-state" --help >"$installed_help" 2>&1; then
  _pass 'installed symlinked launcher executes'
else
  _fail 'installed symlinked launcher executes'
fi
_assert_contains 'installed symlinked launcher resolves repository libraries' \
  'Usage: git repo-state' "$installed_help"

_assert_contains "install reports man destination" "installed man pages to" "$install_out"
_assert_contains "install reports bash destination" "installed bash completions to" "$install_out"
_assert_contains "install reports zsh destination" "installed zsh completions to" "$install_out"
_assert_contains "install reports fish destination" "installed fish completions to" "$install_out"
_assert_contains "install reports shell integration destination" \
  "installed shell integration to" "$install_out"

if ((_failures > 0)); then
  printf '%s failure(s)\n' "$_failures" >&2
  exit 1
fi

printf 'all tests passed\n'
