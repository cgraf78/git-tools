  "$(git -C "$unused_config_repo" branch --list \
    --format='%(refname:short)' unused-config)"

# Repository-local path authorization must be read as one complete, successful
# NUL-delimited stream. A producer that emits a valid prefix and then fails must
# not grant partial deletion authority.
config_read_repo=$(_clone_remote)
