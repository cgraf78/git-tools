late_dirty_repo=$(_clone_remote)
git -C "$late_dirty_repo" switch --quiet -c late-dirty
_commit_file "$late_dirty_repo" late.txt clean "add late dirty work"
git -C "$late_dirty_repo" switch --quiet main
late_dirty_dir=$(_tmpdir)
rm -rf "$late_dirty_dir"
git -C "$late_dirty_repo" worktree add --quiet "$late_dirty_dir" late-dirty
late_dirty_bin=$(_tmpdir)
cat >"$late_dirty_bin/git" <<'EOF'
