# Successful producers with malformed trailing data are operational failures,
# not a valid non-match that may fall through to the cherry proof.
malformed_bin=$(_tmpdir)
cat >"$malformed_bin/git" <<'EOF'
#!/usr/bin/env bash
if [[ "${1:-}" == patch-id ]]; then
  input=$(cat)
  if [[ "$GIT_MALFORMED_PROOF_MODE" == foreign-width ]]; then
    printf '%064d %064d\n' 1 2
    exit 0
  fi
  if [[ "$input" == commit\ * ]]; then
    valid=$(printf '%s\n' "$input" | "$GIT_TOOLS_TEST_REAL_GIT" "$@") || exit $?
    patch_id=${valid%% *}
    source_id=${valid#* }
    case "$GIT_MALFORMED_PROOF_MODE" in
      one-char) printf 'a %s\n' "$source_id" ;;
      mixed-width) printf '%s %s000000000000000000000000\n' "$patch_id" "$source_id" ;;
      extra) printf '%s extra\n' "$valid" ;;
      unterminated) printf '%s' "$valid" ;;
      *) exit 89 ;;
    esac
    exit 0
  fi
  printf '%s\n' "$input" | "$GIT_TOOLS_TEST_REAL_GIT" "$@"
  exit $?
fi
if [[ "${1:-}" == cherry ]]; then
  printf '%s\n' cherry >>"$GIT_MALFORMED_PROOF_LOG"
fi
exec "$GIT_TOOLS_TEST_REAL_GIT" "$@"
EOF
