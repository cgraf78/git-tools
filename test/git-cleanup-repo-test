    "worktree has hidden local content: $hidden_worktree_dir" \
    "$hidden_worktree_output"
  _assert_eq "$hidden_mode preserves branch" "hidden-$hidden_mode" \
    "$(git -C "$hidden_worktree_repo" branch --list --format='%(refname:short)' "hidden-$hidden_mode")"
  _assert_eq "$hidden_mode preserves worktree" present \
    "$(if [[ -e "$hidden_worktree_dir" ]]; then printf 'present'; else printf 'missing'; fi)"
done

corrupt_worktree_repo=$(_clone_remote)
git -C "$corrupt_worktree_repo" switch --quiet -c corrupt-work
_commit_file "$corrupt_worktree_repo" corrupt-work.txt clean "add corrupt work"
git -C "$corrupt_worktree_repo" switch --quiet main
corrupt_worktree_git_dir=$(git -C "$corrupt_worktree_repo" rev-parse --absolute-git-dir)
corrupt_worktree_dir=$(_tmpdir)
rm -rf "$corrupt_worktree_dir"
git -C "$corrupt_worktree_repo" worktree add "$corrupt_worktree_dir" corrupt-work >/dev/null 2>&1
printf 'gitdir: /nonexistent/gitdir\n' >"$corrupt_worktree_dir/.git"
result=$(
  GIT_DIR="$corrupt_worktree_git_dir" GIT_WORK_TREE="$corrupt_worktree_repo" \
    git cleanup-repo --all --remove-worktrees 2>&1
)
_assert_contains "reports corrupt linked worktrees without inspecting or removing them" \
  "skipping corrupt-work; could not inspect worktree operation state: $corrupt_worktree_dir" "$result"
_assert_not_contains "does not remove corrupt worktrees after failed status" \
  "fatal:" "$result"
_assert_eq "corrupt worktree branch remains" \
  "$(printf 'corrupt-work\nmain')" "$(_branches "$corrupt_worktree_repo")"

dirty_repo=$(_clone_remote)
printf 'dirty\n' >"$dirty_repo/dirty.txt"
result=$(git -C "$dirty_repo" cleanup-repo 2>&1 || true)
_assert_contains "refuses dirty worktrees" "worktree must be clean" "$result"
dirty_rc=0
result=$(git -C "$dirty_repo" cleanup-repo --dry-run 2>&1) || dirty_rc=$?
_assert_eq "dry run refuses a dirty worktree like the real run" 2 "$dirty_rc"
_assert_contains "dry run reports the refusal it would make" \
  "would refuse: worktree must be clean before cleanup" "$result"
_assert_not_contains "dry run plans nothing for a dirty worktree" \
  "would delete" "$result"

# Every refusal the real run makes before changing anything is a dry-run
# refusal with the same exit status, such as an active operation.
op_repo=$(_clone_remote)
git -C "$op_repo" switch --quiet -c topic
git -C "$op_repo" commit --quiet --allow-empty -m one
git -C "$op_repo" rebase --quiet --exec false HEAD~1 >/dev/null 2>&1
for op_mode in real dry; do
  op_args=()
  op_prefix=""
  if [[ "$op_mode" == dry ]]; then
    op_args=(--dry-run)
    op_prefix="would refuse: "
  fi
  op_rc=0
  result=$(git -C "$op_repo" cleanup-repo ${op_args[@]+"${op_args[@]}"} 2>&1) ||
    op_rc=$?
  _assert_eq "active operation: $op_mode run exits 2" 2 "$op_rc"
  _assert_contains "active operation: $op_mode run reports why" \
    "${op_prefix}repository already has an active rebase" "$result"
done

# A linked worktree must never take over the base branch. Switching it to the
# base would leave its own branch unreserved, so cleanup would delete the branch
# the caller is working on, and the main checkout could no longer use the base.

# Build a clone whose remote base has merged `feat` while local main is still
# behind. Prints the main checkout path.
_merged_feature_repo() {
  local repo

  repo=$(_clone_remote) || return 1
  git -C "$repo" switch --quiet -c feat
  _commit_file "$repo" feat.txt feat "add feat"
  git -C "$repo" switch --quiet --detach main
  git -C "$repo" merge --quiet --no-ff feat -m "merge feat"
  git -C "$repo" push --quiet origin HEAD:main
  git -C "$repo" switch --quiet main
  printf '%s\n' "$repo"
}

_head_ref() {
  git -C "$1" symbolic-ref -q HEAD || printf 'detached\n'
}

# A divergent base is a dry-run refusal with the real run's exit status too.
dv2_repo=$(_merged_feature_repo)
_commit_file "$dv2_repo" local.txt local "divergent local base"
dv2_rc=0
result=$(git -C "$dv2_repo" cleanup-repo --dry-run 2>&1) || dv2_rc=$?
_assert_eq "divergent base: dry run exits 2 like the real run" 2 "$dv2_rc"
_assert_contains "divergent base: dry run reports the refusal" \
  "would refuse: local base cannot be fast-forwarded to origin/main" "$result"

# The base checked out in the main worktree is fast-forwarded there.
lw_main_repo=$(_merged_feature_repo)
lw_main_remote=$(git -C "$lw_main_repo" rev-parse refs/remotes/origin/main)
lw_main_feat=$(git -C "$lw_main_repo" rev-parse refs/heads/feat)
lw_main_linked="$(_tmpdir)/linked"
git -C "$lw_main_repo" worktree add --quiet "$lw_main_linked" feat
lw_main_rc=0
result=$(git -C "$lw_main_linked" cleanup-repo 2>&1) || lw_main_rc=$?
_assert_eq "linked cleanup succeeds when the main worktree holds base" \
  0 "$lw_main_rc"
_assert_eq "main worktree base is fast-forwarded in place" \
  "$lw_main_remote" "$(git -C "$lw_main_repo" rev-parse HEAD)"
_assert_eq "main worktree stays on base" \
  refs/heads/main "$(_head_ref "$lw_main_repo")"
_assert_eq "main worktree files follow the base fast-forward" "" \
  "$(git -C "$lw_main_repo" status --porcelain)"
_assert_eq "linked worktree keeps its own branch checked out" \
  refs/heads/feat "$(_head_ref "$lw_main_linked")"
_assert_eq "linked worktree's merged branch is kept" \
  "$lw_main_feat" "$(git -C "$lw_main_repo" rev-parse refs/heads/feat)"
_assert_contains "reports keeping the current worktree's branch" \
  "keeping feat; checked out in the current worktree" "$result"

# The base checked out in another linked worktree is fast-forwarded there.
lw_other_repo=$(_merged_feature_repo)
lw_other_remote=$(git -C "$lw_other_repo" rev-parse refs/remotes/origin/main)
git -C "$lw_other_repo" switch --quiet -c other
lw_other_base="$(_tmpdir)/base"
lw_other_linked="$(_tmpdir)/linked"
git -C "$lw_other_repo" worktree add --quiet "$lw_other_base" main
git -C "$lw_other_repo" worktree add --quiet "$lw_other_linked" feat
lw_other_old=$(git -C "$lw_other_repo" rev-parse refs/heads/main)
result=$(git -C "$lw_other_linked" cleanup-repo --dry-run 2>&1)
_assert_contains "linked dry run reports the base worktree fast-forward" \
  "would run: git -C $(printf %q "$lw_other_base") merge --quiet --ff-only $lw_other_remote" \
  "$result"
_assert_eq "linked dry run leaves the base worktree unchanged" \
  "$lw_other_old" "$(git -C "$lw_other_base" rev-parse HEAD)"
lw_other_rc=0
result=$(git -C "$lw_other_linked" cleanup-repo 2>&1) || lw_other_rc=$?
_assert_eq "linked cleanup succeeds when another linked worktree holds base" \
  0 "$lw_other_rc"
_assert_eq "base worktree is fast-forwarded in place" \
  "$lw_other_remote" "$(git -C "$lw_other_base" rev-parse HEAD)"
_assert_contains "linked cleanup reports updating the base worktree" \
  "fast-forwarded main in worktree $lw_other_base" "$result"
_assert_eq "base worktree stays on base" \
  refs/heads/main "$(_head_ref "$lw_other_base")"
_assert_eq "base worktree files follow the fast-forward" "" \
  "$(git -C "$lw_other_base" status --porcelain)"
_assert_eq "invoking linked worktree stays on its branch" \
  refs/heads/feat "$(_head_ref "$lw_other_linked")"
_assert_eq "main worktree stays on its branch" \
  refs/heads/other "$(_head_ref "$lw_other_repo")"
_assert_eq "branches checked out elsewhere are all kept" \
  "$(printf 'feat\nmain\nother')" "$(_branches "$lw_other_repo")"

# With the base checked out nowhere, a linked worktree advances only the ref.
lw_ref_repo=$(_merged_feature_repo)
lw_ref_old=$(git -C "$lw_ref_repo" rev-parse refs/heads/main)
lw_ref_remote=$(git -C "$lw_ref_repo" rev-parse refs/remotes/origin/main)
git -C "$lw_ref_repo" switch --quiet -c other
lw_ref_linked="$(_tmpdir)/linked"
git -C "$lw_ref_repo" worktree add --quiet "$lw_ref_linked" feat
