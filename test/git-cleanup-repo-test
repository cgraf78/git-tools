if [[ "${1:-}" == config && "${2:-}" == --local &&
  "${3:-}" == --null ]]; then
  printf '%s\n' "${sentinel:-unset}" >"$GIT_CONFIG_READ_SENTINEL_CAPTURE"
  printf '.cache\0'
