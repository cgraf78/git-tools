fi

# The streaming helper is subshell-scoped: it must not alter caller traps,
# options, or globals when this sourced library API is used directly.
caller_state_output=$(cd "$readonly_repo" && bash -c '
  source "$1/lib/git-tools-base.sh"
  trap "exit 77" TERM
  trap_before=$(trap -p TERM)
  set +o pipefail
  caller_sentinel=unchanged
  branch=$(git rev-parse refs/heads/readonly-squash)
  base=$(git rev-parse refs/heads/main)
  gt_branch_content_merged "$branch" "$base" || exit 1
  [[ "$(trap -p TERM)" == "$trap_before" ]] || exit 2
  [[ "$caller_sentinel" == unchanged ]] || exit 3
  set -o | grep -q "^pipefail[[:space:]]*off$" || exit 4
  printf preserved
' _ "$ROOT" 2>&1)
_assert_eq "squash helper preserves caller shell state" preserved \
  "$caller_state_output"

# Cleanup paths must not inherit caller attributes through Bash's dynamic
# scoping. In particular, an integer path must never become the unrelated file
# named "0", and readonly names must not prevent proof setup.
caller_collision_output=$(cd "$readonly_repo" && bash -c '
  source "$1/lib/git-tools-base.sh"
  touch 0
  declare -i branch_file=7
  readonly tmpdir=caller
  branch=$(git rev-parse refs/heads/readonly-squash)
  base=$(git rev-parse refs/heads/main)
  gt_branch_content_merged "$branch" "$base" || exit 1
  [[ -e 0 ]] || exit 2
  [[ "$branch_file" == 7 && "$tmpdir" == caller ]] || exit 3
  rm -f 0
  printf isolated
' _ "$ROOT" 2>&1)
_assert_eq "squash cleanup paths ignore caller variable attributes" isolated \
  "$caller_collision_output"

# A handled signal after workspace creation but before the captured EXIT trap is
# installed must still fail the proof conservatively and remove that workspace.
signal_setup_tmp=$(_tmpdir)
signal_setup_marker=$(_tmpdir)/signal-fired
signal_setup_killer=$(_tmpdir)/signal-parent
cat >"$signal_setup_killer" <<'EOF'
#!/bin/bash
kill -TERM "$PPID"
EOF
chmod +x "$signal_setup_killer"
signal_setup_output=$(cd "$readonly_repo" &&
  GIT_PATCH_SIGNAL_KILLER="$signal_setup_killer" \
    GIT_PATCH_SIGNAL_MARKER="$signal_setup_marker" \
    TMPDIR="$signal_setup_tmp" bash -c '
    source "$1/lib/git-tools-base.sh"
    set -T
    trap '\''
      case "$BASH_COMMAND" in
        _gt_squash_branch_file=*)
          trap - DEBUG
          : >"$GIT_PATCH_SIGNAL_MARKER"
          "$GIT_PATCH_SIGNAL_KILLER"
          ;;
      esac
    '\'' DEBUG
    branch=$(git rev-parse refs/heads/readonly-squash)
    base=$(git rev-parse refs/heads/main)
    if gt_branch_content_merged "$branch" "$base"; then
      exit 1
    fi
    trap - DEBUG
    [[ -e "$GIT_PATCH_SIGNAL_MARKER" ]] || exit 2
    printf interrupted
  ' _ "$ROOT" 2>&1)
_assert_eq "setup-time TERM fails squash proof conservatively" interrupted \
  "$signal_setup_output"
_assert_eq "setup-time TERM removes squash workspace" "" \
  "$(_tool_artifacts "$signal_setup_tmp")"

# Every producer in the current-snapshot fallback must complete successfully.
# Use the multi-commit replay fixture: an exact historical squash now returns
# before this fallback by design.
for proof_failure in sort comm; do
  proof_bin=$(_tmpdir)
  cat >"$proof_bin/$proof_failure" <<'EOF'
#!/usr/bin/env bash
exit 88
EOF
  chmod +x "$proof_bin/$proof_failure"
  proof_output=$(cd "$rebase_repo" &&
    PATH="$proof_bin:$PATH" "$ROOT/bin/git-cleanup-repo" 2>&1)
  _assert_contains "$proof_failure failure is not accepted as merged" \
    "keeping rebased; merge not proven" "$proof_output"
  _assert_eq "$proof_failure failure preserves branch" \
    "$(printf 'main\nrebased')" "$(_branches "$rebase_repo")"
done

# Exact raw-delta equality must not add a dependency on cmp: some supported
# minimal distributions do not install it.
cmp_failure_bin=$(_tmpdir)
cat >"$cmp_failure_bin/cmp" <<'EOF'
#!/usr/bin/env bash
exit 127
EOF
chmod +x "$cmp_failure_bin/cmp"
cmp_failure_output=$(cd "$readonly_repo" &&
  PATH="$cmp_failure_bin:$PATH" \
    "$ROOT/bin/git-cleanup-repo" --base main --dry-run 2>&1)
_assert_contains "historical squash proof does not require cmp" \
  "would delete readonly-squash at " "$cmp_failure_output"
_assert_eq "cmp-free dry run preserves the squash branch" \
  "$(printf 'main\nreadonly-squash')" "$(_branches "$readonly_repo")"

# Exact raw-delta equality is mandatory; an indeterminate Git comparison is
# not a historical squash proof and must keep the branch.
comparison_failure_bin=$(_tmpdir)
comparison_failure_log=$(_tmpdir)/git-invocations
cat >"$comparison_failure_bin/git" <<'EOF'
#!/usr/bin/env bash
if [[ "${1:-}" == diff ]]; then
  for arg in "$@"; do
    if [[ "$arg" == --no-index ]]; then
      printf '%s\n' comparison >>"$GIT_COMPARISON_FAILURE_LOG"
      printf '%s\n' 'error: simulated comparator access failure' >&2
      exit 1
    fi
  done
fi
if [[ -e "$GIT_COMPARISON_FAILURE_LOG" ]]; then
  for arg in "$@"; do
    if [[ "$arg" == diff-tree || "$arg" == cherry ]]; then
      printf '%s\n' fallback >>"$GIT_COMPARISON_FAILURE_LOG"
      break
    fi
  done
fi
exec "$GIT_TOOLS_TEST_REAL_GIT" "$@"
EOF
chmod +x "$comparison_failure_bin/git"
comparison_failure_output=$(cd "$readonly_repo" &&
  PATH="$comparison_failure_bin:$PATH" \
    GIT_COMPARISON_FAILURE_LOG="$comparison_failure_log" \
    "$ROOT/bin/git-cleanup-repo" --base main --dry-run 2>&1)
_assert_contains "raw comparison failure is not accepted as squash proof" \
  "keeping readonly-squash; merge not proven" "$comparison_failure_output"
_assert_eq "raw comparison failure stops before replay fallback" comparison \
  "$(<"$comparison_failure_log")"
_assert_eq "raw comparison failure preserves the squash branch" \
  "$(printf 'main\nreadonly-squash')" "$(_branches "$readonly_repo")"

# Failure to open the comparison diagnostic must be distinguishable from
# Git's ordinary status-1 non-match. Exercise both the current direct
# redirection and the separately checked descriptor used by the implementation.
# A self-referential symlink fails even as root while remaining size-false, so
# the old ambiguous status-1 path cannot pass the later diagnostic-size check.
comparison_open_tmp=$(_tmpdir)
comparison_open_output=$(cd "$readonly_repo" &&
  TMPDIR="$comparison_open_tmp" bash -c '
    source "$1/lib/git-tools-base.sh"
    set -T
    trap '\''
      case "$BASH_COMMAND" in
        exec\ 3\>* | git\ diff\ --no-index*)
          trap - DEBUG
          rm -f "$_gt_squash_comparison_error_file"
          ln -s "$_gt_squash_comparison_error_file" \
            "$_gt_squash_comparison_error_file"
          ;;
      esac
    '\'' DEBUG
    branch=$(git rev-parse refs/heads/readonly-squash)
    base=$(git rev-parse refs/heads/main)
    merge_base=$(git merge-base "$base" "$branch") || exit 3
    status=0
    _gt_squash_patch_merged "$branch" "$base" "$merge_base" || status=$?
    trap - DEBUG
    printf "status=%s\n" "$status"
  ' _ "$ROOT" 2>&1)
_assert_contains "comparison diagnostic open failure is indeterminate" \
  "status=2" "$comparison_open_output"
_assert_eq "comparison diagnostic open failure removes workspace" "" \
  "$(_tool_artifacts "$comparison_open_tmp")"

# An operational ancestry failure is unknown, not evidence that content proof
# should run. Keep this fault separate from the cherry producer fault.
ancestor_bin=$(_tmpdir)
cat >"$ancestor_bin/git" <<'EOF'
#!/usr/bin/env bash
if [[ "${1:-}" == merge-base && "${2:-}" == --is-ancestor &&
  "${3:-}" == "$GIT_ANCESTOR_FAIL_TARGET" ]]; then
  exit 88
fi
exec "$GIT_TOOLS_TEST_REAL_GIT" "$@"
EOF
chmod +x "$ancestor_bin/git"
exact_branch_oid=$(git -C "$exact_repo" rev-parse refs/heads/exact-tree)
ancestor_output=$(cd "$exact_repo" &&
  PATH="$ancestor_bin:$PATH" \
    GIT_ANCESTOR_FAIL_TARGET="$exact_branch_oid" \
    "$ROOT/bin/git-cleanup-repo" 2>&1)
_assert_contains "ancestry failure is not accepted as merged" \
  "keeping exact-tree; merge not proven" "$ancestor_output"
_assert_eq "ancestry failure preserves branch" \
  "$(printf 'exact-tree\nmain')" "$(_branches "$exact_repo")"

