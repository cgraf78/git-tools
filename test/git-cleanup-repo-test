cat >"$race_bin/git" <<'SHIM'
#!/usr/bin/env bash
real=$GIT_TOOLS_TEST_REAL_GIT
case " $* " in
  *" update-ref "*" refs/heads/main "*)
    [[ " $* " == *" -d "* ]] || "$real" update-ref refs/heads/main "$RACE_OID"
    ;;
  *" merge --quiet --ff-only "*)
    if [[ -n "${RACE_MERGE:-}" ]]; then
      "$real" update-ref refs/heads/main "$RACE_OID"
      exit 1
    fi
    ;;
esac
exec "$real" "$@"
