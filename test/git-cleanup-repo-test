config_read_rc=$?
unset sentinel
_assert_eq "partial prune config producer fails cleanup" 2 "$config_read_rc"
_assert_contains "partial prune config producer is diagnosed" \
  "could not read repository-local worktree prune paths" "$config_read_output"
_assert_eq "config completion nonce is not exported to its producer" \
  caller-sentinel "$(cat "$config_read_sentinel_capture")"
_assert_eq "partial prune config producer preserves branch" config-read-failure \
  "$(git -C "$config_read_repo" branch --list --format='%(refname:short)' config-read-failure)"
_assert_eq "partial prune config producer preserves cache" present \
  "$(if [[ -e "$config_read_dir/.cache/data" ]]; then printf 'present'; else printf 'missing'; fi)"
_assert_eq "partial prune config producer preserves worktree" present \
  "$(if [[ -e "$config_read_dir" ]]; then printf 'present'; else printf 'missing'; fi)"

# status.showUntrackedFiles=no is common in large work trees. It must not hide
# arbitrary untracked data from cleanup's explicit preflight.
hidden_untracked_repo=$(_clone_remote)
git -C "$hidden_untracked_repo" switch --quiet -c hidden-untracked
_commit_file "$hidden_untracked_repo" hidden-untracked.txt clean \
  "add hidden untracked work"
