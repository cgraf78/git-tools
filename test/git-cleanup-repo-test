_assert_contains "ref advancement makes exact deletion fail closed" \
  "exact ref deletion failed" "$ref_race_output"
if [[ "$ref_race_new" != "$ref_race_old" ]]; then
  _pass "ref advancement preserves the newer branch tip"
else
  _fail "ref advancement preserves the newer branch tip"
fi

# A clean worktree with an active operation is not safe to remove.
operation_repo=$(_clone_remote)
git -C "$operation_repo" switch --quiet -c bisect-work
_commit_file "$operation_repo" bisect.txt work "add bisect work"
git -C "$operation_repo" switch --quiet main
operation_dir=$(_tmpdir)
