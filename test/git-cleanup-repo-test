# Index flags can hide modified tracked files from status. Both skip-worktree
# and assume-unchanged must make automatic worktree removal ineligible.
for hidden_mode in skip-worktree assume-unchanged; do
  hidden_worktree_repo=$(_clone_remote)
  git -C "$hidden_worktree_repo" switch --quiet -c "hidden-$hidden_mode"
