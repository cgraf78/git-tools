    "keeping pr-snapshot; merge not proven" "$result"

  # An open PR named after the branch protects it, even beside a merged PR.
  printf '[[%s]]\n' "$(_pr_json 7 closed '"2026-01-01T00:00:00Z"' "\"$pr_merge\"")" \
    >"$gh_dir/commits-$pr_tip.json"
