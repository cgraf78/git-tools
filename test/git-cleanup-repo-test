  PATH="$literal_prune_bin:$PATH" \
    GIT_LITERAL_PRUNE_PATH="$literal_prune_dir" \
    GIT_LITERAL_PRUNE_REAL="$GIT_TOOLS_TEST_REAL_GIT" \
    "$ROOT/bin/git-cleanup-repo" --base main --all --remove-worktrees 2>&1)
_assert_contains "post-preflight pathspec neighbor blocks removal" \
  "worktree has hidden local content: $literal_prune_dir" \
  "$literal_prune_output"
_assert_eq "literal prune preserves pathspec neighbor" 'late private data' \
