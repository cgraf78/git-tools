late_dirty_output=$(cd "$late_dirty_repo" &&
  PATH="$late_dirty_bin:$PATH" \
    GIT_LATE_DIRTY_PATH="$late_dirty_dir" \
    GIT_LATE_DIRTY_REAL="$GIT_TOOLS_TEST_REAL_GIT" \
    "$ROOT/bin/git-cleanup-repo" --base main --all --remove-worktrees 2>&1)
_assert_contains "late dirty worktree removal fails closed" \
  "worktree could not be removed safely: $late_dirty_dir" "$late_dirty_output"
_assert_eq "late dirty worktree preserves branch" late-dirty \
  "$(git -C "$late_dirty_repo" branch --list --format='%(refname:short)' late-dirty)"
_assert_eq "late dirty worktree remains" present \
  "$(if [[ -e "$late_dirty_dir" ]]; then printf 'present'; else printf 'missing'; fi)"

dirty_worktree_repo=$(_clone_remote)
git -C "$dirty_worktree_repo" switch --quiet -c dirty-work
_commit_file "$dirty_worktree_repo" dirty-work.txt clean "add dirty work"
git -C "$dirty_worktree_repo" switch --quiet main
dirty_worktree_git_dir=$(git -C "$dirty_worktree_repo" rev-parse --absolute-git-dir)
dirty_worktree_dir=$(_tmpdir)
rm -rf "$dirty_worktree_dir"
git -C "$dirty_worktree_repo" worktree add "$dirty_worktree_dir" dirty-work >/dev/null 2>&1
printf '%s\n' dirty >"$dirty_worktree_dir/dirty-work.txt"
result=$(
  GIT_DIR="$dirty_worktree_git_dir" GIT_WORK_TREE="$dirty_worktree_repo" \
    git cleanup-repo --all --remove-worktrees 2>&1
)
_assert_contains "reports dirty linked worktrees without inspecting or removing them" \
  "skipping dirty-work; worktree has uncommitted changes: $dirty_worktree_dir" "$result"
_assert_not_contains "does not let git worktree remove reject dirty worktrees" \
  "fatal:" "$result"
_assert_eq "dirty worktree branch remains" \
  "$(printf 'dirty-work\nmain')" "$(_branches "$dirty_worktree_repo")"

# Porcelain v1 emits a second, headerless NUL record for renames. Preserve a
# renamed worktree without mistaking that continuation record for hidden data
# or a clean checkout.
renamed_worktree_repo=$(_clone_remote)
git -C "$renamed_worktree_repo" switch --quiet -c renamed-work
_commit_file "$renamed_worktree_repo" old-name.txt clean \
  "add rename work"
git -C "$renamed_worktree_repo" switch --quiet main
renamed_worktree_dir=$(_tmpdir)
rm -rf "$renamed_worktree_dir"
git -C "$renamed_worktree_repo" worktree add --quiet \
  "$renamed_worktree_dir" renamed-work
git -C "$renamed_worktree_dir" mv old-name.txt new-name.txt
renamed_worktree_output=$(git -C "$renamed_worktree_repo" cleanup-repo \
  --all --remove-worktrees 2>&1)
_assert_contains "tracked rename prevents worktree removal" \
  "skipping renamed-work; worktree has uncommitted changes: $renamed_worktree_dir" \
  "$renamed_worktree_output"
_assert_eq "tracked rename preserves branch" renamed-work \
  "$(git -C "$renamed_worktree_repo" branch --list \
    --format='%(refname:short)' renamed-work)"
_assert_eq "tracked rename preserves linked checkout" present \
  "$(if [[ -e "$renamed_worktree_dir/new-name.txt" ]]; then printf 'present'; else printf 'missing'; fi)"

# Ignored files are local content even though ordinary porcelain status omits
# them. Never remove a worktree that contains such files.
ignored_worktree_repo=$(_clone_remote)
git -C "$ignored_worktree_repo" switch --quiet -c ignored-work
_commit_file "$ignored_worktree_repo" .gitignore '*.local' "ignore local files"
git -C "$ignored_worktree_repo" switch --quiet main
ignored_worktree_dir=$(_tmpdir)
