_assert_contains "reports exact rich-tree squash merge" \
  "preserving local cleanup candidate exact-tree at " "$result"
_assert_eq "exact rich-tree branch remains" \
  "$(printf 'exact-tree\nmain')" "$(_branches "$exact_repo")"

# Gitlinks participate in the same exact raw-tree proof. An identical target
# is accepted, while a different commit at the same path is not.
gitlink_repo=$(_clone_remote)
gitlink_tree=$(printf '' | git -C "$gitlink_repo" mktree)
gitlink_target=$(printf 'gitlink target\n' |
  git -C "$gitlink_repo" commit-tree "$gitlink_tree")
git -C "$gitlink_repo" switch --quiet -c exact-gitlink
git -C "$gitlink_repo" update-index --add \
  --cacheinfo "160000,$gitlink_target,vendor-link"
git -C "$gitlink_repo" commit --quiet -m "add exact gitlink"
git -C "$gitlink_repo" switch --quiet main
git -C "$gitlink_repo" update-index --add \
  --cacheinfo "160000,$gitlink_target,vendor-link"
git -C "$gitlink_repo" commit --quiet -m "squash exact gitlink"
mkdir "$gitlink_repo/vendor-link"
gitlink_output=$(git -C "$gitlink_repo" cleanup-repo 2>&1)
_assert_contains "reports exact gitlink squash merge" \
  "cleanup candidate exact-gitlink at " "$gitlink_output"

gitlink_distinct_repo=$(_clone_remote)
gitlink_distinct_tree=$(printf '' | git -C "$gitlink_distinct_repo" mktree)
gitlink_branch_target=$(printf 'branch gitlink target\n' |
  git -C "$gitlink_distinct_repo" commit-tree "$gitlink_distinct_tree")
gitlink_base_target=$(printf 'base gitlink target\n' |
  git -C "$gitlink_distinct_repo" commit-tree "$gitlink_distinct_tree")
git -C "$gitlink_distinct_repo" switch --quiet -c distinct-gitlink
git -C "$gitlink_distinct_repo" update-index --add \
  --cacheinfo "160000,$gitlink_branch_target,vendor-link"
git -C "$gitlink_distinct_repo" commit --quiet -m "add branch gitlink"
git -C "$gitlink_distinct_repo" switch --quiet main
git -C "$gitlink_distinct_repo" update-index --add \
  --cacheinfo "160000,$gitlink_base_target,vendor-link"
git -C "$gitlink_distinct_repo" commit --quiet -m "add distinct base gitlink"
mkdir "$gitlink_distinct_repo/vendor-link"
gitlink_distinct_output=$(git -C "$gitlink_distinct_repo" cleanup-repo 2>&1)
_assert_contains "keeps same-path distinct gitlink target" \
  "keeping distinct-gitlink; not merged" "$gitlink_distinct_output"

# Every streamed squash-proof producer is mandatory. A failed diff, log, or
# patch-id command must not fall through to a false merged result.
for proof_failure in diff log patch-id; do
  proof_bin=$(_tmpdir)
  proof_tmp=$(_tmpdir)
  cat >"$proof_bin/git" <<'EOF'
#!/usr/bin/env bash
if [[ "${1:-}" == "$GIT_SQUASH_PROOF_FAILURE" ]]; then
  exit 88
fi
exec "$GIT_TOOLS_TEST_REAL_GIT" "$@"
EOF
  chmod +x "$proof_bin/git"
  proof_output=$(cd "$readonly_repo" &&
    PATH="$proof_bin:$PATH" \
      TMPDIR="$proof_tmp" \
      GIT_SQUASH_PROOF_FAILURE="$proof_failure" \
      "$ROOT/bin/git-cleanup-repo" --base main --dry-run 2>&1)
  _assert_contains "$proof_failure failure is not accepted as a squash proof" \
    "keeping readonly-squash; not merged" "$proof_output"
  _assert_eq "$proof_failure failure preserves the squash branch" \
    "$(printf 'main\nreadonly-squash')" "$(_branches "$readonly_repo")"
  _assert_eq "$proof_failure failure removes private workspace" "" \
    "$(_tool_artifacts "$proof_tmp")"
done

# Successful producers with malformed trailing data are operational failures,
# not a valid non-match that may fall through to the cherry proof.
malformed_bin=$(_tmpdir)
cat >"$malformed_bin/git" <<'EOF'
#!/usr/bin/env bash
if [[ "${1:-}" == patch-id ]]; then
  input=$(cat)
  if [[ "$GIT_MALFORMED_PROOF_MODE" == foreign-width ]]; then
    printf '%064d %064d\n' 1 2
    exit 0
  fi
  if [[ "$input" == commit\ * ]]; then
    valid=$(printf '%s\n' "$input" | "$GIT_TOOLS_TEST_REAL_GIT" "$@") || exit $?
    patch_id=${valid%% *}
    source_id=${valid#* }
    case "$GIT_MALFORMED_PROOF_MODE" in
      one-char) printf 'a %s\n' "$source_id" ;;
      mixed-width) printf '%s %s000000000000000000000000\n' "$patch_id" "$source_id" ;;
      extra) printf '%s extra\n' "$valid" ;;
      unterminated) printf '%s' "$valid" ;;
      *) exit 89 ;;
    esac
    exit 0
  fi
  printf '%s\n' "$input" | "$GIT_TOOLS_TEST_REAL_GIT" "$@"
  exit $?
fi
if [[ "${1:-}" == cherry ]]; then
  printf '%s\n' cherry >>"$GIT_MALFORMED_PROOF_LOG"
fi
exec "$GIT_TOOLS_TEST_REAL_GIT" "$@"
EOF
chmod +x "$malformed_bin/git"
for malformed_mode in one-char mixed-width extra unterminated foreign-width; do
  malformed_log=$(_tmpdir)/git-invocations
  malformed_output=$(cd "$readonly_repo" &&
    PATH="$malformed_bin:$PATH" \
      GIT_MALFORMED_PROOF_LOG="$malformed_log" \
      GIT_MALFORMED_PROOF_MODE="$malformed_mode" \
      "$ROOT/bin/git-cleanup-repo" --base main --dry-run 2>&1)
  _assert_contains "$malformed_mode patch-id record is not accepted as merged" \
    "keeping readonly-squash; not merged" "$malformed_output"
  _assert_eq "$malformed_mode patch-id fails before cherry fallback" "" \
    "$(if [[ -e "$malformed_log" ]]; then printf invoked; fi)"
done

# Squash proof uses a private, invocation-scoped workspace and removes it on a
# successful classification, even under a permissive caller umask.
stream_tmp=$(_tmpdir)
_assert_eq "successful proof TMPDIR starts without artifacts" "" \
  "$(_tool_artifacts "$stream_tmp")"
stream_output=$(cd "$readonly_repo" &&
  (
    umask 000
    TMPDIR="$stream_tmp" "$ROOT/bin/git-cleanup-repo" \
      --base main --dry-run 2>&1
  ))
_assert_contains "streamed squash proof still reports exact merge" \
  "cleanup candidate readonly-squash at " "$stream_output"
_assert_eq "successful squash proof removes private workspace" "" \
  "$(_tool_artifacts "$stream_tmp")"

# Workspace creation is mandatory. Failure must classify conservatively.
mktemp_failure_bin=$(_tmpdir)
mktemp_failure_real=$(command -v mktemp)
cat >"$mktemp_failure_bin/mktemp" <<'EOF'
#!/usr/bin/env bash
case "$*" in
  *git-tools-patch.*) exit 88 ;;
esac
exec "$GIT_PATCH_REAL_MKTEMP" "$@"
EOF
chmod +x "$mktemp_failure_bin/mktemp"
mktemp_failure_output=$(cd "$readonly_repo" &&
  PATH="$mktemp_failure_bin:$PATH" \
    GIT_PATCH_REAL_MKTEMP="$mktemp_failure_real" \
    "$ROOT/bin/git-cleanup-repo" --base main --dry-run 2>&1)
_assert_contains "mktemp failure is not accepted as a squash proof" \
  "keeping readonly-squash; not merged" "$mktemp_failure_output"

# Cleanup failure is also unknown. Leave the injected workspace in place long
# enough to verify restrictive directory and file modes under umask 000.
cleanup_tmp=$(_tmpdir)
cleanup_failure_bin=$(_tmpdir)
cleanup_real_rm=$(command -v rm)
cat >"$cleanup_failure_bin/rm" <<'EOF'
#!/usr/bin/env bash
case "$*" in
  *git-tools-patch.*) exit 88 ;;
esac
exec "$GIT_PATCH_REAL_RM" "$@"
EOF
chmod +x "$cleanup_failure_bin/rm"
cleanup_failure_output=$(cd "$readonly_repo" &&
  (
    umask 000
    TMPDIR="$cleanup_tmp" \
      PATH="$cleanup_failure_bin:$PATH" \
      GIT_PATCH_REAL_RM="$cleanup_real_rm" \
      "$ROOT/bin/git-cleanup-repo" --base main --dry-run 2>&1
  ))
_assert_contains "workspace cleanup failure is not accepted as merged" \
  "keeping readonly-squash; not merged" "$cleanup_failure_output"
cleanup_artifacts=$(_tool_artifacts "$cleanup_tmp")
cleanup_artifact_count=$(printf '%s\n' "$cleanup_artifacts" |
  awk 'NF { count++ } END { print count + 0 }')
_assert_eq "cleanup failure leaves one inspectable workspace" "1" \
  "$cleanup_artifact_count"
if [[ -n "$cleanup_artifacts" ]]; then
  _assert_eq "squash workspace directory is private" "700" \
    "$(_mode "$cleanup_artifacts")"
  _assert_eq "branch patch-id file is private" "600" \
    "$(_mode "$cleanup_artifacts/branch.patch-ids")"
  _assert_eq "base patch-id file is private" "600" \
    "$(_mode "$cleanup_artifacts/base.patch-ids")"
  "$cleanup_real_rm" -f "$cleanup_artifacts/branch.patch-ids" \
    "$cleanup_artifacts/base.patch-ids"
  rmdir "$cleanup_artifacts"
fi

# The streaming helper is subshell-scoped: it must not alter caller traps,
# options, or globals when this sourced library API is used directly.
caller_state_output=$(cd "$readonly_repo" && bash -c '
  source "$1/lib/git-tools-base.sh"
  trap "exit 77" TERM
  trap_before=$(trap -p TERM)
  set +o pipefail
  caller_sentinel=unchanged
  branch=$(git rev-parse refs/heads/readonly-squash)
  base=$(git rev-parse refs/heads/main)
  gt_branch_content_merged "$branch" "$base" || exit 1
  [[ "$(trap -p TERM)" == "$trap_before" ]] || exit 2
  [[ "$caller_sentinel" == unchanged ]] || exit 3
  set -o | grep -q "^pipefail[[:space:]]*off$" || exit 4
  printf preserved
' _ "$ROOT" 2>&1)
_assert_eq "squash helper preserves caller shell state" preserved \
  "$caller_state_output"

# Cleanup paths must not inherit caller attributes through Bash's dynamic
# scoping. In particular, an integer path must never become the unrelated file
# named "0", and readonly names must not prevent proof setup.
caller_collision_output=$(cd "$readonly_repo" && bash -c '
  source "$1/lib/git-tools-base.sh"
  touch 0
  declare -i branch_file=7
  readonly tmpdir=caller
  branch=$(git rev-parse refs/heads/readonly-squash)
  base=$(git rev-parse refs/heads/main)
  gt_branch_content_merged "$branch" "$base" || exit 1
  [[ -e 0 ]] || exit 2
  [[ "$branch_file" == 7 && "$tmpdir" == caller ]] || exit 3
  rm -f 0
  printf isolated
' _ "$ROOT" 2>&1)
_assert_eq "squash cleanup paths ignore caller variable attributes" isolated \
  "$caller_collision_output"

# A handled signal after workspace creation but before the captured EXIT trap is
# installed must still fail the proof conservatively and remove that workspace.
signal_setup_tmp=$(_tmpdir)
signal_setup_marker=$(_tmpdir)/signal-fired
signal_setup_killer=$(_tmpdir)/signal-parent
cat >"$signal_setup_killer" <<'EOF'
#!/bin/bash
kill -TERM "$PPID"
EOF
chmod +x "$signal_setup_killer"
signal_setup_output=$(cd "$readonly_repo" &&
  GIT_PATCH_SIGNAL_KILLER="$signal_setup_killer" \
    GIT_PATCH_SIGNAL_MARKER="$signal_setup_marker" \
    TMPDIR="$signal_setup_tmp" bash -c '
    source "$1/lib/git-tools-base.sh"
    set -T
    trap '\''
      case "$BASH_COMMAND" in
        _gt_squash_branch_file=*)
          trap - DEBUG
          : >"$GIT_PATCH_SIGNAL_MARKER"
          "$GIT_PATCH_SIGNAL_KILLER"
          ;;
      esac
    '\'' DEBUG
    branch=$(git rev-parse refs/heads/readonly-squash)
    base=$(git rev-parse refs/heads/main)
    if gt_branch_content_merged "$branch" "$base"; then
      exit 1
    fi
    trap - DEBUG
    [[ -e "$GIT_PATCH_SIGNAL_MARKER" ]] || exit 2
    printf interrupted
  ' _ "$ROOT" 2>&1)
_assert_eq "setup-time TERM fails squash proof conservatively" interrupted \
  "$signal_setup_output"
_assert_eq "setup-time TERM removes squash workspace" "" \
  "$(_tool_artifacts "$signal_setup_tmp")"

# Every producer in the exact-tree proof must complete successfully.
for proof_failure in sort comm; do
  proof_bin=$(_tmpdir)
  cat >"$proof_bin/$proof_failure" <<'EOF'
#!/usr/bin/env bash
exit 88
EOF
  chmod +x "$proof_bin/$proof_failure"
  proof_output=$(cd "$exact_repo" &&
    PATH="$proof_bin:$PATH" "$ROOT/bin/git-cleanup-repo" 2>&1)
  _assert_contains "$proof_failure failure is not accepted as merged" \
    "keeping exact-tree; not merged" "$proof_output"
  _assert_eq "$proof_failure failure preserves branch" \
    "$(printf 'exact-tree\nmain')" "$(_branches "$exact_repo")"
done

# An operational ancestry failure is unknown, not evidence that content proof
# should run. Keep this fault separate from the cherry producer fault.
ancestor_bin=$(_tmpdir)
cat >"$ancestor_bin/git" <<'EOF'
#!/usr/bin/env bash
if [[ "${1:-}" == merge-base && "${2:-}" == --is-ancestor &&
  "${3:-}" == "$GIT_ANCESTOR_FAIL_TARGET" ]]; then
  exit 88
fi
exec "$GIT_TOOLS_TEST_REAL_GIT" "$@"
EOF
chmod +x "$ancestor_bin/git"
exact_branch_oid=$(git -C "$exact_repo" rev-parse refs/heads/exact-tree)
ancestor_output=$(cd "$exact_repo" &&
  PATH="$ancestor_bin:$PATH" \
    GIT_ANCESTOR_FAIL_TARGET="$exact_branch_oid" \
    "$ROOT/bin/git-cleanup-repo" 2>&1)
_assert_contains "ancestry failure is not accepted as merged" \
  "keeping exact-tree; not merged" "$ancestor_output"
_assert_eq "ancestry failure preserves branch" \
  "$(printf 'exact-tree\nmain')" "$(_branches "$exact_repo")"

# The cherry path must be reached with ancestry fully operational, then reject
# a completed-looking prefix followed by failure.
cherry_bin=$(_tmpdir)
cherry_log=$(_tmpdir)/git-invocations
cat >"$cherry_bin/git" <<'EOF'
#!/usr/bin/env bash
if [[ "${1:-}" == merge-base && "${2:-}" == --is-ancestor ]]; then
  printf '%s\n' ancestry >>"$GIT_CHERRY_PROOF_LOG"
fi
if [[ "${1:-}" == cherry ]]; then
  printf '%s\n' cherry >>"$GIT_CHERRY_PROOF_LOG"
  printf '%s\n' '- partial-proof'
  exit 88
fi
exec "$GIT_TOOLS_TEST_REAL_GIT" "$@"
EOF
chmod +x "$cherry_bin/git"
cherry_output=$(cd "$rebase_repo" &&
  PATH="$cherry_bin:$PATH" \
    GIT_CHERRY_PROOF_LOG="$cherry_log" \
    "$ROOT/bin/git-cleanup-repo" 2>&1)
_assert_contains "cherry failure is not accepted as merged" \
  "keeping rebased; not merged" "$cherry_output"
_assert_contains "cherry fault test exercises ancestry" ancestry \
  "$(<"$cherry_log")"
_assert_contains "cherry fault test reaches git cherry" cherry \
  "$(<"$cherry_log")"
_assert_eq "cherry failure preserves branch" \
  "$(printf 'main\nrebased')" "$(_branches "$rebase_repo")"

# The per-commit replay path also treats an operational grep error as unknown.
grep_failure_bin=$(_tmpdir)
cat >"$grep_failure_bin/grep" <<'EOF'
#!/usr/bin/env bash
if [[ "${1:-}" == -q && "${2:-}" == '^+' ]]; then
  exit 88
fi
exec "$GIT_TOOLS_TEST_REAL_GREP" "$@"
EOF
chmod +x "$grep_failure_bin/grep"
grep_failure_output=$(cd "$rebase_repo" &&
  PATH="$grep_failure_bin:$PATH" "$ROOT/bin/git-cleanup-repo" 2>&1)
_assert_contains "grep failure is not accepted as merged" \
  "keeping rebased; not merged" "$grep_failure_output"
_assert_eq "grep failure preserves branch" \
  "$(printf 'main\nrebased')" "$(_branches "$rebase_repo")"

all_repo=$(_clone_remote)
git -C "$all_repo" switch --quiet -c unmerged
_commit_file "$all_repo" unmerged.txt unmerged "add unmerged"
git -C "$all_repo" push -u origin unmerged >/dev/null 2>&1
git -C "$all_repo" switch --quiet main
result=$(git -C "$all_repo" cleanup-repo --all 2>&1)
_assert_contains "all reports unmerged local candidates" \
  "preserving local cleanup candidate unmerged at " "$result"
_assert_eq "all preserves local branches" \
  "$(printf 'main\nunmerged')" "$(_branches "$all_repo")"

worktree_repo=$(_clone_remote)
git -C "$worktree_repo" switch --quiet -c work
_commit_file "$worktree_repo" work.txt work "add work"
git -C "$worktree_repo" switch --quiet main
worktree_dir=$(_tmpdir)
rm -rf "$worktree_dir"
git -C "$worktree_repo" worktree add "$worktree_dir" work >/dev/null 2>&1
result=$(git -C "$worktree_repo" cleanup-repo --all 2>&1)
_assert_contains "reports checked-out branches without worktree mutation" \
  "preserving local cleanup candidate work at " "$result"
expected="$(printf 'main\nwork')"
_assert_eq "branch remains while worktree is kept" "$expected" "$(_branches "$worktree_repo")"
result=$(git -C "$worktree_repo" cleanup-repo --all --remove-worktrees 2>&1)
_assert_contains "remove-worktrees remains non-destructive" \
  "preserving local cleanup candidate work at " "$result"
_assert_eq "remove-worktrees preserves worktree branch" "$expected" \
  "$(_branches "$worktree_repo")"
_assert_eq "remove-worktrees preserves linked checkout" "work" \
  "$(git -C "$worktree_dir" branch --show-current)"

dirty_worktree_repo=$(_clone_remote)
git -C "$dirty_worktree_repo" switch --quiet -c dirty-work
_commit_file "$dirty_worktree_repo" dirty-work.txt clean "add dirty work"
git -C "$dirty_worktree_repo" switch --quiet main
dirty_worktree_git_dir=$(git -C "$dirty_worktree_repo" rev-parse --absolute-git-dir)
dirty_worktree_dir=$(_tmpdir)
rm -rf "$dirty_worktree_dir"
git -C "$dirty_worktree_repo" worktree add "$dirty_worktree_dir" dirty-work >/dev/null 2>&1
printf '%s\n' dirty >"$dirty_worktree_dir/dirty-work.txt"
result=$(
  GIT_DIR="$dirty_worktree_git_dir" GIT_WORK_TREE="$dirty_worktree_repo" \
    git cleanup-repo --all --remove-worktrees 2>&1
)
_assert_contains "reports dirty linked worktrees without inspecting or removing them" \
  "preserving local cleanup candidate dirty-work at " "$result"
_assert_not_contains "does not let git worktree remove reject dirty worktrees" \
  "fatal:" "$result"
_assert_eq "dirty worktree branch remains" \
  "$(printf 'dirty-work\nmain')" "$(_branches "$dirty_worktree_repo")"

corrupt_worktree_repo=$(_clone_remote)
git -C "$corrupt_worktree_repo" switch --quiet -c corrupt-work
_commit_file "$corrupt_worktree_repo" corrupt-work.txt clean "add corrupt work"
git -C "$corrupt_worktree_repo" switch --quiet main
corrupt_worktree_git_dir=$(git -C "$corrupt_worktree_repo" rev-parse --absolute-git-dir)
corrupt_worktree_dir=$(_tmpdir)
rm -rf "$corrupt_worktree_dir"
git -C "$corrupt_worktree_repo" worktree add "$corrupt_worktree_dir" corrupt-work >/dev/null 2>&1
printf 'gitdir: /nonexistent/gitdir\n' >"$corrupt_worktree_dir/.git"
result=$(
  GIT_DIR="$corrupt_worktree_git_dir" GIT_WORK_TREE="$corrupt_worktree_repo" \
    git cleanup-repo --all --remove-worktrees 2>&1
)
_assert_contains "reports corrupt linked worktrees without inspecting or removing them" \
  "preserving local cleanup candidate corrupt-work at " "$result"
_assert_not_contains "does not remove corrupt worktrees after failed status" \
  "fatal:" "$result"
_assert_eq "corrupt worktree branch remains" \
  "$(printf 'corrupt-work\nmain')" "$(_branches "$corrupt_worktree_repo")"

dirty_repo=$(_clone_remote)
printf 'dirty\n' >"$dirty_repo/dirty.txt"
result=$(git -C "$dirty_repo" cleanup-repo 2>&1 || true)
_assert_contains "refuses dirty worktrees" "worktree must be clean" "$result"
result=$(git -C "$dirty_repo" cleanup-repo --dry-run 2>&1)
_assert_contains "dry run can inspect dirty worktrees" \
  "real cleanup would stop before changing refs" "$result"

if ((_failures > 0)); then
  printf '%s failure(s)\n' "$_failures" >&2
  exit 1
fi

printf 'all tests passed\n'
