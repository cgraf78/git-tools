# Pull request evidence is advisory: only a complete, well-formed
# observation of the exact commit on the pinned base counts. These cases
# drive gt_cleanup_pr_lineage directly with a mocked gh.
lineage_out=$(
  repo=$(_tmpdir)
  _git_init "$repo"
  git -C "$repo" commit -q --allow-empty -m seed
  target=$(git -C "$repo" rev-parse HEAD)
  git -C "$repo" commit -q --allow-empty -m merged
  base=$(git -C "$repo" rev-parse HEAD)
  cd "$repo" || exit 1
  # shellcheck source=../lib/git-tools-base.sh
  . "$ROOT/lib/git-tools-base.sh"
  # shellcheck source=../lib/git-tools-cleanup.sh
  . "$ROOT/lib/git-tools-cleanup.sh"
  # Called by gt_cleanup_pr_lineage in place of the real client.
  # shellcheck disable=SC2329
  gh() {
    case "$*" in
      *'/commits/'*'/pulls'*)
        printf '%s\n' "$pulls"
        return "${pull_error:-0}"
        ;;
      *'/pulls/'*'/commits'*)
        printf '%s\n' "$mock_members"
        return "${member_error:-0}"
        ;;
      *'repos/owner/repo/pulls '*)
        printf '%s\n' "$mock_named"
        return "${named_error:-0}"
        ;;
      *) return 1 ;;
    esac
  }
  record() {
    pulls=$(jq -cn --arg merge "$base" \
      '[[{number:7,state:"closed",merged_at:"2026-01-01",merge_commit_sha:$merge,
        base:{ref:"main",repo:{full_name:"owner/repo"}}}]]')
    mock_members=$(jq -cn --arg target "$target" '[[{sha:$target}]]')
    mock_named='[[]]'
    pull_error=0 member_error=0 named_error=0
  }
  proof() {
    local tip=${1:-$target} pinned=${2:-$base}
    printf '%s|' "$(gt_cleanup_pr_lineage github.com owner/repo feature "$tip" "$pinned" main)"
  }
  record
  proof
  pulls=$(jq '.[0] += [.[0][0] | .number=8 | .state="open" | .merged_at=null]' <<<"$pulls")
  proof
  record
  proof "${target}a"
  pulls=$(jq '.[0][0].base.repo.full_name="other/repo"' <<<"$pulls")
  proof
  record
  pulls=$(jq '.[0][0].base.ref="develop"' <<<"$pulls")
  proof
  record
  pulls=$(jq '.[0][0].merge_commit_sha="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"' <<<"$pulls")
  proof
  record
  proof "$target" "$target"
  record
  mock_members='[[]]'
  proof
