# A worktree that a live process uses as its working directory stays, with its
# branch: removing it would strand an idle shell or agent session.
_in_use_repo() {
  local repo dir

  repo=$(_clone_remote) || return 1
  git -C "$repo" switch --quiet -c busy
  _commit_file "$repo" busy.txt busy "add busy"
  git -C "$repo" switch --quiet main
  dir=$(_tmpdir) || return 1
  rm -rf "$dir"
  git -C "$repo" worktree add "$dir" busy >/dev/null 2>&1 || return 1
  mkdir "$dir/sub"
  printf '%s\t%s\n' "$repo" "$dir"
}

# Park a process in a directory and wait, with a bounded deadline, until it is
# there: its marker is written only after the cd succeeds.
_park() {
  local dir="$1" marker tries=0

  marker=$(_tmpdir)/parked
  (cd "$dir" && : >"$marker" && exec sleep 300) &
  _parked_pid=$!
  _bg_pids+=("$_parked_pid")
  while [[ ! -e "$marker" ]] && ((tries < 500)); do
    sleep 0.01
    tries=$((tries + 1))
  done
  [[ -e "$marker" ]] || printf 'warning: process %s never reached %s\n' \
    "$_parked_pid" "$dir" >&2
}

