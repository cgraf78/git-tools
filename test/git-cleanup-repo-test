chmod +x "$race_bin/git"

# Prints the commit a concurrent writer moves main to: a child of local main.
_race_commit() {
  git -C "$1" commit-tree "$(git -C "$1" rev-parse 'refs/heads/main^{tree}')" \
    -p "$(git -C "$1" rev-parse refs/heads/main)" -m race </dev/null
