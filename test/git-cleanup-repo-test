#!/usr/bin/env bash

set -uo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PATH="$ROOT/bin:$PATH"
export NO_COLOR=1
GIT_TOOLS_TEST_REAL_GIT=$(type -a -p git | tail -n 1)
GIT_TOOLS_TEST_REAL_GREP=$(type -a -p grep | tail -n 1)
export GIT_TOOLS_TEST_REAL_GIT GIT_TOOLS_TEST_REAL_GREP

_failures=0
_suite_tmp_root=$(mktemp -d "${TMPDIR:-/tmp}/git-cleanup-repo-test.XXXXXX") ||
  exit 1

_tmpdir() {
  mktemp -d "$_suite_tmp_root/fixture.XXXXXX"
}

_cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM
  rm -rf -- "$_suite_tmp_root" || status=1
  exit "$status"
}
trap _cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

_pass() {
  printf 'ok - %s\n' "$1"
}

_fail() {
  printf 'not ok - %s\n' "$1" >&2
  _failures=$((_failures + 1))
}

_assert_eq() {
  local name="$1"
  local expected="$2"
  local actual="$3"

  if [[ "$actual" == "$expected" ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected: %q\n' "$expected" >&2
    printf '  actual:   %q\n' "$actual" >&2
  fi
}

_assert_contains() {
  local name="$1"
  local needle="$2"
  local haystack="$3"

  if [[ "$haystack" == *"$needle"* ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected output to contain: %s\n' "$needle" >&2
    printf '  actual output:\n%s\n' "$haystack" >&2
  fi
}

_assert_not_contains() {
  local name="$1"
  local needle="$2"
  local haystack="$3"

  if [[ "$haystack" != *"$needle"* ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected output NOT to contain: %s\n' "$needle" >&2
    printf '  actual output:\n%s\n' "$haystack" >&2
  fi
}

_mode() {
  stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1"
}

_file_fingerprint() {
  local path="$1" metadata

  if [[ ! -e "$path" && ! -L "$path" ]]; then
    printf 'absent\n'
    return 0
  fi
  metadata=$(stat -c '%f %s %y' "$path" 2>/dev/null ||
    stat -f '%p %z %m' "$path") || return 1
  printf '%s ' "$metadata"
  cksum <"$path"
}

_file_bytes() {
  local path="$1"

  if [[ ! -e "$path" && ! -L "$path" ]]; then
    printf 'absent\n'
    return 0
  fi
  cksum <"$path"
}

_refs_snapshot() {
  local git_dir="$1" path

  while IFS= read -r path; do
    printf '%s ' "${path#"$git_dir"/}"
    _file_fingerprint "$path"
  done < <(find "$git_dir/refs" -type f -print | LC_ALL=C sort)
  printf 'HEAD '
  _file_fingerprint "$git_dir/HEAD"
  printf 'packed-refs '
  _file_fingerprint "$git_dir/packed-refs"
  if [[ -d "$git_dir/worktrees" ]]; then
    while IFS= read -r path; do
      printf '%s ' "${path#"$git_dir"/}"
      _file_fingerprint "$path"
    done < <(find "$git_dir/worktrees" -type f -print | LC_ALL=C sort)
  fi
}

_worktree_snapshot() {
  local repo="$1" path

  while IFS= read -r path; do
    printf '%s ' "${path#"$repo"/}"
    _file_fingerprint "$path"
  done < <(find "$repo" -path "$repo/.git" -prune -o -type f -print |
    LC_ALL=C sort)
}

_refs_bytes_snapshot() {
  local git_dir="$1" path

  while IFS= read -r path; do
    printf '%s ' "${path#"$git_dir"/}"
    _file_bytes "$path"
  done < <(find "$git_dir/refs" -type f -print | LC_ALL=C sort)
  printf 'HEAD '
  _file_bytes "$git_dir/HEAD"
  printf 'packed-refs '
  _file_bytes "$git_dir/packed-refs"
}

_worktree_bytes_snapshot() {
  local repo="$1" path

  while IFS= read -r path; do
    printf '%s ' "${path#"$repo"/}"
    _file_bytes "$path"
  done < <(find "$repo" -path "$repo/.git" -prune -o -type f -print |
    LC_ALL=C sort)
}

_git_init() {
  local repo="$1"
  git init -q --initial-branch=main "$repo"
  git -C "$repo" config user.email "test@test.com"
  git -C "$repo" config user.name "Test"
  git -C "$repo" config core.hooksPath /dev/null
}

_commit_file() {
  local repo="$1"
  local path="$2"
  local content="$3"
  local message="$4"

  mkdir -p "$(dirname "$repo/$path")"
  printf '%s\n' "$content" >"$repo/$path"
  git -C "$repo" add "$path"
  git -C "$repo" commit -m "$message" >/dev/null
}

_clone_remote() {
  local remote repo

  remote=$(_tmpdir)
  repo=$(_tmpdir)
  git init --bare --initial-branch=main "$remote" >/dev/null
  _git_init "$repo"
  _commit_file "$repo" README.md base base
  git -C "$repo" remote add origin "$remote"
  git -C "$repo" push -u origin main >/dev/null 2>&1
  printf '%s\n' "$repo"
}

_write_partial_ref_enumeration_failure_git() {
  cat >"$1/git" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == for-each-ref && "$*" == *"%(objectname)"* &&
  "$*" == *"refs/heads"* ]]; then
  "$GIT_PARTIAL_REF_REAL" "$@" | sed -n '1p'
  exit 88
fi
exec "$GIT_PARTIAL_REF_REAL" "$@"
EOF
  chmod +x "$1/git"
}

_write_diff_tree_failure_git() {
  cat >"$1/git" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == "-c" && "${3:-}" == "diff-tree" ]]; then
  for arg; do
    if [[ "$arg" == "$GIT_DIFF_TREE_FAIL_TARGET" ]]; then
      echo "injected diff-tree failure" >&2
      exit 88
    fi
  done
fi
exec "$GIT_DIFF_TREE_REAL" "$@"
EOF
  chmod +x "$1/git"
}

_branches() {
  local repo="$1"
  git -C "$repo" branch --format='%(refname:lstrip=2)' | sort
}

_object_ids() {
  git -C "$1" cat-file --batch-all-objects --batch-check='%(objectname)' |
    LC_ALL=C sort
}

_tool_artifacts() {
  local artifact
  for artifact in \
    "$1"/git-tools-patch.* \
    "$1"/git-cleanup-repo-dry.*; do
    [[ -e "$artifact" ]] || continue
    printf '%s\n' "$artifact"
  done
}

echo "=== git cleanup-repo ==="

# A branch inventory that emits a valid prefix and then fails must abort before
# any candidate is reported or local state is changed.
partial_ref_repo=$(_clone_remote)
git -C "$partial_ref_repo" branch aaa-partial
partial_ref_bin=$(_tmpdir)
partial_ref_real=$GIT_TOOLS_TEST_REAL_GIT
_write_partial_ref_enumeration_failure_git "$partial_ref_bin"
partial_ref_rc=0
partial_ref_output=$(cd "$partial_ref_repo" &&
  PATH="$partial_ref_bin:$PATH" \
    GIT_PARTIAL_REF_REAL="$partial_ref_real" \
    "$ROOT/bin/git-cleanup-repo" --base main 2>&1) || partial_ref_rc=$?
_assert_eq "partial branch inventory fails cleanup" "2" "$partial_ref_rc"
_assert_contains "partial branch inventory is diagnosed" \
  "could not enumerate branches" "$partial_ref_output"
_assert_eq "partial inventory preserves branch" "aaa-partial" \
  "$(git -C "$partial_ref_repo" branch --format='%(refname:short)' --list aaa-partial)"

repo=$(_clone_remote)
git -C "$repo" switch --quiet -c merged
_commit_file "$repo" merged.txt merged "add merged"
git -C "$repo" switch --quiet main
git -C "$repo" merge --no-ff merged -m "merge merged" >/dev/null

git -C "$repo" switch --quiet -c gone
_commit_file "$repo" gone.txt gone "add gone"
git -C "$repo" push -u origin gone >/dev/null 2>&1
git -C "$repo" switch --quiet main
git -C "$repo" push origin --delete gone >/dev/null 2>&1

git -C "$repo" switch --quiet -c keep
_commit_file "$repo" keep.txt keep "add keep"
git -C "$repo" push -u origin keep >/dev/null 2>&1
git -C "$repo" switch --quiet main

result=$(git -C "$repo" cleanup-repo 2>&1)
_assert_contains "reports exact merged cleanup candidate" \
  "preserving local cleanup candidate merged at " "$result"
_assert_contains "reports candidate summary without deletion" \
  "reported 1 local cleanup candidate(s), skipped 2; no local branches deleted" "$result"
expected="$(printf 'gone\nkeep\nmain\nmerged')"
_assert_eq "default cleanup preserves every local branch" "$expected" "$(_branches "$repo")"
result=$(git -C "$repo" cleanup-repo --gone 2>&1)
_assert_contains "gone reports removed-upstream candidates" \
  "preserving local cleanup candidate gone at " "$result"
_assert_eq "gone mode preserves every local branch" "$expected" "$(_branches "$repo")"

squash_repo=$(_clone_remote)
git -C "$squash_repo" switch --quiet -c squashed
_commit_file "$squash_repo" squashed.txt one "add squashed step 1"
_commit_file "$squash_repo" squashed.txt two "edit squashed step 2"
git -C "$squash_repo" switch --quiet main
# Simulate a squash merge: the branch's net change applied as ONE new commit on
# main with a different commit id, exactly what GitHub's squash merge produces.
# The branch tip is not an ancestor of main, so only patch-id detection finds it.
printf '%s\n' two >"$squash_repo/squashed.txt"
git -C "$squash_repo" add squashed.txt
git -C "$squash_repo" commit --quiet -m "squashed (#1)" >/dev/null
result=$(git -C "$squash_repo" cleanup-repo 2>&1)
_assert_contains "default reports squash-merged branches" \
  "preserving local cleanup candidate squashed at " "$result"
_assert_eq "squash-merged branch remains" \
  "$(printf 'main\nsquashed')" "$(_branches "$squash_repo")"

# Dry-run classification is read-only and cannot depend on author identity or
# writable object storage.
readonly_repo=$(_clone_remote)
git -C "$readonly_repo" switch --quiet -c readonly-squash
_commit_file "$readonly_repo" readonly.txt one "readonly step 1"
_commit_file "$readonly_repo" readonly.txt two "readonly step 2"
git -C "$readonly_repo" switch --quiet main
printf '%s\n' two >"$readonly_repo/readonly.txt"
git -C "$readonly_repo" add readonly.txt
git -C "$readonly_repo" commit --quiet -m "squash readonly branch"

readonly_object_dir=$(_tmpdir)
chmod 500 "$readonly_object_dir"
source_object_dir=$(git -C "$readonly_repo" rev-parse --absolute-git-dir)/objects
readonly_result=$(
  GIT_OBJECT_DIRECTORY="$readonly_object_dir" \
    GIT_ALTERNATE_OBJECT_DIRECTORIES="$source_object_dir" \
    git -C "$readonly_repo" cleanup-repo --base main --dry-run 2>&1
)
chmod 700 "$readonly_object_dir"
_assert_contains "cleanup dry-run works with read-only object storage" \
  "cleanup candidate readonly-squash at " "$readonly_result"

objects_before=$(_object_ids "$readonly_repo")
result=$(git -C "$readonly_repo" cleanup-repo --base main --dry-run 2>&1)
objects_after=$(_object_ids "$readonly_repo")
readonly_remote_main_oid=$(git -C "$readonly_repo" ls-remote origin \
  refs/heads/main | awk '{ print $1 }')
_assert_contains "cleanup dry-run reports squash candidate" \
  "cleanup candidate readonly-squash at " "$result"
_assert_contains "ahead dry run pins exact remote OID" \
  "git merge --quiet --ff-only $readonly_remote_main_oid" "$result"
_assert_eq "cleanup dry-run creates no Git objects" "$objects_before" "$objects_after"
readonly_main_oid=$(git -C "$readonly_repo" rev-parse refs/heads/main)
git -C "$readonly_repo" cleanup-repo --base main >/dev/null 2>&1
_assert_eq "ahead real run preserves the preflighted local base" \
  "$readonly_main_oid" "$(git -C "$readonly_repo" rev-parse refs/heads/main)"

identity_name=$(git -C "$readonly_repo" config user.name)
identity_email=$(git -C "$readonly_repo" config user.email)
git -C "$readonly_repo" config --unset user.name
git -C "$readonly_repo" config --unset user.email
identity_result=$(git -C "$readonly_repo" cleanup-repo --base main --dry-run 2>&1)
_assert_contains "cleanup classifies squash merge without commit identity" \
  "cleanup candidate readonly-squash at " "$identity_result"
git -C "$readonly_repo" config user.name "$identity_name"
git -C "$readonly_repo" config user.email "$identity_email"

# Dry-run must not refresh the index stat cache or mutate any repository or
# worktree metadata. A content-clean file with deliberately stale timestamps
# makes an ordinary locking `git status` rewrite the index.
metadata_repo=$(_clone_remote)
metadata_git_dir=$(git -C "$metadata_repo" rev-parse --absolute-git-dir)
touch -t 200001010101 "$metadata_repo/README.md"
printf 'preserved FETCH_HEAD sentinel\n' >"$metadata_git_dir/FETCH_HEAD"
metadata_index_before=$(_file_fingerprint "$metadata_git_dir/index")
metadata_refs_before=$(_refs_snapshot "$metadata_git_dir")
metadata_config_before=$(_file_fingerprint "$metadata_git_dir/config")
metadata_fetch_before=$(_file_fingerprint "$metadata_git_dir/FETCH_HEAD")
metadata_objects_before=$(_object_ids "$metadata_repo")
metadata_worktree_before=$(_worktree_snapshot "$metadata_repo")
git -C "$metadata_repo" cleanup-repo --base main --dry-run >/dev/null 2>&1
_assert_eq "dry run preserves index bytes and metadata" \
  "$metadata_index_before" "$(_file_fingerprint "$metadata_git_dir/index")"
_assert_eq "dry run preserves every ref" \
  "$metadata_refs_before" "$(_refs_snapshot "$metadata_git_dir")"
_assert_eq "dry run preserves config" \
  "$metadata_config_before" "$(_file_fingerprint "$metadata_git_dir/config")"
_assert_eq "dry run preserves FETCH_HEAD" \
  "$metadata_fetch_before" "$(_file_fingerprint "$metadata_git_dir/FETCH_HEAD")"
_assert_eq "dry run preserves permanent objects" \
  "$metadata_objects_before" "$(_object_ids "$metadata_repo")"
_assert_eq "dry run preserves worktree bytes and metadata" \
  "$metadata_worktree_before" "$(_worktree_snapshot "$metadata_repo")"

# Branch/tag collisions must not redirect the base or change emitted branch
# names. The base itself is never a cleanup candidate.
collision_repo=$(_clone_remote)
git -C "$collision_repo" tag main
git -C "$collision_repo" switch --quiet -c feature
_commit_file "$collision_repo" collision.txt feature feature
git -C "$collision_repo" tag feature
git -C "$collision_repo" symbolic-ref HEAD refs/heads/main
git -C "$collision_repo" reset --quiet --hard refs/heads/main
git -C "$collision_repo" merge --quiet --no-ff refs/heads/feature -m \
  "merge collision feature" >/dev/null
collision_result=$(git -C "$collision_repo" cleanup-repo --base main 2>&1)
_assert_contains "collision cleanup reports genuinely merged feature" \
  "cleanup candidate feature at " "$collision_result"
_assert_not_contains "collision cleanup never reports the base branch" \
  "cleanup candidate main at " "$collision_result"
_assert_not_contains "collision cleanup never leaks disambiguated ref spelling" \
  "cleanup candidate heads/" "$collision_result"
_assert_eq "collision cleanup preserves exact local branches" \
  "$(printf 'feature\nmain')" "$(_branches "$collision_repo")"

invalid_base_rc=0
invalid_base_output=$(git -C "$collision_repo" cleanup-repo \
  --base 'main^{commit}' 2>&1) || invalid_base_rc=$?
_assert_eq "cleanup rejects revision syntax as a branch name" "2" "$invalid_base_rc"
_assert_contains "cleanup diagnoses an invalid base branch name" \
  "invalid base branch name" "$invalid_base_output"

# Remote lookup output must be one native object ID. Reject malformed output
# before attempting any fetch or changing the current branch.
remote_oid_repo=$(_clone_remote)
git -C "$remote_oid_repo" switch --quiet -c oid-runner
remote_oid_bin=$(_tmpdir)
remote_oid_log=$(_tmpdir)/fetch-invocations
cat >"$remote_oid_bin/git" <<'EOF'
#!/usr/bin/env bash
if [[ "${1:-}" == ls-remote ]]; then
  printf 'a\trefs/heads/main\n'
  exit 0
fi
if [[ "${1:-}" == fetch ]]; then
  printf '%s\n' "$*" >>"$GIT_REMOTE_OID_LOG"
fi
exec "$GIT_TOOLS_TEST_REAL_GIT" "$@"
EOF
chmod +x "$remote_oid_bin/git"
remote_oid_rc=0
remote_oid_output=$(cd "$remote_oid_repo" &&
  PATH="$remote_oid_bin:$PATH" \
    GIT_REMOTE_OID_LOG="$remote_oid_log" \
    "$ROOT/bin/git-cleanup-repo" --base main 2>&1) || remote_oid_rc=$?
_assert_eq "malformed remote OID fails cleanup" "2" "$remote_oid_rc"
_assert_contains "malformed remote OID is diagnosed" \
  "remote base lookup returned an invalid object ID" "$remote_oid_output"
_assert_eq "malformed remote OID fails before fetch" "" \
  "$(if [[ -e "$remote_oid_log" ]]; then printf invoked; fi)"
_assert_eq "malformed remote OID leaves current branch unchanged" oid-runner \
  "$(git -C "$remote_oid_repo" branch --show-current)"

# An exact-ref fetch failure is also fatal before checkout. Record the complete
# invocation to prove the source is fully qualified and tags/FETCH_HEAD are off.
fetch_failure_repo=$(_clone_remote)
fetch_failure_main=$(git -C "$fetch_failure_repo" rev-parse refs/heads/main)
fetch_failure_url=$(git -C "$fetch_failure_repo" remote get-url origin)
git -C "$fetch_failure_repo" switch --quiet -c fetch-runner
fetch_failure_bin=$(_tmpdir)
fetch_failure_log=$(_tmpdir)/fetch-invocations
cat >"$fetch_failure_bin/git" <<'EOF'
#!/usr/bin/env bash
if [[ "${1:-}" == fetch ]]; then
  printf '%s\n' "$*" >>"$GIT_EXACT_FETCH_LOG"
  exit 88
fi
exec "$GIT_TOOLS_TEST_REAL_GIT" "$@"
EOF
chmod +x "$fetch_failure_bin/git"
fetch_failure_rc=0
fetch_failure_output=$(cd "$fetch_failure_repo" &&
  PATH="$fetch_failure_bin:$PATH" \
    GIT_EXACT_FETCH_LOG="$fetch_failure_log" \
    "$ROOT/bin/git-cleanup-repo" --base main 2>&1) || fetch_failure_rc=$?
_assert_eq "exact remote fetch failure aborts cleanup" "2" "$fetch_failure_rc"
_assert_contains "exact remote fetch failure is diagnosed" \
  "could not fetch exact remote base" "$fetch_failure_output"
_assert_not_contains "fetch failure diagnostics omit the captured endpoint" \
  "$fetch_failure_url" "$fetch_failure_output"
_assert_contains "fetch uses exact head without tags or FETCH_HEAD" \
  "fetch --quiet --no-tags --no-write-fetch-head --no-auto-gc --no-recurse-submodules -- $fetch_failure_url refs/heads/main" \
  "$(<"$fetch_failure_log")"
_assert_eq "fetch failure leaves current branch unchanged" fetch-runner \
  "$(git -C "$fetch_failure_repo" branch --show-current)"
_assert_eq "fetch failure leaves local base unchanged" "$fetch_failure_main" \
  "$(git -C "$fetch_failure_repo" rev-parse refs/heads/main)"

# A dry run with no local base must select the exact remote branch even when a
# same-named remote tag and a configured fetch mapping point elsewhere.
remote_collision_repo=$(_clone_remote)
git -C "$remote_collision_repo" switch --quiet -c remote-merged
_commit_file "$remote_collision_repo" remote.txt merged "add remote merge"
git -C "$remote_collision_repo" switch --quiet main
git -C "$remote_collision_repo" merge --quiet --no-ff remote-merged \
  -m "merge remote feature"
git -C "$remote_collision_repo" push origin main >/dev/null 2>&1
remote_main_oid=$(git -C "$remote_collision_repo" ls-remote origin \
  refs/heads/main | awk '{ print $1 }')
git -C "$remote_collision_repo" switch --quiet -c tag-target
_commit_file "$remote_collision_repo" tag-target.txt tag "tag target"
git -C "$remote_collision_repo" tag main
git -C "$remote_collision_repo" push origin \
  tag-target:refs/heads/release refs/tags/main >/dev/null 2>&1
tag_target_oid=$(git -C "$remote_collision_repo" rev-parse refs/tags/main)
git -C "$remote_collision_repo" config --unset-all remote.origin.fetch
git -C "$remote_collision_repo" config --add remote.origin.fetch \
  '+refs/heads/release:refs/remotes/origin/main'
git -C "$remote_collision_repo" fetch --quiet --no-tags origin
git -C "$remote_collision_repo" switch --quiet -c runner
git -C "$remote_collision_repo" branch -D main tag-target >/dev/null
git -C "$remote_collision_repo" tag -d main >/dev/null
remote_dry_result=$(git -C "$remote_collision_repo" cleanup-repo \
  --base main --dry-run 2>&1)
_assert_contains "remote-only dry run uses exact remote base" \
  "cleanup candidate remote-merged at " "$remote_dry_result"
_assert_contains "remote-only dry run pins the exact remote branch OID" \
  "git merge --quiet --ff-only $remote_main_oid" "$remote_dry_result"
_assert_eq "remote-only dry run does not create a local base" "" \
  "$(git -C "$remote_collision_repo" branch --list main)"
git -C "$remote_collision_repo" cleanup-repo --base main >/dev/null 2>&1
_assert_eq "remote base creation ignores refspec and tag collisions" "$remote_main_oid" \
  "$(git -C "$remote_collision_repo" rev-parse refs/heads/main)"
_assert_eq "created base records the selected remote" origin \
  "$(git -C "$remote_collision_repo" config branch.main.remote)"
_assert_eq "created base tracks the exact remote head" refs/heads/main \
  "$(git -C "$remote_collision_repo" config branch.main.merge)"
_assert_eq "selected-base fetch does not import the colliding tag" "" \
  "$(git -C "$remote_collision_repo" tag --list main)"
if [[ "$remote_main_oid" == "$tag_target_oid" ]]; then
  _fail "remote collision fixture uses distinct objects"
else
  _pass "remote collision fixture uses distinct objects"
fi

# Capture must count configured records without command substitution stripping
# a trailing empty URL and turning two records into one usable-looking value.
multiple_url_repo=$(_clone_remote)
git -C "$multiple_url_repo" config --add remote.origin.url ""
multiple_url_rc=0
multiple_url_output=$(git -C "$multiple_url_repo" cleanup-repo \
  --base main --dry-run 2>&1) || multiple_url_rc=$?
_assert_eq "multiple configured remote URLs are rejected" "2" "$multiple_url_rc"
_assert_contains "multiple configured remote URLs are diagnosed" \
  "could not resolve one fetch endpoint for remote: origin" "$multiple_url_output"

# An option-shaped configured endpoint is still an endpoint, not a Git option.
option_url_repo=$(_clone_remote)
option_url_bin=$(_tmpdir)
option_url_program="$option_url_bin/upload-pack"
option_url_log=$(_tmpdir)/upload-pack-invocations
cat >"$option_url_program" <<'EOF'
#!/usr/bin/env bash
printf 'invoked\n' >>"$GIT_OPTION_URL_LOG"
exit 88
EOF
chmod +x "$option_url_program"
git -C "$option_url_repo" config remote.origin.url \
  "--upload-pack=$option_url_program"
option_url_rc=0
option_url_output=$(cd "$option_url_repo" &&
  GIT_OPTION_URL_LOG="$option_url_log" \
    "$ROOT/bin/git-cleanup-repo" --base main --dry-run 2>&1) || option_url_rc=$?
_assert_eq "option-shaped remote URL is rejected as an endpoint" "2" "$option_url_rc"
_assert_contains "option-shaped remote URL failure is diagnosed" \
  "could not inspect remote base branch: origin/main" "$option_url_output"
_assert_eq "option-shaped remote URL never invokes an upload-pack program" "" \
  "$(if [[ -e "$option_url_log" ]]; then printf invoked; fi)"

# The raw configured endpoint must be reused so each Git operation applies its
# URL rewrite once and never reaches a chained second endpoint.
rewrite_first_remote=$(_tmpdir)
rewrite_first_publisher=$(_tmpdir)
git init --quiet --bare --initial-branch=main "$rewrite_first_remote"
_git_init "$rewrite_first_publisher"
_commit_file "$rewrite_first_publisher" endpoint.txt first "first endpoint"
git -C "$rewrite_first_publisher" remote add origin "$rewrite_first_remote"
git -C "$rewrite_first_publisher" push --quiet -u origin main
rewrite_first_oid=$(git -C "$rewrite_first_publisher" rev-parse refs/heads/main)

rewrite_second_remote=$(_tmpdir)
rewrite_second_publisher=$(_tmpdir)
git init --quiet --bare --initial-branch=main "$rewrite_second_remote"
_git_init "$rewrite_second_publisher"
_commit_file "$rewrite_second_publisher" endpoint.txt second "second endpoint"
git -C "$rewrite_second_publisher" remote add origin "$rewrite_second_remote"
git -C "$rewrite_second_publisher" push --quiet -u origin main
rewrite_second_oid=$(git -C "$rewrite_second_publisher" rev-parse refs/heads/main)

rewrite_repo=$(_tmpdir)
_git_init "$rewrite_repo"
_commit_file "$rewrite_repo" local.txt local "local runner"
git -C "$rewrite_repo" branch --move runner
git -C "$rewrite_repo" remote add origin https://rewrite.test/example/repo.git
git -C "$rewrite_repo" config \
  "url.file://$rewrite_first_remote.insteadOf" \
  https://rewrite.test/example/repo.git
git -C "$rewrite_repo" config \
  "url.file://$rewrite_second_remote.insteadOf" \
  "file://$rewrite_first_remote"
rewrite_rc=0
rewrite_output=$(git -C "$rewrite_repo" cleanup-repo \
  --base main --dry-run 2>&1) || rewrite_rc=$?
_assert_eq "chained rewrite dry run succeeds through first endpoint" "0" "$rewrite_rc"
_assert_contains "chained rewrite lookup and fetch pin the first endpoint" \
  "git merge --quiet --ff-only $rewrite_first_oid" "$rewrite_output"
_assert_not_contains "chained rewrite never reaches the second endpoint" \
  "$rewrite_second_oid" "$rewrite_output"

# Exact endpoint selection also works when the configured fetch mapping omits
# the requested branch and no corresponding remote-tracking ref exists.
excluded_refspec_repo=$(_clone_remote)
git -C "$excluded_refspec_repo" switch --quiet -c excluded-merged
_commit_file "$excluded_refspec_repo" excluded.txt merged "add excluded merge"
git -C "$excluded_refspec_repo" switch --quiet main
git -C "$excluded_refspec_repo" merge --quiet --no-ff excluded-merged \
  -m "merge excluded feature"
git -C "$excluded_refspec_repo" push origin main >/dev/null 2>&1
excluded_main_oid=$(git -C "$excluded_refspec_repo" ls-remote origin \
  refs/heads/main | awk '{ print $1 }')
git -C "$excluded_refspec_repo" config --unset-all remote.origin.fetch
git -C "$excluded_refspec_repo" config --add remote.origin.fetch \
  '+refs/heads/release:refs/remotes/origin/release'
git -C "$excluded_refspec_repo" update-ref -d refs/remotes/origin/main
git -C "$excluded_refspec_repo" switch --quiet -c excluded-runner
git -C "$excluded_refspec_repo" branch -D main >/dev/null
excluded_dry_result=$(git -C "$excluded_refspec_repo" cleanup-repo \
  --base main --dry-run 2>&1)
_assert_contains "excluded refspec dry run uses real remote main" \
  "cleanup candidate excluded-merged at " "$excluded_dry_result"
git -C "$excluded_refspec_repo" cleanup-repo --base main >/dev/null 2>&1
_assert_eq "excluded refspec real run creates exact remote main" \
  "$excluded_main_oid" \
  "$(git -C "$excluded_refspec_repo" rev-parse refs/heads/main)"

# Configured fetch destinations are untrusted. In particular, pruning a remote
# whose wildcard destination is refs/heads would delete local-only branches.
# Exact base fetching must not execute that refspec or prune any destination.
malicious_refspec_repo=$(_clone_remote)
git -C "$malicious_refspec_repo" switch --quiet -c local-only
_commit_file "$malicious_refspec_repo" local-only.txt local "add local-only work"
git -C "$malicious_refspec_repo" switch --quiet main
git -C "$malicious_refspec_repo" branch linked-local
malicious_link_parent=$(_tmpdir)
malicious_linked="$malicious_link_parent/worktree"
git -C "$malicious_refspec_repo" worktree add --quiet \
  "$malicious_linked" linked-local
printf '%s\n' linked >"$malicious_linked/linked.txt"
git -C "$malicious_linked" add linked.txt
git -C "$malicious_linked" commit --quiet -m "add linked local work"
git -C "$malicious_refspec_repo" config --unset-all remote.origin.fetch
git -C "$malicious_refspec_repo" config --add remote.origin.fetch \
  '+refs/heads/*:refs/heads/*'
malicious_git_dir=$(git -C "$malicious_refspec_repo" rev-parse --absolute-git-dir)
malicious_refs_before=$(_refs_bytes_snapshot "$malicious_git_dir")
malicious_config_before=$(_file_fingerprint "$malicious_git_dir/config")
malicious_main_before=$(_worktree_bytes_snapshot "$malicious_refspec_repo")
malicious_linked_before=$(_worktree_bytes_snapshot "$malicious_linked")
malicious_rc=0
git -C "$malicious_refspec_repo" cleanup-repo --base main \
  >/dev/null 2>&1 || malicious_rc=$?
_assert_eq "malicious refspec cleanup succeeds conservatively" "0" "$malicious_rc"
_assert_eq "malicious refspec preserves every local ref" \
  "$malicious_refs_before" "$(_refs_bytes_snapshot "$malicious_git_dir")"
_assert_eq "malicious refspec preserves config" \
  "$malicious_config_before" "$(_file_fingerprint "$malicious_git_dir/config")"
_assert_eq "malicious refspec preserves main worktree" \
  "$malicious_main_before" "$(_worktree_bytes_snapshot "$malicious_refspec_repo")"
_assert_eq "malicious refspec preserves linked worktree" \
  "$malicious_linked_before" "$(_worktree_bytes_snapshot "$malicious_linked")"

# A behind local base is preflighted against the pinned remote OID. Dry-run and
# real execution must describe and merge that identical object.
behind_base_repo=$(_clone_remote)
behind_old_oid=$(git -C "$behind_base_repo" rev-parse refs/heads/main)
git -C "$behind_base_repo" switch --quiet -c behind-merged
_commit_file "$behind_base_repo" behind.txt merged "add behind merge"
git -C "$behind_base_repo" switch --quiet main
git -C "$behind_base_repo" merge --quiet --no-ff behind-merged \
  -m "merge behind feature"
git -C "$behind_base_repo" push origin main >/dev/null 2>&1
behind_remote_oid=$(git -C "$behind_base_repo" ls-remote origin \
  refs/heads/main | awk '{ print $1 }')
git -C "$behind_base_repo" reset --quiet --hard "$behind_old_oid"
git -C "$behind_base_repo" switch --quiet -c behind-runner "$behind_old_oid"
behind_dry_result=$(git -C "$behind_base_repo" cleanup-repo \
  --base main --dry-run 2>&1)
_assert_contains "behind dry run classifies against pinned remote base" \
  "cleanup candidate behind-merged at " "$behind_dry_result"
_assert_contains "behind dry run prints pinned ff-only merge" \
  "git merge --quiet --ff-only $behind_remote_oid" "$behind_dry_result"
git -C "$behind_base_repo" cleanup-repo --base main >/dev/null 2>&1
_assert_eq "behind real run merges the dry-run OID" "$behind_remote_oid" \
  "$(git -C "$behind_base_repo" rev-parse refs/heads/main)"

# When the pinned remote commit is not in local object storage, dry-run fetches
# it into an isolated object directory and removes that directory on exit.
isolated_dry_repo=$(_clone_remote)
isolated_remote=$(git -C "$isolated_dry_repo" remote get-url origin)
isolated_publisher=$(_tmpdir)
git clone --quiet "$isolated_remote" "$isolated_publisher"
git -C "$isolated_publisher" config user.email test@test.com
git -C "$isolated_publisher" config user.name Test
git -C "$isolated_publisher" config core.hooksPath /dev/null
_commit_file "$isolated_publisher" remote-only.txt remote \
  "advance unseen remote base"
git -C "$isolated_publisher" push --quiet origin main
isolated_remote_oid=$(git -C "$isolated_publisher" rev-parse refs/heads/main)
git -C "$isolated_dry_repo" switch --quiet -c isolated-runner
isolated_tmp=$(_tmpdir)
isolated_objects_before=$(_object_ids "$isolated_dry_repo")
_assert_eq "isolated dry-run TMPDIR starts without artifacts" "" \
  "$(_tool_artifacts "$isolated_tmp")"
isolated_dry_output=$(TMPDIR="$isolated_tmp" \
  git -C "$isolated_dry_repo" cleanup-repo --base main --dry-run 2>&1)
isolated_objects_after=$(_object_ids "$isolated_dry_repo")
_assert_contains "isolated dry run pins unseen remote OID" \
  "git merge --quiet --ff-only $isolated_remote_oid" "$isolated_dry_output"
_assert_eq "isolated dry run does not import objects" \
  "$isolated_objects_before" "$isolated_objects_after"
_assert_eq "isolated dry run removes object-store artifacts" "" \
  "$(_tool_artifacts "$isolated_tmp")"

# An unseen base in a shallow clone exercises object transfer while proving the
# isolated dry run leaves every persistent repository surface byte-for-byte
# unchanged, including the shallow boundary.
shallow_seed=$(_clone_remote)
shallow_remote=$(git -C "$shallow_seed" remote get-url origin)
shallow_client=$(_tmpdir)
rm -rf "$shallow_client"
git clone --quiet --depth=1 "file://$shallow_remote" "$shallow_client"
shallow_publisher=$(_tmpdir)
git clone --quiet "$shallow_remote" "$shallow_publisher"
git -C "$shallow_publisher" config user.email test@test.com
git -C "$shallow_publisher" config user.name Test
git -C "$shallow_publisher" config core.hooksPath /dev/null
_commit_file "$shallow_publisher" shallow.txt remote "advance shallow base"
git -C "$shallow_publisher" push --quiet origin main
shallow_remote_oid=$(git -C "$shallow_publisher" rev-parse refs/heads/main)
shallow_git_dir=$(git -C "$shallow_client" rev-parse --absolute-git-dir)
printf 'preserved shallow FETCH_HEAD sentinel\n' >"$shallow_git_dir/FETCH_HEAD"
shallow_index_before=$(_file_fingerprint "$shallow_git_dir/index")
shallow_refs_before=$(_refs_snapshot "$shallow_git_dir")
shallow_config_before=$(_file_fingerprint "$shallow_git_dir/config")
shallow_fetch_before=$(_file_fingerprint "$shallow_git_dir/FETCH_HEAD")
shallow_boundary_before=$(_file_fingerprint "$shallow_git_dir/shallow")
shallow_objects_before=$(_object_ids "$shallow_client")
shallow_worktree_before=$(_worktree_snapshot "$shallow_client")
shallow_rc=0
shallow_output=$(git -C "$shallow_client" cleanup-repo \
  --base main --dry-run 2>&1) || shallow_rc=$?
_assert_eq "shallow unseen-base dry run succeeds" "0" "$shallow_rc"
_assert_contains "shallow dry run pins unseen remote OID" \
  "git merge --quiet --ff-only $shallow_remote_oid" "$shallow_output"
_assert_eq "shallow dry run preserves index" \
  "$shallow_index_before" "$(_file_fingerprint "$shallow_git_dir/index")"
_assert_eq "shallow dry run preserves refs and worktree metadata" \
  "$shallow_refs_before" "$(_refs_snapshot "$shallow_git_dir")"
_assert_eq "shallow dry run preserves config" \
  "$shallow_config_before" "$(_file_fingerprint "$shallow_git_dir/config")"
_assert_eq "shallow dry run preserves FETCH_HEAD" \
  "$shallow_fetch_before" "$(_file_fingerprint "$shallow_git_dir/FETCH_HEAD")"
_assert_eq "shallow dry run preserves shallow boundary" \
  "$shallow_boundary_before" "$(_file_fingerprint "$shallow_git_dir/shallow")"
_assert_eq "shallow dry run preserves permanent objects" \
  "$shallow_objects_before" "$(_object_ids "$shallow_client")"
_assert_eq "shallow dry run preserves worktree" \
  "$shallow_worktree_before" "$(_worktree_snapshot "$shallow_client")"

# Git 2.29 predates rev-parse --path-format. The isolated-object path must remain
# usable at the documented baseline.
legacy_git_bin=$(_tmpdir)
legacy_git_real=$GIT_TOOLS_TEST_REAL_GIT
cat >"$legacy_git_bin/git" <<'EOF'
#!/usr/bin/env bash
for argument in "$@"; do
  case "$argument" in
    --path-format | --path-format=*) exit 88 ;;
  esac
done
exec "$GIT_LEGACY_REAL" "$@"
EOF
chmod +x "$legacy_git_bin/git"
legacy_git_rc=0
legacy_git_output=$(cd "$isolated_dry_repo" &&
  PATH="$legacy_git_bin:$PATH" GIT_LEGACY_REAL="$legacy_git_real" \
    "$ROOT/bin/git-cleanup-repo" --base main --dry-run 2>&1) ||
  legacy_git_rc=$?
_assert_eq "Git 2.29-compatible dry run avoids rev-parse path-format" \
  "0" "$legacy_git_rc"
_assert_contains "Git 2.29-compatible dry run still pins unseen remote OID" \
  "git merge --quiet --ff-only $isolated_remote_oid" "$legacy_git_output"

# Fetch can run configured automatic maintenance even when its object writes are
# isolated. A dry run must suppress that secondary mutation path so maintenance
# cannot prune persistent repository metadata.
maintenance_worktree=$(_tmpdir)
rm -rf "$maintenance_worktree"
git -C "$isolated_dry_repo" worktree add --quiet \
  -b maintenance-stale "$maintenance_worktree" refs/heads/main
maintenance_metadata=$(git -C "$maintenance_worktree" rev-parse --absolute-git-dir)
rm -rf "$maintenance_worktree"
touch -t 200001010101 "$maintenance_metadata/gitdir" "$maintenance_metadata"
_commit_file "$isolated_publisher" maintenance.txt remote \
  "advance base before maintenance dry run"
git -C "$isolated_publisher" push --quiet origin main
git -C "$isolated_dry_repo" config maintenance.worktree-prune.enabled true
git -C "$isolated_dry_repo" config maintenance.worktree-prune.auto 1
git -C "$isolated_dry_repo" config maintenance.autoDetach false
git -C "$isolated_dry_repo" config gc.worktreePruneExpire now
maintenance_dry_rc=0
TMPDIR="$isolated_tmp" git -C "$isolated_dry_repo" cleanup-repo \
  --base main --dry-run >/dev/null 2>&1 || maintenance_dry_rc=$?
_assert_eq "configured maintenance dry run succeeds" "0" "$maintenance_dry_rc"
_assert_eq "dry run preserves stale linked-worktree metadata" "present" \
  "$(if [[ -d "$maintenance_metadata" ]]; then printf present; else printf absent; fi)"

# Configured submodule recursion is another persistent fetch side effect. When
# both the superproject and one of its submodules advance remotely, dry-run must
# not import the unseen submodule object into the submodule's real object store.
submodule_remote=$(_tmpdir)
submodule_publisher=$(_tmpdir)
git init --quiet --bare --initial-branch=main "$submodule_remote"
_git_init "$submodule_publisher"
_commit_file "$submodule_publisher" data.txt v1 "submodule v1"
git -C "$submodule_publisher" remote add origin "$submodule_remote"
git -C "$submodule_publisher" push --quiet -u origin main

super_remote=$(_tmpdir)
super_publisher=$(_tmpdir)
git init --quiet --bare --initial-branch=main "$super_remote"
_git_init "$super_publisher"
git -c protocol.file.allow=always -C "$super_publisher" submodule add \
  --quiet "$submodule_remote" sub
git -C "$super_publisher" commit --quiet -m "superproject v1"
git -C "$super_publisher" remote add origin "$super_remote"
git -C "$super_publisher" push --quiet -u origin main

submodule_client=$(_tmpdir)
rm -rf "$submodule_client"
git -c protocol.file.allow=always clone --quiet --recurse-submodules \
  "$super_remote" "$submodule_client"
_commit_file "$submodule_publisher" data.txt v2 "submodule v2"
git -C "$submodule_publisher" push --quiet origin main
git -c protocol.file.allow=always -C "$super_publisher/sub" fetch --quiet origin
git -C "$super_publisher/sub" checkout --quiet refs/remotes/origin/main
git -C "$super_publisher" add sub
git -C "$super_publisher" commit --quiet -m "superproject v2"
git -C "$super_publisher" push --quiet origin main
unseen_submodule_oid=$(git -C "$submodule_publisher" rev-parse refs/heads/main)
submodule_before=absent
git -C "$submodule_client/sub" cat-file \
  -e "$unseen_submodule_oid^{commit}" 2>/dev/null && submodule_before=present
_assert_eq "submodule commit starts unseen" "absent" "$submodule_before"
git -C "$submodule_client" config fetch.recurseSubmodules on-demand
submodule_dry_rc=0
GIT_ALLOW_PROTOCOL=file TMPDIR="$isolated_tmp" \
  git -C "$submodule_client" cleanup-repo --base main --dry-run \
  >/dev/null 2>&1 || submodule_dry_rc=$?
submodule_after=absent
git -C "$submodule_client/sub" cat-file \
  -e "$unseen_submodule_oid^{commit}" 2>/dev/null && submodule_after=present
_assert_eq "configured recursive-fetch dry run succeeds" "0" "$submodule_dry_rc"
_assert_eq "dry run does not import unseen submodule objects" \
  "absent" "$submodule_after"

# A dry run cannot classify against an invented result when the real ff-only
# pull would reject divergent local and remote base histories.
diverged_base_repo=$(_clone_remote)
git -C "$diverged_base_repo" switch --quiet -c remote-update \
  refs/remotes/origin/main
_commit_file "$diverged_base_repo" remote-base.txt remote "advance remote base"
git -C "$diverged_base_repo" push origin remote-update:main >/dev/null 2>&1
git -C "$diverged_base_repo" switch --quiet main
_commit_file "$diverged_base_repo" local-base.txt local "diverge local base"
git -C "$diverged_base_repo" switch --quiet -c diverged-runner
diverged_base_rc=0
diverged_base_output=$(git -C "$diverged_base_repo" cleanup-repo \
  --base main --dry-run 2>&1) || diverged_base_rc=$?
_assert_eq "divergent dry-run base fails closed" "2" "$diverged_base_rc"
_assert_contains "divergent dry-run base is diagnosed" \
  "local base cannot be fast-forwarded to origin/main" "$diverged_base_output"
diverged_main_oid=$(git -C "$diverged_base_repo" rev-parse refs/heads/main)
diverged_real_rc=0
diverged_real_output=$(git -C "$diverged_base_repo" cleanup-repo \
  --base main 2>&1) || diverged_real_rc=$?
_assert_eq "divergent real base fails closed" "2" "$diverged_real_rc"
_assert_contains "divergent real base is diagnosed before checkout" \
  "local base cannot be fast-forwarded to origin/main" "$diverged_real_output"
_assert_eq "divergent failure leaves current branch unchanged" \
  diverged-runner \
  "$(git -C "$diverged_base_repo" branch --show-current)"
_assert_eq "divergent failure leaves local base unchanged" \
  "$diverged_main_oid" \
  "$(git -C "$diverged_base_repo" rev-parse refs/heads/main)"

rebase_repo=$(_clone_remote)
git -C "$rebase_repo" switch --quiet -c rebased
_commit_file "$rebase_repo" r1.txt one "rebased step 1"
_commit_file "$rebase_repo" r2.txt two "rebased step 2"
git -C "$rebase_repo" switch --quiet main
# main advances independently first (as it has by the time a PR lands), so the
# replayed commits get new ids and the branch tip is definitively not an
# ancestor of main. Without this, cherry-pick can reproduce byte-identical SHAs
# (same content + same-second committer date) and the branch would be detected
# as a plain ancestor merge instead of a content (patch-id) merge.
_commit_file "$rebase_repo" mainline.txt main "unrelated mainline commit"
# Simulate a rebase merge: each branch commit replayed onto main as a NEW commit.
# The collapsed-diff probe will not match, but every commit's patch-id is
# present, which the per-commit check detects.
git -C "$rebase_repo" cherry-pick rebased~1 rebased >/dev/null 2>&1
result=$(git -C "$rebase_repo" cleanup-repo 2>&1)
_assert_contains "default reports multi-commit rebase-merged branches" \
  "preserving local cleanup candidate rebased at " "$result"
_assert_eq "rebase-merged branch remains" \
  "$(printf 'main\nrebased')" "$(_branches "$rebase_repo")"

unmerged_repo=$(_clone_remote)
git -C "$unmerged_repo" switch --quiet -c partial
_commit_file "$unmerged_repo" partial.txt one "add partial step 1"
git -C "$unmerged_repo" switch --quiet main
# Only part of the branch's diff is on main (a different file), so the patch-id
# check must NOT consider it merged and the branch must be kept by default.
_commit_file "$unmerged_repo" other.txt other "add unrelated commit"
result=$(git -C "$unmerged_repo" cleanup-repo 2>&1)
_assert_contains "keeps branches that are not content-merged" \
  "keeping partial; not merged" "$result"
_assert_eq "unmerged branch survives default cleanup" \
  "$(printf 'main\npartial')" "$(_branches "$unmerged_repo")"

# Any unmerged content must keep the branch, even when some of it landed. A
# rebase that replayed only the first commit leaves a second commit unmerged.
rebase_partial_repo=$(_clone_remote)
git -C "$rebase_partial_repo" switch --quiet -c rebased-extra
_commit_file "$rebase_partial_repo" re1.txt one "rebased-extra step 1"
_commit_file "$rebase_partial_repo" re2.txt two "rebased-extra step 2"
git -C "$rebase_partial_repo" switch --quiet main
git -C "$rebase_partial_repo" cherry-pick rebased-extra~1 >/dev/null 2>&1
result=$(git -C "$rebase_partial_repo" cleanup-repo 2>&1)
_assert_contains "keeps a partially rebase-merged branch with an extra commit" \
  "keeping rebased-extra; not merged" "$result"
_assert_eq "partially rebase-merged branch survives" \
  "$(printf 'main\nrebased-extra')" "$(_branches "$rebase_partial_repo")"

# Squash-merge the branch's first commits, then add one more commit that was
# never merged. The collapsed-diff probe will not match (extra content) and the
# per-commit check sees the unmerged commit, so the branch must be kept.
squash_partial_repo=$(_clone_remote)
git -C "$squash_partial_repo" switch --quiet -c squashed-extra
_commit_file "$squash_partial_repo" se1.txt one "squashed-extra step 1"
_commit_file "$squash_partial_repo" se2.txt two "squashed-extra step 2"
git -C "$squash_partial_repo" switch --quiet main
printf '%s\n' one >"$squash_partial_repo/se1.txt"
printf '%s\n' two >"$squash_partial_repo/se2.txt"
git -C "$squash_partial_repo" add se1.txt se2.txt
git -C "$squash_partial_repo" commit --quiet -m "squashed-extra (#1)"
git -C "$squash_partial_repo" switch --quiet squashed-extra
_commit_file "$squash_partial_repo" se3.txt three "squashed-extra step 3 (unmerged)"
git -C "$squash_partial_repo" switch --quiet main
result=$(git -C "$squash_partial_repo" cleanup-repo 2>&1)
_assert_contains "keeps a squash-merged branch with an extra unmerged commit" \
  "keeping squashed-extra; not merged" "$result"
_assert_eq "squash-merged branch with extra work survives" \
  "$(printf 'main\nsquashed-extra')" "$(_branches "$squash_partial_repo")"

# Patch IDs deliberately ignore whitespace, but cleanup classification must use
# the exact net tree and reject byte-distinct content.
whitespace_repo=$(_clone_remote)
git -C "$whitespace_repo" switch --quiet -c whitespace-distinct
printf 'alpha beta\n' >"$whitespace_repo/whitespace.txt"
git -C "$whitespace_repo" add whitespace.txt
git -C "$whitespace_repo" commit --quiet -m "add branch whitespace"
git -C "$whitespace_repo" switch --quiet main
printf 'alpha    beta\n' >"$whitespace_repo/whitespace.txt"
git -C "$whitespace_repo" add whitespace.txt
git -C "$whitespace_repo" commit --quiet -m "add main whitespace"
result=$(git -C "$whitespace_repo" cleanup-repo 2>&1)
_assert_contains "keeps patch-equivalent byte-distinct content" \
  "keeping whitespace-distinct; not merged" "$result"
_assert_eq "byte-distinct branch survives default cleanup" \
  "$(printf 'main\nwhitespace-distinct')" "$(_branches "$whitespace_repo")"

# Failure to produce either exact delta is not proof of a merge.
whitespace_branch_oid=$(git -C "$whitespace_repo" rev-parse whitespace-distinct)
whitespace_base_oid=$(git -C "$whitespace_repo" rev-parse main)
diff_failure_bin=$(_tmpdir)
_write_diff_tree_failure_git "$diff_failure_bin"
for failure_side in base branch; do
  case "$failure_side" in
    branch) diff_failure_target=$whitespace_branch_oid ;;
    base) diff_failure_target=$whitespace_base_oid ;;
  esac
  diff_failure_output=$(cd "$whitespace_repo" &&
    PATH="$diff_failure_bin:$PATH" \
      GIT_DIFF_TREE_FAIL_TARGET="$diff_failure_target" \
      GIT_DIFF_TREE_REAL="$GIT_TOOLS_TEST_REAL_GIT" \
      "$ROOT/bin/git-cleanup-repo" 2>&1)
  _assert_contains "keeps branch after $failure_side delta producer failure" \
    "keeping whitespace-distinct; not merged" "$diff_failure_output"
  _assert_eq "$failure_side delta producer failure preserves branch" \
    "$whitespace_branch_oid" \
    "$(git -C "$whitespace_repo" rev-parse refs/heads/whitespace-distinct)"
done

# Exact comparison covers tree modes and later same-path edits, not only bytes.
tree_repo=$(_clone_remote)
git -C "$tree_repo" switch --quiet -c mode-distinct
printf 'same bytes\n' >"$tree_repo/mode.txt"
chmod +x "$tree_repo/mode.txt"
git -C "$tree_repo" add mode.txt
git -C "$tree_repo" commit --quiet -m "add executable"
git -C "$tree_repo" switch --quiet main
printf 'same bytes\n' >"$tree_repo/mode.txt"
git -C "$tree_repo" add mode.txt
git -C "$tree_repo" commit --quiet -m "add regular file"
result=$(git -C "$tree_repo" cleanup-repo 2>&1)
_assert_contains "keeps mode-distinct tree entry" \
  "keeping mode-distinct; not merged" "$result"

later_repo=$(_clone_remote)
git -C "$later_repo" switch --quiet -c landed-then-edited
_commit_file "$later_repo" shared.txt landed "add landed content"
git -C "$later_repo" switch --quiet main
printf '%s\n' landed >"$later_repo/shared.txt"
git -C "$later_repo" add shared.txt
git -C "$later_repo" commit --quiet -m "squash landed content"
printf '%s\n' later >"$later_repo/shared.txt"
git -C "$later_repo" add shared.txt
git -C "$later_repo" commit --quiet -m "edit landed path later"
result=$(git -C "$later_repo" cleanup-repo 2>&1)
_assert_contains "keeps landed branch after later same-path edit" \
  "keeping landed-then-edited; not merged" "$result"

# Exact squash merges still match with modes, symlinks, binary data, unusual
# path syntax, and a file without a final newline.
exact_repo=$(_clone_remote)
exact_weird=':(literal)name.txt'
_commit_file "$exact_repo" delete-me.txt obsolete "add file for exact deletion"
git -C "$exact_repo" switch --quiet -c exact-tree
git -C "$exact_repo" rm --quiet delete-me.txt
printf '#!/bin/sh\nprintf exact\n' >"$exact_repo/executable"
chmod +x "$exact_repo/executable"
ln -s executable "$exact_repo/exact-link"
printf '\000exact bytes\377' >"$exact_repo/exact.dat"
printf 'exact no final newline' >"$exact_repo/exact-eof.txt"
printf '%s\n' pathspec >"$exact_repo/$exact_weird"
git -C "$exact_repo" add --all
git -C "$exact_repo" commit --quiet -m "add exact branch tree"
_commit_file "$exact_repo" exact-step2.txt second "add exact second step"
git -C "$exact_repo" switch --quiet main
git -C "$exact_repo" rm --quiet delete-me.txt
printf '#!/bin/sh\nprintf exact\n' >"$exact_repo/executable"
chmod +x "$exact_repo/executable"
ln -s executable "$exact_repo/exact-link"
printf '\000exact bytes\377' >"$exact_repo/exact.dat"
printf 'exact no final newline' >"$exact_repo/exact-eof.txt"
printf '%s\n' pathspec >"$exact_repo/$exact_weird"
printf '%s\n' second >"$exact_repo/exact-step2.txt"
git -C "$exact_repo" add --all
git -C "$exact_repo" commit --quiet -m "squash exact branch tree"
