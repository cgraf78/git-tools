  unset "$result"

# A main checkout with a separate Git directory records nowhere where its work
# tree is, so from a linked worktree it can only be named by its Git directory.
sx_remote=$(_tmpdir)
sx_gitdir="$(_tmpdir)/repo.git"
sx_repo="$(_tmpdir)/repo"
sx_linked="$(_tmpdir)/linked"
git init --quiet --bare --initial-branch=main "$sx_remote"
git init --quiet --initial-branch=main --separate-git-dir "$sx_gitdir" \
  "$sx_repo"
git -C "$sx_repo" config user.email "test@test.com"
git -C "$sx_repo" config user.name "Test"
git -C "$sx_repo" config core.hooksPath /dev/null
_commit_file "$sx_repo" README.md base base
git -C "$sx_repo" remote add origin "$sx_remote"
git -C "$sx_repo" push --quiet -u origin main
sx_old=$(git -C "$sx_repo" rev-parse HEAD)
git -C "$sx_repo" branch feat
git -C "$sx_repo" worktree add --quiet "$sx_linked" feat
_commit_file "$sx_linked" feat.txt feat "add feat"
git -C "$sx_linked" push --quiet origin HEAD:main
sx_before=$(_worktree_snapshot "$sx_repo")
sx_rc=0
result=$(git -C "$sx_linked" cleanup-repo 2>&1) || sx_rc=$?
_assert_eq "linked cleanup beside a separate Git directory main succeeds" \
  0 "$sx_rc"
_assert_contains "separate Git directory main is named by its Git directory" \
  "not updating main; it is checked out in the main worktree, whose work tree location is unknown (Git directory $sx_gitdir)" \
  "$result"
_assert_eq "separate Git directory main keeps its base" \
  "$sx_old" "$(git -C "$sx_repo" rev-parse refs/heads/main)"
_assert_eq "separate Git directory main keeps its files" \
  "$sx_before" "$(_worktree_snapshot "$sx_repo")"

# A bare repository whose HEAD names the base and that has an index is in use
# through an external work tree, even though `git worktree list` shows no
# branch for it. Moving the ref would stage the difference in that work tree.
bx_repo=$(_merged_feature_repo)
bx_old=$(git -C "$bx_repo" rev-parse refs/heads/main)
bx_gitdir="$(_tmpdir)/cfg.git"
bx_work=$(_tmpdir)
bx_linked="$(_tmpdir)/linked"
git clone --quiet --bare "$bx_repo" "$bx_gitdir"
git --git-dir="$bx_gitdir" config remote.origin.url \
  "$(git -C "$bx_repo" config remote.origin.url)"
git --git-dir="$bx_gitdir" --work-tree="$bx_work" checkout --quiet -f main
git --git-dir="$bx_gitdir" worktree add --quiet "$bx_linked" feat
bx_rc=0
result=$(git -C "$bx_linked" cleanup-repo 2>&1) || bx_rc=$?
_assert_eq "linked cleanup beside a bare external work tree succeeds" \
  0 "$bx_rc"
_assert_contains "bare external work tree on the base is not updated" \
  "not updating main in $bx_gitdir; update that checkout with its own tooling" \
  "$result"
_assert_contains "bare external work tree skip explains the index rule" \
  "remove $bx_gitdir/index if no work tree uses it" "$result"
_assert_eq "bare external work tree base ref is not moved" \
  "$bx_old" "$(git --git-dir="$bx_gitdir" rev-parse refs/heads/main)"
_assert_eq "bare external work tree has no staged changes" "" \
  "$(git --git-dir="$bx_gitdir" --work-tree="$bx_work" status --porcelain)"

# A plain bare clone that only hosts linked worktrees has no index, so its
# HEAD naming the base does not mean anything has it checked out.
bb_repo=$(_merged_feature_repo)
bb_remote=$(git -C "$bb_repo" rev-parse refs/remotes/origin/main)
bb_gitdir="$(_tmpdir)/repo.git"
bb_linked="$(_tmpdir)/linked"
git clone --quiet --bare "$bb_repo" "$bb_gitdir"
git --git-dir="$bb_gitdir" config remote.origin.url \
  "$(git -C "$bb_repo" config remote.origin.url)"
git --git-dir="$bb_gitdir" worktree add --quiet "$bb_linked" feat
bb_rc=0
result=$(git -C "$bb_linked" cleanup-repo 2>&1) || bb_rc=$?
_assert_eq "linked cleanup in a bare worktree host succeeds" 0 "$bb_rc"
_assert_eq "bare worktree host base ref is fast-forwarded" \
  "$bb_remote" "$(git --git-dir="$bb_gitdir" rev-parse refs/heads/main)"
_assert_contains "bare worktree host reports the ref-only update" \
  "fast-forwarded main to origin/main" "$result"

# The current-worktree path check keeps a branch the invoking worktree reserves
# without having it checked out, such as during a detached bisect.
ph_repo=$(_merged_feature_repo)
ph_feat=$(git -C "$ph_repo" rev-parse refs/heads/feat)
ph_linked="$(_tmpdir)/linked"
git -C "$ph_repo" worktree add --quiet "$ph_linked" feat
git -C "$ph_linked" bisect start >/dev/null
git -C "$ph_linked" switch --quiet --detach 2>/dev/null
ph_rc=0
result=$(git -C "$ph_linked" cleanup-repo --remove-worktrees 2>&1) ||
  ph_rc=$?
_assert_eq "bisecting linked cleanup succeeds" 0 "$ph_rc"
_assert_contains "bisecting linked worktree keeps the branch it reserves" \
  "keeping feat; checked out in the current worktree" "$result"
_assert_eq "bisecting linked worktree's branch still exists" \
  "$ph_feat" "$(git -C "$ph_repo" rev-parse refs/heads/feat)"

# The main worktree leaves reservation checks to `git switch`, which refuses a
# base reserved by a detached operation elsewhere before any branch is deleted.
# That avoids scanning every worktree on each main-worktree run.
mr_repo=$(_merged_feature_repo)
mr_old=$(git -C "$mr_repo" rev-parse refs/heads/main)
git -C "$mr_repo" switch --quiet -c other
mr_base="$(_tmpdir)/base"
git -C "$mr_repo" worktree add --quiet "$mr_base" main
git -C "$mr_base" bisect start >/dev/null
git -C "$mr_base" switch --quiet --detach 2>/dev/null
mr_branches=$(_branches "$mr_repo")
mr_rc=0
git -C "$mr_repo" cleanup-repo >/dev/null 2>&1 || mr_rc=$?
_assert_eq "main worktree beside a reserved base stops in git switch" \
  nonzero "$(if [[ "$mr_rc" != 0 ]]; then printf nonzero; else printf zero; fi)"
_assert_eq "main worktree leaves the reserved base in place" \
  "$mr_old" "$(git -C "$mr_repo" rev-parse refs/heads/main)"
_assert_eq "main worktree beside a reserved base keeps its branch" \
  refs/heads/other "$(_head_ref "$mr_repo")"
_assert_eq "main worktree beside a reserved base deletes nothing" \
  "$mr_branches" "$(_branches "$mr_repo")"

# Hidden untracked files still block the base worktree update, so the
# fast-forward is skipped instead of failing on an untracked collision.
su_repo=$(_merged_feature_repo)
su_old=$(git -C "$su_repo" rev-parse refs/heads/main)
git -C "$su_repo" config status.showUntrackedFiles no
printf '%s\n' "local file" >"$su_repo/feat.txt"
su_linked="$(_tmpdir)/linked"
git -C "$su_repo" worktree add --quiet "$su_linked" feat
su_rc=0
result=$(git -C "$su_linked" cleanup-repo 2>&1) || su_rc=$?
_assert_eq "linked cleanup beside hidden untracked files succeeds" 0 "$su_rc"
_assert_contains "hidden untracked files skip the base worktree update" \
  "not updating main; could not fast-forward it in worktree $su_repo" "$result"
_assert_eq "hidden untracked files leave the base in place" \
  "$su_old" "$(git -C "$su_repo" rev-parse refs/heads/main)"
_assert_eq "hidden untracked file is preserved" "local file" \
  "$(cat "$su_repo/feat.txt")"

# A locked worktree whose directory is gone cannot be pruned until unlocked.
lk_repo=$(_merged_feature_repo)
git -C "$lk_repo" switch --quiet -c other
lk_gone="$(_tmpdir)/gone"
lk_linked="$(_tmpdir)/linked"
git -C "$lk_repo" worktree add --quiet --lock -b stale "$lk_gone"
rm -rf "$lk_gone"
git -C "$lk_repo" worktree add --quiet "$lk_linked" feat
result=$(git -C "$lk_linked" cleanup-repo 2>&1)
_assert_contains "missing locked worktree hint mentions unlocking" \
  "if worktree $lk_gone was deleted, run git worktree unlock $(printf %q "$lk_gone"), then git worktree prune" \
  "$result"
# The same advice comes from the main worktree, where no base reservation scan
# runs but each branch's reservation check fails on the missing worktree.
result=$(git -C "$lk_repo" cleanup-repo 2>&1)
_assert_contains "missing locked worktree hint is the same from the main worktree" \
  "if worktree $lk_gone was deleted, run git worktree unlock $(printf %q "$lk_gone"), then git worktree prune" \
  "$result"
_assert_occurrences "missing locked worktree hint is printed once" 1 \
  "if worktree $lk_gone was deleted" "$result"

# A main worktree whose path ends in a newline is still an ordinary main
# worktree, so a linked worktree fast-forwards the base there.
nl_parent=$(_tmpdir)
nl_repo="$nl_parent/main"$'\n'
nl_remote=$(_tmpdir)
git init --bare --quiet --initial-branch=main "$nl_remote"
_git_init "$nl_repo"
_commit_file "$nl_repo" README.md base base
git -C "$nl_repo" remote add origin "$nl_remote"
git -C "$nl_repo" push --quiet -u origin main
git -C "$nl_repo" switch --quiet -c feat
_commit_file "$nl_repo" feat.txt feat "add feat"
git -C "$nl_repo" switch --quiet --detach main
git -C "$nl_repo" merge --quiet --no-ff feat -m "merge feat"
git -C "$nl_repo" push --quiet origin HEAD:main
git -C "$nl_repo" switch --quiet main
nl_remote_oid=$(git -C "$nl_repo" rev-parse refs/remotes/origin/main)
nl_linked="$(_tmpdir)/linked"
git -C "$nl_repo" worktree add --quiet "$nl_linked" feat
nl_rc=0
result=$(git -C "$nl_linked" cleanup-repo 2>&1) || nl_rc=$?
_assert_eq "linked cleanup beside a newline-terminated main succeeds" \
  0 "$nl_rc"
_assert_eq "newline-terminated main worktree is fast-forwarded" \
  "$nl_remote_oid" "$(git -C "$nl_repo" rev-parse HEAD)"

# --- Porcelain records and composition options ---

# A repository with one merged branch, one unproven local branch, and a remote
# base that is one commit ahead of the local base.
_porcelain_repo() {
  local repo other remote

  repo=$(_clone_remote) || return 1
  git -C "$repo" switch --quiet -c merged
  _commit_file "$repo" merged.txt merged "add merged"
  git -C "$repo" switch --quiet main
  git -C "$repo" merge --quiet --no-ff merged -m "merge merged"
  git -C "$repo" push --quiet origin main
  git -C "$repo" switch --quiet -c local-only
  _commit_file "$repo" local.txt local "add local-only"
  git -C "$repo" switch --quiet main
  remote=$(git -C "$repo" remote get-url origin)
  other=$(_tmpdir) || return 1
  git clone --quiet "$remote" "$other" 2>/dev/null
  git -C "$other" config user.email test@test.com
  git -C "$other" config user.name Test
  _commit_file "$other" remote.txt remote "remote-only commit"
  git -C "$other" push --quiet origin main
  printf '%s\n' "$repo"
}

pc_repo=$(_porcelain_repo)
pc_merged_oid=$(git -C "$pc_repo" rev-parse refs/heads/merged)
pc_stderr=$(_tmpdir)/stderr
pc_out=$(git -C "$pc_repo" cleanup-repo --porcelain 2>"$pc_stderr")
_assert_contains "porcelain records a deleted branch with proof and OID" \
  $'delete-branch\tmerged\tmerged\t'"$pc_merged_oid" "$pc_out"
_assert_contains "porcelain records a kept branch with its reason" \
  $'keep-branch\tlocal-only\tmerge-unproven\tno-upstream' "$pc_out"
_assert_not_contains "porcelain keeps decision messages off stderr" \
  "deleting merged" "$(cat "$pc_stderr")"
_assert_not_contains "porcelain leaves the tally to the caller" \
  "done; deleted" "$(cat "$pc_stderr")"
_assert_eq "porcelain still deletes the merged branch" \
  "$(printf 'local-only\nmain')" "$(_branches "$pc_repo")"

pc_repo=$(_porcelain_repo)
pc_out=$(git -C "$pc_repo" cleanup-repo --porcelain --dry-run 2>"$pc_stderr")
_assert_contains "porcelain dry run records would-delete-branch" \
  $'would-delete-branch\tmerged\tmerged\t' "$pc_out"
_assert_not_contains "porcelain dry run does not echo commands" \
  "would run:" "$(cat "$pc_stderr")"
_assert_eq "porcelain dry run keeps every branch" \
  "$(printf 'local-only\nmain\nmerged')" "$(_branches "$pc_repo")"

# Without a base update, the local base, the current branch, and a dirty
# current checkout are all left alone, and merges are proven against the
# pinned remote base.
nub_repo=$(_porcelain_repo)
nub_local_main=$(git -C "$nub_repo" rev-parse refs/heads/main)
git -C "$nub_repo" switch --quiet local-only
printf 'dirty\n' >>"$nub_repo/local.txt"
nub_rc=0
nub_out=$(git -C "$nub_repo" cleanup-repo --no-update-base 2>&1) || nub_rc=$?
_assert_eq "no-update-base runs from a dirty checkout" 0 "$nub_rc"
_assert_contains "no-update-base deletes a branch merged into the remote base" \
  "deleting merged (merged)" "$nub_out"
_assert_contains "no-update-base keeps the current branch" \
  "keeping local-only" "$nub_out"
_assert_eq "no-update-base leaves the local base where it was" \
  "$nub_local_main" "$(git -C "$nub_repo" rev-parse refs/heads/main)"
_assert_eq "no-update-base leaves the current checkout on its branch" \
  refs/heads/local-only "$(git -C "$nub_repo" symbolic-ref HEAD)"
_assert_eq "no-update-base leaves the dirty file alone" \
  "$(printf 'local\ndirty')" "$(cat "$nub_repo/local.txt")"

# A branch merged only on the remote is proven against the fetched base.
nub_remote_repo=$(_clone_remote)
git -C "$nub_remote_repo" switch --quiet -c remote-merged
_commit_file "$nub_remote_repo" rm.txt rm "add remote-merged"
git -C "$nub_remote_repo" push --quiet origin remote-merged:remote-merged
git -C "$nub_remote_repo" switch --quiet main
nub_other=$(_tmpdir)
git clone --quiet "$(git -C "$nub_remote_repo" remote get-url origin)" "$nub_other" 2>/dev/null
git -C "$nub_other" config user.email test@test.com
git -C "$nub_other" config user.name Test
git -C "$nub_other" merge --quiet --no-ff origin/remote-merged -m "merge remote"
git -C "$nub_other" push --quiet origin main
nub_out=$(git -C "$nub_remote_repo" cleanup-repo --no-update-base --no-fetch 2>&1)
_assert_contains "no-fetch proves against the stale remote-tracking base" \
  "keeping remote-merged; merge not proven" "$nub_out"
nub_out=$(git -C "$nub_remote_repo" cleanup-repo --no-update-base 2>&1)
_assert_contains "no-update-base fetches and proves against the remote base" \
  "deleting remote-merged (merged)" "$nub_out"

# Without a fetch nothing reaches the remote, so an unreachable one is fine.
nf_repo=$(_porcelain_repo)
git -C "$nf_repo" remote set-url origin "$(_tmpdir)/missing.git"
nf_rc=0
nf_out=$(git -C "$nf_repo" cleanup-repo --no-update-base --no-fetch 2>&1) || nf_rc=$?
_assert_eq "no-fetch works with an unreachable remote" 0 "$nf_rc"
_assert_contains "no-fetch still deletes a locally proven branch" \
  "deleting merged (merged)" "$nf_out"
nf_missing_repo=$(_clone_remote)
git -C "$nf_missing_repo" update-ref -d refs/remotes/origin/main
nf_rc=0
nf_out=$(git -C "$nf_missing_repo" cleanup-repo --no-fetch 2>&1) || nf_rc=$?
_assert_eq "no-fetch without a remote-tracking base fails" 2 "$nf_rc"
_assert_contains "no-fetch names the missing remote-tracking base" \
  "remote-tracking base does not exist: origin/main" "$nf_out"

# --worktree limits removal to the listed checkouts and implies removal.
ws_repo=$(_clone_remote)
for ws_branch in first second; do
  git -C "$ws_repo" switch --quiet -c "$ws_branch"
  _commit_file "$ws_repo" "$ws_branch.txt" "$ws_branch" "add $ws_branch"
  git -C "$ws_repo" switch --quiet main
  git -C "$ws_repo" merge --quiet --no-ff "$ws_branch" -m "merge $ws_branch"
done
git -C "$ws_repo" push --quiet origin main
ws_first=$(_tmpdir)
ws_second=$(_tmpdir)
rm -rf "$ws_first" "$ws_second"
git -C "$ws_repo" worktree add --quiet "$ws_first" first
git -C "$ws_repo" worktree add --quiet "$ws_second" second
ws_out=$(git -C "$ws_repo" cleanup-repo --worktree "$ws_first" --porcelain 2>&1)
_assert_contains "worktree scope removes the listed checkout" \
  $'remove-worktree\t'"$ws_first"$'\tmerged\tfirst' "$ws_out"
_assert_contains "worktree scope keeps an unlisted checkout's branch" \
  $'keep-branch\tsecond\tchecked-out\t'"$ws_second" "$ws_out"
_assert_eq "worktree scope deletes only the listed checkout's branch" \
  "$(printf 'main\nsecond')" "$(_branches "$ws_repo")"
_assert_eq "worktree scope leaves the unlisted checkout" present \
  "$(if [[ -d "$ws_second" ]]; then printf present; else printf missing; fi)"

# Scope arguments are matched to Git's recorded worktree paths: a relative
# spelling with a trailing slash and a symlinked spelling both select the
# worktree, and records name it the way Git does.
canon_repo=$(_clone_remote)
for canon_branch in rel linked; do
  git -C "$canon_repo" switch --quiet -c "$canon_branch"
  _commit_file "$canon_repo" "$canon_branch.txt" "$canon_branch" "add $canon_branch"
  git -C "$canon_repo" switch --quiet main
  git -C "$canon_repo" merge --quiet --no-ff "$canon_branch" -m "merge $canon_branch"
done
git -C "$canon_repo" push --quiet origin main
canon_parent=$(_tmpdir)
git -C "$canon_repo" worktree add --quiet "$canon_parent/rel" rel
git -C "$canon_repo" worktree add --quiet "$canon_parent/linked" linked
ln -s "$canon_parent/linked" "$canon_parent/alias"
canon_out=$(cd "$canon_parent" && git -C "$canon_repo" cleanup-repo --porcelain \
  --worktree "$(cd "$canon_parent" && printf '%s' "$PWD")/rel/" \
  --worktree "$canon_parent/alias" 2>&1)
_assert_contains "a trailing-slash scope argument selects the worktree" \
  $'remove-worktree\t'"$canon_parent/rel"$'\tmerged\trel' "$canon_out"
_assert_contains "a symlinked scope argument selects the worktree by its recorded path" \
  $'remove-worktree\t'"$canon_parent/linked"$'\tmerged\tlinked' "$canon_out"

# Arguments that name no linked worktree select nothing, never everything.
none_repo=$(_clone_remote)
git -C "$none_repo" switch --quiet -c bystander
_commit_file "$none_repo" by.txt by "add bystander"
git -C "$none_repo" switch --quiet main
git -C "$none_repo" merge --quiet --no-ff bystander -m "merge bystander"
git -C "$none_repo" push --quiet origin main
none_dir=$(_tmpdir)
rm -rf "$none_dir"
git -C "$none_repo" worktree add --quiet "$none_dir" bystander
none_out=$(git -C "$none_repo" cleanup-repo --porcelain --worktree "$(_tmpdir)" 2>&1)
_assert_contains "an unmatched scope argument removes no worktree" \
  $'keep-branch\tbystander\tchecked-out\t'"$none_dir" "$none_out"
_assert_eq "an unmatched scope argument leaves the bystander checkout" present \
  "$(if [[ -d "$none_dir" ]]; then printf present; else printf missing; fi)"

# A worktree path with a tab cannot forge a field in a porcelain record.
tab_repo=$(_clone_remote)
git -C "$tab_repo" switch --quiet -c tabbed
_commit_file "$tab_repo" tab.txt tab "add tabbed"
git -C "$tab_repo" switch --quiet main
git -C "$tab_repo" merge --quiet --no-ff tabbed -m "merge tabbed"
git -C "$tab_repo" push --quiet origin main
tab_dir="$(_tmpdir)/with"$'\t'"tab"
git -C "$tab_repo" worktree add --quiet "$tab_dir" tabbed
tab_out=$(git -C "$tab_repo" cleanup-repo --remove-worktrees --porcelain \
  --dry-run 2>&1)
_assert_contains "porcelain escapes a tab in a worktree path" \
  $'would-remove-worktree\t'"${tab_dir%$'\t'tab}"$'\\ttab\tmerged\ttabbed' "$tab_out"

# --- Pull request evidence and age limits ---

# A fake gh answers the three GitHub endpoints cleanup reads from per-test
# files and logs every call. --slurp output is an array of pages.
gh_bin=$(_tmpdir)
cat >"$gh_bin/gh" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$FAKE_GH_DIR/calls"
[[ -z "${FAKE_GH_FAIL:-}" ]] || exit 1
endpoint="" head=""
for arg; do
  case "$arg" in
    repos/*) endpoint=$arg ;;
    head=*) head=${arg#head=} ;;
  esac
done
case "$endpoint" in
  repos/acme/widgets/commits/*/pulls)
    oid=${endpoint#repos/acme/widgets/commits/}
    file=$FAKE_GH_DIR/commits-${oid%/pulls}.json
    ;;
  repos/acme/widgets/pulls) file=$FAKE_GH_DIR/named-${head#acme:}.json ;;
  repos/acme/widgets/pulls/*/commits)
    number=${endpoint#repos/acme/widgets/pulls/}
    file=$FAKE_GH_DIR/members-${number%/commits}.json
    ;;
  *) exit 1 ;;
esac
if [[ -f "$file" ]]; then cat "$file"; else printf '[[]]\n'; fi
EOF
chmod +x "$gh_bin/gh"

# A clone whose origin is spelled as a GitHub URL but resolves to a local bare
# repository, so pull request evidence is pinned to acme/widgets offline.
_github_clone() {
  local repo remote

  repo=$(_clone_remote) || return 1
  remote=$(git -C "$repo" remote get-url origin)
  git -C "$repo" config "url.$remote.insteadOf" https://github.com/acme/widgets.git
  git -C "$repo" remote set-url origin https://github.com/acme/widgets.git
  printf '%s\n' "$repo"
}

_pr_json() {
  local number="$1" state="$2" merged_at="$3" merge_sha="$4" head="${5:-}"

  printf '{"number":%s,"state":"%s","merged_at":%s,"merge_commit_sha":%s,' \
    "$number" "$state" "$merged_at" "$merge_sha"
  printf '"base":{"ref":"main","repo":{"full_name":"acme/widgets"}},'
  printf '"head":{"ref":"%s","repo":{"full_name":"acme/widgets"}}}' "$head"
}

# Pull request evidence needs jq; without it cleanup leaves the evidence out,
# which these cases cannot observe.
if command -v jq >/dev/null 2>&1; then
  # A branch whose tip is an earlier snapshot of a merged PR has no local proof
  # (the PR landed later work as one squash), but the PR holds its commit and
  # its merge commit is on the base.
  gh_dir=$(_tmpdir)
  pr_repo=$(_github_clone)
  git -C "$pr_repo" switch --quiet -c pr-snapshot
  _commit_file "$pr_repo" p.txt one "early snapshot"
  pr_tip=$(git -C "$pr_repo" rev-parse HEAD)
  git -C "$pr_repo" switch --quiet main
  _commit_file "$pr_repo" p.txt two "land the PR (#7)"
  pr_merge=$(git -C "$pr_repo" rev-parse HEAD)
  git -C "$pr_repo" push --quiet origin main
  printf '[[%s]]\n' "$(_pr_json 7 closed '"2026-01-01T00:00:00Z"' "\"$pr_merge\"")" \
    >"$gh_dir/commits-$pr_tip.json"
  printf '[[{"sha":"%s"}]]\n' "$pr_tip" >"$gh_dir/members-7.json"
  result=$(cd "$pr_repo" && PATH="$gh_bin:$PATH" FAKE_GH_DIR=$gh_dir \
    git cleanup-repo --porcelain 2>&1)
  _assert_contains "a merged PR containing the tip proves deletion" \
    $'delete-branch\tpr-snapshot\tmerged-pr\t'"$pr_tip" "$result"
  result=$(git -C "$pr_repo" branch --list pr-snapshot)
  _assert_eq "the merged-PR snapshot branch is deleted" "" "$result"

  # The same evidence is withheld when gh fails or the network is off.
  pr_repo=$(_github_clone)
  git -C "$pr_repo" switch --quiet -c pr-snapshot
  _commit_file "$pr_repo" p.txt one "early snapshot"
  pr_tip=$(git -C "$pr_repo" rev-parse HEAD)
  git -C "$pr_repo" switch --quiet main
  _commit_file "$pr_repo" p.txt two "land the PR (#7)"
  pr_merge=$(git -C "$pr_repo" rev-parse HEAD)
  git -C "$pr_repo" push --quiet origin main
  printf '[[%s]]\n' "$(_pr_json 7 closed '"2026-01-01T00:00:00Z"' "\"$pr_merge\"")" \
    >"$gh_dir/commits-$pr_tip.json"
  printf '[[{"sha":"%s"}]]\n' "$pr_tip" >"$gh_dir/members-7.json"
  result=$(cd "$pr_repo" && PATH="$gh_bin:$PATH" FAKE_GH_DIR=$gh_dir FAKE_GH_FAIL=1 \
    git cleanup-repo 2>&1)
  _assert_contains "a failing gh is no proof" \
    "keeping pr-snapshot; merge not proven" "$result"
  : >"$gh_dir/calls"
  result=$(cd "$pr_repo" && PATH="$gh_bin:$PATH" FAKE_GH_DIR=$gh_dir \
    git cleanup-repo --no-fetch 2>&1)
  _assert_contains "no-fetch withholds pull request evidence" \
    "keeping pr-snapshot; merge not proven" "$result"
  _assert_eq "no-fetch never calls gh" "" "$(cat "$gh_dir/calls")"

  # A merge commit that is not on the pinned base proves nothing.
  printf '[[%s]]\n' "$(_pr_json 7 closed '"2026-01-01T00:00:00Z"' \
    '"1111111111111111111111111111111111111111"')" >"$gh_dir/commits-$pr_tip.json"
