_assert_eq "remove-worktrees deletes worktree branch" "main" \
  "$(_branches "$worktree_repo")"
_assert_eq "remove-worktrees removes linked checkout" "missing" \
  "$(if [[ -e "$worktree_dir" ]]; then printf 'present'; else printf 'missing'; fi)"

# Expected-old-OID deletion must preserve a branch that advances after
# classification but before the ref transaction.
ref_race_repo=$(_clone_remote)
git -C "$ref_race_repo" switch --quiet -c ref-race
_commit_file "$ref_race_repo" race.txt merged "add raced branch"
