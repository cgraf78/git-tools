# Local opt-ins are literal top-level names. Reject traversal, nested paths,
# separators with platform-dependent meaning, and Git's own administrative
# entry before fetching or mutating worktrees.
for invalid_prune_path in ../outside nested/cache 'nested\cache' .git; do
