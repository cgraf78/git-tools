# A configured name is a literal entry, not a Git pathspec pattern. If a file
# appears after preflight, metacharacters in the configured name must not let
# the bounded clean consume that unrelated file.
literal_prune_repo=$(_clone_remote)
git -C "$literal_prune_repo" switch --quiet -c literal-prune
_commit_file "$literal_prune_repo" literal-prune.txt clean \
