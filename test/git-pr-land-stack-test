  cat >"$dir/git-pr-restack" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'restack %s\n' "$*" >>"${STACK_LOG:?}"
number=${1##*/}
topology_state=${STACK_TOPOLOGY_STATE:-${STACK_LOG}.topology}
if [[ " $* " == *" --dry-run "* ]]; then
  exit 0
fi
: >"$topology_state.$number"
if [[ -z "${STACK_REWRITE_REPO:-}" ]]; then
  case "$number" in
    2) rewrite_branch=feature/b ;;
    3) rewrite_branch=feature/c ;;
    *) rewrite_branch="" ;;
  esac
  if [[ -n "$rewrite_branch" ]]; then
    old=$(git rev-parse "refs/heads/$rewrite_branch")
    tree=$(git rev-parse "$old^{tree}")
    new=$(printf '%s\n' "restacked-$rewrite_branch" |
      git commit-tree "$tree" -p "$old")
    git update-ref "refs/heads/$rewrite_branch" "$new" "$old"
  fi
fi
if [[ -n "${STACK_RACE_REPO:-}" && "$number" == 2 ]]; then
  git -C "$STACK_RACE_REPO" worktree add --quiet "${STACK_RACE_WORKTREE:?}" feature/a
fi
if [[ -n "${STACK_ADVANCE_LOCAL_REPO:-}" && "$number" == 2 ]]; then
  old=$(git -C "$STACK_ADVANCE_LOCAL_REPO" rev-parse refs/heads/feature/a)
  tree=$(git -C "$STACK_ADVANCE_LOCAL_REPO" rev-parse "$old^{tree}")
  new=$(printf '%s\n' concurrent-local |
    git -C "$STACK_ADVANCE_LOCAL_REPO" commit-tree "$tree" -p "$old")
  git -C "$STACK_ADVANCE_LOCAL_REPO" update-ref refs/heads/feature/a "$new" "$old"
  printf '%s\n' "$new" >"${STACK_ADVANCE_LOCAL_OID:?}"
fi
if [[ -n "${STACK_ADVANCE_REMOTE_REPO:-}" && "$number" == 2 ]]; then
  old=$(git -C "$STACK_ADVANCE_REMOTE_REPO" rev-parse refs/remotes/origin/feature/a)
  tree=$(git -C "$STACK_ADVANCE_REMOTE_REPO" rev-parse "$old^{tree}")
  new=$(printf '%s\n' concurrent-remote |
    git -C "$STACK_ADVANCE_REMOTE_REPO" commit-tree "$tree" -p "$old")
  git -C "$STACK_ADVANCE_REMOTE_REPO" push --quiet origin \
    "$new:refs/heads/feature/a"
  printf '%s\n' "$new" >"${STACK_ADVANCE_REMOTE_OID:?}"
fi
if [[ -n "${STACK_REWRITE_REPO:-}" ]]; then
  case "$number" in
    2) rewrite_branch=feature/b ;;
    3) rewrite_branch=feature/c ;;
    *) rewrite_branch="" ;;
  esac
  if [[ -n "$rewrite_branch" ]]; then
    old=$(git -C "$STACK_REWRITE_REPO" rev-parse "refs/heads/$rewrite_branch")
    tree=$(git -C "$STACK_REWRITE_REPO" rev-parse "$old^{tree}")
    new=$(printf '%s\n' "restacked-$rewrite_branch" |
      git -C "$STACK_REWRITE_REPO" commit-tree "$tree" -p "$old")
    git -C "$STACK_REWRITE_REPO" update-ref "refs/heads/$rewrite_branch" "$new" "$old"
    git -C "$STACK_REWRITE_REPO" push --quiet origin \
      "$new:refs/heads/$rewrite_branch"
  fi
fi
EOF

  cat >"$dir/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
_merge_state() {
  local target="$1"
  local count count_file

  case "${GH_MERGE_CASE:-clean}" in
    clean)
      printf 'CLEAN\n'
      ;;
    dirty)
      printf 'DIRTY\n'
      ;;
    dirty-then-clean)
      topology_state=${STACK_TOPOLOGY_STATE:-${STACK_LOG}.topology}
      if [[ ! -e "$topology_state.$target" ]]; then
        printf 'CLEAN\n'
        return 0
      fi
      count_file="${GH_VIEW_COUNT:?}.$target"
      count=0
      [[ ! -f "$count_file" ]] || count=$(< "$count_file")
      count=$((count + 1))
      printf '%s\n' "$count" >"$count_file"
      if ((count <= 2)); then
        printf 'DIRTY\n'
      else
        printf 'CLEAN\n'
      fi
      ;;
    *)
      printf 'unexpected merge case: %s\n' "$GH_MERGE_CASE" >&2
      exit 99
      ;;
  esac
}

if [[ "$1 $2" == "auth status" ]]; then
  exit 0
fi
if [[ "$1 $2" == "repo view" ]]; then
  printf 'example/repo\thttps://github.test/example/repo\n'
  exit 0
fi
if [[ "$1 $2" == "pr list" && "${GH_STACK_CASE:-}" == inventory-overflow ]]; then
  limit=0
  previous=""
  for argument in "$@"; do
    if [[ "$previous" == --limit ]]; then
      limit=$argument
      break
    fi
    previous=$argument
  done
  count=$limit
  ((count <= 201)) || count=201
  index=1
  while ((index <= count)); do
    if ((index == 201)); then
      printf '201\tOPEN\tfalse\tCLEAN\tfeature/201\t1111111111111111111111111111111111111111\tfeature/1\texample/repo\tfalse\thttps://github.test/example/repo/pull/201\tHidden child\n'
    else
      printf '%s\tOPEN\tfalse\tCLEAN\tfeature/%s\t1111111111111111111111111111111111111111\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/%s\tVisible PR\n' "$index" "$index" "$index"
    fi
    index=$((index + 1))
  done
  exit 0
fi
if [[ "$1 $2" == "pr list" ]]; then
  exit 0
fi
if [[ "$1 $2" == "pr view" ]]; then
  target=${3:-}
  number=${target##*/}
  merge_state=$(_merge_state "$number")
  case "$number" in
    1)
      base=main
      if [[ -n "${STACK_DRIFT_BEFORE_LAND:-}" ]]; then
        base=release
      fi
      oid=$(git rev-parse refs/heads/feature/a)
      printf '1\tOPEN\tfalse\tCLEAN\tfeature/a\t%s\t%s\texample/repo\tfalse\thttps://github.test/example/repo/pull/1\tRoot PR\n' "$oid" "$base"
      ;;
    2)
      base=feature/a
      topology_state=${STACK_TOPOLOGY_STATE:-${STACK_LOG}.topology}
      [[ ! -e "$topology_state.2" ]] || base=main
      if [[ -n "${STACK_DRIFT_AFTER_LAND:-}" && -e "$STACK_DRIFT_AFTER_LAND" ]]; then
        base=release
      fi
      if [[ "${STACK_DRIFT_DURING_WAIT:-0}" == 1 &&
        -e "$topology_state.2" && "$merge_state" == CLEAN ]]; then
        base=release
      fi
      oid=$(git rev-parse refs/heads/feature/b)
      printf '2\tOPEN\tfalse\t%s\tfeature/b\t%s\t%s\texample/repo\tfalse\thttps://github.test/example/repo/pull/2\tChild PR\n' "$merge_state" "$oid" "$base"
      ;;
    3)
      base=feature/b
      topology_state=${STACK_TOPOLOGY_STATE:-${STACK_LOG}.topology}
      [[ ! -e "$topology_state.3" ]] || base=main
      oid=$(git rev-parse refs/heads/feature/c)
      printf '3\tOPEN\tfalse\t%s\tfeature/c\t%s\t%s\texample/repo\tfalse\thttps://github.test/example/repo/pull/3\tGrandchild PR\n' "$merge_state" "$oid" "$base"
      ;;
    *)
      printf 'unexpected pr view target: %s\n' "${3:-}" >&2
      exit 99
      ;;
  esac
  exit 0
fi
if [[ "$1 $2" == "pr checks" ]]; then
  printf 'checks %s\n' "$*" >>"${STACK_LOG:?}"
  case "${GH_CHECK_CASE:-pass}" in
    pass)
      printf 'pass\n'
      ;;
    fail)
      printf 'fail\n'
      ;;
    none)
      printf 'none\n'
      ;;
  esac
  exit 0
fi
printf 'unexpected gh call: %s\n' "$*" >&2
exit 99
EOF

  cat >"$dir/git" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-} ${2:-} ${3:-} ${4:-}" == "remote get-url --push --all" ]] &&
  [[ "${GIT_TEST_REAL_EFFECTIVE_PUSH_URL:-0}" != 1 ]]; then
  remote=${5:-}
  url=$(/usr/bin/git config --get-all "remote.$remote.pushurl" 2>/dev/null || true)
  [[ -n "$url" ]] || url=$(/usr/bin/git config --get-all "remote.$remote.url")
  printf '%s\n' "$url"
  exit 0
fi
if [[ "${GIT_TEST_REAL_EFFECTIVE_PUSH_URL:-0}" != 1 &&
  "${1:-}" == -c && "${2:-}" == url.*.insteadOf=* &&
  "${3:-}" == -c && "${4:-}" == url.*.pushInsteadOf=* ]]; then
  pin=${2#url.}
  target=${pin%%.insteadOf=*}
  alias=${pin#*.insteadOf=}
  shift 4
  rewritten=()
  for argument in "$@"; do
    [[ "$argument" != "$alias" ]] || argument=$target
    rewritten+=("$argument")
  done
  set -- "${rewritten[@]}"
fi
exec /usr/bin/git "$@"
EOF

  chmod +x "$dir/git-pr-stack" "$dir/git-pr-land" "$dir/git-pr-restack" \
    "$dir/gh" "$dir/git"
}

_write_worktree_list_failure_git() {
  cat >"$1/git" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == worktree && "${2:-}" == list ]]; then
  exit 88
fi
exec /usr/bin/git "$@"
EOF
  chmod +x "$1/git"
}

echo "=== git pr-land-stack ==="

repo=$(_tmpdir)
bin_dir=$(_tmpdir)
log=$(_tmpdir)/stack.log
_git_init "$repo"
git -C "$repo" branch feature/a
git -C "$repo" branch feature/b
git -C "$repo" branch feature/c
_write_tool_stubs "$bin_dir"

drift_before_log=$(_tmpdir)/stack.log
drift_before_rc=0
drift_before_output=$(PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" \
  STACK_LOG="$drift_before_log" STACK_DRIFT_BEFORE_LAND=1 \
  _pr_land_stack "$repo" 1 2>&1) || drift_before_rc=$?
_assert_eq "pre-land topology drift exits nonzero" "1" "$drift_before_rc"
_assert_contains "pre-land topology drift reports rejection" \
  "PR #1 topology changed since stack discovery" "$drift_before_output"
if [[ ! -s "$drift_before_log" ]]; then
  _pass "pre-land topology drift causes no stack mutation"
else
  _fail "pre-land topology drift causes no stack mutation"
fi

drift_parent_log=$(_tmpdir)/stack.log
drift_parent_marker=$(_tmpdir)/drifted
drift_parent_state=$(_tmpdir)/topology
drift_parent_oid=$(git -C "$repo" rev-parse refs/heads/feature/a)
drift_parent_rc=0
drift_parent_output=$(PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" \
  STACK_LOG="$drift_parent_log" STACK_DRIFT_AFTER_LAND="$drift_parent_marker" \
  STACK_TOPOLOGY_STATE="$drift_parent_state" \
  _pr_land_stack "$repo" 1 2>&1) || drift_parent_rc=$?
_assert_eq "post-parent topology drift exits nonzero" "1" "$drift_parent_rc"
_assert_contains "post-parent topology drift reports rejection" \
  "PR #2 topology changed since stack discovery" "$drift_parent_output"
_assert_eq "post-parent topology drift stops before child restack" \
  $'land https://github.test/example/repo/pull/1 --method squash --keep-branch --expect-topology 1\tfeature/a\t'"$drift_parent_oid"$'\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/1' \
  "$(cat "$drift_parent_log")"

drift_wait_log=$(_tmpdir)/stack.log
drift_wait_count=$(_tmpdir)/view-count
drift_wait_state=$(_tmpdir)/topology
drift_wait_rc=0
drift_wait_output=$(PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" \
  STACK_LOG="$drift_wait_log" STACK_TOPOLOGY_STATE="$drift_wait_state" \
  STACK_DRIFT_DURING_WAIT=1 GH_MERGE_CASE=dirty-then-clean \
  GH_VIEW_COUNT="$drift_wait_count" \
  _pr_land_stack "$repo" 1 --check-timeout 3 --check-interval 1 2>&1) ||
  drift_wait_rc=$?
_assert_eq "readiness-poll topology drift exits nonzero" "1" "$drift_wait_rc"
_assert_contains "readiness-poll topology drift reports rejection" \
  "PR #2 topology changed after restack" "$drift_wait_output"
if [[ "$(cat "$drift_wait_log")" != *"land https://github.test/example/repo/pull/2"* ]]; then
  _pass "readiness-poll topology drift stops before child land"
else
  _fail "readiness-poll topology drift stops before child land"
fi

enumeration_repo=$(_tmpdir)
enumeration_bin=$(_tmpdir)
enumeration_log=$(_tmpdir)/stack.log
_git_init "$enumeration_repo"
git -C "$enumeration_repo" branch feature/a
git -C "$enumeration_repo" branch feature/b
git -C "$enumeration_repo" branch feature/c
_write_worktree_list_failure_git "$enumeration_bin"
rc=0
result=$(cd "$enumeration_repo" &&
  PATH="$enumeration_bin:$bin_dir:$ROOT/bin:/usr/bin:/bin" \
    GIT_TOOLS_TOOL_DIR="$bin_dir" STACK_LOG="$enumeration_log" \
    "$ROOT/bin/git-pr-land-stack" 1 2>&1) || rc=$?
_assert_eq "worktree enumeration failure: stack refuses before landing" "1" "$rc"
_assert_contains "worktree enumeration failure: stack reports preflight failure" \
  "could not inspect worktrees" "$result"
if [[ -s "$enumeration_log" ]]; then
  _fail "worktree enumeration failure: stack does not land"
else
  _pass "worktree enumeration failure: stack does not land"
fi

newline_parent=$(_tmpdir)
newline_repo="$newline_parent/current"$'\n'
newline_log=$(_tmpdir)/stack.log
_git_init "$newline_repo"
git -C "$newline_repo" branch feature/a
git -C "$newline_repo" branch feature/b
git -C "$newline_repo" branch feature/c
git -C "$newline_repo" switch --quiet feature/c
result=$(PATH="$bin_dir:$ROOT/bin:/usr/bin:/bin" GIT_TOOLS_TOOL_DIR="$bin_dir" \
  STACK_LOG="$newline_log" _pr_land_stack "$newline_repo" 1 --dry-run 2>&1)
rc=$?
_assert_eq "terminal-newline current stack worktree passes topology" "0" "$rc"

for current_operation in rebase bisect; do
  operation_parent=$(_tmpdir)
  operation_repo="$operation_parent/current-$current_operation"$'\n'
  operation_log=$(_tmpdir)/stack.log
  _git_init "$operation_repo"
  git -C "$operation_repo" switch --quiet -c feature/a
  printf '%s\n' "$current_operation" >"$operation_repo/operation.txt"
  git -C "$operation_repo" add operation.txt
  git -C "$operation_repo" commit -m operation >/dev/null
  git -C "$operation_repo" branch feature/b
  git -C "$operation_repo" branch feature/c
  if [[ "$current_operation" == rebase ]]; then
    git -C "$operation_repo" rebase --exec false HEAD~1 >/dev/null 2>&1 || true
  else
    printf 'second\n' >"$operation_repo/second.txt"
    git -C "$operation_repo" add second.txt
    git -C "$operation_repo" commit -m second >/dev/null
    git -C "$operation_repo" bisect start HEAD HEAD~2 >/dev/null
  fi
  result=$(PATH="$bin_dir:$ROOT/bin:/usr/bin:/bin" GIT_TOOLS_TOOL_DIR="$bin_dir" \
    STACK_LOG="$operation_log" _pr_land_stack "$operation_repo" 1 2>&1)
  rc=$?
  _assert_eq "terminal-newline stack $current_operation refuses before landing" "1" "$rc"
  _assert_contains "terminal-newline stack $current_operation reports operation" \
    "current worktree has $current_operation in progress: ${operation_repo%$'\n'}" "$result"
  if [[ -s "$operation_log" ]]; then
    _fail "terminal-newline stack $current_operation does not land before refusal"
  else
    _pass "terminal-newline stack $current_operation does not land before refusal"
  fi
done

topology_repo=$(_tmpdir)
topology_worktree=$(_tmpdir)
topology_log=$(_tmpdir)/stack.log
_git_init "$topology_repo"
git -C "$topology_repo" branch feature/a
git -C "$topology_repo" branch feature/b
git -C "$topology_repo" branch feature/c
git -C "$topology_repo" worktree add --quiet "$topology_worktree" feature/b
result=$(PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" STACK_LOG="$topology_log" \
  _pr_land_stack "$topology_repo" 1 2>&1)
rc=$?
_assert_eq "linked stack: refuses before first merge" "1" "$rc"
_assert_contains "linked stack: reports reserved child branch" \
  "stack branch feature/b is checked out or reserved in another worktree" "$result"
if [[ -s "$topology_log" ]]; then
  _fail "linked stack: does not land before refusal"
else
  _pass "linked stack: does not land before refusal"
fi

race_repo=$(_tmpdir)
race_worktree=$(_tmpdir)
race_log=$(_tmpdir)/stack.log
_git_init "$race_repo"
git -C "$race_repo" branch feature/a
git -C "$race_repo" branch feature/b
git -C "$race_repo" branch feature/c
result=$(PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" STACK_LOG="$race_log" \
  STACK_RACE_REPO="$race_repo" STACK_RACE_WORKTREE="$race_worktree" \
  _pr_land_stack "$race_repo" 1 2>&1)
rc=$?
_assert_eq "stack checkout race: landing remains successful" "0" "$rc"
if git -C "$race_repo" show-ref --verify --quiet refs/heads/feature/a; then
  _pass "stack cleanup race: preserves local branch"
else
  _fail "stack cleanup race: preserves local branch"
fi

advance_local_repo=$(_tmpdir)
advance_local_log=$(_tmpdir)/stack.log
advance_local_oid_file=$(_tmpdir)/advanced
_git_init "$advance_local_repo"
git -C "$advance_local_repo" branch feature/a
git -C "$advance_local_repo" branch feature/b
git -C "$advance_local_repo" branch feature/c
advance_local_before=$(git -C "$advance_local_repo" rev-parse feature/a)
result=$(PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" \
  STACK_LOG="$advance_local_log" \
  STACK_ADVANCE_LOCAL_REPO="$advance_local_repo" \
  STACK_ADVANCE_LOCAL_OID="$advance_local_oid_file" \
  _pr_land_stack "$advance_local_repo" 1 2>&1)
rc=$?
advance_local_after=$(cat "$advance_local_oid_file")
_assert_eq "stack local advance: landing remains successful" "0" "$rc"
_assert_eq "stack local advance: preserves concurrent commit" "$advance_local_after" \
  "$(git -C "$advance_local_repo" rev-parse refs/heads/feature/a)"
if [[ "$advance_local_before" != "$advance_local_after" ]]; then
  _pass "stack local advance: fixture changes local OID"
else
  _fail "stack local advance: fixture changes local OID"
fi

advance_remote_repo=$(_tmpdir)
advance_remote=$(_tmpdir)
advance_remote_log=$(_tmpdir)/stack.log
advance_remote_oid_file=$(_tmpdir)/advanced
_git_init "$advance_remote_repo"
git -C "$advance_remote_repo" branch feature/a
git -C "$advance_remote_repo" branch feature/b
git -C "$advance_remote_repo" branch feature/c
git init -q --bare "$advance_remote"
_add_github_remote "$advance_remote_repo" origin "$advance_remote"
git -C "$advance_remote_repo" push --quiet origin main feature/a feature/b feature/c
git -C "$advance_remote_repo" fetch --quiet origin
result=$(PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" \
  STACK_LOG="$advance_remote_log" \
