#!/usr/bin/env bash

set -uo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PATH="$ROOT/bin:$PATH"
export NO_COLOR=1

_failures=0
_temps=()

_tmpdir() {
  local dir
  dir=$(mktemp -d)
  _temps+=("$dir")
  printf '%s\n' "$dir"
}

_cleanup() {
  local dir
  for dir in "${_temps[@]}"; do
    rm -rf "$dir"
  done
}
trap _cleanup EXIT

_pass() {
  printf 'ok - %s\n' "$1"
}

_fail() {
  printf 'not ok - %s\n' "$1" >&2
  _failures=$((_failures + 1))
}

_assert_eq() {
  local name="$1"
  local expected="$2"
  local actual="$3"

  if [[ "$actual" == "$expected" ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected: %q\n' "$expected" >&2
    printf '  actual:   %q\n' "$actual" >&2
  fi
}

_assert_contains() {
  local name="$1"
  local needle="$2"
  local haystack="$3"

  if [[ "$haystack" == *"$needle"* ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected output to contain: %s\n' "$needle" >&2
    printf '  actual output:\n%s\n' "$haystack" >&2
  fi
}

_git_init() {
  local repo="$1"
  git init -q --initial-branch=main "$repo"
  git -C "$repo" config user.email "test@test.com"
  git -C "$repo" config user.name "Test"
  git -C "$repo" config core.hooksPath /dev/null
  printf 'base\n' >"$repo/README.md"
  git -C "$repo" add README.md
  git -C "$repo" commit -m base >/dev/null
}

_write_tool_stubs() {
  local dir="$1"

  cat >"$dir/git-pr-stack" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
case "${STACK_CASE:-ready}" in
  ready)
    printf 'pr\t0\t1\tmain\tfeature/a\ttrue\tready\tpass\thttps://example/pr/1\n'
    printf 'pr\t1\t2\tfeature/a\tfeature/b\ttrue\tready\tpass\thttps://example/pr/2\n'
    printf 'pr\t2\t3\tfeature/b\tfeature/c\ttrue\tready\tpass\thttps://example/pr/3\n'
    ;;
  blocked)
    printf 'pr\t0\t1\tmain\tfeature/a\ttrue\tready\tpass\thttps://example/pr/1\n'
    printf 'pr\t1\t2\tfeature/a\tfeature/b\tfalse\tchecks pending\tpending\thttps://example/pr/2\n'
    ;;
esac
EOF

  cat >"$dir/git-pr-land" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'land %s\n' "$*" >>"${STACK_LOG:?}"
EOF

  cat >"$dir/git-pr-restack" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'restack %s\n' "$*" >>"${STACK_LOG:?}"
if [[ -n "${STACK_RACE_REPO:-}" && "${1:-}" == 2 ]]; then
  git -C "$STACK_RACE_REPO" worktree add --quiet "${STACK_RACE_WORKTREE:?}" feature/a
fi
EOF

  cat >"$dir/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
_merge_state() {
  local target="$1"
  local count count_file

  case "${GH_MERGE_CASE:-clean}" in
    clean)
      printf 'CLEAN\n'
      ;;
    dirty)
      printf 'DIRTY\n'
      ;;
    dirty-then-clean)
      count_file="${GH_VIEW_COUNT:?}.$target"
      count=0
      [[ ! -f "$count_file" ]] || count=$(< "$count_file")
      count=$((count + 1))
      printf '%s\n' "$count" >"$count_file"
      if ((count == 1)); then
        printf 'DIRTY\n'
      else
        printf 'CLEAN\n'
      fi
      ;;
    *)
      printf 'unexpected merge case: %s\n' "$GH_MERGE_CASE" >&2
      exit 99
      ;;
  esac
}

if [[ "$1 $2" == "auth status" ]]; then
  exit 0
fi
if [[ "$1 $2" == "pr view" ]]; then
  merge_state=$(_merge_state "${3:-}")
  case "${3:-}" in
    2)
      printf '2\tOPEN\tfalse\t%s\tfeature/b\tmain\thttps://example/pr/2\tChild PR\n' "$merge_state"
      ;;
    3)
      printf '3\tOPEN\tfalse\t%s\tfeature/c\tmain\thttps://example/pr/3\tGrandchild PR\n' "$merge_state"
      ;;
    *)
      printf 'unexpected pr view target: %s\n' "${3:-}" >&2
      exit 99
      ;;
  esac
  exit 0
fi
if [[ "$1 $2" == "pr checks" ]]; then
  printf 'checks %s\n' "$*" >>"${STACK_LOG:?}"
  case "${GH_CHECK_CASE:-pass}" in
    pass)
      printf 'pass\n'
      ;;
    fail)
      printf 'fail\n'
      ;;
    none)
      printf 'none\n'
      ;;
  esac
  exit 0
fi
printf 'unexpected gh call: %s\n' "$*" >&2
exit 99
EOF

  chmod +x "$dir/git-pr-stack" "$dir/git-pr-land" "$dir/git-pr-restack" "$dir/gh"
}

echo "=== git pr-land-stack ==="

repo=$(_tmpdir)
bin_dir=$(_tmpdir)
log=$(_tmpdir)/stack.log
_git_init "$repo"
git -C "$repo" branch feature/a
git -C "$repo" branch feature/b
git -C "$repo" branch feature/c
_write_tool_stubs "$bin_dir"

topology_repo=$(_tmpdir)
topology_worktree=$(_tmpdir)
topology_log=$(_tmpdir)/stack.log
_git_init "$topology_repo"
git -C "$topology_repo" branch feature/a
git -C "$topology_repo" branch feature/b
git -C "$topology_repo" branch feature/c
git -C "$topology_repo" worktree add --quiet "$topology_worktree" feature/b
result=$(PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" STACK_LOG="$topology_log" \
  git -C "$topology_repo" pr-land-stack 1 2>&1)
rc=$?
_assert_eq "linked stack: refuses before first merge" "1" "$rc"
_assert_contains "linked stack: reports reserved child branch" \
  "stack branch feature/b is checked out or reserved in another worktree" "$result"
if [[ -s "$topology_log" ]]; then
  _fail "linked stack: does not land before refusal"
else
  _pass "linked stack: does not land before refusal"
fi

base_topology_repo=$(_tmpdir)
base_topology_worktree=$(_tmpdir)
base_topology_log=$(_tmpdir)/stack.log
_git_init "$base_topology_repo"
git -C "$base_topology_repo" branch feature/a
git -C "$base_topology_repo" branch feature/b
git -C "$base_topology_repo" branch feature/c
git -C "$base_topology_repo" switch --quiet -c runner
git -C "$base_topology_repo" worktree add --quiet "$base_topology_worktree" main
result=$(PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" STACK_LOG="$base_topology_log" \
  git -C "$base_topology_repo" pr-land-stack 1 2>&1)
rc=$?
_assert_eq "linked stack base: refuses before first merge" "1" "$rc"
_assert_contains "linked stack base: reports final cleanup conflict" \
  "cannot delete feature/c while main is checked out or reserved" "$result"
if [[ -s "$base_topology_log" ]]; then
  _fail "linked stack base: does not land before refusal"
else
  _pass "linked stack base: does not land before refusal"
fi

race_repo=$(_tmpdir)
race_worktree=$(_tmpdir)
race_log=$(_tmpdir)/stack.log
_git_init "$race_repo"
git -C "$race_repo" branch feature/a
git -C "$race_repo" branch feature/b
git -C "$race_repo" branch feature/c
result=$(PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" STACK_LOG="$race_log" \
  STACK_RACE_REPO="$race_repo" STACK_RACE_WORKTREE="$race_worktree" \
  git -C "$race_repo" pr-land-stack 1 2>&1)
rc=$?
_assert_eq "stack cleanup race: exits before branch deletion" "1" "$rc"
_assert_contains "stack cleanup race: reports new branch owner" \
  "cannot delete feature/a; branch is checked out or reserved" "$result"
if git -C "$race_repo" show-ref --verify --quiet refs/heads/feature/a; then
  _pass "stack cleanup race: preserves local branch"
else
  _fail "stack cleanup race: preserves local branch"
fi

push_race_repo=$(_tmpdir)
push_race_remote=$(_tmpdir)
push_race_worktree=$(_tmpdir)
push_race_hooks=$(_tmpdir)
push_race_log=$(_tmpdir)/stack.log
_git_init "$push_race_repo"
git -C "$push_race_repo" branch feature/a
git -C "$push_race_repo" branch feature/b
git -C "$push_race_repo" branch feature/c
git init -q --bare "$push_race_remote"
git -C "$push_race_repo" remote add origin "$push_race_remote"
git -C "$push_race_repo" push --quiet origin main feature/a feature/b feature/c
git -C "$push_race_repo" fetch --quiet origin
cat >"$push_race_hooks/pre-push" <<EOF
#!/usr/bin/env bash
set -euo pipefail
git branch feature/a refs/remotes/origin/feature/a >/dev/null
git worktree add --quiet "$push_race_worktree" feature/a
EOF
chmod +x "$push_race_hooks/pre-push"
git -C "$push_race_repo" config core.hooksPath "$push_race_hooks"
result=$(PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" STACK_LOG="$push_race_log" \
  git -C "$push_race_repo" pr-land-stack 1 2>&1)
rc=$?
_assert_eq "stack push race: reports partial cleanup" "1" "$rc"
_assert_contains "stack push race: explains recreated local branch" \
  "remote branch origin/feature/a was deleted but the local branch was recreated" "$result"
if git -C "$push_race_remote" show-ref --verify --quiet refs/heads/feature/a; then
  _fail "stack push race: remote deletion completed"
else
  _pass "stack push race: remote deletion completed"
fi
_assert_eq "stack push race: preserves concurrent checkout" \
  "feature/a" "$(git -C "$push_race_worktree" branch --show-current)"

remote_repo=$(_tmpdir)
origin_remote=$(_tmpdir)
upstream_remote=$(_tmpdir)
remote_log=$(_tmpdir)/stack.log
_git_init "$remote_repo"
git -C "$remote_repo" branch feature/a
git -C "$remote_repo" branch feature/b
git -C "$remote_repo" branch feature/c
git init -q --bare "$origin_remote"
git init -q --bare "$upstream_remote"
git -C "$remote_repo" remote add origin "$origin_remote"
git -C "$remote_repo" remote add upstream "$upstream_remote"
git -C "$remote_repo" push --quiet origin main feature/a feature/b feature/c
git -C "$remote_repo" push --quiet upstream main feature/a feature/b feature/c
git -C "$remote_repo" fetch --quiet origin
git -C "$remote_repo" fetch --quiet upstream
git -C "$remote_repo" config branch.feature/a.remote upstream
git -C "$remote_repo" config branch.feature/b.remote upstream
PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" STACK_LOG="$remote_log" \
  git -C "$remote_repo" pr-land-stack 1 >/tmp/pr-land-stack-remote.out 2>&1
if git -C "$upstream_remote" show-ref --verify --quiet refs/heads/feature/a; then
  _fail "configured remote cleanup: deletes upstream feature/a"
else
  _pass "configured remote cleanup: deletes upstream feature/a"
fi
if git -C "$origin_remote" show-ref --verify --quiet refs/heads/feature/a; then
  _pass "configured remote cleanup: preserves same-named origin branch"
else
  _fail "configured remote cleanup: preserves same-named origin branch"
fi

# Regression: a dry run must NOT delete intermediate stack branches. The bug was
# that _run_tool printed "would run" but fell through to execute the raw
# git branch -D / git push --delete in _delete_landed_head. Use a dedicated repo
# so this holds regardless of the destructive real runs below (which is why the
# existing bottom-of-file dry-run test could not catch it).
dry_repo=$(_tmpdir)
dry_log=$(_tmpdir)/stack.log
_git_init "$dry_repo"
git -C "$dry_repo" branch feature/a
git -C "$dry_repo" branch feature/b
git -C "$dry_repo" branch feature/c
PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" STACK_LOG="$dry_log" git -C "$dry_repo" pr-land-stack 1 --dry-run >/tmp/pr-land-stack-dryrun-safe.out 2>&1
rc=$?
_assert_eq "dry run completes successfully" "0" "$rc"
for _dry_branch in feature/a feature/b feature/c; do
  if git -C "$dry_repo" show-ref --verify --quiet "refs/heads/$_dry_branch"; then
    _pass "dry run keeps $_dry_branch"
  else
    _fail "dry run keeps $_dry_branch"
  fi
done
_assert_contains "dry run still plans the land" "land 1 --method squash --keep-branch --dry-run" "$(cat "$dry_log")"

# Regression: a dry run must NOT delete the REMOTE intermediate branches either
# (the most destructive path: git push --delete). Wire a real bare remote so
# _remote_branch_exists is true and _delete_landed_head reaches the push.
dry_remote=$(_tmpdir)
git init -q --bare "$dry_remote"
dry_remote_repo=$(_tmpdir)
dry_remote_log=$(_tmpdir)/stack.log
_git_init "$dry_remote_repo"
git -C "$dry_remote_repo" branch feature/a
git -C "$dry_remote_repo" branch feature/b
git -C "$dry_remote_repo" branch feature/c
git -C "$dry_remote_repo" remote add origin "$dry_remote"
git -C "$dry_remote_repo" push -q origin feature/a feature/b feature/c
git -C "$dry_remote_repo" fetch -q origin
PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" STACK_LOG="$dry_remote_log" git -C "$dry_remote_repo" pr-land-stack 1 --dry-run >/tmp/pr-land-stack-dryrun-remote.out 2>&1
rc=$?
_assert_eq "dry run with remote branches completes successfully" "0" "$rc"
for _dry_branch in feature/a feature/b feature/c; do
  if git -C "$dry_remote" show-ref --verify --quiet "refs/heads/$_dry_branch"; then
    _pass "dry run keeps remote $_dry_branch"
  else
    _fail "dry run keeps remote $_dry_branch"
  fi
done

PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" STACK_LOG="$log" git -C "$repo" pr-land-stack 1 >/tmp/pr-land-stack.out 2>&1
expected="$(
  cat <<'EOF'
land 1 --method squash --keep-branch
restack 2 --base main --fork feature/a
checks pr checks 2 --json bucket --jq [.[].bucket] as $buckets | if any($buckets[]; . != "pass" and . != "skipping" and . != "fail" and . != "cancel" and . != "pending") then error("unknown check bucket") elif ($buckets | length) == 0 then "none" elif any($buckets[]; . == "fail" or . == "cancel") then "fail" elif any($buckets[]; . == "pending") then "pending" else "pass" end
land 2 --method squash --keep-branch
restack 3 --base main --fork feature/b
checks pr checks 3 --json bucket --jq [.[].bucket] as $buckets | if any($buckets[]; . != "pass" and . != "skipping" and . != "fail" and . != "cancel" and . != "pending") then error("unknown check bucket") elif ($buckets | length) == 0 then "none" elif any($buckets[]; . == "fail" or . == "cancel") then "fail" elif any($buckets[]; . == "pending") then "pending" else "pass" end
land 3 --method squash
EOF
)"
_assert_eq "lands and restacks in stack order" "$expected" "$(cat "$log")"
if git -C "$repo" show-ref --verify --quiet refs/heads/feature/a; then
  _fail "deletes first intermediate branch after child restack"
else
  _pass "deletes first intermediate branch after child restack"
fi
if git -C "$repo" show-ref --verify --quiet refs/heads/feature/b; then
  _fail "deletes second intermediate branch after child restack"
else
  _pass "deletes second intermediate branch after child restack"
fi
if git -C "$repo" show-ref --verify --quiet refs/heads/feature/c; then
  _pass "leaves final branch cleanup to git pr-land"
else
  _fail "leaves final branch cleanup to git pr-land"
fi
_assert_contains "reports stack completion" "landed stack rooted at PR #1" "$(</tmp/pr-land-stack.out)"

log_dirty=$(_tmpdir)/stack.log
view_count=$(_tmpdir)/view-count
PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" GH_MERGE_CASE=dirty-then-clean GH_VIEW_COUNT="$view_count" STACK_LOG="$log_dirty" git -C "$repo" pr-land-stack 1 --check-timeout 3 --check-interval 1 >/tmp/pr-land-stack-dirty.out 2>&1
_assert_contains "waits through transient dirty merge state" "waiting for PR #2 after restack: merge DIRTY, checks pass" "$(</tmp/pr-land-stack-dirty.out)"
_assert_contains "lands after transient dirty merge state" "land 3 --method squash" "$(cat "$log_dirty")"

result=$(PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" GH_MERGE_CASE=dirty STACK_LOG="$log" git -C "$repo" pr-land-stack 1 --check-timeout 1 --check-interval 1 2>&1 || true)
_assert_contains "times out persistent dirty merge state" "timed out waiting for PR #2 after restack: merge DIRTY, checks pass" "$result"

log_keep=$(_tmpdir)/stack.log
PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" STACK_LOG="$log_keep" git -C "$repo" pr-land-stack 1 --method merge --keep-branch >/tmp/pr-land-stack-keep.out 2>&1
_assert_contains "passes keep-branch to land" "land 1 --method merge --keep-branch" "$(cat "$log_keep")"

log_dry=$(_tmpdir)/stack.log
PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" STACK_LOG="$log_dry" git -C "$repo" pr-land-stack 1 --dry-run >/tmp/pr-land-stack-dry.out 2>&1
_assert_contains "dry run passes through to land" "land 1 --method squash --keep-branch --dry-run" "$(cat "$log_dry")"
_assert_contains "dry run passes through to restack" "restack 2 --base main --fork feature/a --dry-run" "$(cat "$log_dry")"

result=$(PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" STACK_CASE=blocked STACK_LOG="$log" git -C "$repo" pr-land-stack 1 2>&1 || true)
_assert_contains "refuses unready stacks before landing" "PR #2 is not ready: checks pending" "$result"

result=$(PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" GH_CHECK_CASE=fail STACK_LOG="$log" git -C "$repo" pr-land-stack 1 2>&1 || true)
_assert_contains "refuses failed post-restack checks" "PR #2 checks failed after restack" "$result"

result=$(PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" STACK_LOG="$log" git -C "$repo" pr-land-stack 1 --method bad 2>&1 || true)
_assert_contains "validates merge method" "merge method must be squash, merge, or rebase" "$result"

result=$(PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" STACK_LOG="$log" git -C "$repo" pr-land-stack 1 --check-timeout 0 2>&1 || true)
_assert_contains "validates check timeout" "--check-timeout must be greater than zero" "$result"

outside=$(_tmpdir)
result=$(PATH="$bin_dir:$PATH" GIT_TOOLS_TOOL_DIR="$bin_dir" STACK_LOG="$log" git -C "$outside" pr-land-stack 1 2>&1 || true)
_assert_contains "requires git repo" "not inside a git repository" "$result"

if ((_failures > 0)); then
  printf '%s failure(s)\n' "$_failures" >&2
  exit 1
fi

printf 'all tests passed\n'
