#!/usr/bin/env bash

set -uo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PATH="$ROOT/bin:$PATH"
export NO_COLOR=1

_failures=0
# shellcheck source=test/lib/test-temp.sh
. "$ROOT/test/lib/test-temp.sh"
gt_test_temp_init || exit 1
_tmpdir() { gt_test_temp_dir; }

_pass() {
  printf 'ok - %s\n' "$1"
}

_fail() {
  printf 'not ok - %s\n' "$1" >&2
  _failures=$((_failures + 1))
}

_assert_eq() {
  local name="$1"
  local expected="$2"
  local actual="$3"

  if [[ "$actual" == "$expected" ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected: %q\n' "$expected" >&2
    printf '  actual:   %q\n' "$actual" >&2
  fi
}

_assert_contains() {
  local name="$1"
  local needle="$2"
  local haystack="$3"

  if [[ "$haystack" == *"$needle"* ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected output to contain: %s\n' "$needle" >&2
    printf '  actual output:\n%s\n' "$haystack" >&2
  fi
}

_git_init() {
  local repo="$1"
  git init -q --initial-branch=main "$repo"
  git -C "$repo" config user.email "test@test.com"
  git -C "$repo" config user.name "Test"
  git -C "$repo" config core.hooksPath /dev/null
  printf 'base\n' >"$repo/README.md"
  git -C "$repo" add README.md
  git -C "$repo" commit -m base >/dev/null
}

_add_github_remote() {
  local repo="$1" name="$2" path="$3" identity="${4:-example/repo}"
  local url="https://github.test/$identity.git"

  git -C "$repo" config "url.$path.insteadOf" "$url"
  git -C "$repo" remote add "$name" "$url"
}

_write_git_remote_ssh() {
  cat >"$1" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

for argument in "$@"; do
  [[ "$argument" != -G ]] || exit 1
done
command=""
for argument in "$@"; do
  command=$argument
done
case "$command" in
  "git-upload-pack "*) exec /usr/bin/git-upload-pack "${GIT_TEST_SSH_REPO:?}" ;;
  "git-receive-pack "*) exec /usr/bin/git-receive-pack "${GIT_TEST_SSH_REPO:?}" ;;
esac
printf 'unexpected ssh invocation: %s\n' "$*" >&2
exit 99
EOF
  chmod +x "$1"
}

_pr_land_stack() {
  local repo="$1"
  shift
  (cd "$repo" && "$ROOT/bin/git-pr-land-stack" "$@")
}

_write_tool_stubs() {
  local dir="$1"

  cat >"$dir/git-pr-stack" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
topology_state=${STACK_TOPOLOGY_STATE:-${STACK_LOG}.topology}
rm -f "$topology_state.1" "$topology_state.2" "$topology_state.3"
oid_a=$(git rev-parse refs/heads/feature/a)
oid_b=$(git rev-parse refs/heads/feature/b)
oid_c=$(git rev-parse refs/heads/feature/c)
case "${STACK_CASE:-ready}" in
  ready)
    printf 'pr\t0\t1\tmain\tfeature/a\ttrue\tready\tpass\thttps://github.test/example/repo/pull/1\t%s\texample/repo\tfalse\n' "$oid_a"
    printf 'pr\t1\t2\tfeature/a\tfeature/b\ttrue\tready\tpass\thttps://github.test/example/repo/pull/2\t%s\texample/repo\tfalse\n' "$oid_b"
    printf 'pr\t2\t3\tfeature/b\tfeature/c\ttrue\tready\tpass\thttps://github.test/example/repo/pull/3\t%s\texample/repo\tfalse\n' "$oid_c"
    ;;
  blocked)
    printf 'pr\t0\t1\tmain\tfeature/a\ttrue\tready\tpass\thttps://github.test/example/repo/pull/1\t%s\texample/repo\tfalse\n' "$oid_a"
    printf 'pr\t1\t2\tfeature/a\tfeature/b\tfalse\tchecks pending\tpending\thttps://github.test/example/repo/pull/2\t%s\texample/repo\tfalse\n' "$oid_b"
    ;;
  partial-failure)
    printf 'pr\t0\t1\tmain\tfeature/a\ttrue\tready\tpass\thttps://github.test/example/repo/pull/1\t%s\texample/repo\tfalse\n' "$oid_a"
    exit 88
    ;;
esac
EOF

  cat >"$dir/git-pr-land" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'land %s\n' "$*" >>"${STACK_LOG:?}"
number=${1##*/}
if [[ -n "${STACK_DRIFT_AFTER_LAND:-}" && "$number" == 1 ]]; then
  : >"$STACK_DRIFT_AFTER_LAND"
