#!/usr/bin/env bash

set -uo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PATH="$ROOT/bin:$PATH"
export NO_COLOR=1

_failures=0
# shellcheck source=test/lib/test-temp.sh
. "$ROOT/test/lib/test-temp.sh"
gt_test_temp_init || exit 1
_tmpdir() { gt_test_temp_dir; }

_canonical_path() {
  (cd -P -- "$1" && pwd)
}

_pass() {
  printf 'ok - %s\n' "$1"
}

_fail() {
  printf 'not ok - %s\n' "$1" >&2
  _failures=$((_failures + 1))
}

_assert_eq() {
  local name="$1"
  local expected="$2"
  local actual="$3"

  if [[ "$actual" == "$expected" ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected: %q\n' "$expected" >&2
    printf '  actual:   %q\n' "$actual" >&2
  fi
}

_assert_contains() {
  local name="$1"
  local needle="$2"
  local haystack="$3"

  if [[ "$haystack" == *"$needle"* ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected output to contain: %s\n' "$needle" >&2
    printf '  actual output:\n%s\n' "$haystack" >&2
  fi
}

_commit_file() {
  local repo="$1"
  local path="$2"
  local content="$3"
  local message="$4"

  mkdir -p "$(dirname "$repo/$path")"
  printf '%s\n' "$content" >"$repo/$path"
  git -C "$repo" add "$path"
  git -C "$repo" commit -m "$message" >/dev/null
}

_pr_land() {
  local repo="$1"
  local head_oid
  shift
  head_oid=${GH_PR_HEAD_OID:-}
  if [[ -z "$head_oid" ]]; then
    head_oid=$(git -C "$repo" rev-parse refs/remotes/origin/feature)
  fi
  (cd "$repo" && GH_TEST_REPO="$repo" GH_PR_HEAD_OID="$head_oid" \
    "$ROOT/bin/git-pr-land" "$@")
}

_init_repo() {
  local repo="$1"
  local remote="$2"

  git init --bare --initial-branch=main "$remote" >/dev/null
  git init -q --initial-branch=main "$repo"
  git -C "$repo" config user.email "test@test.com"
  git -C "$repo" config user.name "Test"
  git -C "$repo" config core.hooksPath /dev/null
  _commit_file "$repo" README.md base base
  git -C "$repo" config "url.$remote.insteadOf" \
    https://github.test/example/repo.git
  git -C "$repo" remote add origin https://github.test/example/repo.git
  git -C "$repo" push -u origin main >/dev/null 2>&1
  git -C "$repo" switch --quiet -c feature
  _commit_file "$repo" feature.txt feature feature
  git -C "$repo" push -u origin feature >/dev/null 2>&1
  git -C "$repo" switch --quiet feature
}

_write_gh_stub() {
  local dir="$1"
  local bin="$dir/gh"
  cat >"$bin" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

log="${GH_LOG:?}"
state_file="${GH_STATE:-$log.state}"
GH_PR_HEAD_OID=${GH_PR_HEAD_OID:-$(git rev-parse \
  refs/remotes/origin/feature 2>/dev/null || git rev-parse refs/heads/feature)}

if [[ "$1 $2" == "auth status" ]]; then
  exit 0
fi

if [[ "$1 $2" == "repo view" ]]; then
  printf 'example/repo\thttps://github.test/example/repo\n'
  exit 0
fi

if [[ "$1 $2" == "pr list" ]]; then
  case "${GH_DELETE_INVENTORY:-empty}" in
    empty)
      ;;
    dependent)
      printf '5\tOPEN\tfalse\tCLEAN\tdependent\t2222222222222222222222222222222222222222\tfeature\texample/repo\tfalse\thttps://github.test/example/repo/pull/5\tNew dependent PR\n'
      ;;
    shared-head)
      printf '5\tOPEN\tfalse\tCLEAN\tfeature\t2222222222222222222222222222222222222222\trelease\texample/repo\tfalse\thttps://github.test/example/repo/pull/5\tShared head PR\n'
      ;;
    unrelated)
      printf '5\tOPEN\tfalse\tCLEAN\tsibling\t2222222222222222222222222222222222222222\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/5\tUnrelated sibling PR\n'
      ;;
    failure)
      printf 'partial inventory\n'
      exit 88
      ;;
    overflow)
      index=1
      while ((index <= 201)); do
        printf '%s\tOPEN\tfalse\tCLEAN\tconsumer/%s\t2222222222222222222222222222222222222222\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/%s\tInventory PR\n' \
          "$index" "$index" "$index"
        index=$((index + 1))
      done
      ;;
  esac
  exit 0
fi

if [[ "$1 $2" == "pr view" ]]; then
  case "${GH_PR_CASE:-ready}" in
    ready)
      if [[ -f "$state_file" ]]; then
        printf '4\tMERGED\tfalse\tUNKNOWN\tfeature\t%s\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/4\tFeature PR\n' "$GH_PR_HEAD_OID"
      else
        printf '4\tOPEN\tfalse\tCLEAN\tfeature\t%s\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/4\tFeature PR\n' "$GH_PR_HEAD_OID"
      fi
      ;;
    pending)
      printf '4\tOPEN\tfalse\tCLEAN\tfeature\t%s\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/4\tFeature PR\n' "$GH_PR_HEAD_OID"
      ;;
    dirty)
      printf '4\tOPEN\tfalse\tDIRTY\tfeature\t%s\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/4\tFeature PR\n' "$GH_PR_HEAD_OID"
      ;;
    merged-after-error)
      if [[ -f "$state_file" ]]; then
        printf '4\tMERGED\tfalse\tUNKNOWN\tfeature\t%s\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/4\tFeature PR\n' "$GH_PR_HEAD_OID"
      else
        printf '4\tOPEN\tfalse\tCLEAN\tfeature\t%s\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/4\tFeature PR\n' "$GH_PR_HEAD_OID"
      fi
      ;;
    checkout-head-after-merge | advance-head-after-merge | advance-remote-after-merge | create-remote-after-merge)
      if [[ -f "$state_file" ]]; then
        printf '4\tMERGED\tfalse\tUNKNOWN\tfeature\t%s\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/4\tFeature PR\n' "$GH_PR_HEAD_OID"
      else
        printf '4\tOPEN\tfalse\tCLEAN\tfeature\t%s\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/4\tFeature PR\n' "$GH_PR_HEAD_OID"
      fi
      ;;
    queued)
      printf '4\tOPEN\tfalse\tCLEAN\tfeature\t%s\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/4\tFeature PR\n' "$GH_PR_HEAD_OID"
      ;;
    fork)
      if [[ -f "$state_file" ]]; then
        printf '4\tMERGED\tfalse\tUNKNOWN\tfeature\t%s\tmain\tforker/repo\ttrue\thttps://github.test/example/repo/pull/4\tFork PR\n' "$GH_PR_HEAD_OID"
      else
        printf '4\tOPEN\tfalse\tCLEAN\tfeature\t%s\tmain\tforker/repo\ttrue\thttps://github.test/example/repo/pull/4\tFork PR\n' "$GH_PR_HEAD_OID"
      fi
      ;;
    foreign-target)
      printf '4\tOPEN\tfalse\tCLEAN\tforeign-head\t%s\tmain\tforeign/repo\tfalse\thttps://github.test/foreign/repo/pull/4\tForeign PR\n' "$GH_PR_HEAD_OID"
      ;;
    number-url-mismatch)
      printf '4\tOPEN\tfalse\tCLEAN\tfeature\t%s\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/5\tMismatched number\n' "$GH_PR_HEAD_OID"
      ;;
    explicit-target-rebound)
      printf '5\tOPEN\tfalse\tCLEAN\tfeature\t%s\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/5\tRebound PR\n' "$GH_PR_HEAD_OID"
      ;;
    branch-target-rebound)
      printf '4\tOPEN\tfalse\tCLEAN\tfeature\t%s\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/4\tWrong branch PR\n' "$GH_PR_HEAD_OID"
      ;;
    post-action-rebound)
      if [[ -f "$state_file" ]]; then
        printf '5\tMERGED\tfalse\tUNKNOWN\tfeature\t%s\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/5\tRebound PR\n' "$GH_PR_HEAD_OID"
      else
        printf '4\tOPEN\tfalse\tCLEAN\tfeature\t%s\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/4\tFeature PR\n' "$GH_PR_HEAD_OID"
      fi
      ;;
    wrong-same-repo-head)
      printf '4\tOPEN\tfalse\tCLEAN\tfeature\t%s\tmain\tforeign/repo\tfalse\thttps://github.test/example/repo/pull/4\tWrong head repository\n' "$GH_PR_HEAD_OID"
      ;;
    wrong-cross-repo-head)
      printf '4\tOPEN\tfalse\tCLEAN\tfeature\t%s\tmain\texample/repo\ttrue\thttps://github.test/example/repo/pull/4\tWrong cross repository state\n' "$GH_PR_HEAD_OID"
      ;;
    malformed-draft)
      printf '4\tOPEN\tmaybe\tCLEAN\tfeature\t%s\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/4\tMalformed draft\n' "$GH_PR_HEAD_OID"
      ;;
    malformed-cross)
      printf '4\tOPEN\tfalse\tCLEAN\tfeature\t%s\tmain\texample/repo\tmaybe\thttps://github.test/example/repo/pull/4\tMalformed cross state\n' "$GH_PR_HEAD_OID"
      ;;
    malformed-head)
      printf '4\tOPEN\tfalse\tCLEAN\tbad..head\t%s\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/4\tMalformed head\n' "$GH_PR_HEAD_OID"
      ;;
    malformed-base)
      printf '4\tOPEN\tfalse\tCLEAN\tfeature\t%s\tbad..base\texample/repo\tfalse\thttps://github.test/example/repo/pull/4\tMalformed base\n' "$GH_PR_HEAD_OID"
      ;;
    same-head-base)
      printf '4\tOPEN\tfalse\tCLEAN\tmain\t%s\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/4\tSame head and base\n' "$GH_PR_HEAD_OID"
      ;;
  esac
  exit 0
fi

if [[ "$1 $2" == "pr checks" ]]; then
  case "${GH_PR_CASE:-ready}" in
    pending) printf 'pending\n'; exit 8 ;;
    *) printf 'pass\n' ;;
  esac
  exit 0
fi

if [[ "$1 $2" == "pr merge" ]]; then
  if [[ -n "${GH_ROUTE_LOG:-}" ]]; then
    printf 'repo=%s host=%s %s\n' \
      "${GH_REPO:-}" "${GH_HOST:-}" "$*" >>"$GH_ROUTE_LOG"
  fi
  printf '%s\n' "$*" >>"$log"
  case "${GH_PR_CASE:-ready}" in
    merged-after-error)
      : >"$state_file"
      exit 1
      ;;
    checkout-head-after-merge)
      git -C "${GH_TEST_REPO:?}" worktree add "${GH_WORKTREE:?}" feature >/dev/null 2>&1
      : >"$state_file"
      ;;
    advance-head-after-merge)
      old=$(git -C "${GH_TEST_REPO:?}" rev-parse refs/heads/feature)
      tree=$(git -C "$GH_TEST_REPO" rev-parse "$old^{tree}")
      new=$(printf '%s\n' concurrent | git -C "$GH_TEST_REPO" commit-tree "$tree" -p "$old")
      git -C "$GH_TEST_REPO" update-ref refs/heads/feature "$new" "$old"
      printf '%s\n' "$new" >"${GH_ADVANCED_OID:?}"
      : >"$state_file"
      ;;
    advance-remote-after-merge)
      old=$(git -C "${GH_TEST_REPO:?}" rev-parse refs/remotes/origin/feature)
      tree=$(git -C "$GH_TEST_REPO" rev-parse "$old^{tree}")
      new=$(printf '%s\n' concurrent-remote | git -C "$GH_TEST_REPO" commit-tree "$tree" -p "$old")
      git -C "$GH_TEST_REPO" push --quiet origin "$new:refs/heads/feature"
      printf '%s\n' "$new" >"${GH_ADVANCED_OID:?}"
      : >"$state_file"
      ;;
    create-remote-after-merge)
      git -C "${GH_TEST_REPO:?}" push --quiet origin \
        "refs/heads/feature:refs/heads/feature"
      : >"$state_file"
      ;;
    queued)
      exit 0
      ;;
    *)
      : >"$state_file"
      ;;
  esac
  exit 0
fi

printf 'unexpected gh call: %s\n' "$*" >&2
exit 99
EOF
  chmod +x "$bin"
  cat >"$dir/git" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

# Tests use local bare repositories behind GitHub-shaped configured URLs. Keep
# the configured push URL visible to identity validation while real Git applies
# its ordinary insteadOf rule to ls-remote and push operations.
if [[ "${1:-} ${2:-} ${3:-} ${4:-}" == "remote get-url --push --all" ]] &&
  [[ "${GIT_TEST_REAL_EFFECTIVE_PUSH_URL:-0}" != 1 ]]; then
  remote=${5:-}
  url=$(/usr/bin/git config --get-all "remote.$remote.pushurl" 2>/dev/null || true)
  [[ -n "$url" ]] || url=$(/usr/bin/git config --get-all "remote.$remote.url")
  printf '%s\n' "$url"
  exit 0
fi
if [[ "${1:-} ${2:-} ${3:-}" == "remote get-url --all" ]]; then
  /usr/bin/git config --get-all "remote.${4:-}.url"
  exit $?
fi
if [[ "${1:-}" == -c && "${2:-}" == url.*.insteadOf=* &&
  "${3:-}" == -c && "${4:-}" == url.*.pushInsteadOf=* ]]; then
  pin=${2#url.}
  target=${pin%%.insteadOf=*}
  alias=${pin#*.insteadOf=}
  shift 4
  rewritten=()
  for argument in "$@"; do
    [[ "$argument" != "$alias" ]] || argument=$target
    rewritten+=("$argument")
  done
  set -- "${rewritten[@]}"
fi
exec /usr/bin/git "$@"
EOF
  chmod +x "$dir/git"
}

