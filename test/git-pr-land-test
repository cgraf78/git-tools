_write_git_remote_ssh() {
  cat >"$1" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

for argument in "$@"; do
  [[ "$argument" != -G ]] || exit 1
done
command=""
for argument in "$@"; do
  command=$argument
done
case "$command" in
  "git-upload-pack "*) exec /usr/bin/git-upload-pack "${GIT_TEST_SSH_REPO:?}" ;;
  "git-receive-pack "*) exec /usr/bin/git-receive-pack "${GIT_TEST_SSH_REPO:?}" ;;
esac
printf 'unexpected ssh invocation: %s\n' "$*" >&2
exit 99
EOF
  chmod +x "$1"
}

echo "=== git pr-land ==="

repo=$(_tmpdir)
remote=$(_tmpdir)
bin_dir=$(_tmpdir)
log=$(_tmpdir)/gh.log
_init_repo "$repo" "$remote"
_write_gh_stub "$bin_dir"
head_oid=$(git -C "$repo" rev-parse refs/remotes/origin/feature)

result=$(GH_LOG="$log" PATH="$bin_dir:$PATH" _pr_land "$repo" 4 2>&1)
_assert_contains "merges ready PR" "merging PR #4 with squash" "$result"
_assert_eq "uses squash merge without unleased server deletion" \
  "pr merge 4 --squash --match-head-commit $head_oid --repo github.test/example/repo" \
  "$(cat "$log")"
_assert_eq "syncs base branch" "main" "$(git -C "$repo" branch --show-current)"
if git -C "$repo" show-ref --verify --quiet refs/heads/feature; then
  _pass "preserves local feature branch for manual cleanup"
else
  _fail "preserves local feature branch for manual cleanup"
fi
_assert_contains "reports manual local cleanup" \
  "preserving local PR head feature at " \
  "$result"
if git -C "$remote" show-ref --verify --quiet refs/heads/feature; then
  _pass "preserves remote feature branch for manual cleanup"
else
  _fail "preserves remote feature branch for manual cleanup"
fi
_assert_contains "reports manual remote cleanup candidate" \
  "preserving remote PR head feature at $head_oid; delete it manually" \
  "$result"

_assert_final_inventory_preserves_branch() {
  local inventory_case="$1" expected_message="$2"
  local case_repo case_remote case_log case_output

  case_repo=$(_tmpdir)
  case_remote=$(_tmpdir)
  case_log=$(_tmpdir)/gh.log
  _init_repo "$case_repo" "$case_remote"
  case_output=$(GH_DELETE_INVENTORY="$inventory_case" GH_LOG="$case_log" \
    PATH="$bin_dir:$PATH" _pr_land "$case_repo" 4 2>&1)
  _assert_contains "final inventory preserves branch: $inventory_case" \
    "$expected_message" "$case_output"
  if git -C "$case_remote" show-ref --verify --quiet refs/heads/feature; then
    _pass "final inventory keeps remote branch: $inventory_case"
  else
    _fail "final inventory keeps remote branch: $inventory_case"
  fi
}

_assert_final_inventory_preserves_branch dependent \
  "delete it manually after verifying no pull request consumes it"
_assert_final_inventory_preserves_branch shared-head \
  "delete it manually after verifying no pull request consumes it"
_assert_final_inventory_preserves_branch failure \
  "delete it manually after verifying no pull request consumes it"
_assert_final_inventory_preserves_branch overflow \
  "delete it manually after verifying no pull request consumes it"

unrelated_repo=$(_tmpdir)
unrelated_remote=$(_tmpdir)
unrelated_log=$(_tmpdir)/gh.log
_init_repo "$unrelated_repo" "$unrelated_remote"
GH_DELETE_INVENTORY=unrelated GH_LOG="$unrelated_log" PATH="$bin_dir:$PATH" \
  _pr_land "$unrelated_repo" 4 >/dev/null 2>&1
if git -C "$unrelated_remote" show-ref --verify --quiet refs/heads/feature; then
  _pass "unrelated new PR cannot trigger automatic branch cleanup"
else
  _fail "unrelated new PR cannot trigger automatic branch cleanup"
fi

ambient_repo=$(_tmpdir)
ambient_origin=$(_tmpdir)
ambient_bin=$(_tmpdir)
ambient_log=$(_tmpdir)/gh.log
ambient_route_log=$(_tmpdir)/route.log
_init_repo "$ambient_repo" "$ambient_origin"
_write_gh_stub "$ambient_bin"
ambient_head_oid=$(git -C "$ambient_repo" rev-parse refs/remotes/origin/feature)
ambient_output=$(GH_REPO=github.test/foreign/repo GH_HOST=foreign.test \
  GH_LOG="$ambient_log" GH_ROUTE_LOG="$ambient_route_log" \
  PATH="$ambient_bin:$PATH" _pr_land "$ambient_repo" 4 2>&1)
_assert_contains "ambient routing cannot redirect numeric landing" \
  "landed PR #4" "$ambient_output"
_assert_contains "merge mutation is pinned to the checkout repository" \
  "repo=github.test/example/repo host=github.test pr merge 4 --squash --match-head-commit $ambient_head_oid" \
  "$(<"$ambient_route_log")"

# Base tracking configuration is not trusted for an irreversible merge. Resolve
# the unique fetch remote mapped to the checkout repository instead.
base_route_repo=$(_tmpdir)
base_route_origin=$(_tmpdir)
base_route_other=$(_tmpdir)
base_route_bin=$(_tmpdir)
base_route_log=$(_tmpdir)/gh.log
_init_repo "$base_route_repo" "$base_route_origin"
git init -q --bare --initial-branch=main "$base_route_other"
git -C "$base_route_repo" config "url.$base_route_other.insteadOf" \
  https://github.test/other/repo.git
git -C "$base_route_repo" remote add other https://github.test/other/repo.git
git -C "$base_route_repo" config branch.main.remote other
_write_gh_stub "$base_route_bin"
base_route_output=$(GH_LOG="$base_route_log" PATH="$base_route_bin:$PATH" \
  _pr_land "$base_route_repo" 4 2>&1)
_assert_contains "landing ignores a mismatched base tracking remote" \
  "syncing main from origin" "$base_route_output"
_assert_contains "landing with mismatched tracking still completes" \
  "landed PR #4" "$base_route_output"

# Base preflight and synchronization must fetch refs/heads/main from the exact
# validated repository URL. A named remote refspec maps a decoy branch onto the
# usual tracking name, while colliding tags try to capture every historical
# short spelling used by the implementation.
exact_base_repo=$(_tmpdir)
exact_base_remote=$(_tmpdir)
exact_base_updater=$(_tmpdir)
exact_base_log=$(_tmpdir)/gh.log
_init_repo "$exact_base_repo" "$exact_base_remote"
git -C "$exact_base_repo" push -q origin \
  refs/heads/main:refs/heads/decoy
git clone -q "$exact_base_remote" "$exact_base_updater"
git -C "$exact_base_updater" config user.email test@test.com
git -C "$exact_base_updater" config user.name Test
git -C "$exact_base_updater" config core.hooksPath /dev/null
_commit_file "$exact_base_updater" base-advance.txt advanced "advance base"
git -C "$exact_base_updater" push -q origin main
exact_remote_main=$(git -C "$exact_base_remote" rev-parse refs/heads/main)
git -C "$exact_base_repo" config --unset-all remote.origin.fetch
git -C "$exact_base_repo" config --add remote.origin.fetch \
  '+refs/heads/decoy:refs/remotes/origin/main'
git -C "$exact_base_repo" tag main refs/heads/feature
git -C "$exact_base_repo" tag origin/main refs/heads/feature
git -C "$exact_base_repo" tag upstream/main refs/heads/feature
exact_base_output=$(GH_LOG="$exact_base_log" PATH="$bin_dir:$PATH" \
  _pr_land "$exact_base_repo" 4 2>&1)
_assert_contains "exact base fetch lands despite refspec and tag collisions" \
  "landed PR #4" "$exact_base_output"
_assert_eq "post-merge sync uses the exact remote main OID" \
  "$exact_remote_main" \
  "$(git -C "$exact_base_repo" rev-parse refs/heads/main)"

foreign_repo=$(_tmpdir)
foreign_origin=$(_tmpdir)
foreign_bin=$(_tmpdir)
foreign_log=$(_tmpdir)/gh.log
_init_repo "$foreign_repo" "$foreign_origin"
_write_gh_stub "$foreign_bin"
foreign_rc=0
foreign_output=$(GH_LOG="$foreign_log" GH_PR_CASE=foreign-target \
  GT_CURRENT_REPO_IDENTITY=github.test/foreign/repo \
  PATH="$foreign_bin:$PATH" _pr_land "$foreign_repo" \
  https://github.test/foreign/repo/pull/4 2>&1) || foreign_rc=$?
_assert_contains "foreign same-number PR URL is rejected" \
  "target pull request belongs to a different repository" "$foreign_output"
if [[ "$foreign_rc" != 0 && ! -e "$foreign_log" ]]; then
  _pass "foreign PR URL causes no GitHub mutation"
else
  _fail "foreign PR URL causes no GitHub mutation"
fi

_assert_rejected_record_before_merge() {
  local case_name="$1"
  local target="${2:-4}"
  local case_repo case_origin case_bin case_log case_rc=0

  case_repo=$(_tmpdir)
  case_origin=$(_tmpdir)
  case_bin=$(_tmpdir)
  case_log=$(_tmpdir)/gh.log
  _init_repo "$case_repo" "$case_origin"
  _write_gh_stub "$case_bin"
  GH_LOG="$case_log" GH_PR_CASE="$case_name" PATH="$case_bin:$PATH" \
    _pr_land "$case_repo" "$target" >/dev/null 2>&1 || case_rc=$?
  if [[ "$case_rc" != 0 && ! -e "$case_log" ]]; then
