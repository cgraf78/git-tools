oid_advance=$(_tmpdir)/advanced-oid
_init_repo "$repo_advance" "$remote_advance"
feature_before=$(git -C "$repo_advance" rev-parse feature)
git -C "$repo_advance" switch --quiet main
result=$(GH_PR_CASE=advance-head-after-merge GH_STATE="$state_advance" \
  GH_TEST_REPO="$repo_advance" GH_ADVANCED_OID="$oid_advance" \
  GH_LOG="$log_advance" PATH="$bin_dir:$PATH" \
  _pr_land "$repo_advance" 4 2>&1)
rc=$?
feature_after=$(cat "$oid_advance")
_assert_eq "advanced local head: landing remains successful" "0" "$rc"
_assert_contains "advanced local head: reports live cleanup candidate" \
  "preserving local PR head feature at $feature_after" "$result"
_assert_eq "advanced local head: preserves concurrent commit" "$feature_after" \
  "$(git -C "$repo_advance" rev-parse refs/heads/feature)"
if [[ "$feature_after" != "$feature_before" ]]; then
  _pass "advanced local head: fixture changes the branch OID"
else
  _fail "advanced local head: fixture changes the branch OID"
fi

repo_remote_advance=$(_tmpdir)
remote_remote_advance=$(_tmpdir)
log_remote_advance=$(_tmpdir)/gh.log
state_remote_advance=$(_tmpdir)/merged
oid_remote_advance=$(_tmpdir)/advanced-oid
_init_repo "$repo_remote_advance" "$remote_remote_advance"
git -C "$repo_remote_advance" switch --quiet main
result=$(GH_PR_CASE=advance-remote-after-merge GH_STATE="$state_remote_advance" \
  GH_TEST_REPO="$repo_remote_advance" GH_ADVANCED_OID="$oid_remote_advance" \
  GH_LOG="$log_remote_advance" PATH="$bin_dir:$PATH" \
  _pr_land "$repo_remote_advance" 4 2>&1)
rc=$?
remote_feature_after=$(cat "$oid_remote_advance")
_assert_eq "advanced remote head: landing remains successful" "0" "$rc"
_assert_contains "advanced remote head: reports manual cleanup" \
  "delete it manually after verifying no pull request consumes it" "$result"
_assert_eq "advanced remote head: preserves concurrent commit" "$remote_feature_after" \
  "$(git -C "$remote_remote_advance" rev-parse refs/heads/feature)"
_assert_eq "advanced remote head: preserves local branch" \
  "feature" \
  "$(git -C "$repo_remote_advance" branch --format='%(refname:short)' --list feature)"

# A PR whose structured head OID is absent from the live remote must fail before
# merge. There is no exact commit to pin or a safe cleanup snapshot to take.
repo_remote_create=$(_tmpdir)
remote_remote_create=$(_tmpdir)
log_remote_create=$(_tmpdir)/gh.log
state_remote_create=$(_tmpdir)/merged
_init_repo "$repo_remote_create" "$remote_remote_create"
remote_create_oid=$(git -C "$repo_remote_create" rev-parse refs/heads/feature)
git -C "$repo_remote_create" push --quiet origin --delete feature
git -C "$repo_remote_create" fetch --quiet --prune origin
git -C "$repo_remote_create" switch --quiet main
remote_create_rc=0
remote_create_output=$(GH_PR_HEAD_OID="$remote_create_oid" \
  GH_PR_CASE=create-remote-after-merge \
  GH_STATE="$state_remote_create" GH_TEST_REPO="$repo_remote_create" \
  GH_LOG="$log_remote_create" PATH="$bin_dir:$PATH" \
  _pr_land "$repo_remote_create" 4 2>&1) || remote_create_rc=$?
_assert_eq "absent remote head: exits nonzero before merge" "1" "$remote_create_rc"
_assert_contains "absent remote head: reports exact-head failure" \
  "remote PR head does not exist" "$remote_create_output"
if git -C "$remote_remote_create" show-ref --verify --quiet \
  refs/heads/feature; then
  _fail "absent remote head: does not merge or create a branch"
else
  _pass "absent remote head: does not merge or create a branch"
fi

# Remote cleanup is based on authoritative remote state. An operational
# ls-remote failure must stop before the irreversible GitHub merge.
repo_remote_lookup_failure=$(_tmpdir)
remote_remote_lookup_failure=$(_tmpdir)
log_remote_lookup_failure=$(_tmpdir)/gh.log
remote_lookup_failure_bin=$(_tmpdir)
_init_repo "$repo_remote_lookup_failure" "$remote_remote_lookup_failure"
cat >"$remote_lookup_failure_bin/git" <<'EOF'
#!/usr/bin/env bash
if [[ "$*" == *"refs/heads/feature"* &&
  ("${1:-}" == ls-remote || "${5:-}" == ls-remote) ]]; then
  exit 88
fi
exec "$GIT_TEST_PROXY" "$@"
EOF
chmod +x "$remote_lookup_failure_bin/git"
remote_lookup_failure_rc=0
remote_lookup_failure_output=$(cd "$repo_remote_lookup_failure" &&
  GH_LOG="$log_remote_lookup_failure" \
    GIT_TEST_PROXY="$bin_dir/git" \
    PATH="$remote_lookup_failure_bin:$bin_dir:$ROOT/bin:/usr/bin:/bin" \
    "$ROOT/bin/git-pr-land" 4 2>&1) || remote_lookup_failure_rc=$?
_assert_eq "remote lookup failure: refuses before merge" \
  "1" "$remote_lookup_failure_rc"
_assert_contains "remote lookup failure: reports snapshot error" \
  "could not snapshot remote branch origin/feature" "$remote_lookup_failure_output"
if [[ -s "$log_remote_lookup_failure" ]]; then
  _fail "remote lookup failure: does not merge"
else
  _pass "remote lookup failure: does not merge"
fi

repo_status_failure=$(_tmpdir)
remote_status_failure=$(_tmpdir)
log_status_failure=$(_tmpdir)/gh.log
status_failure_bin=$(_tmpdir)
_init_repo "$repo_status_failure" "$remote_status_failure"
cat >"$status_failure_bin/git" <<'EOF'
#!/usr/bin/env bash
if [[ "${1:-}" == status && "${2:-}" == --porcelain ]]; then
  exit 88
fi
exec "$GIT_TEST_PROXY" "$@"
EOF
chmod +x "$status_failure_bin/git"
result=$(cd "$repo_status_failure" && GH_LOG="$log_status_failure" \
  GIT_TEST_PROXY="$bin_dir/git" \
  PATH="$status_failure_bin:$bin_dir:$ROOT/bin:/usr/bin:/bin" \
  "$ROOT/bin/git-pr-land" 4 2>&1)
rc=$?
_assert_eq "status failure: refuses before merge" "1" "$rc"
_assert_contains "status failure: reports inspection error" \
  "could not inspect worktree status" "$result"
if [[ -s "$log_status_failure" ]]; then
  _fail "status failure: does not merge"
else
  _pass "status failure: does not merge"
fi

repo_operation_failure=$(_tmpdir)
remote_operation_failure=$(_tmpdir)
main_operation_failure=$(_tmpdir)
log_operation_failure=$(_tmpdir)/gh.log
operation_failure_bin=$(_tmpdir)
_init_repo "$repo_operation_failure" "$remote_operation_failure"
git -C "$repo_operation_failure" worktree add --quiet "$main_operation_failure" main
_commit_file "$main_operation_failure" base-2.txt base-2 base-2
git -C "$main_operation_failure" push --quiet origin main
git -C "$main_operation_failure" rebase --exec false HEAD~1 >/dev/null 2>&1 || true
cat >"$operation_failure_bin/git" <<'EOF'
#!/usr/bin/env bash
for arg in "$@"; do
  [[ "$arg" != rebase-merge ]] || exit 88
done
if [[ "${1:-} ${2:-} ${3:-}" == "remote get-url --all" ]]; then
  /usr/bin/git config --get-all "remote.${4:-}.url"
  exit $?
fi
exec "$GIT_TEST_PROXY" "$@"
EOF
chmod +x "$operation_failure_bin/git"
result=$(cd "$repo_operation_failure" && GH_LOG="$log_operation_failure" \
  GIT_TEST_PROXY="$bin_dir/git" \
  PATH="$operation_failure_bin:$bin_dir:$ROOT/bin:/usr/bin:/bin" \
  "$ROOT/bin/git-pr-land" 4 2>&1)
rc=$?
_assert_eq "operation probe failure: refuses before merge" "1" "$rc"
_assert_contains "operation probe failure: reports inspection error" \
  "could not inspect current worktree operation" "$result"
if [[ -s "$log_operation_failure" ]]; then
  _fail "operation probe failure: does not merge"
else
  _pass "operation probe failure: does not merge"
fi

# Worktree inventory is a safety boundary for landing. Descriptor exhaustion,
# producer failure, and an unterminated NUL record must all fail without
# clobbering descriptors owned by the caller.
fd_open_rc=0
PATH=/usr/bin:/bin bash -c '
  . "'"$ROOT"'/lib/git-tools-base.sh"
  eval() { return 88; }
  (exit 0) &
  _gt_materialize_worktree_list
' >/dev/null 2>&1 || fd_open_rc=$?
_assert_eq "failed worktree descriptor open fails inventory" "1" "$fd_open_rc"

fd_preserve_rc=0
(cd "$repo" && PATH=/usr/bin:/bin ROOT="$ROOT" bash -c '
  . "$ROOT/lib/git-tools-base.sh"
  exec 9</dev/null
  count=0
  while ((count < 50)); do
    _gt_materialize_worktree_list || exit 91
    count=$((count + 1))
  done
  true <&9
') || fd_preserve_rc=$?
_assert_eq "repeated worktree inventories preserve caller descriptors" \
  "0" "$fd_preserve_rc"

nonwaitable_process_rc=0
(cd "$repo" && PATH=/usr/bin:/bin ROOT="$ROOT" bash -c '
  . "$ROOT/lib/git-tools-base.sh"
  wait() { return 127; }
  _gt_materialize_worktree_list || exit 91
  ((${#_GT_WORKTREE_FIELDS[@]} > 0)) || exit 92
') >/dev/null 2>&1 || nonwaitable_process_rc=$?
_assert_eq "worktree inventory does not require a waitable process substitution" \
  "0" "$nonwaitable_process_rc"

fd_exhaust_rc=0
(cd "$repo" && PATH=/usr/bin:/bin ROOT="$ROOT" bash -c '
  . "$ROOT/lib/git-tools-base.sh"
  for fd in 3 4 5 6 7 8 9; do eval "exec $fd</dev/null"; done
  ! _gt_materialize_worktree_list || exit 91
  for fd in 3 4 5 6 7 8 9; do eval "true <&$fd" || exit 92; done
') || fd_exhaust_rc=$?
_assert_eq "worktree inventory exhaustion preserves caller descriptors" \
  "0" "$fd_exhaust_rc"

inventory_bin=$(_tmpdir)
cat >"$inventory_bin/git" <<'EOF'
#!/usr/bin/env bash
case "${GT_INVENTORY_CASE:-}" in
  partial)
    printf 'worktree /partial\0'
    exit 88
    ;;
  spoofed-completion)
    printf '\036git-tools-worktree-list-complete\0'
    exit 88
    ;;
  leaked-completion)
    printf '%s\0' "${_gt_worktree_completion:-missing}"
    exit 88
    ;;
  unterminated)
    printf 'worktree /unterminated'
    exit 0
    ;;
esac
exec /usr/bin/git "$@"
EOF
chmod +x "$inventory_bin/git"
for inventory_case in partial spoofed-completion leaked-completion unterminated; do
  inventory_rc=0
  (cd "$repo" && GT_INVENTORY_CASE="$inventory_case" \
    PATH="$inventory_bin:/usr/bin:/bin" ROOT="$ROOT" bash -c '
      export _gt_worktree_completion=caller-value
      . "$ROOT/lib/git-tools-base.sh"
      _gt_materialize_worktree_list
    ') >/dev/null 2>&1 || inventory_rc=$?
  _assert_eq "$inventory_case worktree inventory fails closed" "1" "$inventory_rc"
done

failing_od_bin=$(_tmpdir)
cat >"$failing_od_bin/od" <<'EOF'
#!/usr/bin/env bash
printf '00 11 22 33 44 55 66 77 88 99 aa bb cc dd ee ff\n'
exit 88
EOF
chmod +x "$failing_od_bin/od"
failing_od_rc=0
(cd "$repo" && PATH="$failing_od_bin:/usr/bin:/bin" ROOT="$ROOT" bash -c '
  . "$ROOT/lib/git-tools-base.sh"
  _gt_materialize_worktree_list
') >/dev/null 2>&1 || failing_od_rc=$?
_assert_eq "failed nonce generation fails worktree inventory" "1" "$failing_od_rc"

result=$(GH_PR_CASE=pending GH_LOG="$log" PATH="$bin_dir:$PATH" _pr_land "$repo" 4 2>&1 || true)
_assert_contains "refuses pending checks" "checks are pending" "$result"

result=$(GH_PR_CASE=pending GH_LOG="$log" PATH="$bin_dir:$PATH" _pr_land "$repo" 4 --dry-run 2>&1 || true)
_assert_contains "dry run still refuses unready PRs" "checks are pending" "$result"

result=$(GH_PR_CASE=dirty GH_LOG="$log" PATH="$bin_dir:$PATH" _pr_land "$repo" 4 2>&1 || true)
_assert_contains "refuses dirty merge state" "merge state is DIRTY" "$result"

result=$(GH_LOG="$log" PATH="$bin_dir:$PATH" _pr_land "$repo" 4 --method bad 2>&1 || true)
_assert_contains "validates merge method" "merge method must be squash, merge, or rebase" "$result"

if ((_failures > 0)); then
  printf '%s failure(s)\n' "$_failures" >&2
  exit 1
fi

printf 'all tests passed\n'
