  _pass "fork PR is rebased onto the current base-repository OID"
else
  _fail "fork PR is rebased onto the current base-repository OID"
fi

# A validated remote name is still unsafe as a fetch primitive because its
# configured fetch refspec can redirect the ordinary tracking ref. Resolve the
# exact base URL and requested source ref instead, despite colliding short tags.
repo_fetch_refspec=$(_tmpdir)
remote_fetch_refspec=$(_tmpdir)
updater_fetch_refspec=$(_tmpdir)
log_fetch_refspec=$(_tmpdir)/gh.log
_init_stack_repo "$repo_fetch_refspec" "$remote_fetch_refspec"
git -C "$repo_fetch_refspec" push -q origin \
  refs/heads/main:refs/heads/decoy
git clone -q "$remote_fetch_refspec" "$updater_fetch_refspec"
git -C "$updater_fetch_refspec" config user.email test@test.com
git -C "$updater_fetch_refspec" config user.name Test
git -C "$updater_fetch_refspec" config core.hooksPath /dev/null
_commit_file "$updater_fetch_refspec" exact-base.txt exact "advance exact base"
git -C "$updater_fetch_refspec" push -q origin main
fetch_refspec_main=$(git -C "$remote_fetch_refspec" rev-parse refs/heads/main)
git -C "$repo_fetch_refspec" config --unset-all remote.origin.fetch
git -C "$repo_fetch_refspec" config --add remote.origin.fetch \
  '+refs/heads/decoy:refs/remotes/origin/main'
git -C "$repo_fetch_refspec" tag main refs/heads/child
git -C "$repo_fetch_refspec" tag origin/main refs/heads/child
git -C "$repo_fetch_refspec" tag upstream/main refs/heads/child
fetch_refspec_output=$(GH_LOG="$log_fetch_refspec" PATH="$bin_dir:$PATH" \
  _pr_restack "$repo_fetch_refspec" 2 --base main 2>&1)
_assert_contains "restack survives base refspec and tag collisions" \
  "restacked PR #2" "$fetch_refspec_output"
if git -C "$repo_fetch_refspec" merge-base --is-ancestor \
  "$fetch_refspec_main" refs/heads/child; then
  _pass "restack uses the exact remote main OID"
else
  _fail "restack uses the exact remote main OID"
fi

# A post-checkout hook can mutate the just-checked-out branch after the initial
# PR/remote validation. The injected commit is clean and a descendant of the
# expected head, so only exact post-checkout revalidation prevents its push.
repo_checkout_race=$(_tmpdir)
remote_checkout_race=$(_tmpdir)
hooks_checkout_race=$(_tmpdir)
log_checkout_race=$(_tmpdir)/gh.log
marker_checkout_race=$(_tmpdir)/injected
_init_stack_repo "$repo_checkout_race" "$remote_checkout_race"
checkout_expected=$(git -C "$repo_checkout_race" rev-parse refs/heads/child)
checkout_tree=$(git -C "$repo_checkout_race" rev-parse \
  "refs/heads/child^{tree}")
checkout_injected=$(printf '%s\n' injected-checkout |
  git -C "$repo_checkout_race" commit-tree "$checkout_tree" \
    -p "$checkout_expected")
cat >"$hooks_checkout_race/post-checkout" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[[ "${GIT_TEST_CHECKOUT_INJECT:-0}" == 1 ]] || exit 0
[[ ! -e "${GIT_TEST_CHECKOUT_MARKER:?}" ]] || exit 0
: >"$GIT_TEST_CHECKOUT_MARKER"
git reset --hard "${GIT_TEST_CHECKOUT_OID:?}" >/dev/null
EOF
chmod +x "$hooks_checkout_race/post-checkout"
git -C "$repo_checkout_race" config core.hooksPath "$hooks_checkout_race"
checkout_race_output=$(GIT_TEST_CHECKOUT_INJECT=1 \
  GIT_TEST_CHECKOUT_MARKER="$marker_checkout_race" \
  GIT_TEST_CHECKOUT_OID="$checkout_injected" GH_LOG="$log_checkout_race" \
  PATH="$bin_dir:$PATH" _pr_restack "$repo_checkout_race" 2 --base main \
  2>&1 || true)
_assert_contains "restack rejects a post-checkout local head race" \
  "local PR head changed during checkout" "$checkout_race_output"
_assert_eq "post-checkout injected commit is never force-pushed" \
  "$checkout_expected" \
  "$(git -C "$remote_checkout_race" rev-parse refs/heads/child)"

repo_concurrent=$(_tmpdir)
remote_concurrent=$(_tmpdir)
log_concurrent=$(_tmpdir)/gh.log
advance_marker=$(_tmpdir)/advanced
_init_stack_repo "$repo_concurrent" "$remote_concurrent"
old_concurrent=$(git -C "$repo_concurrent" rev-parse refs/heads/child)
tree_concurrent=$(git -C "$repo_concurrent" rev-parse "$old_concurrent^{tree}")
new_concurrent=$(printf '%s\n' concurrent-restack |
  git -C "$repo_concurrent" commit-tree "$tree_concurrent" -p "$old_concurrent")
concurrent_result=$(GIT_TEST_ADVANCE_BEFORE_PUSH=1 \
  GIT_TEST_ADVANCE_MARKER="$advance_marker" \
  GIT_TEST_ADVANCE_REPO="$repo_concurrent" \
  GIT_TEST_ADVANCE_REMOTE="$remote_concurrent" \
  GIT_TEST_ADVANCE_OID="$new_concurrent" \
  GH_LOG="$log_concurrent" PATH="$bin_dir:$PATH" \
  _pr_restack "$repo_concurrent" 2 --base main 2>&1 || true)
_assert_contains "concurrent restack push is rejected by the exact lease" \
  "stale info" "$concurrent_result"
_assert_eq "concurrent restack preserves the newer remote head" \
  "$new_concurrent" \
  "$(git -C "$remote_concurrent" rev-parse refs/heads/child)"
_assert_eq "failed leased push does not edit the PR base" "" \
  "$(cat "$log_concurrent" 2>/dev/null || true)"

repo_no_push=$(_tmpdir)
remote_no_push=$(_tmpdir)
log_no_push=$(_tmpdir)/gh.log
_init_stack_repo "$repo_no_push" "$remote_no_push"
result=$(GH_LOG="$log_no_push" PATH="$bin_dir:$PATH" _pr_restack "$repo_no_push" 2 --base main --no-push 2>&1)
_assert_contains "supports no-push mode" "push skipped" "$result"
_assert_contains "no-push skips remote PR edits" "PR base update skipped" "$result"
if [[ -f "$log_no_push" ]]; then
  _assert_eq "no-push does not edit PR base" "" "$(cat "$log_no_push")"
else
  _pass "no-push does not edit PR base"
fi

repo_dry=$(_tmpdir)
remote_dry=$(_tmpdir)
log_dry=$(_tmpdir)/gh.log
_init_stack_repo "$repo_dry" "$remote_dry"
result=$(GH_LOG="$log_dry" PATH="$bin_dir:$PATH" _pr_restack "$repo_dry" 2 --base main --dry-run 2>&1)
_assert_contains "dry run prints exact fetch" \
  "would fetch refs/heads/main from origin" "$result"
_assert_eq "dry run does not switch branches" "main" "$(git -C "$repo_dry" branch --show-current)"

repo_dirty=$(_tmpdir)
remote_dirty=$(_tmpdir)
log_dirty=$(_tmpdir)/gh.log
_init_stack_repo "$repo_dirty" "$remote_dirty"
printf 'dirty\n' >"$repo_dirty/dirty.txt"
result=$(GH_LOG="$log_dirty" PATH="$bin_dir:$PATH" _pr_restack "$repo_dirty" 2 --base main 2>&1 || true)
_assert_contains "refuses dirty worktrees" "worktree must be clean" "$result"

result=$(GH_PR_CASE=draft GH_LOG="$log" PATH="$bin_dir:$PATH" _pr_restack "$repo" 2 --base main 2>&1 || true)
_assert_contains "refuses draft PRs" "PR #2 is a draft" "$result"

repo_fork=$(_tmpdir)
remote_fork=$(_tmpdir)
log_fork=$(_tmpdir)/gh.log
_init_squash_repo "$repo_fork" "$remote_fork"
result=$(GH_LOG="$log_fork" PATH="$bin_dir:$PATH" _pr_restack "$repo_fork" 2 --base main --fork parent 2>&1)
_assert_contains "fork rebases with --onto from the old base" "dropping commits up to origin/parent" "$result"
_assert_eq "fork drops the squash-merged parent commit" "squashed" "$(git -C "$repo_fork" show child:parent.txt)"
_assert_eq "fork keeps the child's own change" "child" "$(git -C "$repo_fork" show child:child.txt)"
if git -C "$repo_fork" merge-base --is-ancestor origin/main child; then
  _pass "fork rebases the child onto the squashed base"
else
  _fail "fork rebases the child onto the squashed base"
fi

repo_same_name_fork=$(_tmpdir)
remote_same_name_base=$(_tmpdir)
remote_same_name_head=$(_tmpdir)
log_same_name_fork=$(_tmpdir)/gh.log
_init_squash_repo "$repo_same_name_fork" "$remote_same_name_base"
git init -q --bare --initial-branch=main "$remote_same_name_head"
git -C "$repo_same_name_fork" config \
  "url.$remote_same_name_head.insteadOf" \
  https://github.test/forker/repo.git
git -C "$repo_same_name_fork" remote add fork \
  https://github.test/forker/repo.git
git -C "$repo_same_name_fork" push --quiet fork child parent
git -C "$repo_same_name_fork" push --quiet \
  fork main:refs/heads/tmp-main
git -C "$remote_same_name_head" update-ref refs/heads/parent \
  "$(git -C "$repo_same_name_fork" rev-parse main)"
git -C "$remote_same_name_head" update-ref -d refs/heads/tmp-main
git -C "$repo_same_name_fork" config branch.child.remote fork
same_name_result=$(GH_PR_CASE=fork GH_LOG="$log_same_name_fork" \
  PATH="$bin_dir:$PATH" _pr_restack "$repo_same_name_fork" 2 \
  --base main --fork parent 2>&1)
_assert_contains "fork boundary comes from the base repository" \
  "dropping commits up to" "$same_name_result"
_assert_eq "same-named fork ref cannot reintroduce the parent change" \
  "squashed" "$(git -C "$repo_same_name_fork" show child:parent.txt)"
_assert_eq "base-repository fork boundary preserves the child change" \
  "child" "$(git -C "$repo_same_name_fork" show child:child.txt)"

repo_badfork=$(_tmpdir)
remote_badfork=$(_tmpdir)
log_badfork=$(_tmpdir)/gh.log
_init_squash_repo "$repo_badfork" "$remote_badfork"
result=$(GH_LOG="$log_badfork" PATH="$bin_dir:$PATH" _pr_restack "$repo_badfork" 2 --base main --fork nope 2>&1 || true)
_assert_contains "rejects an unknown fork ref" \
  "fork is not a branch on base repository remote origin: nope" "$result"

# Branch namespaces remain branches even when their names look like object IDs;
# internal object handoffs require an explicit oid: prefix.
repo_hex_base=$(_tmpdir)
remote_hex_base=$(_tmpdir)
log_hex_base=$(_tmpdir)/gh.log
_init_stack_repo "$repo_hex_base" "$remote_hex_base"
hex_base=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
git -C "$repo_hex_base" branch "$hex_base" main
git -C "$repo_hex_base" push -q origin "$hex_base"
hex_output=$(GH_LOG="$log_hex_base" PATH="$bin_dir:$PATH" \
  _pr_restack "$repo_hex_base" 2 --base "$hex_base" --no-push 2>&1)
_assert_contains "hex-looking base resolves as an exact remote branch" \
  "onto origin/$hex_base" "$hex_output"

repo_raw_oid=$(_tmpdir)
remote_raw_oid=$(_tmpdir)
log_raw_oid=$(_tmpdir)/gh.log
_init_stack_repo "$repo_raw_oid" "$remote_raw_oid"
raw_fork_oid=$(git -C "$repo_raw_oid" rev-parse parent)
raw_oid_output=$(GH_LOG="$log_raw_oid" PATH="$bin_dir:$PATH" \
  _pr_restack "$repo_raw_oid" 2 --base main --fork "$raw_fork_oid" \
  --no-push 2>&1 || true)
_assert_contains "raw fork OID requires an explicit namespace" \
  "fork is not a branch on base repository remote origin" "$raw_oid_output"

base_oid_output=$(GH_LOG="$log_raw_oid" PATH="$bin_dir:$PATH" \
  _pr_restack "$repo_raw_oid" 2 --base main --base-oid "$raw_fork_oid" \
  2>&1 || true)
_assert_contains "internal base OID cannot be pushed" \
  "--base-oid requires --no-push" "$base_oid_output"

if ((_failures > 0)); then
  printf '%s failure(s)\n' "$_failures" >&2
  exit 1
fi

printf 'all tests passed\n'
