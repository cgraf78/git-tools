#!/usr/bin/env bash

set -uo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PATH="$ROOT/bin:$PATH"
export NO_COLOR=1

_failures=0
# shellcheck source=test/lib/test-temp.sh
. "$ROOT/test/lib/test-temp.sh"
gt_test_temp_init || exit 1
_tmpdir() { gt_test_temp_dir; }

_pass() {
  printf 'ok - %s\n' "$1"
}

_fail() {
  printf 'not ok - %s\n' "$1" >&2
  _failures=$((_failures + 1))
}

_assert_eq() {
  local name="$1"
  local expected="$2"
  local actual="$3"

  if [[ "$actual" == "$expected" ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected: %q\n' "$expected" >&2
    printf '  actual:   %q\n' "$actual" >&2
  fi
}

_assert_contains() {
  local name="$1"
  local needle="$2"
  local haystack="$3"

  if [[ "$haystack" == *"$needle"* ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected output to contain: %s\n' "$needle" >&2
    printf '  actual output:\n%s\n' "$haystack" >&2
  fi
}

_commit_file() {
  local repo="$1"
  local path="$2"
  local content="$3"
  local message="$4"

  mkdir -p "$(dirname "$repo/$path")"
  printf '%s\n' "$content" >"$repo/$path"
  git -C "$repo" add "$path"
  git -C "$repo" commit -m "$message" >/dev/null
}

_pr_restack() {
  local repo="$1"
  shift
  (cd "$repo" && GH_TEST_REPO="$repo" "$ROOT/bin/git-pr-restack" "$@")
}

_init_stack_repo() {
  local repo="$1"
  local remote="$2"

  git init --bare --initial-branch=main "$remote" >/dev/null
  git init -q --initial-branch=main "$repo"
  git -C "$repo" config user.email "test@test.com"
  git -C "$repo" config user.name "Test"
  git -C "$repo" config core.hooksPath /dev/null
  _commit_file "$repo" README.md base base
  git -C "$repo" config "url.$remote.insteadOf" \
    https://github.test/example/repo.git
  git -C "$repo" remote add origin https://github.test/example/repo.git
  git -C "$repo" push -u origin main >/dev/null 2>&1

  git -C "$repo" switch --quiet -c parent
  _commit_file "$repo" parent.txt parent parent
  git -C "$repo" push -u origin parent >/dev/null 2>&1

  git -C "$repo" switch --quiet -c child
  _commit_file "$repo" child.txt child child
  git -C "$repo" push -u origin child >/dev/null 2>&1

  git -C "$repo" switch --quiet main
  git -C "$repo" merge --ff-only parent >/dev/null
  git -C "$repo" push origin main >/dev/null 2>&1
}

# Build a stack where the parent has been squash-merged: main carries a new
# commit touching parent.txt with different content than the parent branch's
# own commit, so a plain rebase of the child would re-apply (and conflict on)
# the parent commit.
_init_squash_repo() {
  local repo="$1"
  local remote="$2"

  git init --bare --initial-branch=main "$remote" >/dev/null
  git init -q --initial-branch=main "$repo"
  git -C "$repo" config user.email "test@test.com"
  git -C "$repo" config user.name "Test"
  git -C "$repo" config core.hooksPath /dev/null
  _commit_file "$repo" README.md base base
  git -C "$repo" config "url.$remote.insteadOf" \
    https://github.test/example/repo.git
  git -C "$repo" remote add origin https://github.test/example/repo.git
  git -C "$repo" push -u origin main >/dev/null 2>&1

  git -C "$repo" switch --quiet -c parent
  _commit_file "$repo" parent.txt v1 parent
  git -C "$repo" push -u origin parent >/dev/null 2>&1

  git -C "$repo" switch --quiet -c child
  _commit_file "$repo" child.txt child child
  git -C "$repo" push -u origin child >/dev/null 2>&1

  git -C "$repo" switch --quiet main
  _commit_file "$repo" parent.txt squashed "squash parent"
  git -C "$repo" push origin main >/dev/null 2>&1
}

_write_gh_stub() {
  local dir="$1"
  local bin="$dir/gh"
  cat >"$bin" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

log="${GH_LOG:?}"
edit_state="$log.edited"

_head_oid() {
  local remote oid
  if [[ -n "${GH_PR_HEAD_OID:-}" ]]; then
    printf '%s\n' "$GH_PR_HEAD_OID"
    return 0
  fi
  remote=$(git config branch.child.remote 2>/dev/null || printf origin)
  oid=$(git ls-remote --refs "$remote" refs/heads/child 2>/dev/null |
    awk 'NR == 1 { print $1 }')
  [[ -n "$oid" ]] || oid=$(git rev-parse refs/heads/child)
  printf '%s\n' "$oid"
}

if [[ "$1 $2" == "auth status" ]]; then
  exit 0
fi

if [[ "$1 $2" == "repo view" ]]; then
  if [[ "${GH_REPO:-}" == github.test/foreign/repo ]]; then
    printf 'foreign/repo\thttps://github.test/foreign/repo\n'
  else
    printf 'example/repo\thttps://github.test/example/repo\n'
  fi
  exit 0
fi

if [[ "$1 $2" == "pr view" ]]; then
  head_oid=$(_head_oid)
  if [[ "${3:-}" == https://github.test/foreign/repo/pull/2 ||
    "${GH_REPO:-}" == github.test/foreign/repo ]]; then
    printf '2\tOPEN\tfalse\tCLEAN\tforeign-child\t%s\tmain\tforeign/repo\tfalse\thttps://github.test/foreign/repo/pull/2\tForeign PR\n' "$head_oid"
    exit 0
  fi
  case "${GH_PR_CASE:-open}" in
    open)
      base=parent
      [[ ! -f "$edit_state" ]] || base=main
      printf '2\tOPEN\tfalse\tCLEAN\tchild\t%s\t%s\texample/repo\tfalse\thttps://github.test/example/repo/pull/2\tChild PR\n' "$head_oid" "$base"
      ;;
    draft)
      printf '2\tOPEN\ttrue\tCLEAN\tchild\t%s\tparent\texample/repo\tfalse\thttps://github.test/example/repo/pull/2\tChild PR\n' "$head_oid"
      ;;
    fork)
      printf '2\tOPEN\tfalse\tCLEAN\tchild\t%s\tparent\tforker/repo\ttrue\thttps://github.test/example/repo/pull/2\tFork PR\n' "$head_oid"
      ;;
    explicit-target-rebound)
      printf '3\tOPEN\tfalse\tCLEAN\tchild\t%s\tparent\texample/repo\tfalse\thttps://github.test/example/repo/pull/3\tRebound PR\n' "$head_oid"
      ;;
    branch-target-rebound)
      printf '2\tOPEN\tfalse\tCLEAN\tchild\t%s\tparent\texample/repo\tfalse\thttps://github.test/example/repo/pull/2\tWrong branch PR\n' "$head_oid"
      ;;
    post-action-rebound)
      if [[ -f "$edit_state" ]]; then
        printf '3\tOPEN\tfalse\tCLEAN\tchild\t%s\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/3\tRebound PR\n' "$head_oid"
      else
        printf '2\tOPEN\tfalse\tCLEAN\tchild\t%s\tparent\texample/repo\tfalse\thttps://github.test/example/repo/pull/2\tChild PR\n' "$head_oid"
      fi
      ;;
    wrong-same-repo-head)
      printf '2\tOPEN\tfalse\tCLEAN\tchild\t%s\tparent\tforeign/repo\tfalse\thttps://github.test/example/repo/pull/2\tWrong head repository\n' "$head_oid"
      ;;
    malformed-draft)
      printf '2\tOPEN\tmaybe\tCLEAN\tchild\t%s\tparent\texample/repo\tfalse\thttps://github.test/example/repo/pull/2\tMalformed draft\n' "$head_oid"
      ;;
  esac
  exit 0
fi

if [[ "$1 $2" == "pr edit" ]]; then
  printf '%s\n' "$*" >>"$log"
  : >"$edit_state"
  exit 0
fi

printf 'unexpected gh call: %s\n' "$*" >&2
exit 99
EOF
  chmod +x "$bin"
  cat >"$dir/git" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-} ${2:-} ${3:-} ${4:-}" == "remote get-url --push --all" &&
  "${GIT_TEST_REAL_EFFECTIVE_PUSH_URL:-0}" != 1 ]]; then
  remote=${5:-}
  url=$(/usr/bin/git config --get-all "remote.$remote.pushurl" 2>/dev/null || true)
  [[ -n "$url" ]] || url=$(/usr/bin/git config --get-all "remote.$remote.url")
  printf '%s\n' "$url"
  exit 0
fi
if [[ "${1:-} ${2:-} ${3:-}" == "remote get-url --all" ]]; then
  /usr/bin/git config --get-all "remote.${4:-}.url"
  exit $?
fi
if [[ "${GIT_TEST_LS_REMOTE_FAIL:-0}" == 1 && "$*" == *" ls-remote "* ]]; then
  printf 'partial remote output\n'
  exit 88
fi
if [[ "${1:-}" == -c && "${2:-}" == url.*.insteadOf=* &&
  "${3:-}" == -c && "${4:-}" == url.*.pushInsteadOf=* ]]; then
  pin=${2#url.}
  target=${pin%%.insteadOf=*}
  alias=${pin#*.insteadOf=}
  shift 4
  rewritten=()
  for argument in "$@"; do
    [[ "$argument" != "$alias" ]] || argument=$target
    rewritten+=("$argument")
  done
  set -- "${rewritten[@]}"
fi
if [[ "${GIT_TEST_ADVANCE_BEFORE_PUSH:-0}" == 1 && "${1:-}" == push &&
  ! -e "${GIT_TEST_ADVANCE_MARKER:?}" ]]; then
  : >"$GIT_TEST_ADVANCE_MARKER"
  /usr/bin/git -C "${GIT_TEST_ADVANCE_REPO:?}" push --quiet \
    "${GIT_TEST_ADVANCE_REMOTE:?}" \
    "${GIT_TEST_ADVANCE_OID:?}:refs/heads/child"
fi
exec /usr/bin/git "$@"
EOF
  chmod +x "$dir/git"
}

echo "=== git pr-restack ==="

repo=$(_tmpdir)
remote=$(_tmpdir)
bin_dir=$(_tmpdir)
log=$(_tmpdir)/gh.log
_init_stack_repo "$repo" "$remote"
_write_gh_stub "$bin_dir"

