  PATH="$bin_dir:$PATH" _pr_restack "$repo_stale_pr_oid" 2 --base main \
  2>&1 || true)
_assert_contains "restack requires GitHub to observe the pushed head OID" \
  "PR #2 head OID did not update after push" "$stale_pr_result"
_assert_eq "unobserved pushed head OID prevents PR edit" "" \
  "$(cat "$log_stale_pr_oid" 2>/dev/null || true)"

repo_ambient=$(_tmpdir)
remote_ambient=$(_tmpdir)
log_ambient=$(_tmpdir)/gh.log
_init_stack_repo "$repo_ambient" "$remote_ambient"
result=$(GH_REPO=github.test/foreign/repo GH_HOST=foreign.test \
  GH_LOG="$log_ambient" PATH="$bin_dir:$PATH" \
  _pr_restack "$repo_ambient" 2 --base main 2>&1)
_assert_contains "ambient routing cannot redirect numeric restack" \
  "restacked PR #2" "$result"
_assert_eq "ambient routing still updates the current PR" \
  "pr edit 2 --base main --repo github.test/example/repo" "$(cat "$log_ambient")"

repo_foreign=$(_tmpdir)
remote_foreign=$(_tmpdir)
log_foreign=$(_tmpdir)/gh.log
_init_stack_repo "$repo_foreign" "$remote_foreign"
foreign_result=$(GH_LOG="$log_foreign" PATH="$bin_dir:$PATH" \
  _pr_restack "$repo_foreign" \
  https://github.test/foreign/repo/pull/2 --base main 2>&1 || true)
_assert_contains "restack rejects a foreign same-number URL" \
  "target pull request belongs to a different repository" "$foreign_result"
_assert_eq "foreign restack performs no GitHub mutation" "" \
  "$(cat "$log_foreign" 2>/dev/null || true)"

_assert_restack_rejected_before_push() {
  local case_name="$1"
  local target="$2"
  local case_repo case_remote case_log case_before case_after case_rc=0

  case_repo=$(_tmpdir)
  case_remote=$(_tmpdir)
  case_log=$(_tmpdir)/gh.log
  _init_stack_repo "$case_repo" "$case_remote"
  case_before=$(git -C "$case_remote" rev-parse refs/heads/child)
  GH_PR_CASE="$case_name" GH_LOG="$case_log" PATH="$bin_dir:$PATH" \
    _pr_restack "$case_repo" "$target" --base main >/dev/null 2>&1 || case_rc=$?
  case_after=$(git -C "$case_remote" rev-parse refs/heads/child)
  if [[ "$case_rc" != 0 && "$case_before" == "$case_after" && ! -e "$case_log" ]]; then
    _pass "restack rejects malformed PR before push: $case_name"
  else
    _fail "restack rejects malformed PR before push: $case_name"
  fi
}

_assert_restack_rejected_before_push explicit-target-rebound 2
_assert_restack_rejected_before_push explicit-target-rebound \
  https://github.test/example/repo/pull/2
_assert_restack_rejected_before_push branch-target-rebound expected/child
_assert_restack_rejected_before_push branch-target-rebound example:child
_assert_restack_rejected_before_push wrong-same-repo-head 2
