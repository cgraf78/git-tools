remote_expected=$(_tmpdir)
log_expected=$(_tmpdir)/gh.log
_init_stack_repo "$repo_expected" "$remote_expected"
expected_before=$(git -C "$remote_expected" rev-parse refs/heads/child)
expected_rc=0
GH_LOG="$log_expected" PATH="$bin_dir:$PATH" \
