_init_stack_repo "$repo_multi" "$remote_multi_a"
_commit_file "$repo_multi" later.txt later "advance main"
git -C "$repo_multi" push --quiet origin main
git init -q --bare --initial-branch=main "$remote_multi_b"
git -C "$repo_multi" push --quiet "$remote_multi_b" main child
multi_a_before=$(git -C "$remote_multi_a" rev-parse refs/heads/child)
multi_b_before=$(git -C "$remote_multi_b" rev-parse refs/heads/child)
git -C "$repo_multi" config --add remote.origin.pushurl \
  https://github.test/example/repo.git
git -C "$repo_multi" config --add remote.origin.pushurl \
  ssh://git@github.test/example/repo.git
