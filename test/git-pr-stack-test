      limit=0
      previous=""
      for argument in "$@"; do
        if [[ "$previous" == --limit ]]; then
          limit=$argument
          break
        fi
        previous=$argument
      done
      count=$limit
      ((count <= 201)) || count=201
      index=1
      while ((index <= count)); do
        if ((index == 201)); then
          printf '201\tOPEN\tfalse\tCLEAN\tfeature/201\t1111111111111111111111111111111111111111\tfeature/1\texample/repo\tfalse\thttps://github.test/example/repo/pull/201\tHidden child\n'
