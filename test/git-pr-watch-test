# Print "<pid> <ppid>" for every process. Minimal Linux container images ship
# without ps, so read /proc there.
_process_table() {
  local stat line rest ppid

  if command -v ps >/dev/null 2>&1; then
    ps -A -o pid= -o ppid= 2>/dev/null || ps -o pid,ppid 2>/dev/null
    return
  fi
  for stat in /proc/[0-9]*/stat; do
    { read -r line <"$stat"; } 2>/dev/null || continue
    # The command name in parentheses can hold spaces; fields follow its
    # last ") ".
    rest=${line##*) }
    read -r _ ppid _ <<<"$rest"
    printf '%s %s\n' "${stat//[!0-9]/}" "$ppid"
  done
}

# Print every descendant of a process, from one process-table snapshot.
_descendants() {
  local table

  table=$(_process_table) || return 0
  printf '%s\n' "$table" | awk -v root="$1" '
    $1 ~ /^[0-9]+$/ { parent[$1] = $2; pids[n++] = $1 }
    END {
      found[root] = 1
      do {
        added = 0
        for (i = 0; i < n; i++)
          if (!(pids[i] in found) && (parent[pids[i]] in found)) {
            found[pids[i]] = 1; added = 1; print pids[i]
          }
      } while (added)
    }'
}

# @brief Start the watcher on a hung call, signal it, and check its status and
# that nothing it started is left running. Runs the script itself, not through
# `git`, so the status asserted is the script's own.
_signal_case() {
  local signal="$1" expected="$2" when="$3" watcher deadline children pid left=""

  _scenario
  if [[ "$when" == call ]]; then
    touch "$FAKE_GH_DIR/call-1.hang"
    printf '200\n' >"$FAKE_GH_DIR/call-1.status"
  else
    _serve 1 "$(_response "$(_running_pr 12)")"
  fi
  (cd "$repo" && PATH="$bin_dir:$PATH" exec bash "$ROOT/bin/git-pr-watch" --wait \
    --interval 15 12 >"$FAKE_GH_DIR/out" 2>"$FAKE_GH_DIR/err") &
  watcher=$!
  deadline=$((SECONDS + 20))
  if [[ "$when" == call ]]; then
    while [[ ! -s "$FAKE_GH_DIR/hang.pid" ]] && ((SECONDS < deadline)); do sleep 0.1; done
  else
    while ! grep -q 'checks-running' "$FAKE_GH_DIR/err" 2>/dev/null && ((SECONDS < deadline)); do
      sleep 0.1
    done
  fi
  # Wait until the watcher has started its child (the hung call, or the
  # sleep between checks) so the leftover check has something to check.
  children=$(_descendants "$watcher")
  while [[ -z "$children" ]] && ((SECONDS < deadline)); do
    sleep 0.1
    children=$(_descendants "$watcher")
  done
  if [[ -n "$children" ]]; then
    _pass "$signal during the $when: the watcher's processes were found"
  else
    _fail "$signal during the $when: the watcher's processes were found"
  fi
  kill "-$signal" "$watcher" 2>/dev/null
  wait "$watcher"
  _assert_eq "$signal during the $when exits $expected" "$expected" "$?"
  _assert_contains "$signal during the $when reports the signal" \
    "result: $expected reason=signal prs=12" "$(cat "$FAKE_GH_DIR/out")"
  deadline=$((SECONDS + 10))
  for pid in $children; do
    while kill -0 "$pid" 2>/dev/null && ((SECONDS < deadline)); do sleep 0.1; done
    if kill -0 "$pid" 2>/dev/null; then
      left="$left $pid"
      kill "$pid" 2>/dev/null
    fi
  done
  _assert_eq "$signal during the $when leaves nothing running" "" "$left"
}

