_assert_eq "after the grace GitHub's head is judged" 0 "$status"

# A local branch with push configuration resolves its tracking ref through
# %(push) even when no unique fetch remote exists (two remotes name the repo).
git -C "$race" remote add mirror https://github.test/example/repo.git
git -C "$race" branch -q feature/12 HEAD
git -C "$race" config branch.feature/12.pushRemote mirror
