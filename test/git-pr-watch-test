  _state=$XDG_STATE_HOME/git-tools/pr-watch
  _state_t0=$(date +%s)
}

# Print a done record's commit and word, checking that its epoch is when this
# case ran.
_done_record() {
  local commit word epoch now

  { read -r commit word epoch <"$1"; } 2>/dev/null || return 0
  now=$(date +%s)
  if [[ "$epoch" =~ ^[0-9]+$ ]] && ((epoch >= _state_t0 && epoch <= now)); then
    printf '%s %s\n' "$commit" "$word"
  else
    printf 'epoch %s outside %s..%s\n' "$epoch" "$_state_t0" "$now"
  fi
}

# List a state directory's entries, one per line, sorted.
_state_ls() {
  local file

  for file in "$_state/$1"/* "$_state/$1"/.[!.]*; do
    [[ ! -e "$file" ]] || printf '%s\n' "${file##*/}"
  done | LC_ALL=C sort
}

# A pid no process has: a finished child's.
_dead_pid() {
  sh -c 'exit 0' &
  local pid=$!
  wait "$pid"
  printf '%s\n' "$pid"
}

