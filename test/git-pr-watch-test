# The push just updated the remote-tracking ref but GitHub still reports the
# previous head: wait for GitHub to catch up instead of judging the old head.
# The tracking ref is set directly, as a push would, under a remote that names
# the fixture repository.
race=$(_tmpdir)
_git_init "$race"
git -C "$race" remote add origin https://github.test/example/repo.git
git -C "$race" commit -q --allow-empty -m change
git -C "$race" update-ref -m "update by push" refs/remotes/origin/feature/12 HEAD

# Pin the test clock to just after the push so the grace check cannot race
# the wall clock.
_pushed_at=$(git -C "$race" reflog -1 --date=unix --format=%gd refs/remotes/origin/feature/12)
_pushed_at=${_pushed_at##*@\{}
_pushed_at=${_pushed_at%\}}
_scenario
_clock=$(_tmpdir)/clock
printf '%s\n' $((_pushed_at + 1)) >"$_clock"
_serve 1 "$(_response "$(_green_pr 12)")"
out=$(GIT_TOOLS_TEST_PR_WATCH_CLOCK="$_clock" PATH="$bin_dir:$PATH" git -C "$race" pr-watch 12 2>/dev/null)
status=$?
_assert_eq "fresh push GitHub has not seen yet is pending" 8 "$status"
_assert_contains "push-grace record" "pr=12 state=pending reason=push-grace" "$out"

_scenario
_clock=$(_tmpdir)/clock
printf '%s\n' $((_pushed_at + 120)) >"$_clock"
