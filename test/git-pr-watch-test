#!/usr/bin/env bash

set -uo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PATH="$ROOT/bin:$PATH"
export NO_COLOR=1

_failures=0
# shellcheck source=test/lib/test-temp.sh
. "$ROOT/test/lib/test-temp.sh"
gt_test_temp_init || exit 1
# shellcheck source=test/lib/hermetic-git.sh
. "$ROOT/test/lib/hermetic-git.sh"
gt_test_git_isolate "$GT_TEST_TEMP_ROOT" || exit 1
_tmpdir() { gt_test_temp_dir; }

echo "=== git pr-watch ==="

# The fake gh runs the command's real jq program, so the suite needs jq.
if ! command -v jq >/dev/null 2>&1; then
  echo "ok - skipped: jq is not installed"
  exit 0
fi

_pass() {
  printf 'ok - %s\n' "$1"
}

_fail() {
  printf 'not ok - %s\n' "$1" >&2
  _failures=$((_failures + 1))
}

_assert_eq() {
  local name="$1" expected="$2" actual="$3"

  if [[ "$actual" == "$expected" ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected: %s\n  actual:   %s\n' "$expected" "$actual" >&2
  fi
}

_assert_contains() {
  local name="$1" needle="$2" haystack="$3"

  if [[ "$haystack" == *"$needle"* ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected output to contain: %s\n  actual output:\n%s\n' \
      "$needle" "$haystack" >&2
  fi
}

_assert_not_contains() {
  local name="$1" needle="$2" haystack="$3"

  if [[ "$haystack" != *"$needle"* ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected output not to contain: %s\n  actual output:\n%s\n' \
      "$needle" "$haystack" >&2
  fi
}

# Every fake response carries this Date header; completion times below are
# relative to it so the failure-confirmation window is deterministic.
#   Thu, 15 Oct 2026 14:14:10 GMT = 1792073650
RECENT=2026-10-15T14:13:10Z # 60s before the server clock: inside the window
OLD=2026-10-15T14:04:10Z    # 600s before: past the window
HEAD=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
OTHER=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

_write_gh_stub() {
  local bin="$1/gh"

  cat >"$bin" <<'EOF'
#!/usr/bin/env bash
set -uo pipefail

dir=${FAKE_GH_DIR:?}
printf '%s\n' "$*" >>"$dir/log"
printf '%s CLICOLOR_FORCE=%s GH_FORCE_TTY=%s GH_DEBUG=%s NO_COLOR=%s\n' "$1" \
  "${CLICOLOR_FORCE-unset}" "${GH_FORCE_TTY-unset}" "${GH_DEBUG-unset}" \
  "${NO_COLOR-unset}" >>"$dir/env-all"

case "$1 ${2:-}" in
  "auth status")
    [[ ! -f "$dir/auth-fail" ]] || exit 1
    exit 0
    ;;
  "repo view")
    printf 'example/repo\thttps://github.test/example/repo\n'
    exit 0
    ;;
  "api graphql")
    # A real gh without credentials makes no request and exits 4.
    if [[ -f "$dir/auth-fail" ]]; then
      printf 'To get started with GitHub CLI, please run:  gh auth login\n' >&2
      exit 4
    fi
    ;;
  *)
    printf 'unexpected gh call: %s\n' "$*" >&2
    exit 99
    ;;
esac

printf 'CLICOLOR_FORCE=%s GH_FORCE_TTY=%s GH_DEBUG=%s NO_COLOR=%s GH_HOST=%s GH_REPO=%s\n' \
  "${CLICOLOR_FORCE-unset}" "${GH_FORCE_TTY-unset}" "${GH_DEBUG-unset}" \
  "${NO_COLOR-unset}" "${GH_HOST-unset}" "${GH_REPO-unset}" >>"$dir/env"

jq_program=""
query=""
include=0
prev=""
for arg in "$@"; do
  case "$prev" in
    --jq) jq_program=$arg ;;
    -f) [[ "$arg" != query=* ]] || query=${arg#query=} ;;
  esac
  [[ "$arg" != -i ]] || include=1
  prev=$arg
done

# Branch lookups have their own fixtures so snapshot calls number from 1:
# branch-<m> for the m-th lookup when present, else branch.
if [[ "$query" == *PrWatchBranch* ]]; then
  m=$(($(cat "$dir/bn" 2>/dev/null || printf 0) + 1))
  printf '%s\n' "$m" >"$dir/bn"
  base="$dir/branch"
  [[ ! -e "$dir/branch-$m.json" && ! -e "$dir/branch-$m.status" ]] || base="$dir/branch-$m"
else
  n=$(($(cat "$dir/n" 2>/dev/null || printf 0) + 1))
  printf '%s\n' "$n" >"$dir/n"
  base="$dir/call-$n"
  # Reuse the last fixture once a scenario runs out of numbered ones.
  if [[ -e "$base.json" || -e "$base.status" ]]; then
    printf '%s\n' "$base" >"$dir/last"
  else
    base=$(cat "$dir/last")
  fi
fi

# A hanging call: record this process for the leftover-process check, then
# stay silent until killed.
if [[ -f "$base.hang" ]]; then
  printf '%s\n' "$$" >"$dir/hang.pid"
  exec sleep 30
fi
status=200
[[ ! -f "$base.status" ]] || status=$(cat "$base.status")
if [[ "$include" == 1 ]]; then
  printf 'HTTP/2.0 %s X\n' "$status"
  printf 'Access-Control-Expose-Headers: ETag, Retry-After, X-RateLimit-Remaining, X-RateLimit-Reset, X-GitHub-SSO\r\n'
  if [[ -f "$base.date" ]]; then
    printf 'Date: %s\r\n' "$(cat "$base.date")"
  elif [[ ! -f "$base.nodate" ]]; then
    printf 'Date: Thu, 15 Oct 2026 14:14:10 GMT\r\n'
  fi
  if [[ -f "$base.headers" ]]; then
    while IFS= read -r header; do
      printf '%s\r\n' "$header"
    done <"$base.headers"
  fi
  printf '\r\n'
fi
# gh prints only headers, then an error, when the body is empty or not JSON.
if [[ ! -f "$base.json" ]]; then
  printf 'unexpected end of JSON input\n' >&2
  exit 1
fi
# gh skips --jq and prints the raw body for errors and non-2xx statuses.
if [[ "$status" != 200 ]] || jq -e 'has("errors")' "$base.json" >/dev/null 2>&1; then
  cat "$base.json"
  exit 1
fi
jq -r "$jq_program" "$base.json"
EOF
  chmod +x "$bin"
}

_git_init() {
  local repo="$1"

  git init -q --initial-branch=main "$repo"
  git -C "$repo" config user.email "test@test.com"
  git -C "$repo" config user.name "Test"
  git -C "$repo" config core.hooksPath /dev/null
  printf 'base\n' >"$repo/README.md"
  git -C "$repo" add README.md
  git -C "$repo" commit -q -m base
}

# --- fixture builders -------------------------------------------------------

# A CheckRun context. Args: name status conclusion suite-id suite-status id
# [completedAt] [required] [event] [workflow-path] [suite-conclusion].
_run() {
  jq -cn --arg name "$1" --arg status "$2" --arg conclusion "$3" \
    --argjson suite "$4" --arg suite_status "$5" --argjson id "$6" \
    --arg completed "${7:-}" --arg req "${8:-true}" --arg event "${9:-pull_request}" \
    --arg path "${10:-.github/workflows/test.yml}" --arg suite_conclusion "${11:-}" '
    {__typename: "CheckRun", databaseId: $id, name: $name, status: $status,
     conclusion: (if $conclusion == "" then null else $conclusion end),
     completedAt: (if $completed == "" then null else $completed end),
     isRequired: ($req == "true"),
     checkSuite: {databaseId: $suite, status: $suite_status,
       conclusion: (if $suite_conclusion == "" then null else $suite_conclusion end),
       app: {databaseId: 15368, slug: "github-actions"},
       workflowRun: {event: $event, file: {path: $path}, workflow: {databaseId: 7}}}}'
}

# A StatusContext. Args: context state createdAt.
_status_context() {
  jq -cn --arg context "$1" --arg state "$2" --arg created "$3" '
    {__typename: "StatusContext", context: $context, state: $state,
     createdAt: $created, isRequired: false}'
}

# A check suite as listed under checkSuites. Args: id status conclusion runs
# [workflow-path] [event] [app-slug].
_suite() {
  jq -cn --argjson id "$1" --arg status "$2" --arg conclusion "$3" \
    --argjson runs "$4" --arg path "${5:-.github/workflows/test.yml}" \
    --arg event "${6:-pull_request}" --arg app "${7:-github-actions}" '
    {databaseId: $id, status: $status,
     conclusion: (if $conclusion == "" then null else $conclusion end),
     app: {slug: $app}, checkRuns: {totalCount: $runs},
     workflowRun: {event: $event, file: {path: $path}}}'
}

# Join JSON values into a JSON array.
_list() {
  if (($# == 0)); then
    printf '[]'
  else
    printf '%s\n' "$@" | jq -cs '.'
  fi
}

# A pull request node. Args: number contexts-json suites-json [overrides].
_pr() {
  local extra=${4:-}

  [[ -n "$extra" ]] || extra='{}'
  jq -cn --argjson n "$1" --argjson ctx "$2" --argjson suites "$3" \
    --argjson extra "$extra" --arg head "$HEAD" '
    {number: $n, url: "https://github.test/example/repo/pull/\($n)",
     state: "OPEN", isDraft: false, mergeable: "MERGEABLE",
     mergeStateStatus: "CLEAN", reviewDecision: null, baseRefName: "main",
     headRefName: "feature/\($n)", headRefOid: $head,
     isCrossRepository: false, autoMergeRequest: null,
     commits: {nodes: [{commit: {oid: $head,
       statusCheckRollup: (if ($ctx | length) == 0 then null
         else {contexts: {totalCount: ($ctx | length), nodes: $ctx}} end),
       checkSuites: {totalCount: ($suites | length), nodes: $suites}}}]}}
    * $extra'
}

# A snapshot response holding the given PR nodes as p00, p01, ...
_response() {
  printf '%s\n' "$@" | jq -cs '
    {data: {repository: (to_entries
      | map({key: ("p" + (if .key < 10 then "0" else "" end) + (.key | tostring)),
             value: .value}) | from_entries)}}'
}

# One passing check in a completed suite.
_green_pr() {
  _pr "$1" "$(_list "$(_run build COMPLETED SUCCESS 1 COMPLETED 11 "$OLD")")" \
    "$(_list "$(_suite 1 COMPLETED SUCCESS 1)")" "${2:-}"
}

# --- scenario harness -------------------------------------------------------

repo=$(_tmpdir)
bin_dir=$(_tmpdir)
_git_init "$repo"
_write_gh_stub "$bin_dir"

# Start a scenario with a fresh fake-gh state directory.
_scenario() {
  FAKE_GH_DIR=$(_tmpdir)
  export FAKE_GH_DIR
}

# Serve a snapshot response as call N. Optional status and headers.
_serve() {
  local n="$1" body="$2" status="${3:-}"
  shift 3 2>/dev/null || shift $#

  [[ -z "$body" ]] || printf '%s\n' "$body" >"$FAKE_GH_DIR/call-$n.json"
  [[ -z "$status" ]] || printf '%s\n' "$status" >"$FAKE_GH_DIR/call-$n.status"
  if (($# > 0)); then
    printf '%s\n' "$@" >"$FAKE_GH_DIR/call-$n.headers"
  fi
  [[ -e "$FAKE_GH_DIR/call-$n.json" || -e "$FAKE_GH_DIR/call-$n.status" ]] ||
    printf '200\n' >"$FAKE_GH_DIR/call-$n.status"
}

_watch() {
  out=$(PATH="$bin_dir:$PATH" git -C "$repo" pr-watch "$@" 2>"$FAKE_GH_DIR/stderr")
  status=$?
  err=$(cat "$FAKE_GH_DIR/stderr")
}

_calls() {
  cat "$FAKE_GH_DIR/n" 2>/dev/null || printf 0
}

