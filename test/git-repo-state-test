#!/usr/bin/env bash

set -uo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PATH="$ROOT/bin:$PATH"
export NO_COLOR=1

_failures=0
# shellcheck source=test/lib/test-temp.sh
. "$ROOT/test/lib/test-temp.sh"
gt_test_temp_init || exit 1
# shellcheck source=test/lib/hermetic-git.sh
. "$ROOT/test/lib/hermetic-git.sh"
gt_test_git_isolate "$GT_TEST_TEMP_ROOT" || exit 1
_tmpdir() { gt_test_temp_dir; }

_pass() {
  printf 'ok - %s\n' "$1"
}

_fail() {
  printf 'not ok - %s\n' "$1" >&2
  _failures=$((_failures + 1))
}

_assert_contains() {
  local name="$1"
  local needle="$2"
  local haystack="$3"

  if [[ "$haystack" == *"$needle"* ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected output to contain: %s\n' "$needle" >&2
    printf '  actual output:\n%s\n' "$haystack" >&2
  fi
}

_assert_equal() {
  local name="$1"
  local expected="$2"
  local actual="$3"

  if [[ "$expected" == "$actual" ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected:\n%s\n' "$expected" >&2
    printf '  actual:\n%s\n' "$actual" >&2
  fi
}

_repo_view_count() {
  grep -c '^repo view' "$GH_CALL_LOG" 2>/dev/null || true
}

_git_init() {
  local repo="$1"
  git init -q --initial-branch=main "$repo"
  git -C "$repo" config user.email "test@test.com"
  git -C "$repo" config user.name "Test"
  git -C "$repo" config core.hooksPath /dev/null
  printf 'base\n' >"$repo/README.md"
  git -C "$repo" add README.md
  git -C "$repo" commit -m base >/dev/null
}

_write_gh_stub() {
  local bin="$1/gh"
  cat >"$bin" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${GH_CALL_LOG:-}" ]]; then
  printf '%s\n' "$*" >>"$GH_CALL_LOG"
fi

if [[ "$1 $2" == "auth status" ]]; then
  exit 0
fi

if [[ "$1 $2" == "repo view" ]]; then
  printf 'example/repo\thttps://github.test/example/repo\n'
  exit 0
fi

if [[ "$1 $2" == "pr view" ]]; then
  printf '7\tOPEN\tfalse\tCLEAN\tfeature/state\t1111111111111111111111111111111111111111\tmain\texample/repo\tfalse\thttps://github.test/example/repo/pull/7\tState PR\n'
  exit 0
fi

if [[ "$1 $2" == "pr checks" ]]; then
  printf 'pass\n'
  exit 0
fi

printf 'unexpected gh call: %s\n' "$*" >&2
exit 99
EOF
  chmod +x "$bin"
}

_write_unauthenticated_gh_stub() {
  local bin="$1/gh"
  cat >"$bin" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

if [[ "$1 $2" == "auth status" ]]; then
  exit 1
fi

printf 'unexpected gh call: %s\n' "$*" >&2
exit 99
EOF
  chmod +x "$bin"
}

echo "=== git repo-state ==="

# Keep the identity cache hermetic: every repo-state invocation below resolves
# XDG_CACHE_HOME to this scratch dir instead of the developer's real cache.
XDG_CACHE_HOME="$(_tmpdir)/xdg"
export XDG_CACHE_HOME
mkdir -p "$XDG_CACHE_HOME"

repo=$(_tmpdir)
bin_dir=$(_tmpdir)
_git_init "$repo"
_write_gh_stub "$bin_dir"

git -C "$repo" switch -q -c feature/state
git -C "$repo" branch --set-upstream-to main >/dev/null
printf 'changed\n' >>"$repo/README.md"
printf 'new\n' >"$repo/new.txt"
git -C "$repo" stash push -u -m state-test >/dev/null

result=$(PATH="$bin_dir:$PATH" git -C "$repo" repo-state --porcelain 2>&1)
_assert_contains "porcelain includes branch" "branch=feature/state" "$result"
_assert_contains "porcelain includes default branch" "default=main" "$result"
_assert_contains "porcelain includes upstream" "upstream=main" "$result"
_assert_contains "porcelain reports clean after stash" "dirty=false" "$result"
_assert_contains "porcelain includes stash count" "stashes=1" "$result"
_assert_contains "porcelain includes PR number" "pr_number=7" "$result"
_assert_contains "porcelain includes PR checks" "pr_checks=pass" "$result"

printf 'again\n' >>"$repo/README.md"
printf 'other\n' >"$repo/other.txt"
result=$(PATH="$bin_dir:$PATH" git -C "$repo" repo-state 2>&1)
_assert_contains "human reports dirty worktree" "worktree: dirty" "$result"
_assert_contains "human reports PR" "pr: #7 main -> feature/state checks=pass" "$result"

result=$(PATH="$bin_dir:$PATH" git -C "$repo" repo-state --json 2>&1)
_assert_contains "json includes dirty boolean" '"dirty":true' "$result"
_assert_contains "json includes PR URL" '"pr_url":"https://github.test/example/repo/pull/7"' "$result"

unauthenticated_gh=$(_tmpdir)
_write_unauthenticated_gh_stub "$unauthenticated_gh"
result=$(PATH="$unauthenticated_gh:$PATH" git -C "$repo" repo-state --porcelain 2>&1)
_assert_contains "works without authenticated gh" "pr_available=false" "$result"

outside=$(_tmpdir)
result=$(PATH="$bin_dir:$PATH" git -C "$outside" repo-state 2>&1 || true)
_assert_contains "requires git repo" "not inside a git repository" "$result"

# Detached HEAD still reports DETACHED (status -b header parsing).
detached=$(_tmpdir)
_git_init "$detached"
git -C "$detached" checkout -q --detach HEAD
result=$(PATH="$bin_dir:$PATH" git -C "$detached" repo-state --porcelain 2>&1)
_assert_contains "detached HEAD reports DETACHED branch" "branch=DETACHED" "$result"

# Bare repositories keep their dedicated error.
bare_parent=$(_tmpdir)
git init -q --bare "$bare_parent/bare.git"
result=$(PATH="$bin_dir:$PATH" git -C "$bare_parent/bare.git" repo-state 2>&1 || true)
_assert_contains "bare repo reports unsupported" "bare repositories are not supported" "$result"

# Subdirectory invocation reports the worktree root.
mkdir -p "$repo/sub/dir"
result=$(PATH="$bin_dir:$PATH" git -C "$repo/sub/dir" repo-state --porcelain 2>&1)
_assert_contains "subdir reports repo root" "repo=$repo" "$result"
_assert_contains "subdir reports branch" "branch=feature/state" "$result"

# Identity cache: byte-identical reports with a single `gh repo view`.
cache_repo=$(_tmpdir)
_git_init "$cache_repo"
export GH_CALL_LOG="$cache_repo/gh-calls.log"
: >"$GH_CALL_LOG"
miss_porcelain=$(PATH="$bin_dir:$PATH" git -C "$cache_repo" repo-state --porcelain 2>&1)
miss_json=$(PATH="$bin_dir:$PATH" git -C "$cache_repo" repo-state --json 2>&1)
miss_human=$(PATH="$bin_dir:$PATH" git -C "$cache_repo" repo-state 2>&1)
_assert_contains "cache miss reports PR" "pr_number=7" "$miss_porcelain"
hit_porcelain=$(PATH="$bin_dir:$PATH" git -C "$cache_repo" repo-state --porcelain 2>&1)
hit_json=$(PATH="$bin_dir:$PATH" git -C "$cache_repo" repo-state --json 2>&1)
hit_human=$(PATH="$bin_dir:$PATH" git -C "$cache_repo" repo-state 2>&1)
_assert_equal "cache hit porcelain identical" "$miss_porcelain" "$hit_porcelain"
_assert_equal "cache hit json identical" "$miss_json" "$hit_json"
_assert_equal "cache hit human identical" "$miss_human" "$hit_human"
_assert_equal "cache hit skips gh repo view" "1" "$(_repo_view_count)"

# Remote edits invalidate the cache key; restoring remotes hits again.
git -C "$cache_repo" remote add origin https://github.test/example/repo.git
remote_porcelain=$(PATH="$bin_dir:$PATH" git -C "$cache_repo" repo-state --porcelain 2>&1)
_assert_equal "remote add keeps report identical" "$miss_porcelain" "$remote_porcelain"
_assert_equal "remote add refetches identity" "2" "$(_repo_view_count)"
git -C "$cache_repo" remote set-url origin https://github.test/example/other.git
PATH="$bin_dir:$PATH" git -C "$cache_repo" repo-state --porcelain >/dev/null 2>&1
_assert_equal "remote set-url refetches identity" "3" "$(_repo_view_count)"
git -C "$cache_repo" remote remove origin
restored_porcelain=$(PATH="$bin_dir:$PATH" git -C "$cache_repo" repo-state --porcelain 2>&1)
_assert_equal "remote remove keeps report identical" "$miss_porcelain" "$restored_porcelain"
_assert_equal "remote remove hits original entry" "3" "$(_repo_view_count)"

# Expired and corrupt entries fall back to live resolution.
ttl_repo=$(_tmpdir)
_git_init "$ttl_repo"
ttl_before=$(_repo_view_count)
ttl_miss=$(PATH="$bin_dir:$PATH" git -C "$ttl_repo" repo-state --porcelain 2>&1)
_assert_equal "ttl repo fetches identity" "$((ttl_before + 1))" "$(_repo_view_count)"
ttl_entry=$(grep -l -F "$ttl_repo" "$XDG_CACHE_HOME"/git-tools/repo-identity/*)
{
  printf '1\n'
  tail -n +2 "$ttl_entry"
} >"$ttl_entry.stale"
mv -f "$ttl_entry.stale" "$ttl_entry"
ttl_refetch=$(PATH="$bin_dir:$PATH" git -C "$ttl_repo" repo-state --porcelain 2>&1)
_assert_equal "expired entry refetches" "$((ttl_before + 2))" "$(_repo_view_count)"
_assert_equal "expired entry keeps report identical" "$ttl_miss" "$ttl_refetch"
printf 'garbage\n' >"$ttl_entry"
ttl_corrupt=$(PATH="$bin_dir:$PATH" git -C "$ttl_repo" repo-state --porcelain 2>&1)
_assert_equal "corrupt entry refetches" "$((ttl_before + 3))" "$(_repo_view_count)"
_assert_equal "corrupt entry keeps report identical" "$ttl_miss" "$ttl_corrupt"

if ((_failures > 0)); then
  printf '%s failure(s)\n' "$_failures" >&2
  exit 1
fi

printf 'all tests passed\n'
