#!/usr/bin/env bash

set -uo pipefail

ROOT=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

# shellcheck source=lib/test-temp.sh
. "$ROOT/test/lib/test-temp.sh"
# shellcheck source=lib/git-tools-inventory.sh
. "$ROOT/lib/git-tools-inventory.sh"

gt_test_temp_init || exit 1
failures=0

pass() {
  printf 'ok - %s\n' "$1"
}

fail() {
  printf 'not ok - %s\n' "$1" >&2
  failures=$((failures + 1))
}

assert_eq() {
  local description="$1" expected="$2" actual="$3"

  if [[ "$expected" == "$actual" ]]; then
    pass "$description"
  else
    fail "$description (expected '$expected', got '$actual')"
  fi
}

assert_link() {
  local description="$1" expected="$2" target="$3" actual

  if [[ ! -L "$target" ]]; then
    fail "$description (not a symlink: $target)"
    return
  fi
  actual=$(readlink "$target")
  assert_eq "$description" "$expected" "$actual"
}

commands=()
while IFS= read -r command; do
  commands+=("$command")
done < <(git_tools_commands "$ROOT")
if ((${#commands[@]} > 0)); then
  pass "installer inventory: discovers public commands"
else
  fail "installer inventory: discovers public commands"
fi

wrapper="$ROOT/install.sh"
delegate="$ROOT/support/install-checkout.sh"
if [[ -f "$wrapper" ]]; then
  pass "installer: generated checkout wrapper is present"
else
  fail "installer: generated checkout wrapper is present"
fi
if [[ -f "$delegate" ]]; then
  pass "installer: checkout-owned delegate is present"
else
  fail "installer: checkout-owned delegate is present"
fi
if [[ -f "$wrapper" ]] &&
  [[ $(sed -n '2p' "$wrapper") == *'Generated by cgraf78/actions checkout-installer'* ]]; then
  pass "installer: wrapper identifies the shared generator"
else
  fail "installer: wrapper identifies the shared generator"
fi
if [[ ! -f "$wrapper" || ! -f "$delegate" ]]; then
  printf '%s failure(s)\n' "$failures" >&2
  exit 1
fi

run_installer() {
  local installer="$1" prefix="$2"

  PREFIX="$prefix" \
    SHARE_DIR="$prefix/share" \
    BIN_DIR="$prefix/bin" \
    MAN_DIR="$prefix/share/man/man1" \
    BASH_COMPLETION_DIR="$prefix/share/bash-completion/completions" \
    ZSH_COMPLETION_DIR="$prefix/share/zsh/site-functions" \
    FISH_COMPLETION_DIR="$prefix/share/fish/vendor_completions.d" \
    "$installer"
}

assert_install() {
  local description="$1" checkout="$2" prefix="$3" command command_status

  for command in "${commands[@]}"; do
    assert_link "$description: command $command" \
      "$checkout/bin/$command" "$prefix/bin/$command"
    assert_link "$description: manpage $command" \
      "$checkout/man/man1/$command.1" \
      "$prefix/share/man/man1/$command.1"
    assert_link "$description: Bash completion $command" \
      "$checkout/completions/$command.bash" \
      "$prefix/share/bash-completion/completions/$command"
    assert_link "$description: Zsh completion $command" \
      "$checkout/completions/$command.zsh" \
      "$prefix/share/zsh/site-functions/_$command"
    assert_link "$description: Fish completion $command" \
      "$checkout/completions/$command.fish" \
      "$prefix/share/fish/vendor_completions.d/$command.fish"
    command_status=0
    "$prefix/bin/$command" --help >/dev/null 2>&1 || command_status=$?
    assert_eq "$description: $command resolves checkout libraries" 0 \
      "$command_status"
  done
}

current_prefix=$(gt_test_temp_dir)
run_installer "$wrapper" "$current_prefix" >/dev/null
installer_status=$?
assert_eq "installer direct checkout: installer succeeds" 0 "$installer_status"
current_root=$(cd -P -- "$ROOT" && pwd)
assert_install "installer direct checkout" "$current_root" "$current_prefix"

fixture=$(gt_test_temp_dir)
source_checkout="$fixture/source"
remote="$fixture/git-tools.git"
managed="$fixture/managed/git-tools"
direct_prefix="$fixture/direct-prefix"
pipe_prefix="$fixture/pipe-prefix"
mkdir -p "$source_checkout"
cp "$wrapper" "$source_checkout/install.sh"
cp -R "$ROOT/bin" "$ROOT/completions" "$ROOT/lib" "$ROOT/man" \
  "$ROOT/support" "$source_checkout/"
git -C "$source_checkout" init --quiet --initial-branch=main --template=''
git -C "$source_checkout" config core.hooksPath /dev/null
git -C "$source_checkout" config commit.gpgsign false
git -C "$source_checkout" config user.name 'Git Tools Installer Test'
git -C "$source_checkout" config user.email \
  git-tools-installer@example.invalid
git -C "$source_checkout" add .
git -C "$source_checkout" commit --quiet -m 'checkout installer fixture'
git init --quiet --bare --initial-branch=main "$remote"
git -C "$source_checkout" remote add origin "$remote"
git -C "$source_checkout" push --quiet --set-upstream origin main

run_installer "$source_checkout/install.sh" "$direct_prefix" >/dev/null
installer_status=$?
assert_eq "installer generated direct wrapper: installer succeeds" 0 \
  "$installer_status"
source_physical=$(cd -P -- "$source_checkout" && pwd)
assert_install "installer generated direct wrapper" "$source_physical" \
  "$direct_prefix"

pipe_output_file="$fixture/pipe.out"
curl --fail --silent --show-error "file://$source_checkout/install.sh" |
  PREFIX="$pipe_prefix" \
    SHARE_DIR="$pipe_prefix/share" \
    BIN_DIR="$pipe_prefix/bin" \
    MAN_DIR="$pipe_prefix/share/man/man1" \
    BASH_COMPLETION_DIR="$pipe_prefix/share/bash-completion/completions" \
    ZSH_COMPLETION_DIR="$pipe_prefix/share/zsh/site-functions" \
    FISH_COMPLETION_DIR="$pipe_prefix/share/fish/vendor_completions.d" \
    CGRAF78_CHECKOUT_INSTALL_DIR="$managed" \
    CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$remote" \
    bash -s >"$pipe_output_file" 2>&1
pipeline_status=("${PIPESTATUS[@]}")
assert_eq "installer piped wrapper: curl succeeds" 0 \
  "${pipeline_status[0]}"
assert_eq "installer piped wrapper: installer succeeds" 0 \
  "${pipeline_status[1]}"
pipe_output=$(<"$pipe_output_file")
managed_physical=$(cd -P -- "$managed" && pwd)
if [[ -f "$managed/.git/HEAD" ]]; then
  pass "installer piped wrapper: keeps a durable checkout"
else
  fail "installer piped wrapper: keeps a durable checkout"
fi
assert_install "installer piped wrapper" "$managed_physical" "$pipe_prefix"
if [[ "$pipe_output" == *"cloning cgraf78/git-tools to $managed_physical"* ]]; then
  pass "installer piped wrapper: reports its durable clone"
else
  fail "installer piped wrapper: reports its durable clone"
fi

if ((failures > 0)); then
  printf '%s failure(s)\n' "$failures" >&2
  exit 1
fi

printf 'all tests passed\n'
