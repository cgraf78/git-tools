#!/usr/bin/env bash

set -uo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
TMPDIR_ROOT=$(mktemp -d)
trap 'rm -rf "$TMPDIR_ROOT"' EXIT

failures=0

pass() {
  printf 'ok - %s\n' "$1"
}

fail() {
  printf 'not ok - %s\n' "$1" >&2
  failures=$((failures + 1))
}

fixture="$TMPDIR_ROOT/repo"
sync="$fixture/support/sync-launcher-bootstrap"
launcher="$fixture/bin/git-repo-state"
output="$TMPDIR_ROOT/output"

reset_fixture() {
  rm -rf "$fixture"
  mkdir -p "$fixture/bin" "$fixture/lib" "$fixture/support"
  cp "$ROOT/bin/git-repo-state" "$launcher"
  cp "$ROOT/lib/git-tools-inventory.sh" "$fixture/lib/"
  cp "$ROOT/support/launcher-bootstrap.sh.template" "$fixture/support/"
  cp "$ROOT/support/sync-launcher-bootstrap" "$sync"
  chmod +x "$launcher" "$sync"
}

echo '=== launcher bootstrap ==='

reset_fixture
if "$sync" --check >"$output" 2>&1; then
  pass 'canonical launcher passes --check'
else
  fail 'canonical launcher passes --check'
fi

awk '
  { print }
  /Generated by support\/sync-launcher-bootstrap/ { print "# deliberate drift" }
' "$launcher" >"$launcher.tmp"
mv "$launcher.tmp" "$launcher"
chmod 751 "$launcher"
if "$sync" --check >"$output" 2>&1; then
  fail '--check rejects drifted generated content'
else
  pass '--check rejects drifted generated content'
fi
if "$sync" >"$output" 2>&1 && "$sync" --check >>"$output" 2>&1; then
  pass 'synchronizer repairs drift idempotently'
else
  fail 'synchronizer repairs drift idempotently'
fi
if [[ $(find "$launcher" -prune -perm 0751 -print) == "$launcher" ]]; then
  pass 'repair preserves launcher mode'
else
  fail 'repair preserves launcher mode'
fi
if grep -F -q 'deliberate drift' "$launcher"; then
  fail 'repair removes drifted content'
else
  grep_status=$?
  if [[ "$grep_status" -eq 1 ]]; then
    pass 'repair removes drifted content'
  else
    fail 'repair removes drifted content'
  fi
fi

reset_fixture
launcher_contents=$(cat "$launcher")
printf '%s' "$launcher_contents" >"$launcher"
if "$sync" --check >"$output" 2>&1; then
  fail '--check rejects a missing final newline'
else
  pass '--check rejects a missing final newline'
fi
if "$sync" >"$output" 2>&1 && "$sync" --check >>"$output" 2>&1; then
  pass 'synchronizer restores the final newline'
else
  fail 'synchronizer restores the final newline'
fi

reset_fixture
cp "$launcher" "$TMPDIR_ROOT/launcher-before-template-error"
template_contents=$(cat "$fixture/support/launcher-bootstrap.sh.template")
printf '%s' "$template_contents" >"$fixture/support/launcher-bootstrap.sh.template"
if "$sync" >"$output" 2>&1; then
  fail 'synchronizer rejects a template without a final newline'
else
  pass 'synchronizer rejects a template without a final newline'
fi
if cmp -s "$launcher" "$TMPDIR_ROOT/launcher-before-template-error"; then
  pass 'malformed template leaves launcher unchanged'
else
  fail 'malformed template leaves launcher unchanged'
fi

reset_fixture
printf '%s\n' '# BEGIN GENERATED LAUNCHER BOOTSTRAP' \
  >>"$fixture/support/launcher-bootstrap.sh.template"
if "$sync" >"$output" 2>&1; then
  fail 'synchronizer rejects reserved markers in the template'
else
  pass 'synchronizer rejects reserved markers in the template'
fi

reset_fixture
chmod -x "$launcher"
if "$sync" --check >"$output" 2>&1; then
  fail '--check rejects a launcher without its executable bit'
else
  pass '--check rejects a launcher without its executable bit'
fi

reset_fixture
printf '%s\n' '# interrupted update residue' >"$fixture/bin/.git-repo-state.tmp.ABCDEF"
chmod +x "$fixture/bin/.git-repo-state.tmp.ABCDEF"
if "$sync" --check >"$output" 2>&1; then
  pass 'hidden interruption residue cannot enter command inventory'
else
  fail 'hidden interruption residue cannot enter command inventory'
fi

reset_fixture
awk '
  /^# BEGIN GENERATED LAUNCHER BOOTSTRAP$/ { inside = 1; next }
  /^# END GENERATED LAUNCHER BOOTSTRAP$/ { inside = 0; next }
  !inside { print }
' "$launcher" >"$launcher.tmp"
mv "$launcher.tmp" "$launcher"
chmod +x "$launcher"
if "$sync" --check >"$output" 2>&1; then
  fail '--check rejects a launcher without generated markers'
else
  pass '--check rejects a launcher without generated markers'
fi

reset_fixture
printf '%s\n' '#!/usr/bin/env bash' 'exit 0' >"$fixture/bin/git-new-command"
chmod +x "$fixture/bin/git-new-command"
if "$sync" --check >"$output" 2>&1; then
  fail 'inventory includes newly added launchers in --check'
else
  pass 'inventory includes newly added launchers in --check'
fi

if ((failures > 0)); then
  printf '%s failure(s)\n' "$failures" >&2
  exit 1
fi

printf 'all tests passed\n'
